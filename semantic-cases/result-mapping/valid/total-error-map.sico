// case: RESULT-002
// expect: accept
// semantics: SEM-031, SEM-064, SEM-071

enum ParseError
  Empty
  Invalid(value: Text)
end

enum AppError
  MissingInput
  BadInput(value: Text)
end

fn parse() -> Result<Int, ParseError>
  return ok(1)
end

fn load() -> Result<Int, AppError>
  return parse().map_error(problem => match problem
    ParseError.Empty => AppError.MissingInput
    ParseError.Invalid(value) => AppError.BadInput(value)
  end)
end
