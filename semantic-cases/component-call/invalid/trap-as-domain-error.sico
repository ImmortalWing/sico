// case: COMP-102
// expect: reject(COMPONENT_FAILURE_COLLAPSE)
// semantics: SEM-074, SEM-121

enum FormatError
  InvalidInput
end

interface Formatter
  fn format(input: Text) -> Result<Text, FormatError>
end

fn render(formatter: Component<Formatter>, input: Text) -> Result<Text, FormatError>
  effects component.call
  capabilities formatter
  return call formatter.format(input)
end
