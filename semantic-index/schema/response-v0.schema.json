{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sico:schema:semantic-response:v0",
  "title": "Sico Semantic Query Response v0",
  "type": "object",
  "required": ["schema", "protocol_version", "request_id", "snapshot_id", "operation", "budget", "result"],
  "properties": {
    "schema": { "const": "sico.semantic-response.v0" },
    "protocol_version": { "const": 0 },
    "request_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "snapshot_id": { "type": "string", "pattern": "^(fixture:[a-z0-9._-]+|sha256:[a-f0-9]{64})$" },
    "operation": { "enum": ["outline", "describe", "slice", "impact", "flow"] },
    "budget": {
      "type": "object",
      "required": ["max_depth", "max_items", "max_bytes", "used_depth", "used_items", "used_bytes", "truncated", "omitted_items"],
      "properties": {
        "max_depth": { "type": "integer", "minimum": 0, "maximum": 16 },
        "max_items": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "max_bytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
        "used_depth": { "type": "integer", "minimum": 0 },
        "used_items": { "type": "integer", "minimum": 0 },
        "used_bytes": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "omitted_items": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "required": ["target", "completeness", "reasons", "blocked_by", "items", "edges", "next_queries"],
      "properties": {
        "target": { "type": "string", "pattern": "^sico://[a-z0-9][a-z0-9.-]*(/[A-Za-z0-9._~%-]+)+$" },
        "completeness": { "enum": ["complete", "partial", "unknown"] },
        "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "blocked_by": { "type": "array", "items": { "type": "string", "pattern": "^E[1-9][0-9]{3}$" } },
        "summary": {
          "type": "object",
          "required": ["basis", "value", "evidence"],
          "properties": {
            "basis": { "enum": ["declared", "verified", "inferred"] },
            "value": {},
            "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
          },
          "additionalProperties": true
        },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
        "next_queries": { "type": "array", "items": { "$ref": "#/$defs/nextQuery" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "semanticId": {
      "type": "string",
      "pattern": "^sico://[a-z0-9][a-z0-9.-]*(/[A-Za-z0-9._~%-]+)+$"
    },
    "position": {
      "type": "object",
      "required": ["byte", "line", "column"],
      "properties": {
        "byte": { "type": "integer", "minimum": 0 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["file", "range"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "range": { "$ref": "#/$defs/range" }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "enum": ["source", "analysis", "semantic-rule", "diagnostic", "user-change"] },
        "ref": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" }
      },
      "additionalProperties": true
    },
    "fact": {
      "type": "object",
      "required": ["basis", "value", "evidence"],
      "properties": {
        "basis": { "enum": ["declared", "verified", "inferred"] },
        "value": {},
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      },
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "required": ["id", "kind", "name", "role", "completeness", "facets"],
      "properties": {
        "id": { "$ref": "#/$defs/semanticId" },
        "kind": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "completeness": { "enum": ["complete", "partial", "unknown"] },
        "facets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/fact" } },
        "source": { "$ref": "#/$defs/source" },
        "reason": { "$ref": "#/$defs/fact" },
        "via": { "type": "array", "items": { "$ref": "#/$defs/semanticId" } }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["kind", "from", "to", "basis", "evidence"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "from": { "$ref": "#/$defs/semanticId" },
        "to": { "$ref": "#/$defs/semanticId" },
        "basis": { "enum": ["declared", "verified", "inferred"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "label": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "nextQuery": {
      "type": "object",
      "required": ["operation", "target"],
      "properties": {
        "operation": { "enum": ["outline", "describe", "slice", "impact", "flow"] },
        "target": { "$ref": "#/$defs/semanticId" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 160 }
      },
      "additionalProperties": true
    }
  }
}
