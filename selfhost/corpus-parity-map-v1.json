    "equivalence_class": "Named equivalence class the pair is registered under.",
    "evidence": {
      "corpus_count": "number of corpus entries backing this pair in the frozen parity run.",
      "sample_paths": "up to 3 corpus paths (deterministic first-3 order).",
      "source": "provenance of the evidence."
