        end if
        if same(body_line, "end match"):
          let covered = sico.list.length(match_cases)
          let variants = owner_count(variant_owners, match_enum_one)
          if I64.equal(match_is_error_map, I64.literal(1)):
            if U64.less_than(covered, variants):
              if I64.equal(match_wildcard, I64.literal(1)):
                return "E3103"
              end if
              return "E3102"
            end if
          else:
            if I64.equal(match_wildcard, I64.literal(1)):
              if U64.less_than(U64.literal(0), sico.text.length(match_enum_two)):
                return "E3002"
              end if
              if U64.less_than(covered, variants):
                return "E3002"
              end if
            else:
              if U64.equal(sico.text.length(match_enum_two), U64.literal(0)):
                if U64.less_than(covered, variants):
                  return "E3001"
                end if
              end if
            end if
          end if
          set match_active = I64.literal(0)
        end if
      end if

      if sico.text.starts_with(body_line, "let "):
        let try_index = compiler_parser.find(body_parts, "try")
        if U64.less_than(try_index, sico.list.length(body_parts)):
          let try_callee = compiler_parser.at(body_parts, add(try_index, U64.literal(1)))
          let try_source_error = map_get(function_names, function_result_errors, try_callee)
          if U64.less_than(U64.literal(0), sico.text.length(try_source_error)):
            if U64.less_than(U64.literal(0), sico.text.length(active_result_error)):
              if different(try_source_error, active_result_error):
                return "E3101"
              end if
            end if
          end if
        end if
      end if

      if U64.equal(sico.list.length(body_parts), U64.literal(1)):
        let statement_error = map_get(function_names, function_result_errors, compiler_parser.at(body_parts, U64.literal(0)))
        if U64.less_than(U64.literal(0), sico.text.length(statement_error)):
          return "E3104"
        end if
      end if

      if sico.text.starts_with(body_line, "return "):
        if same(active_return, "Float64"):
          let value = compiler_parser.at(body_parts, U64.literal(1))
          if implicit_integer_float(value):
            return "E2002"
          end if
        end if
        if same(active_return, "Int"):
          if sico.text.starts_with(body_line, "return \""):
            return "E2001"
          end if
        end if

        let constructor = compiler_parser.at(body_parts, U64.literal(1))
        if list_has(record_names, constructor):
          let field_index = U64.literal(0)
          while U64.less_than(field_index, sico.list.length(field_owners)):
            if same(item(field_owners, field_index), constructor):
              if missing_field_label(body_line, item(field_names, field_index)):
                return "E2010"
              end if
            end if
            set field_index = add(field_index, U64.literal(1))
          end while
          if U64.less_than(owner_count(field_owners, constructor), count_byte(body_line, I64.literal(58))):
            return "E2011"
          end if
          let invariant_index = U64.literal(0)
          while U64.less_than(invariant_index, sico.list.length(invariant_owners)):
            if same(item(invariant_owners, invariant_index), constructor):
              let left_value = word_after(body_parts, item(invariant_left, invariant_index))
              let right_value = word_after(body_parts, item(invariant_right, invariant_index))
              if invariant_violated(left_value, right_value):
                return "E2020"
