      if U64.less_than(U64.literal(0), collect_index):
        if U64.less_than(collect_index, sico.list.length(body_parts)):
          let collect_receiver = compiler_parser.at(body_parts, sub(collect_index, U64.literal(1)))
          if same(parameter_type(parameter_owners, parameter_names, parameter_types, active_function_name, collect_receiver), "Stream"):
            if U64.equal(compiler_parser.find(body_parts, "limit"), sico.list.length(body_parts)):
              return "E5201"
            end if
          end if
        end if
      end if

      if sico.text.starts_with(body_line, "return "):
        if I64.equal(declared_capability_none, I64.literal(1)):
          if U64.less_than(U64.literal(0), count_byte(body_line, I64.literal(46))):
            return "E4001"
          end if
        end if
        if I64.equal(declared_effect_none, I64.literal(1)):
          if U64.less_than(U64.literal(0), count_byte(body_line, I64.literal(46))):
            return "E4002"
          end if
        end if
        if U64.less_than(compiler_parser.find(body_parts, "call"), sico.list.length(body_parts)):
          if same(active_return, "Result"):
            return "E6002"
          end if
        end if
        let commit_index = compiler_parser.find(body_parts, "commit")
        if U64.less_than(commit_index, sico.list.length(body_parts)):
          if missing_two_arguments(body_parts, commit_index):
            return "E7001"
          end if
        end if
      end if
      if sico.text.starts_with(body_line, "if "):
        set if_depth = add(if_depth, U64.literal(1))
        if U64.less_than(U64.literal(1), count_byte(body_line, I64.literal(61))):
          let guard_scan = U64.literal(0)
          while U64.less_than(guard_scan, sico.list.length(versioned_payloads)):
            let guard_name = item(versioned_payloads, guard_scan)
            if words_adjacent(body_parts, guard_name, "revision"):
              set guard_payloads = sico.list.append(guard_payloads, guard_name)
              set guard_depths = sico.list.append(guard_depths, sico.u64.to_text(if_depth))
            end if
            set guard_scan = add(guard_scan, U64.literal(1))
          end while
        end if
      end if
      if same(body_line, "end if"):
        let kept_payloads = sico.text.split_lines("")
        let kept_depths = sico.text.split_lines("")
        let keep_scan = U64.literal(0)
        while U64.less_than(keep_scan, sico.list.length(guard_payloads)):
          if decimal_less_equal(item(guard_depths, keep_scan), sico.u64.to_text(sub(if_depth, U64.literal(1)))):
            set kept_payloads = sico.list.append(kept_payloads, item(guard_payloads, keep_scan))
            set kept_depths = sico.list.append(kept_depths, item(guard_depths, keep_scan))
          end if
          set keep_scan = add(keep_scan, U64.literal(1))
        end while
        set guard_payloads = kept_payloads
        set guard_depths = kept_depths
        set if_depth = sub(if_depth, U64.literal(1))
      end if
    end if
    set index = add(index, U64.literal(1))
  end while
  return ""
end function
