        if U64.less_than(U64.literal(0), sico.text.length(pending_error_map)):
          set match_enum_one = pending_error_map
          set match_is_error_map = I64.literal(1)
          set pending_error_map = ""
        else:
          set match_enum_one = parameter_type(parameter_owners, parameter_names, parameter_types, active_function_name, compiler_parser.at(body_parts, U64.literal(1)))
          set match_enum_two = parameter_type(parameter_owners, parameter_names, parameter_types, active_function_name, compiler_parser.at(body_parts, U64.literal(2)))
        end if
