module compiler_semantics

use compiler_parser.words
use compiler_parser.at
use compiler_parser.find
use compiler_parser.syntax_function_header

function add(left: U64, right: U64) returns U64:
  match U64.checked_add(left, right):
    case ok(value):
      return value
    case error(_):
      return left
  end match
end function

function sub(left: U64, right: U64) returns U64:
  match U64.checked_sub(left, right):
    case ok(value):
      return value
    case error(_):
      return U64.literal(0)
  end match
end function

function same(left: Text, right: Text) returns Bool:
  return sico.bytes.equal(sico.text.encode(left), sico.text.encode(right))
end function

function different(left: Text, right: Text) returns Bool:
  if same(left, right):
    return false
  end if
  return true
end function

function less_equal(left: U64, right: U64) returns Bool:
  if U64.less_than(left, right):
    return true
  end if
  return U64.equal(left, right)
end function

function item(items: List[Text], index: U64) returns Text:
  match sico.list.get(items, index):
    case ok(value):
      return value
    case error(_):
      return ""
  end match
end function

function list_has(items: List[Text], target: Text) returns Bool:
  let index = U64.literal(0)
  while U64.less_than(index, sico.list.length(items)):
    if same(item(items, index), target):
      return true
    end if
    set index = add(index, U64.literal(1))
  end while
  return false
end function

function list_missing(items: List[Text], target: Text) returns Bool:
  if list_has(items, target):
    return false
  end if
  return true
end function

function has_unconsumed(spawned: List[Text], consumed: List[Text]) returns Bool:
  let index = U64.literal(0)
  while U64.less_than(index, sico.list.length(spawned)):
    if list_missing(consumed, item(spawned, index)):
      return true
    end if
    set index = add(index, U64.literal(1))
  end while
  return false
end function

function missing_two_arguments(items: List[Text], call_index: U64) returns Bool:
  if U64.less_than(add(call_index, U64.literal(2)), sico.list.length(items)):
    return false
  end if
  return true
end function

function map_get(keys: List[Text], values: List[Text], target: Text) returns Text:
  let index = U64.literal(0)
  while U64.less_than(index, sico.list.length(keys)):
    if same(item(keys, index), target):
      return item(values, index)
    end if
    set index = add(index, U64.literal(1))
  end while
  return ""
end function

function parameter_type(owners: List[Text], names: List[Text], types: List[Text], function_name: Text, parameter_name: Text) returns Text:
  let index = U64.literal(0)
  while U64.less_than(index, sico.list.length(owners)):
    if same(item(owners, index), function_name):
      if same(item(names, index), parameter_name):
        return item(types, index)
      end if
    end if
    set index = add(index, U64.literal(1))
  end while
  return ""
end function

function owner_count(owners: List[Text], target: Text) returns U64:
  let index = U64.literal(0)
  let count = U64.literal(0)
  while U64.less_than(index, sico.list.length(owners)):
    if same(item(owners, index), target):
      set count = add(count, U64.literal(1))
    end if
    set index = add(index, U64.literal(1))
  end while
  return count
end function

function record_has_field(owners: List[Text], names: List[Text], record_name: Text, field: Text) returns Bool:
  let index = U64.literal(0)
  while U64.less_than(index, sico.list.length(owners)):
    if same(item(owners, index), record_name):
      if same(item(names, index), field):
        return true
      end if
    end if
    set index = add(index, U64.literal(1))
  end while
  return false
end function

function record_lacks_field(owners: List[Text], names: List[Text], record_name: Text, field: Text) returns Bool:
  if record_has_field(owners, names, record_name, field):
    return false
  end if
  return true
end function

function record_field_type(owners: List[Text], names: List[Text], types: List[Text], record_name: Text, field: Text) returns Text:
  let index = U64.literal(0)
  while U64.less_than(index, sico.list.length(owners)):
    if same(item(owners, index), record_name):
      if same(item(names, index), field):
        return item(types, index)
      end if
    end if
    set index = add(index, U64.literal(1))
  end while
  return ""
end function

function is_versioned_record(record_names: List[Text], field_owners: List[Text], field_names: List[Text], field_types: List[Text], type_name: Text) returns Bool:
  if list_missing(record_names, type_name):
    return false
  end if
  if different(record_field_type(field_owners, field_names, field_types, type_name, "revision"), "Revision"):
    return false
  end if
  return record_has_field(field_owners, field_names, type_name, "text")
end function

function versioned_payloads_for(parameter_owners: List[Text], parameter_names: List[Text], parameter_types: List[Text], record_names: List[Text], field_owners: List[Text], field_names: List[Text], field_types: List[Text], function_name: Text) returns List[Text]:
  let payloads = sico.text.split_lines("")
  let index = U64.literal(0)
  while U64.less_than(index, sico.list.length(parameter_owners)):
    if same(item(parameter_owners, index), function_name):
      if is_versioned_record(record_names, field_owners, field_names, field_types, item(parameter_types, index)):
        set payloads = sico.list.append(payloads, item(parameter_names, index))
      end if
    end if
    set index = add(index, U64.literal(1))
  end while
  return payloads
end function

function words_adjacent(items: List[Text], left: Text, right: Text) returns Bool:
  let index = U64.literal(0)
  while U64.less_than(add(index, U64.literal(1)), sico.list.length(items)):
    if same(item(items, index), left):
      if same(item(items, add(index, U64.literal(1))), right):
        return true
      end if
    end if
    set index = add(index, U64.literal(1))
  end while
  return false
end function

function count_byte(text: Text, target: I64) returns U64:
  let bytes = sico.text.encode(text)
  let index = U64.literal(0)
  let count = U64.literal(0)
  while U64.less_than(index, sico.bytes.length(bytes)):
    if I64.equal(sico.bytes.at(bytes, index, I64.literal(-1)), target):
      set count = add(count, U64.literal(1))
    end if
    set index = add(index, U64.literal(1))
  end while
  return count
end function

function has_field_label(line: Text, field: Text) returns Bool:
  let source = sico.text.encode(line)
  let needle = sico.text.encode(sico.text.concat(field, ":"))
  let start = U64.literal(0)
  while less_equal(add(start, sico.bytes.length(needle)), sico.bytes.length(source)):
    match sico.bytes.slice(source, start, sico.bytes.length(needle)):
      case ok(part):
        if sico.bytes.equal(part, needle):
          return true
        end if
      case error(_):
        return false
    end match
    set start = add(start, U64.literal(1))
  end while
  return false
end function

function word_after(items: List[Text], target: Text) returns Text:
  let index = U64.literal(0)
  while U64.less_than(add(index, U64.literal(1)), sico.list.length(items)):
    if same(item(items, index), target):
      return item(items, add(index, U64.literal(1)))
    end if
    set index = add(index, U64.literal(1))
  end while
  return ""
end function

function decimal_less_equal(left: Text, right: Text) returns Bool:
  let left_bytes = sico.text.encode(left)
  let right_bytes = sico.text.encode(right)
  if U64.equal(sico.bytes.length(left_bytes), U64.literal(0)):
    return true
  end if
  if U64.equal(sico.bytes.length(right_bytes), U64.literal(0)):
    return true
  end if
  if U64.less_than(sico.bytes.length(left_bytes), sico.bytes.length(right_bytes)):
    return true
  end if
  if U64.less_than(sico.bytes.length(right_bytes), sico.bytes.length(left_bytes)):
    return false
  end if
  let index = U64.literal(0)
  while U64.less_than(index, sico.bytes.length(left_bytes)):
    let left_byte = sico.bytes.at(left_bytes, index, I64.literal(-1))
    let right_byte = sico.bytes.at(right_bytes, index, I64.literal(-1))
    if I64.less_than(left_byte, right_byte):
      return true
    end if
    if I64.less_than(right_byte, left_byte):
      return false
    end if
    set index = add(index, U64.literal(1))
  end while
  return true
end function

function decimal_digits(value: Text) returns Bool:
  let bytes = sico.text.encode(value)
  let index = U64.literal(0)
  if U64.equal(sico.bytes.length(bytes), U64.literal(0)):
    return false
  end if
  while U64.less_than(index, sico.bytes.length(bytes)):
    let b = sico.bytes.at(bytes, index, I64.literal(-1))
    if I64.less_than(b, I64.literal(48)):
      return false
    end if
    if I64.less_than(b, I64.literal(58)):
      set index = add(index, U64.literal(1))
    else:
      return false
    end if
  end while
  return true
end function

function missing_field_label(line: Text, field: Text) returns Bool:
  if has_field_label(line, field):
    return false
  end if
  return true
end function

function invariant_violated(left: Text, right: Text) returns Bool:
  if decimal_digits(left):
    if decimal_digits(right):
      if decimal_less_equal(left, right):
        return false
      end if
      return true
    end if
  end if
  return false
end function

function implicit_integer_float(value: Text) returns Bool:
  if decimal_digits(value):
    return true
  end if
  return false
end function

function word_byte(b: I64) returns Bool:
  if I64.equal(b, I64.literal(95)):
    return true
  end if
  if I64.less_than(b, I64.literal(48)):
    return false
  end if
  if I64.less_than(b, I64.literal(58)):
    return true
  end if
  if I64.less_than(b, I64.literal(65)):
    return false
  end if
  if I64.less_than(b, I64.literal(91)):
    return true
  end if
  if I64.less_than(b, I64.literal(97)):
    return false
  end if
  return I64.less_than(b, I64.literal(123))
end function

function letter_byte(b: I64) returns Bool:
  if I64.less_than(b, I64.literal(65)):
    return false
  end if
  if I64.less_than(b, I64.literal(91)):
    return true
  end if
  if I64.less_than(b, I64.literal(97)):
    return false
  end if
  return I64.less_than(b, I64.literal(123))
end function

function dot_before_equal(line: Text) returns Bool:
  let source = sico.text.encode(line)
  let index = U64.literal(0)
  while U64.less_than(index, sico.bytes.length(source)):
    let b = sico.bytes.at(source, index, I64.literal(-1))
    if I64.equal(b, I64.literal(46)):
      return true
    end if
    if I64.equal(b, I64.literal(61)):
      return false
    end if
    set index = add(index, U64.literal(1))
  end while
  return false
end function

function count_field_label(line: Text, field: Text) returns U64:
  let source = sico.text.encode(line)
  let needle = sico.text.encode(sico.text.concat(field, ":"))
  let start = U64.literal(0)
  let count = U64.literal(0)
  while less_equal(add(start, sico.bytes.length(needle)), sico.bytes.length(source)):
    match sico.bytes.slice(source, start, sico.bytes.length(needle)):
      case ok(part):
        if sico.bytes.equal(part, needle):
          set count = add(count, U64.literal(1))
        end if
      case error(_):
        return count
    end match
    set start = add(start, U64.literal(1))
  end while
  return count
end function

function has_dot_call(line: Text, root: Text) returns Bool:
  let source = sico.text.encode(line)
  let needle = sico.text.encode(root)
  let start = U64.literal(0)
  while less_equal(add(start, sico.bytes.length(needle)), sico.bytes.length(source)):
    match sico.bytes.slice(source, start, sico.bytes.length(needle)):
      case ok(part):
        if sico.bytes.equal(part, needle):
          if at_word_boundary(source, start):
            if outside_quotes(source, start):
              let after = add(start, sico.bytes.length(needle))
              if I64.equal(sico.bytes.at(source, after, I64.literal(-1)), I64.literal(46)):
                let field_start = add(after, U64.literal(1))
                if letter_byte(sico.bytes.at(source, field_start, I64.literal(-1))):
                  let cursor = field_start
                  let stop = I64.literal(0)
                  while I64.equal(stop, I64.literal(0)):
                    if U64.less_than(cursor, sico.bytes.length(source)):
                      if word_byte(sico.bytes.at(source, cursor, I64.literal(-1))):
                        set cursor = add(cursor, U64.literal(1))
                      else:
                        set stop = I64.literal(1)
                      end if
                    else:
                      set stop = I64.literal(1)
                    end if
                  end while
                  if I64.equal(sico.bytes.at(source, cursor, I64.literal(-1)), I64.literal(40)):
                    return true
                  end if
                end if
              end if
            end if
          end if
        end if
      case error(_):
        return false
    end match
    set start = add(start, U64.literal(1))
  end while
  return false
end function

function builtin_call_root(name: Text) returns Bool:
  if same(name, "I64"):
    return true
  end if
  if same(name, "U64"):
    return true
  end if
  if same(name, "Float64"):
    return true
  end if
  if same(name, "sico"):
    return true
  end if
  return false
end function

function bare_field_line(line: Text) returns Bool:
  if sico.text.starts_with(line, "field "):
    return false
  end if
  if sico.text.starts_with(line, "invariant "):
    return false
  end if
  if sico.text.starts_with(line, "end "):
    return false
  end if
  return true
end function

function at_word_boundary(source: Bytes, start: U64) returns Bool:
  if U64.equal(start, U64.literal(0)):
    return true
  end if
  if word_byte(sico.bytes.at(source, sub(start, U64.literal(1)), I64.literal(-1))):
    return false
  end if
  if I64.equal(sico.bytes.at(source, sub(start, U64.literal(1)), I64.literal(-1)), I64.literal(46)):
    return false
  end if
  return true
end function

function outside_quotes(source: Bytes, position: U64) returns Bool:
  let scan = U64.literal(0)
  let inside = I64.literal(0)
  while U64.less_than(scan, position):
    if I64.equal(sico.bytes.at(source, scan, I64.literal(-1)), I64.literal(34)):
      if I64.equal(inside, I64.literal(0)):
        set inside = I64.literal(1)
      else:
        set inside = I64.literal(0)
      end if
    end if
    set scan = add(scan, U64.literal(1))
  end while
  if I64.equal(inside, I64.literal(0)):
    return true
  end if
  return false
end function

function dot_access_field(line: Text, root: Text) returns Text:
  let source = sico.text.encode(line)
  let needle = sico.text.encode(root)
  let start = U64.literal(0)
  while less_equal(add(start, sico.bytes.length(needle)), sico.bytes.length(source)):
    match sico.bytes.slice(source, start, sico.bytes.length(needle)):
      case ok(part):
        if sico.bytes.equal(part, needle):
          if at_word_boundary(source, start):
            if outside_quotes(source, start):
              let after = add(start, sico.bytes.length(needle))
              if I64.equal(sico.bytes.at(source, after, I64.literal(-1)), I64.literal(46)):
                let field_start = add(after, U64.literal(1))
                if letter_byte(sico.bytes.at(source, field_start, I64.literal(-1))):
                  let cursor = field_start
                  let stop = I64.literal(0)
                  while I64.equal(stop, I64.literal(0)):
                    if U64.less_than(cursor, sico.bytes.length(source)):
                      if word_byte(sico.bytes.at(source, cursor, I64.literal(-1))):
                        set cursor = add(cursor, U64.literal(1))
                      else:
                        set stop = I64.literal(1)
                      end if
                    else:
                      set stop = I64.literal(1)
                    end if
                  end while
                  match sico.bytes.slice(source, field_start, sub(cursor, field_start)):
                    case ok(word_bytes):
                      return sico.bytes.utf8_decode(word_bytes)
                    case error(_):
                      return ""
                  end match
                end if
              end if
            end if
          end if
        end if
      case error(_):
        return ""
    end match
    set start = add(start, U64.literal(1))
  end while
  return ""
end function

function semantic_diagnostic(source: Text) returns Text:
  let lines = sico.text.split_lines(source)
  let nominal_names = sico.text.split_lines("")
  let record_names = sico.text.split_lines("")
  let resource_names = sico.text.split_lines("")
  let enum_names = sico.text.split_lines("")
  let variant_owners = sico.text.split_lines("")
  let field_owners = sico.text.split_lines("")
  let field_names = sico.text.split_lines("")
  let field_types = sico.text.split_lines("")
  let invariant_owners = sico.text.split_lines("")
  let invariant_left = sico.text.split_lines("")
  let invariant_right = sico.text.split_lines("")
  let function_names = sico.text.split_lines("")
  let function_params = sico.text.split_lines("")
  let function_returns = sico.text.split_lines("")
  let function_result_errors = sico.text.split_lines("")
  let async_function_names = sico.text.split_lines("")
  let parameter_owners = sico.text.split_lines("")
  let parameter_names = sico.text.split_lines("")
  let parameter_types = sico.text.split_lines("")
  let active_record = ""
  let active_enum = ""
  let imported_roots = sico.text.split_lines("")
  let index = U64.literal(0)

  while U64.less_than(index, sico.list.length(lines)):
    let raw = item(lines, index)
    let line = sico.text.trim(raw)
    let parts = compiler_parser.words(line)
    if same(raw, line):
      if sico.text.starts_with(line, "module "):
        return "E8010"
      end if
      if sico.text.starts_with(line, "use "):
        if U64.less_than(U64.literal(1), sico.list.length(parts)):
          set imported_roots = sico.list.append(imported_roots, compiler_parser.at(parts, U64.literal(1)))
        end if
      end if
      if sico.text.starts_with(line, "newtype "):
        if U64.equal(sico.list.length(parts), U64.literal(4)):
          set nominal_names = sico.list.append(nominal_names, compiler_parser.at(parts, U64.literal(1)))
        end if
      end if
      if sico.text.starts_with(line, "record "):
        set active_record = compiler_parser.at(parts, U64.literal(1))
        set record_names = sico.list.append(record_names, active_record)
      end if
      if sico.text.starts_with(line, "resource "):
        set resource_names = sico.list.append(resource_names, compiler_parser.at(parts, U64.literal(1)))
      end if
      if sico.text.starts_with(line, "enum "):
        set active_enum = compiler_parser.at(parts, U64.literal(1))
        set enum_names = sico.list.append(enum_names, active_enum)
      end if
      if same(line, "end record"):
        if U64.equal(owner_count(field_owners, active_record), U64.literal(0)):
          return "E2022"
        end if
        set active_record = ""
      end if
      if same(line, "end enum"):
        set active_enum = ""
      end if
      if compiler_parser.syntax_function_header(line):
        let function_index = compiler_parser.find(parts, "function")
        let returns_index = compiler_parser.find(parts, "returns")
        if U64.less_than(function_index, sico.list.length(parts)):
          if U64.less_than(returns_index, sico.list.length(parts)):
            let name = compiler_parser.at(parts, add(function_index, U64.literal(1)))
            let parameter = ""
            if U64.equal(returns_index, add(function_index, U64.literal(4))):
              set parameter = compiler_parser.at(parts, add(function_index, U64.literal(3)))
            end if
            set function_names = sico.list.append(function_names, name)
            set function_params = sico.list.append(function_params, parameter)
            set function_returns = sico.list.append(function_returns, compiler_parser.at(parts, add(returns_index, U64.literal(1))))
            let result_error = ""
            if same(compiler_parser.at(parts, add(returns_index, U64.literal(1))), "Result"):
              if U64.less_than(add(returns_index, U64.literal(3)), sico.list.length(parts)):
                set result_error = compiler_parser.at(parts, add(returns_index, U64.literal(3)))
              end if
            end if
            set function_result_errors = sico.list.append(function_result_errors, result_error)
            if sico.text.starts_with(line, "async function "):
              set async_function_names = sico.list.append(async_function_names, name)
            end if
            if sico.text.starts_with(line, "export async function "):
              set async_function_names = sico.list.append(async_function_names, name)
            end if
            let parameter_index = add(function_index, U64.literal(2))
            while U64.less_than(add(parameter_index, U64.literal(1)), returns_index):
              set parameter_owners = sico.list.append(parameter_owners, name)
              set parameter_names = sico.list.append(parameter_names, compiler_parser.at(parts, parameter_index))
              set parameter_types = sico.list.append(parameter_types, compiler_parser.at(parts, add(parameter_index, U64.literal(1))))
              set parameter_index = add(parameter_index, U64.literal(2))
            end while
          end if
        end if
      end if
    else:
      if U64.less_than(U64.literal(0), sico.text.length(active_record)):
        if sico.text.starts_with(line, "field "):
          if U64.less_than(U64.literal(2), sico.list.length(parts)):
            set field_owners = sico.list.append(field_owners, active_record)
            set field_names = sico.list.append(field_names, compiler_parser.at(parts, U64.literal(1)))
            set field_types = sico.list.append(field_types, compiler_parser.at(parts, U64.literal(2)))
          end if
        end if
        if sico.text.starts_with(line, "invariant "):
          if U64.equal(sico.list.length(parts), U64.literal(3)):
            set invariant_owners = sico.list.append(invariant_owners, active_record)
            set invariant_left = sico.list.append(invariant_left, compiler_parser.at(parts, U64.literal(1)))
            set invariant_right = sico.list.append(invariant_right, compiler_parser.at(parts, U64.literal(2)))
          end if
        end if
        if U64.less_than(U64.literal(1), sico.list.length(parts)):
          if bare_field_line(line):
            set field_owners = sico.list.append(field_owners, active_record)
            set field_names = sico.list.append(field_names, compiler_parser.at(parts, U64.literal(0)))
            set field_types = sico.list.append(field_types, compiler_parser.at(parts, U64.literal(1)))
          end if
        end if
      end if
      if U64.less_than(U64.literal(0), sico.text.length(active_enum)):
        if sico.text.starts_with(line, "case "):
          set variant_owners = sico.list.append(variant_owners, active_enum)
        end if
      end if
    end if
