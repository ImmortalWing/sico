// The bytes of a `read_local` instruction: the local cell's flat slots copied
// into the instruction result's flat slots.
//
// The backend copies slot by slot -- `local.get` the cell, `local.set` the
// result -- and it refuses a result whose flat width differs from the cell's.
function cgs_read_local_hex(bytes: Bytes, fn: U64, instr: U64, data: U64, result0: U64) returns Text:
  let ccrlh_local_text = cgj_value_text(bytes, cgj_member(bytes, data, "local"))
