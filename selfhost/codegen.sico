// The backend's `sico.bytes.slice` refuses the inputs that do not fit the
// 32-bit arena and the inputs that wrap or overrun the source, and writes the
// sliced pair otherwise; both refusals are the numeric error arm, so the guest
// writes the same bytes in the same order.
function cgs_bytes_slice_hex(bytes: Bytes, run: U64, instr: U64, data: U64, result0: U64) returns Text:
  let cbsh_arguments = cgj_member(bytes, data, "arguments")
  if U64.equal(cbsh_arguments, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cbsh_first = cgj_array_item(bytes, cbsh_arguments, U64.literal(0))
  if U64.equal(cbsh_first, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cbsh_second = cgj_array_item(bytes, cbsh_arguments, U64.literal(1))
  if U64.equal(cbsh_second, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cbsh_third = cgj_array_item(bytes, cbsh_arguments, U64.literal(2))
  if U64.equal(cbsh_third, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cbsh_fourth = cgj_array_item(bytes, cbsh_arguments, U64.literal(3))
  if U64.less_than(U64.literal(0), cbsh_fourth):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cbsh_source = cgj_value_text(bytes, cbsh_first)
  let cbsh_start = cgj_value_text(bytes, cbsh_second)
  let cbsh_requested = cgj_value_text(bytes, cbsh_third)
  let cbsh_source_slot = cgs_value_slot(bytes, run, cbsh_source)
  if U64.equal(cbsh_source_slot, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cbsh_start_slot = cgs_value_slot(bytes, run, cbsh_start)
  if U64.equal(cbsh_start_slot, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cbsh_requested_slot = cgs_value_slot(bytes, run, cbsh_requested)
  if U64.equal(cbsh_requested_slot, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cbsh_source_ty = cgs_value_ty(bytes, run, cbsh_source)
  if U64.equal(cbsh_source_ty, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cbsh_source_kind = cgj_ident_text(bytes, cgj_member(bytes, cbsh_source_ty, "kind"))
  if cg_is_word(cbsh_source_kind, "bytes"):
    let cbsh_kind_ok = I64.literal(1)
  else:
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cbsh_start_ty = cgs_value_ty(bytes, run, cbsh_start)
  if U64.equal(cbsh_start_ty, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  if U64.equal(cgs_type_slots(bytes, cbsh_start_ty), U64.literal(1)):
    let cbsh_start_ok = I64.literal(1)
  else:
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cbsh_requested_ty = cgs_value_ty(bytes, run, cbsh_requested)
  if U64.equal(cbsh_requested_ty, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  if U64.equal(cgs_type_slots(bytes, cbsh_requested_ty), U64.literal(1)):
    let cbsh_requested_ok = I64.literal(1)
  else:
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  if U64.equal(cgs_type_slots(bytes, cgj_member(bytes, instr, "ty")), U64.literal(4)):
    let cbsh_result_ok = I64.literal(1)
  else:
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cbsh_source_pointer = cgs_sub(cbsh_source_slot, U64.literal(1))
  let cbsh_source_length = cbsh_source_slot
  let cbsh_start_local = cgs_sub(cbsh_start_slot, U64.literal(1))
  let cbsh_requested_local = cgs_sub(cbsh_requested_slot, U64.literal(1))
  let cbsh_tag = result0
  let cbsh_pointer = cgs_add(result0, U64.literal(1))
  let cbsh_length = cgs_add(result0, U64.literal(2))
  let cbsh_error = cgs_add(result0, U64.literal(3))
  let cbsh_limit = cgs_i64_const_hex(U64.literal(4294967296))
  let cbsh_out = cgs_local_get_hex(cbsh_start_local)
  set cbsh_out = sico.text.concat(cbsh_out, cbsh_limit)
  set cbsh_out = sico.text.concat(cbsh_out, "5a")
  set cbsh_out = sico.text.concat(cbsh_out, cgs_local_get_hex(cbsh_requested_local))
  set cbsh_out = sico.text.concat(cbsh_out, cbsh_limit)
  set cbsh_out = sico.text.concat(cbsh_out, "5a")
  set cbsh_out = sico.text.concat(cbsh_out, "72")
  set cbsh_out = sico.text.concat(cbsh_out, "0440")
  set cbsh_out = sico.text.concat(cbsh_out, cgs_numeric_error_hex(cbsh_tag, cbsh_pointer, cbsh_length, cbsh_error))
  set cbsh_out = sico.text.concat(cbsh_out, "05")
  set cbsh_out = sico.text.concat(cbsh_out, cgs_local_get_hex(cbsh_start_local))
  set cbsh_out = sico.text.concat(cbsh_out, "a7")
  set cbsh_out = sico.text.concat(cbsh_out, cgs_local_get_hex(cbsh_requested_local))
  set cbsh_out = sico.text.concat(cbsh_out, "a7")
  set cbsh_out = sico.text.concat(cbsh_out, "6a")
  set cbsh_out = sico.text.concat(cbsh_out, cgs_local_tee_hex(cbsh_length))
  set cbsh_out = sico.text.concat(cbsh_out, cgs_local_get_hex(cbsh_start_local))
  set cbsh_out = sico.text.concat(cbsh_out, "a7")
  set cbsh_out = sico.text.concat(cbsh_out, "49")
  set cbsh_out = sico.text.concat(cbsh_out, cgs_local_get_hex(cbsh_length))
  set cbsh_out = sico.text.concat(cbsh_out, cgs_local_get_hex(cbsh_source_length))
  set cbsh_out = sico.text.concat(cbsh_out, "4b")
  set cbsh_out = sico.text.concat(cbsh_out, "72")
  set cbsh_out = sico.text.concat(cbsh_out, "0440")
  set cbsh_out = sico.text.concat(cbsh_out, cgs_numeric_error_hex(cbsh_tag, cbsh_pointer, cbsh_length, cbsh_error))
  set cbsh_out = sico.text.concat(cbsh_out, "05")
  set cbsh_out = sico.text.concat(cbsh_out, cgs_i32_const_hex(U64.literal(0)))
  set cbsh_out = sico.text.concat(cbsh_out, cgs_local_set_hex(cbsh_tag))
  set cbsh_out = sico.text.concat(cbsh_out, cgs_local_get_hex(cbsh_source_pointer))
  set cbsh_out = sico.text.concat(cbsh_out, cgs_local_get_hex(cbsh_start_local))
  set cbsh_out = sico.text.concat(cbsh_out, "a7")
  set cbsh_out = sico.text.concat(cbsh_out, "6a")
  set cbsh_out = sico.text.concat(cbsh_out, cgs_local_set_hex(cbsh_pointer))
  set cbsh_out = sico.text.concat(cbsh_out, cgs_local_get_hex(cbsh_requested_local))
  set cbsh_out = sico.text.concat(cbsh_out, "a7")
  set cbsh_out = sico.text.concat(cbsh_out, cgs_local_set_hex(cbsh_length))
  set cbsh_out = sico.text.concat(cbsh_out, "0b")
  set cbsh_out = sico.text.concat(cbsh_out, "0b")
  return cbsh_out
end function

// The bytes of an `i32.const` of the value -1.
//
// The backend's dispatcher uses -1 as the "no arm selected" sentinel: it
// writes the sentinel before the arm chain and compares against it after
// every arm.
function cgs_i32_const_neg_one_hex() returns Text:
  return "417f"
end function

// True when the payload of a variant pattern carries neither a literal nor a
// variant.
//
// The backend refuses both ("match payload inspection"), while a binding
// payload needs no inspection at all: the arm block reads the payload
// through a project instruction.
function cgs_match_payload_ok(bytes: Bytes, payload: U64) returns Bool:
  let cmpo_index = U64.literal(0)
  let cmpo_more = U64.literal(1)
  while U64.less_than(U64.literal(0), cmpo_more):
    let cmpo_item = cgj_array_item(bytes, payload, cmpo_index)
    if U64.equal(cmpo_item, U64.literal(0)):
      set cmpo_more = U64.literal(0)
    else:
      let cmpo_kind = cgj_ident_text(bytes, cgj_member(bytes, cmpo_item, "kind"))
      if cg_is_word(cmpo_kind, "bool"):
        return false
      end if
      if cg_is_word(cmpo_kind, "variant"):
        return false
      end if
    end if
    set cmpo_index = cg_next(cmpo_index)
  end while
  return true
end function

// The bytes of one pattern test of a `match` arm.
//
// The backend tests the discriminant for a variant pattern, the value itself
// for a literal pattern and writes a constant true for a wildcard. The
// discriminant is the first slot of the value and the canonical tags are
// ok=0 and error=1. A binding pattern is refused, exactly as the backend
// refuses it.
//
// The backend reads the discriminant through `LocalLayout::tag`, which refuses
// a variant pattern over a value that is not a variant, and reads the literal
// through `LocalLayout::scalar`, which refuses a value that is not a single
// scalar slot. The guest keeps both gates: a variant pattern needs a `result`
// value and a literal pattern needs a `bool` value.
function cgs_match_pattern_hex(bytes: Bytes, fn: U64, value: Text, pattern: U64) returns Text:
  let cmph_kind = cgj_ident_text(bytes, cgj_member(bytes, pattern, "kind"))
  if cg_is_word(cmph_kind, "wildcard"):
    return cgs_i32_const_hex(U64.literal(1))
  end if
  if cg_is_word(cmph_kind, "binding"):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cmph_slot = cgs_value_slot(bytes, fn, value)
  if U64.equal(cmph_slot, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cmph_local = cgs_sub(cmph_slot, U64.literal(1))
  let cmph_ty = cgs_value_ty(bytes, fn, value)
  if U64.equal(cmph_ty, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cmph_value_kind = cgj_ident_text(bytes, cgj_member(bytes, cmph_ty, "kind"))
  if cg_is_word(cmph_kind, "bool"):
    if cg_is_word(cmph_value_kind, "bool"):
      let cmph_bool_text = cgj_value_text(bytes, cgj_member(bytes, pattern, "data"))
      let cmph_bool_value = U64.literal(0)
      if cg_is_word(cmph_bool_text, "true"):
        set cmph_bool_value = U64.literal(1)
      end if
      let cmph_bool_out = cgs_local_get_hex(cmph_local)
      set cmph_bool_out = sico.text.concat(cmph_bool_out, cgs_i32_const_hex(cmph_bool_value))
      set cmph_bool_out = sico.text.concat(cmph_bool_out, "46")
      return cmph_bool_out
    end if
    return "ERR:E-SH-CG-IR-MATCH-SCALAR"
  end if
  if cg_is_word(cmph_kind, "variant"):
    if cg_is_word(cmph_value_kind, "result"):
      let cmph_data = cgj_member(bytes, pattern, "data")
      if U64.equal(cmph_data, U64.literal(0)):
        return "ERR:E-SH-CG-IR-PLAN"
      end if
      let cmph_name = cgj_ident_text(bytes, cgj_member(bytes, cmph_data, "name"))
      let cmph_tag = U64.literal(0)
      let cmph_known = U64.literal(0)
      if cg_is_word(cmph_name, "ok"):
        set cmph_known = U64.literal(1)
      end if
      if cg_is_word(cmph_name, "error"):
        set cmph_known = U64.literal(1)
        set cmph_tag = U64.literal(1)
      end if
      if U64.equal(cmph_known, U64.literal(0)):
        return "ERR:E-SH-CG-IR-EMIT"
      end if
      let cmph_payload = cgj_member(bytes, cmph_data, "payload")
      if U64.equal(cmph_payload, U64.literal(0)):
        return "ERR:E-SH-CG-IR-PLAN"
      end if
      if cgs_match_payload_ok(bytes, cmph_payload):
        let cmph_out = cgs_local_get_hex(cmph_local)
        set cmph_out = sico.text.concat(cmph_out, cgs_i32_const_hex(cmph_tag))
        set cmph_out = sico.text.concat(cmph_out, "46")
        return cmph_out
      end if
      return "ERR:E-SH-CG-IR-EMIT"
    end if
    return "ERR:E-SH-CG-IR-MATCH-VARIANT"
  end if
  return "ERR:E-SH-CG-IR-EMIT"
end function

// The bytes of the `match` condition of one arm: the accumulator, one test
// per pattern and an `i32.and` after each of them.
//
// The backend's `emit_match_condition` writes them in that order, so the
// guest writes the same bytes in the same order. The values and the patterns
// are zipped, exactly as the backend zips them.
function cgs_match_condition_hex(bytes: Bytes, fn: U64, values: U64, patterns: U64) returns Text:
  let cmch_out = cgs_i32_const_hex(U64.literal(1))
  let cmch_index = U64.literal(0)
  let cmch_more = U64.literal(1)
  while U64.less_than(U64.literal(0), cmch_more):
    let cmch_value = cgj_array_item(bytes, values, cmch_index)
    let cmch_pattern = cgj_array_item(bytes, patterns, cmch_index)
    if U64.equal(cmch_value, U64.literal(0)):
      set cmch_more = U64.literal(0)
    else:
      if U64.equal(cmch_pattern, U64.literal(0)):
        set cmch_more = U64.literal(0)
      else:
        let cmch_value_text = cgj_value_text(bytes, cmch_value)
        let cmch_test = cgs_match_pattern_hex(bytes, fn, cmch_value_text, cmch_pattern)
        if sico.text.starts_with(cmch_test, "ERR:"):
          return cmch_test
        end if
        set cmch_out = sico.text.concat(cmch_out, cmch_test)
        set cmch_out = sico.text.concat(cmch_out, "71")
      end if
    end if
    set cmch_index = cg_next(cmch_index)
  end while
  return cmch_out
end function

// The bytes of the `match` terminator of a block: the dispatcher sentinel,
// one guarded arm per arm and the jump back to the dispatcher loop.
//
// The backend's `compile_terminator` writes the sentinel, then for every arm
// the dispatcher check, the arm's condition, the arm's dispatch store and the
// two closing `end`s, and finally the unreachable guard and the `br 1`, so
// the guest writes the same bytes in the same order.
function cgs_match_hex(bytes: Bytes, fn: U64, term: U64) returns Text:
  let cgmh_data = cgj_member(bytes, term, "data")
  if U64.equal(cgmh_data, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cgmh_values = cgj_member(bytes, cgmh_data, "values")
  if U64.equal(cgmh_values, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cgmh_arms = cgj_member(bytes, cgmh_data, "arms")
  if U64.equal(cgmh_arms, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cgmh_dispatcher = cgs_dispatcher_slot(bytes, fn)
  if U64.equal(cgmh_dispatcher, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cgmh_out = cgs_i32_const_neg_one_hex()
  set cgmh_out = sico.text.concat(cgmh_out, cgs_local_set_hex(cgmh_dispatcher))
  let cgmh_index = U64.literal(0)
  let cgmh_more = U64.literal(1)
  while U64.less_than(U64.literal(0), cgmh_more):
    let cgmh_arm = cgj_array_item(bytes, cgmh_arms, cgmh_index)
    if U64.equal(cgmh_arm, U64.literal(0)):
      set cgmh_more = U64.literal(0)
    else:
      let cgmh_patterns = cgj_member(bytes, cgmh_arm, "patterns")
      if U64.equal(cgmh_patterns, U64.literal(0)):
        return "ERR:E-SH-CG-IR-PLAN"
      end if
      let cgmh_target_text = cgj_value_text(bytes, cgj_member(bytes, cgmh_arm, "target"))
      if cgs_decimal_bad(cgmh_target_text):
        return "ERR:E-SH-CG-IR-EMIT"
      end if
      let cgmh_condition = cgs_match_condition_hex(bytes, fn, cgmh_values, cgmh_patterns)
      if sico.text.starts_with(cgmh_condition, "ERR:"):
        return cgmh_condition
      end if
      set cgmh_out = sico.text.concat(cgmh_out, cgs_local_get_hex(cgmh_dispatcher))
      set cgmh_out = sico.text.concat(cgmh_out, cgs_i32_const_neg_one_hex())
      set cgmh_out = sico.text.concat(cgmh_out, "460440")
      set cgmh_out = sico.text.concat(cgmh_out, cgmh_condition)
      set cgmh_out = sico.text.concat(cgmh_out, "0440")
      set cgmh_out = sico.text.concat(cgmh_out, cgs_i32_const_hex(cgs_decimal_u64(cgmh_target_text)))
      set cgmh_out = sico.text.concat(cgmh_out, cgs_local_set_hex(cgmh_dispatcher))
      set cgmh_out = sico.text.concat(cgmh_out, "0b0b")
    end if
    set cgmh_index = cg_next(cgmh_index)
  end while
  set cgmh_out = sico.text.concat(cgmh_out, cgs_local_get_hex(cgmh_dispatcher))
  set cgmh_out = sico.text.concat(cgmh_out, cgs_i32_const_neg_one_hex())
  set cgmh_out = sico.text.concat(cgmh_out, "460440")
  set cgmh_out = sico.text.concat(cgmh_out, "00")
  set cgmh_out = sico.text.concat(cgmh_out, "0b")
  set cgmh_out = sico.text.concat(cgmh_out, "0c01")
  return cgmh_out
end function

// The terminator bytes of the block `block` of the module function `fn`:
// the flat return, the branch, the jump or the unreachable byte.
//
// The Script `run` returns through the result area instead of a flat value,
// and that return is written by the result-area path, so a terminator for the
// `run` function is refused here. A terminator kind outside the set above is
// refused instead of approximated.
function cgs_block_terminator_hex(bytes: Bytes, fn: U64, block: U64) returns Text:
  let cbth_term = cgj_member(bytes, block, "terminator")
  if U64.equal(cbth_term, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cbth_kind = cgj_ident_text(bytes, cgj_member(bytes, cbth_term, "kind"))
  let cbth_name = cgj_ident_text(bytes, cgj_member(bytes, fn, "name"))
  if cg_is_word(cbth_name, "run"):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  if cg_is_word(cbth_kind, "return"):
    let cbth_value = cgj_value_text(bytes, cgj_member(bytes, cbth_term, "data"))
    return cgs_flat_return_hex(bytes, fn, cbth_value)
  end if
  if cg_is_word(cbth_kind, "branch"):
    return cgs_branch_hex(bytes, fn, cbth_term)
  end if
  if cg_is_word(cbth_kind, "jump"):
    return cgs_jump_hex(bytes, fn, cbth_term)
  end if
  if cg_is_word(cbth_kind, "match"):
    return cgs_match_hex(bytes, fn, cbth_term)
  end if
  if cg_is_word(cbth_kind, "unreachable"):
    return "00"
  end if
  return "ERR:E-SH-CG-IR-EMIT"
end function

// The whole body of the module function at `index`: the local declaration
// section, the dispatcher shell, the block dispatch, the instructions, the
// return and the fixed epilogue.
//
// The `run` function keeps its result-area return; every other function
// returns its flat value directly.
function cgs_function_body_hex(bytes: Bytes, index: U64) returns Text:
  let cgfh_fn = cgs_function_at_index(bytes, index)
  if U64.equal(cgfh_fn, U64.literal(0)):
    return ""
  end if
  let cgfh_name = cgj_ident_text(bytes, cgj_member(bytes, cgfh_fn, "name"))
  if cg_is_word(cgfh_name, "run"):
    let cgfh_run_body = cg_run_body_hex_from_ir(bytes)
    return cgfh_run_body
  end if
  let cgfh_locals = cgs_function_local_hex(bytes, cgfh_fn)
  if sico.text.starts_with(cgfh_locals, "ERR:"):
    return cgfh_locals
  end if
  let cgfh_code = cgs_function_instr_hex(bytes, cgfh_fn, U64.literal(1))
  if sico.text.starts_with(cgfh_code, "ERR:"):
    return cgfh_code
  end if
  let cgfh_local_len = sico.text.length(cgfh_locals)
  let cgfh_groups = U64.shr(cgfh_local_len, U64.literal(2))
  let cgfh_group_hex = cg_leb_hex(cgfh_groups)
  let cgfh_body = sico.text.concat(cgfh_group_hex, cgfh_locals)
  set cgfh_body = sico.text.concat(cgfh_body, cgfh_code)
  set cgfh_body = sico.text.concat(cgfh_body, "000b0b000b")
  return cgfh_body
end function

// The core module's code section: the module functions' bodies in the
// module's function order, then the three frozen arena helper bodies, then
// the emitted standard-library helper bodies.
//
// The helper bodies follow the backend's own alphabetical helper order
// (`sico.bytes.utf8_decode` < `sico.text.concat` < `sico.text.length`),
// because the backend sorts the used helper set before it numbers it.
function cgs_core_code_hex(bytes: Bytes, arena_base: U64) returns Text:
  let cccsh_count = cgs_function_count(bytes)
  if U64.equal(cccsh_count, U64.literal(0)):
    return ""
  end if
  let cccsh_utf8 = cgs_module_has_intrinsic(bytes, "sico.bytes.utf8_decode")
  let cccsh_concat = cgs_module_has_intrinsic(bytes, "sico.text.concat")
  let cccsh_total = cgs_add(cccsh_count, U64.literal(3))
  if U64.equal(cccsh_utf8, U64.literal(1)):
    set cccsh_total = cgs_add(cccsh_total, U64.literal(1))
  end if
  if U64.equal(cccsh_concat, U64.literal(1)):
    set cccsh_total = cgs_add(cccsh_total, U64.literal(1))
  end if
  let cccsh_length = cgs_module_has_intrinsic(bytes, "sico.text.length")
  if U64.equal(cccsh_length, U64.literal(1)):
    set cccsh_total = cgs_add(cccsh_total, U64.literal(1))
  end if
  let cccsh_out = cg_leb_hex(cccsh_total)
  let cccsh_index = U64.literal(0)
  while U64.less_than(cccsh_index, cccsh_count):
    let cccsh_body = cgs_function_body_hex(bytes, cccsh_index)
    if sico.text.starts_with(cccsh_body, "ERR:"):
      return cccsh_body
    end if
    if U64.equal(sico.text.length(cccsh_body), U64.literal(0)):
      return ""
    end if
    let cccsh_body_len = sico.text.length(cccsh_body)
    let cccsh_body_size = U64.shr(cccsh_body_len, U64.literal(1))
    let cccsh_body_hex = cg_leb_hex(cccsh_body_size)
    set cccsh_out = sico.text.concat(cccsh_out, cccsh_body_hex)
    set cccsh_out = sico.text.concat(cccsh_out, cccsh_body)
    set cccsh_index = cg_next(cccsh_index)
  end while
  let cccsh_alloc = cg_alloc_body_hex()
  let cccsh_alloc_len = sico.text.length(cccsh_alloc)
  let cccsh_alloc_size = U64.shr(cccsh_alloc_len, U64.literal(1))
  let cccsh_alloc_hex = cg_leb_hex(cccsh_alloc_size)
  set cccsh_out = sico.text.concat(cccsh_out, cccsh_alloc_hex)
  set cccsh_out = sico.text.concat(cccsh_out, cccsh_alloc)
  let cccsh_realloc = cg_realloc_body_hex()
  let cccsh_realloc_len = sico.text.length(cccsh_realloc)
  let cccsh_realloc_size = U64.shr(cccsh_realloc_len, U64.literal(1))
  let cccsh_realloc_hex = cg_leb_hex(cccsh_realloc_size)
  set cccsh_out = sico.text.concat(cccsh_out, cccsh_realloc_hex)
  set cccsh_out = sico.text.concat(cccsh_out, cccsh_realloc)
  let cccsh_post = cg_post_body_hex(arena_base)
  let cccsh_post_len = sico.text.length(cccsh_post)
  let cccsh_post_size = U64.shr(cccsh_post_len, U64.literal(1))
  let cccsh_post_hex = cg_leb_hex(cccsh_post_size)
  set cccsh_out = sico.text.concat(cccsh_out, cccsh_post_hex)
  set cccsh_out = sico.text.concat(cccsh_out, cccsh_post)
  let cccsh_utf8_helper = cg_utf8_validate_helper_body_hex()
  let cccsh_utf8_len = sico.text.length(cccsh_utf8_helper)
  let cccsh_utf8_size = U64.shr(cccsh_utf8_len, U64.literal(1))
  let cccsh_utf8_hex = cg_leb_hex(cccsh_utf8_size)
  if U64.equal(cccsh_utf8, U64.literal(1)):
    set cccsh_out = sico.text.concat(cccsh_out, cccsh_utf8_hex)
    set cccsh_out = sico.text.concat(cccsh_out, cccsh_utf8_helper)
  end if
  let cccsh_helper = cg_concat_helper_body_hex(cccsh_count)
  let cccsh_helper_len = sico.text.length(cccsh_helper)
  let cccsh_helper_size = U64.shr(cccsh_helper_len, U64.literal(1))
  let cccsh_helper_hex = cg_leb_hex(cccsh_helper_size)
  if U64.equal(cccsh_concat, U64.literal(1)):
    set cccsh_out = sico.text.concat(cccsh_out, cccsh_helper_hex)
    set cccsh_out = sico.text.concat(cccsh_out, cccsh_helper)
  end if
  let cccsh_length_helper = cg_text_length_helper_body_hex()
  let cccsh_length_len = sico.text.length(cccsh_length_helper)
  let cccsh_length_size = U64.shr(cccsh_length_len, U64.literal(1))
  let cccsh_length_hex = cg_leb_hex(cccsh_length_size)
  if U64.equal(cccsh_length, U64.literal(1)):
    set cccsh_out = sico.text.concat(cccsh_out, cccsh_length_hex)
    set cccsh_out = sico.text.concat(cccsh_out, cccsh_length_helper)
  end if
  return cccsh_out
end function
