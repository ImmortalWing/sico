      let ccrlh_get = cgs_local_get_hex(ccrlh_cell_slot)
      let ccrlh_set = cgs_local_set_hex(ccrlh_result_slot)
      set ccrlh_out = sico.text.concat(ccrlh_out, ccrlh_get)
      set ccrlh_out = sico.text.concat(ccrlh_out, ccrlh_set)
      set ccrlh_index = cg_next(ccrlh_index)
    end while
    return ccrlh_out
  end if
  return "ERR:E-SH-CG-IR-EMIT"
