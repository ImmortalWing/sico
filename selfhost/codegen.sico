// comparison and the result store.
//
// The backend's `emit_fixed_comparison` compares the two operand slots with
// `i64.eq` and stores the boolean result, and the frontend only lowers this
// operation for fixed-width operands, so the comparison is the same form for
// every shape it reaches.
function cgs_equal_fixed_hex(bytes: Bytes, run: U64, data: U64, result0: U64) returns Text:
  let cefh_left = cgj_value_text(bytes, cgj_member(bytes, data, "left"))
  let cefh_right = cgj_value_text(bytes, cgj_member(bytes, data, "right"))
  let cefh_left_slot = cgs_value_slot(bytes, run, cefh_left)
  if U64.equal(cefh_left_slot, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cefh_right_slot = cgs_value_slot(bytes, run, cefh_right)
  if U64.equal(cefh_right_slot, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cefh_out = cgs_local_get_hex(cgs_sub(cefh_left_slot, U64.literal(1)))
  set cefh_out = sico.text.concat(cefh_out, cgs_local_get_hex(cgs_sub(cefh_right_slot, U64.literal(1))))
  set cefh_out = sico.text.concat(cefh_out, "51")
  set cefh_out = sico.text.concat(cefh_out, cgs_local_set_hex(result0))
  return cefh_out
end function

// The instruction segment of the Script-profile `run` body: the dispatcher
// shell, the per-block dispatch heads and the block instructions, up to (but
// not including) the Script result-area return.
function cgs_run_instr_hex(bytes: Bytes) returns Text:
  let crih_run = cgs_run_function(bytes)
  if U64.equal(crih_run, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let crih_instr = cgs_function_instr_hex(bytes, crih_run, U64.literal(0))
  return crih_instr
end function

// The instruction segment of the module function `fn`: the dispatcher shell,
// the per-block dispatch heads and the block instructions.
//
// The shell and the dispatch are the backend's own shape (STEP-0502); STEP-0507
// applies them to every module function, not just to `run`.
function cgs_function_instr_hex(bytes: Bytes, fn: U64, terms: U64) returns Text:
  let crih_run = fn
  let crih_terms = terms
  let crih_blocks = cgj_member(bytes, crih_run, "blocks")
  if U64.equal(crih_blocks, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let crih_entry_text = cgj_value_text(bytes, cgj_member(bytes, crih_run, "entry"))
  if cgs_decimal_bad(crih_entry_text):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let crih_entry = cgs_decimal_u64(crih_entry_text)
  let crih_dispatcher = cgs_dispatcher_slot(bytes, crih_run)
  if U64.equal(crih_dispatcher, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let crih_out = sico.text.concat(cgs_i32_const_hex(crih_entry), cgs_local_set_hex(crih_dispatcher))
  set crih_out = sico.text.concat(crih_out, "02400340")
  let crih_bindex = U64.literal(0)
  let crih_bmore = U64.literal(1)
  while U64.less_than(U64.literal(0), crih_bmore):
    let crih_block = cgj_array_item(bytes, crih_blocks, crih_bindex)
    if U64.equal(crih_block, U64.literal(0)):
      set crih_bmore = U64.literal(0)
    else:
      let crih_block_text = cgj_value_text(bytes, cgj_member(bytes, crih_block, "id"))
      if cgs_decimal_bad(crih_block_text):
        return "ERR:E-SH-CG-IR-EMIT"
      end if
      let crih_block_id = cgs_decimal_u64(crih_block_text)
      set crih_out = sico.text.concat(crih_out, cgs_local_get_hex(crih_dispatcher))
      set crih_out = sico.text.concat(crih_out, cgs_i32_const_hex(crih_block_id))
      set crih_out = sico.text.concat(crih_out, "460440")
      let crih_instructions = cgj_member(bytes, crih_block, "instructions")
      if U64.equal(crih_instructions, U64.literal(0)):
        return "ERR:E-SH-CG-IR-PLAN"
      end if
      let crih_iindex = U64.literal(0)
      let crih_imore = U64.literal(1)
      while U64.less_than(U64.literal(0), crih_imore):
        let crih_instruction = cgj_array_item(bytes, crih_instructions, crih_iindex)
        if U64.equal(crih_instruction, U64.literal(0)):
          set crih_imore = U64.literal(0)
        else:
          let crih_op = cgs_op_hex(bytes, crih_run, crih_instruction)
          if sico.text.starts_with(crih_op, "ERR:"):
            return crih_op
          end if
          set crih_out = sico.text.concat(crih_out, crih_op)
        end if
        set crih_iindex = cg_next(crih_iindex)
      end while
      if U64.equal(crih_terms, U64.literal(1)):
        let crih_terminator = cgs_block_terminator_hex(bytes, crih_run, crih_block)
        if sico.text.starts_with(crih_terminator, "ERR:"):
          return crih_terminator
        end if
        set crih_out = sico.text.concat(crih_out, crih_terminator)
        set crih_out = sico.text.concat(crih_out, "0b")
      end if
    end if
    set crih_bindex = cg_next(crih_bindex)
  end while
  return crih_out
end function

// ---------------------------------------------------------------------------
// STEP-0503: the Script result-area return and the dispatcher epilogue.
//
// The facts in this section are *component-level*, not IR-derived: they come
// from the frozen Script WIT records and the frozen component skeleton, so
// the guest carries them the same way STEP-0487 carries the frozen core
// module segments. Everything else -- which slot holds the discriminant,
// which slots hold the payload fields -- is derived from the ingested IR.
// ---------------------------------------------------------------------------

// The name of the frozen `ScriptOutput` record field at `index`, in the
// frozen WIT record order; "" when the index is outside the record.
function cgs_abi_field_name(index: U64) returns Text:
  if U64.equal(index, U64.literal(0)):
    return "stdout"
  end if
  if U64.equal(index, U64.literal(1)):
    return "stderr"
  end if
  if U64.equal(index, U64.literal(2)):
    return "exit_code"
  end if
  return ""
end function

// The flat kind of the frozen `ScriptOutput` record field at `index`:
// "list" for the two byte lists and "i64" for the exit code; "" when the
// index is outside the record.
function cgs_abi_field_kind(index: U64) returns Text:
  if U64.less_than(U64.literal(3), index):
    return ""
  end if
  if U64.equal(index, U64.literal(2)):
    return "i64"
  end if
  return "list"
end function

// The result-area byte offset of the field at `index`: the pointer of a
// list, the value of a scalar; 0 when the index is outside the record.
function cgs_abi_field_area(index: U64) returns U64:
  if U64.equal(index, U64.literal(0)):
    return U64.literal(8)
  end if
  if U64.equal(index, U64.literal(1)):
    return U64.literal(16)
  end if
  if U64.equal(index, U64.literal(2)):
    return U64.literal(24)
  end if
  return U64.literal(0)
end function

// The result-area byte offset of the field at `index`'s length component; 0
// when the field is not a list.
function cgs_abi_field_area_len(index: U64) returns U64:
  if U64.equal(index, U64.literal(0)):
    return U64.literal(12)
  end if
  if U64.equal(index, U64.literal(1)):
    return U64.literal(20)
  end if
  return U64.literal(0)
end function

// The offset of the field at `index` inside the flat `ScriptOutput` record
// layout; 0 when the index is outside the record.
function cgs_abi_field_slot_offset(index: U64) returns U64:
  if U64.equal(index, U64.literal(0)):
    return U64.literal(0)
  end if
  if U64.equal(index, U64.literal(1)):
    return U64.literal(2)
  end if
  if U64.equal(index, U64.literal(2)):
    return U64.literal(4)
  end if
  return U64.literal(0)
end function

// The frozen byte size of the Script result area.
function cgs_frozen_result_area_size() returns U64:
  return U64.literal(32)
end function

// The name of the frozen `ScriptError` record field at `index`, in the
// frozen WIT record order; "" when the index is outside the record.
function cgs_abi_error_field_name(index: U64) returns Text:
  if U64.equal(index, U64.literal(0)):
    return "code"
  end if
  if U64.equal(index, U64.literal(1)):
    return "message"
  end if
  return ""
end function

// The flat kind of the frozen `ScriptError` record field at `index`: "i32"
// for the error code (one byte in the result area) and "list" for the
// message; "" when the index is outside the record.
function cgs_abi_error_field_kind(index: U64) returns Text:
  if U64.equal(index, U64.literal(0)):
    return "i32"
  end if
  if U64.equal(index, U64.literal(1)):
    return "list"
  end if
  return ""
end function

// The result-area byte offset of the frozen `ScriptError` field at `index`:
// the error code at 8 and the message pointer at 12; 0 when the index is
// outside the record.
function cgs_abi_error_field_area(index: U64) returns U64:
  if U64.equal(index, U64.literal(0)):
    return U64.literal(8)
  end if
  if U64.equal(index, U64.literal(1)):
    return U64.literal(12)
  end if
  return U64.literal(0)
end function

// The result-area byte offset of the frozen `ScriptError` field at `index`'s
// length component; 0 when the field is not a list.
function cgs_abi_error_field_area_len(index: U64) returns U64:
  if U64.equal(index, U64.literal(1)):
    return U64.literal(16)
  end if
  return U64.literal(0)
end function

// The offset of the frozen `ScriptError` field at `index` inside the flat
// `ScriptError` record layout; 0 when the index is outside the record.
function cgs_abi_error_field_slot_offset(index: U64) returns U64:
  if U64.equal(index, U64.literal(0)):
    return U64.literal(0)
  end if
  if U64.equal(index, U64.literal(1)):
    return U64.literal(1)
  end if
  return U64.literal(0)
end function

// The discriminant of the frozen `ScriptErrorCode` case named by the
// variant name `name`; 255 when the name is not a frozen case.
//
// The tags are the Canonical ABI discriminants of the frozen WIT
// `script-error-code` enum, in its declaration order -- not the source
// enum's declaration order. A name outside the frozen table is refused
// rather than guessed: the backend assigns the unknown names its own
// sequence, and the guest does not reproduce that sequence.
function cgs_enum_case_tag(name: Text) returns U64:
  if cg_is_word(name, "ScriptErrorCode.InvalidInput"):
    return U64.literal(0)
  end if
  if cg_is_word(name, "ScriptErrorCode.ResourceLimit"):
    return U64.literal(1)
  end if
  if cg_is_word(name, "ScriptErrorCode.DomainError"):
    return U64.literal(2)
  end if
  if cg_is_word(name, "ScriptErrorCode.Cancelled"):
    return U64.literal(3)
  end if
  return U64.literal(255)
end function

// The core-module function index of the bump allocator (STEP-0507).
//
// The backend appends the three arena helpers *after* the module functions,
// so the allocator's index is the module function count: one for a module
// that carries only `run`, two for a module that carries one more function.
// The frozen constant this slot used to hold only described the
// single-function module.
function cgs_alloc_index(bytes: Bytes) returns U64:
  return cgs_function_count(bytes)
end function

// The bytes of the call to the bump allocator.
//
// The concatenation goes through a cell: the guest frontend lowers a host
// call with a user-call argument in a statement, not in a return expression
// (the self-hosting shape frontier).
function cgs_alloc_call_hex(alloc_index: U64) returns Text:
  let cgsach_out = "10"
  set cgsach_out = sico.text.concat(cgsach_out, cg_leb_hex(alloc_index))
  return cgsach_out
end function

// The value id text the Script-profile `run` block returns; "" when the
// block's terminator is not a `return` of a value.
function cgs_run_return_value(bytes: Bytes, run: U64) returns Text:
  let crrv_blocks = cgj_member(bytes, run, "blocks")
  if U64.equal(crrv_blocks, U64.literal(0)):
    return ""
  end if
  let crrv_block = cgj_array_item(bytes, crrv_blocks, U64.literal(0))
  if U64.equal(crrv_block, U64.literal(0)):
    return ""
  end if
  let crrv_terminator = cgj_member(bytes, crrv_block, "terminator")
  if U64.equal(crrv_terminator, U64.literal(0)):
    return ""
  end if
  let crrv_kind = cgj_member(bytes, crrv_terminator, "kind")
  if U64.equal(crrv_kind, U64.literal(0)):
    return ""
  end if
  if cg_is_word(cgj_ident_text(bytes, crrv_kind), "return"):
    let crrv_data = cgj_member(bytes, crrv_terminator, "data")
    if U64.equal(crrv_data, U64.literal(0)):
      return ""
    end if
    let crrv_value = cgj_value_text(bytes, crrv_data)
    if cg_is_word(crrv_value, "null"):
      return ""
    end if
    return crrv_value
  end if
  return ""
end function

// The instruction of `run` that produced the value with the id text `id`; 0
// when no instruction produced it.
function cgs_instruction_for_value(bytes: Bytes, run: U64, id: Text) returns U64:
  let cifv_blocks = cgj_member(bytes, run, "blocks")
  if U64.equal(cifv_blocks, U64.literal(0)):
    return U64.literal(0)
  end if
  let cifv_bindex = U64.literal(0)
  let cifv_bmore = U64.literal(1)
  while U64.less_than(U64.literal(0), cifv_bmore):
    let cifv_block = cgj_array_item(bytes, cifv_blocks, cifv_bindex)
    if U64.equal(cifv_block, U64.literal(0)):
      set cifv_bmore = U64.literal(0)
    else:
      let cifv_instructions = cgj_member(bytes, cifv_block, "instructions")
      let cifv_iindex = U64.literal(0)
      let cifv_imore = U64.literal(1)
      while U64.less_than(U64.literal(0), cifv_imore):
        let cifv_instruction = cgj_array_item(bytes, cifv_instructions, cifv_iindex)
        if U64.equal(cifv_instruction, U64.literal(0)):
          set cifv_imore = U64.literal(0)
        else:
          let cifv_rid = cgj_value_text(bytes, cgj_member(bytes, cifv_instruction, "result"))
          if cg_is_word(cifv_rid, id):
            return cifv_instruction
          end if
        end if
        set cifv_iindex = cg_next(cifv_iindex)
      end while
    end if
    set cifv_bindex = cg_next(cifv_bindex)
  end while
  return U64.literal(0)
end function

// The name of the instruction's operation; "" when the instruction carries
// no operation.
function cgs_op_name(bytes: Bytes, instr: U64) returns Text:
  let con_operation = cgj_member(bytes, instr, "operation")
  if U64.equal(con_operation, U64.literal(0)):
    return ""
  end if
  let con_op = cgj_member(bytes, con_operation, "op")
  if U64.equal(con_op, U64.literal(0)):
    return ""
  end if
  return cgj_ident_text(bytes, con_op)
end function

// The data object of the instruction's operation; 0 when the instruction
// carries no operation.
function cgs_op_data(bytes: Bytes, instr: U64) returns U64:
  let cod_operation = cgj_member(bytes, instr, "operation")
  if U64.equal(cod_operation, U64.literal(0)):
    return U64.literal(0)
  end if
  return cgj_member(bytes, cod_operation, "data")
end function

// The arm name of a `variant` instruction; "" when the instruction is not a
// variant.
function cgs_variant_arm(bytes: Bytes, instr: U64) returns Text:
  let cva_data = cgs_op_data(bytes, instr)
  if U64.equal(cva_data, U64.literal(0)):
    return ""
  end if
  let cva_name = cgj_member(bytes, cva_data, "name")
  if U64.equal(cva_name, U64.literal(0)):
    return ""
  end if
  return cgj_ident_text(bytes, cva_name)
end function

// The single payload value id of a `variant` instruction; "" when the
// variant does not carry exactly one payload value.
function cgs_variant_payload(bytes: Bytes, instr: U64) returns Text:
  let cvp_data = cgs_op_data(bytes, instr)
  if U64.equal(cvp_data, U64.literal(0)):
    return ""
  end if
  let cvp_payload = cgj_member(bytes, cvp_data, "payload")
  if U64.equal(cvp_payload, U64.literal(0)):
    return ""
  end if
  if U64.less_than(U64.literal(0), cgj_array_item(bytes, cvp_payload, U64.literal(1))):
    return ""
  end if
  let cvp_first = cgj_array_item(bytes, cvp_payload, U64.literal(0))
  if U64.equal(cvp_first, U64.literal(0)):
    return ""
  end if
  return cgj_value_text(bytes, cvp_first)
end function

// The name of the construct field at `index`; "" when the field is absent.
function cgs_construct_field_name(bytes: Bytes, instr: U64, index: U64) returns Text:
  let ccfn_data = cgs_op_data(bytes, instr)
  if U64.equal(ccfn_data, U64.literal(0)):
    return ""
  end if
  let ccfn_fields = cgj_member(bytes, ccfn_data, "fields")
  if U64.equal(ccfn_fields, U64.literal(0)):
    return ""
  end if
  let ccfn_item = cgj_array_item(bytes, ccfn_fields, index)
  if U64.equal(ccfn_item, U64.literal(0)):
    return ""
  end if
  let ccfn_name = cgj_member(bytes, ccfn_item, "name")
  if U64.equal(ccfn_name, U64.literal(0)):
    return ""
  end if
  return cgj_ident_text(bytes, ccfn_name)
end function

// The value id text of the construct field at `index`; "" when the field is
// absent.
function cgs_construct_field_value(bytes: Bytes, instr: U64, index: U64) returns Text:
  let ccfv_data = cgs_op_data(bytes, instr)
  if U64.equal(ccfv_data, U64.literal(0)):
    return ""
  end if
  let ccfv_fields = cgj_member(bytes, ccfv_data, "fields")
  if U64.equal(ccfv_fields, U64.literal(0)):
    return ""
  end if
  let ccfv_item = cgj_array_item(bytes, ccfv_fields, index)
  if U64.equal(ccfv_item, U64.literal(0)):
    return ""
  end if
  let ccfv_value = cgj_member(bytes, ccfv_item, "value")
  if U64.equal(ccfv_value, U64.literal(0)):
    return ""
  end if
  return cgj_value_text(bytes, ccfv_value)
end function

// Whether the construct carries a field at `index`.
function cgs_construct_has_field(bytes: Bytes, instr: U64, index: U64) returns Bool:
  let cchf_data = cgs_op_data(bytes, instr)
  if U64.equal(cchf_data, U64.literal(0)):
    return false
  end if
  let cchf_fields = cgj_member(bytes, cchf_data, "fields")
  if U64.equal(cchf_fields, U64.literal(0)):
    return false
  end if
  if U64.equal(cgj_array_item(bytes, cchf_fields, index), U64.literal(0)):
    return false
  end if
  return true
end function

// Whether the construct field at `index` carries the flat kind the frozen
// `ScriptOutput` record declares for that field; false when it does not.
function cgs_abi_field_matches(bytes: Bytes, run: U64, construct: U64, index: U64) returns Bool:
  let cafm_value = cgs_construct_field_value(bytes, construct, index)
  let cafm_ty = cgs_value_ty(bytes, run, cafm_value)
  if U64.equal(cafm_ty, U64.literal(0)):
    return false
  end if
  let cafm_slots = cgs_type_slots(bytes, cafm_ty)
  let cafm_flat = cgs_flat_hex(bytes, cafm_ty)
  if cg_is_word(cgs_abi_field_kind(index), "list"):
    if U64.equal(cafm_slots, U64.literal(2)):
      if cg_is_word(cgs_flat_slot_kind(cafm_flat, U64.literal(0)), "i32"):
        return cg_is_word(cgs_flat_slot_kind(cafm_flat, U64.literal(1)), "i32")
      end if
    end if
    return false
  end if
  if cg_is_word(cgs_abi_field_kind(index), "i64"):
    if U64.equal(cafm_slots, U64.literal(1)):
      return cg_is_word(cgs_flat_slot_kind(cafm_flat, U64.literal(0)), "i64")
    end if
    return false
  end if
  return false
end function

// The bytes that copy the list field at (`ptr_slot`, `len_slot`) into the
// result area: the bounded copy into the arena, then the pointer and the
// length stores.
//
// `alloc_index` is the core-module index of the bump allocator (STEP-0507).
function cgs_result_list_hex(return_area: U64, copy_dest: U64, ptr_slot: U64, len_slot: U64, area: U64, area_len: U64, alloc_index: U64) returns Text:
  let crlh_out = cgs_local_get_hex(len_slot)
  set crlh_out = sico.text.concat(crlh_out, sico.text.concat(cgs_alloc_call_hex(alloc_index), cgs_local_set_hex(copy_dest)))
  set crlh_out = sico.text.concat(crlh_out, cgs_local_get_hex(copy_dest))
  set crlh_out = sico.text.concat(crlh_out, cgs_local_get_hex(ptr_slot))
  set crlh_out = sico.text.concat(crlh_out, cgs_local_get_hex(len_slot))
  set crlh_out = sico.text.concat(crlh_out, "fc0a0000")
  set crlh_out = sico.text.concat(crlh_out, cgs_local_get_hex(return_area))
  set crlh_out = sico.text.concat(crlh_out, cgs_local_get_hex(copy_dest))
  set crlh_out = sico.text.concat(crlh_out, sico.text.concat("3602", cg_leb_hex(area)))
  set crlh_out = sico.text.concat(crlh_out, cgs_local_get_hex(return_area))
  set crlh_out = sico.text.concat(crlh_out, cgs_local_get_hex(len_slot))
  set crlh_out = sico.text.concat(crlh_out, sico.text.concat("3602", cg_leb_hex(area_len)))
  return crlh_out
end function

// The bytes that store the scalar field at `slot` into the result area.
function cgs_result_scalar_hex(return_area: U64, slot: U64, area: U64) returns Text:
  let crsh_out = cgs_local_get_hex(return_area)
  set crsh_out = sico.text.concat(crsh_out, cgs_local_get_hex(slot))
  set crsh_out = sico.text.concat(crsh_out, sico.text.concat("3703", cg_leb_hex(area)))
  return crsh_out
end function

// The bytes of the frozen `ScriptOutput` field at `index` copied into the
// result area; an `ERR:` identity when the construct's field at `index` is
// not the frozen field.
function cgs_result_field_hex(bytes: Bytes, run: U64, construct: U64, index: U64, base: U64, return_area: U64, copy_dest: U64) returns Text:
  let crfh_name = cgs_abi_field_name(index)
  if cg_is_word(cgs_construct_field_name(bytes, construct, index), crfh_name):
    if cgs_abi_field_matches(bytes, run, construct, index):
      let crfh_slot = cgs_add(base, cgs_abi_field_slot_offset(index))
      if cg_is_word(cgs_abi_field_kind(index), "list"):
        return cgs_result_list_hex(return_area, copy_dest, crfh_slot, cgs_add(crfh_slot, U64.literal(1)), cgs_abi_field_area(index), cgs_abi_field_area_len(index), cgs_alloc_index(bytes))
      end if
      return cgs_result_scalar_hex(return_area, crfh_slot, cgs_abi_field_area(index))
    end if
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  return "ERR:E-SH-CG-IR-EMIT"
end function

// The bytes of the frozen `ScriptOutput` fields copied into the result area.
function cgs_result_fields_hex(bytes: Bytes, run: U64, construct: U64, base: U64, return_area: U64, copy_dest: U64) returns Text:
  let crfs_out = ""
  let crfs_index = U64.literal(0)
  let crfs_more = U64.literal(1)
  while U64.less_than(U64.literal(0), crfs_more):
    let crfs_name = cgs_abi_field_name(crfs_index)
    if U64.equal(sico.text.length(crfs_name), U64.literal(0)):
      set crfs_more = U64.literal(0)
    else:
      let crfs_field = cgs_result_field_hex(bytes, run, construct, crfs_index, base, return_area, copy_dest)
      if sico.text.starts_with(crfs_field, "ERR:"):
        return crfs_field
      end if
      set crfs_out = sico.text.concat(crfs_out, crfs_field)
    end if
    set crfs_index = cg_next(crfs_index)
  end while
  return crfs_out
end function

// The number of flat slots the result arm `arm` of the value `value_id`
// occupies; 0 when the value or the arm does not flatten.
function cgs_result_arm_slots(bytes: Bytes, run: U64, value_id: Text, arm: Text) returns U64:
  let cras_ty = cgs_value_ty(bytes, run, value_id)
  if U64.equal(cras_ty, U64.literal(0)):
    return U64.literal(0)
  end if
  let cras_data = cgj_member(bytes, cras_ty, "data")
  if U64.equal(cras_data, U64.literal(0)):
    return U64.literal(0)
  end if
  let cras_arm_ty = cgj_member(bytes, cras_data, arm)
  if U64.equal(cras_arm_ty, U64.literal(0)):
    return U64.literal(0)
  end if
  return cgs_type_slots(bytes, cras_arm_ty)
end function

// The IR offset of the type of the result arm `arm` of the value `value_id`;
// 0 when the value or the arm carries no type.
//
// The backend's `Operation::Project` layout compares the projected field's
// whole Wasm type sequence with the declared result type, so the guest needs
// the arm's own type and not only its slot count.
function cgs_result_arm_ty(bytes: Bytes, run: U64, value_id: Text, arm: Text) returns U64:
  let crat_ty = cgs_value_ty(bytes, run, value_id)
  if U64.equal(crat_ty, U64.literal(0)):
    return U64.literal(0)
  end if
  let crat_data = cgj_member(bytes, crat_ty, "data")
  if U64.equal(crat_data, U64.literal(0)):
    return U64.literal(0)
  end if
  let crat_arm_ty = cgj_member(bytes, crat_data, arm)
  if U64.equal(crat_arm_ty, U64.literal(0)):
    return U64.literal(0)
  end if
  return crat_arm_ty
end function

// The bytes that store the one-byte scalar field at `slot` into the
// result area.
//
// The `ScriptError` code is a Canonical ABI enum discriminant, so it is
// one byte wide: the backend stores it with an `i32.store8`, not with the
// four-byte `i32.store` the list fields use.
function cgs_result_scalar8_hex(return_area: U64, slot: U64, area: U64) returns Text:
  let crsh8_out = cgs_local_get_hex(return_area)
  set crsh8_out = sico.text.concat(crsh8_out, cgs_local_get_hex(slot))
  set crsh8_out = sico.text.concat(crsh8_out, sico.text.concat("3a00", cg_leb_hex(area)))
  return crsh8_out
end function

// Whether the construct field at `index` carries the flat kind the frozen
// `ScriptError` record declares for that field; false when it does not.
function cgs_abi_error_field_matches(bytes: Bytes, run: U64, construct: U64, index: U64) returns Bool:
  let caefm_value = cgs_construct_field_value(bytes, construct, index)
  let caefm_ty = cgs_value_ty(bytes, run, caefm_value)
  if U64.equal(caefm_ty, U64.literal(0)):
    return false
  end if
  let caefm_slots = cgs_type_slots(bytes, caefm_ty)
  let caefm_flat = cgs_flat_hex(bytes, caefm_ty)
  if cg_is_word(cgs_abi_error_field_kind(index), "list"):
    if U64.equal(caefm_slots, U64.literal(2)):
      if cg_is_word(cgs_flat_slot_kind(caefm_flat, U64.literal(0)), "i32"):
        return cg_is_word(cgs_flat_slot_kind(caefm_flat, U64.literal(1)), "i32")
      end if
    end if
    return false
  end if
  if U64.equal(caefm_slots, U64.literal(1)):
    return cg_is_word(cgs_flat_slot_kind(caefm_flat, U64.literal(0)), "i32")
  end if
  return false
end function

// The bytes of the frozen `ScriptError` field at `index` copied into the
// result area; an `ERR:` identity when the construct's field at `index` is
// not the frozen field.
function cgs_result_error_field_hex(bytes: Bytes, run: U64, construct: U64, index: U64, base: U64, return_area: U64, copy_dest: U64) returns Text:
  let crefh_name = cgs_abi_error_field_name(index)
  if cg_is_word(cgs_construct_field_name(bytes, construct, index), crefh_name):
    if cgs_abi_error_field_matches(bytes, run, construct, index):
      let crefh_slot = cgs_add(base, cgs_abi_error_field_slot_offset(index))
      if cg_is_word(cgs_abi_error_field_kind(index), "list"):
        return cgs_result_list_hex(return_area, copy_dest, crefh_slot, cgs_add(crefh_slot, U64.literal(1)), cgs_abi_error_field_area(index), cgs_abi_error_field_area_len(index), cgs_alloc_index(bytes))
      end if
      return cgs_result_scalar8_hex(return_area, crefh_slot, cgs_abi_error_field_area(index))
    end if
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  return "ERR:E-SH-CG-IR-EMIT"
end function

// The bytes of the frozen `ScriptError` fields copied into the result area.
function cgs_result_error_fields_hex(bytes: Bytes, run: U64, construct: U64, base: U64, return_area: U64, copy_dest: U64) returns Text:
  let crefh_out = ""
  let crefh_index = U64.literal(0)
  let crefh_more = U64.literal(1)
  while U64.less_than(U64.literal(0), crefh_more):
    let crefh_name = cgs_abi_error_field_name(crefh_index)
    if U64.equal(sico.text.length(crefh_name), U64.literal(0)):
      set crefh_more = U64.literal(0)
    else:
      let crefh_field = cgs_result_error_field_hex(bytes, run, construct, crefh_index, base, return_area, copy_dest)
      if sico.text.starts_with(crefh_field, "ERR:"):
        return crefh_field
      end if
      set crefh_out = sico.text.concat(crefh_out, crefh_field)
    end if
    set crefh_index = cg_next(crefh_index)
  end while
  return crefh_out
end function

// The bytes of the Script result-area return of the `run` body: the result
// area allocation, the discriminant store, the frozen `ScriptOutput` fields
// and the returned area pointer.
function cgs_result_return_hex(bytes: Bytes, run: U64) returns Text:
  let crrh_out = ""
  let crrh_alloc = cgs_alloc_index(bytes)
  let crrh_blocks = cgj_member(bytes, run, "blocks")
  if U64.equal(crrh_blocks, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  if U64.less_than(U64.literal(0), cgj_array_item(bytes, crrh_blocks, U64.literal(1))):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let crrh_value = cgs_run_return_value(bytes, run)
  if U64.equal(sico.text.length(crrh_value), U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let crrh_variant = cgs_instruction_for_value(bytes, run, crrh_value)
  if U64.equal(crrh_variant, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  if cg_is_word(cgs_op_name(bytes, crrh_variant), "variant"):
    if cg_is_word(cgs_variant_arm(bytes, crrh_variant), "ok"):
      let crrh_payload = cgs_variant_payload(bytes, crrh_variant)
      if U64.equal(sico.text.length(crrh_payload), U64.literal(0)):
        return "ERR:E-SH-CG-IR-EMIT"
      end if
      let crrh_construct = cgs_instruction_for_value(bytes, run, crrh_payload)
      if U64.equal(crrh_construct, U64.literal(0)):
        return "ERR:E-SH-CG-IR-EMIT"
      end if
      if cg_is_word(cgs_op_name(bytes, crrh_construct), "construct"):
        if cgs_construct_has_field(bytes, crrh_construct, U64.literal(3)):
          return "ERR:E-SH-CG-IR-EMIT"
        end if
        let crrh_slot1 = cgs_value_slot(bytes, run, crrh_value)
        if U64.equal(crrh_slot1, U64.literal(0)):
          return "ERR:E-SH-CG-IR-EMIT"
        end if
        let crrh_dispatcher = cgs_dispatcher_slot(bytes, run)
        if U64.equal(crrh_dispatcher, U64.literal(0)):
          return "ERR:E-SH-CG-IR-EMIT"
        end if
        let crrh_tag = cgs_sub(crrh_slot1, U64.literal(1))
        let crrh_base = cgs_add(crrh_tag, U64.literal(1))
        let crrh_area = cgs_add(crrh_dispatcher, U64.literal(1))
        let crrh_copy = cgs_add(crrh_dispatcher, U64.literal(2))
        set crrh_out = sico.text.concat(cgs_i32_const_hex(cgs_frozen_result_area_size()), sico.text.concat(cgs_alloc_call_hex(crrh_alloc), cgs_local_set_hex(crrh_area)))
        set crrh_out = sico.text.concat(crrh_out, cgs_local_get_hex(crrh_area))
        set crrh_out = sico.text.concat(crrh_out, cgs_local_get_hex(crrh_tag))
        set crrh_out = sico.text.concat(crrh_out, "3a0000")
        set crrh_out = sico.text.concat(crrh_out, cgs_result_fields_hex(bytes, run, crrh_construct, crrh_base, crrh_area, crrh_copy))
        set crrh_out = sico.text.concat(crrh_out, cgs_local_get_hex(crrh_area))
        set crrh_out = sico.text.concat(crrh_out, "0f")
      else:
        return "ERR:E-SH-CG-IR-EMIT"
      end if
    else:
      let crrhe_payload = cgs_variant_payload(bytes, crrh_variant)
      if U64.equal(sico.text.length(crrhe_payload), U64.literal(0)):
        return "ERR:E-SH-CG-IR-EMIT"
      end if
      let crrhe_construct = cgs_instruction_for_value(bytes, run, crrhe_payload)
      if U64.equal(crrhe_construct, U64.literal(0)):
        return "ERR:E-SH-CG-IR-EMIT"
      end if
      if cg_is_word(cgs_op_name(bytes, crrhe_construct), "construct"):
        if cgs_construct_has_field(bytes, crrhe_construct, U64.literal(2)):
          return "ERR:E-SH-CG-IR-EMIT"
        end if
        let crrhe_slot1 = cgs_value_slot(bytes, run, crrh_value)
        if U64.equal(crrhe_slot1, U64.literal(0)):
          return "ERR:E-SH-CG-IR-EMIT"
        end if
        let crrhe_dispatcher = cgs_dispatcher_slot(bytes, run)
        if U64.equal(crrhe_dispatcher, U64.literal(0)):
          return "ERR:E-SH-CG-IR-EMIT"
        end if
        let crrhe_ok_slots = cgs_result_arm_slots(bytes, run, crrh_value, "ok")
        if U64.equal(crrhe_ok_slots, U64.literal(0)):
          return "ERR:E-SH-CG-IR-EMIT"
        end if
        let crrhe_tag = cgs_sub(crrhe_slot1, U64.literal(1))
        let crrhe_base = cgs_add(crrhe_tag, cgs_add(U64.literal(1), crrhe_ok_slots))
        let crrhe_area = cgs_add(crrhe_dispatcher, U64.literal(1))
        let crrhe_copy = cgs_add(crrhe_dispatcher, U64.literal(2))
        let crrhe_alloc = cgs_alloc_index(bytes)
        set crrh_out = sico.text.concat(cgs_i32_const_hex(cgs_frozen_result_area_size()), sico.text.concat(cgs_alloc_call_hex(crrhe_alloc), cgs_local_set_hex(crrhe_area)))
        set crrh_out = sico.text.concat(crrh_out, cgs_local_get_hex(crrhe_area))
        set crrh_out = sico.text.concat(crrh_out, cgs_local_get_hex(crrhe_tag))
        set crrh_out = sico.text.concat(crrh_out, "3a0000")
        set crrh_out = sico.text.concat(crrh_out, cgs_result_error_fields_hex(bytes, run, crrhe_construct, crrhe_base, crrhe_area, crrhe_copy))
        set crrh_out = sico.text.concat(crrh_out, cgs_local_get_hex(crrhe_area))
        set crrh_out = sico.text.concat(crrh_out, "0f")
      else:
        return "ERR:E-SH-CG-IR-EMIT"
      end if
    end if
  else:
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  return crrh_out
end function

// The whole `run` body: the instruction segment, the Script result-area
// return and the dispatcher epilogue.
function cgs_run_body_hex(bytes: Bytes) returns Text:
  let crbh_instr = cgs_run_instr_hex(bytes)
  if sico.text.starts_with(crbh_instr, "ERR:"):
    return crbh_instr
  end if
  let crbh_run = cgs_run_function(bytes)
  if U64.equal(crbh_run, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let crbh_return = cgs_result_return_hex(bytes, crbh_run)
  if sico.text.starts_with(crbh_return, "ERR:"):
    return crbh_return
  end if
  return sico.text.concat(crbh_instr, sico.text.concat(crbh_return, "0b000b0b000b"))
end function

// ---------------------------------------------------------------------------
// STEP-0506: the static data segment and the arena base.
//
// The backend's `script_data` collects every string literal of the program
// into one deterministic data segment placed at memory offset 0, and the
// arena base -- the address the bump allocator starts at -- is that
// segment's length rounded up to eight bytes. The arena base is the initial
// value of the first core global and the constant the post-run helper
// restores, so the guest derives both from the same segment instead of
// replaying a frozen zero.
// ---------------------------------------------------------------------------

// The hex digit of the value `value` (0..15).
function cg_hex_digit_i64(value: I64) returns Text:
  if I64.less_than(value, I64.literal(10)):
    return sico.i64.to_text(value)
  end if
  if I64.equal(value, I64.literal(10)):
    return "a"
  end if
  if I64.equal(value, I64.literal(11)):
    return "b"
  end if
  if I64.equal(value, I64.literal(12)):
    return "c"
  end if
  if I64.equal(value, I64.literal(13)):
    return "d"
  end if
  if I64.equal(value, I64.literal(14)):
    return "e"
  end if
  return "f"
end function

// The hex byte pair of the byte value `value`.
//
// `sico.bytes.at` hands out an `I64`, so the byte hex uses the signed
// builtins; the value is masked to one byte first.
function cg_hex_byte_i64(value: I64) returns Text:
  let chbi_byte = I64.bit_and(value, I64.literal(255))
  let chbi_high = I64.shr(chbi_byte, I64.literal(4))
  let chbi_low = I64.bit_and(chbi_byte, I64.literal(15))
  return sico.text.concat(cg_hex_digit_i64(chbi_high), cg_hex_digit_i64(chbi_low))
end function

// The static data segment of the program: the bytes of every distinct
// string literal in instruction order, as hex byte pairs.
//
// The backend walks the program in the same order and keeps the first
// occurrence of a literal, so the segment bytes agree. The guest skips a
// literal it has already seen for the same reason, and `cgs_data_offset`
// resolves such a literal to that first occurrence (STEP-0521).
//
// STEP-0522: the literal's bytes are its *decoded* bytes, so the segment
// carries the byte the source escape stands for.
function cgs_data_hex(bytes: Bytes) returns Text:
  let cdh_seen = sico.text.split_lines("")
  let cdh_out = ""
  let cdh_functions = cgj_member(bytes, U64.literal(0), "functions")
  if U64.equal(cdh_functions, U64.literal(0)):
    return ""
  end if
  let cdh_findex = U64.literal(0)
  let cdh_fmore = U64.literal(1)
  while U64.less_than(U64.literal(0), cdh_fmore):
    let cdh_function = cgj_array_item(bytes, cdh_functions, cdh_findex)
    if U64.equal(cdh_function, U64.literal(0)):
      set cdh_fmore = U64.literal(0)
    else:
      let cdh_blocks = cgj_member(bytes, cdh_function, "blocks")
      if U64.equal(cdh_blocks, U64.literal(0)):
        return ""
      end if
      let cdh_bindex = U64.literal(0)
      let cdh_bmore = U64.literal(1)
      while U64.less_than(U64.literal(0), cdh_bmore):
        let cdh_block = cgj_array_item(bytes, cdh_blocks, cdh_bindex)
        if U64.equal(cdh_block, U64.literal(0)):
          set cdh_bmore = U64.literal(0)
        else:
          let cdh_instructions = cgj_member(bytes, cdh_block, "instructions")
          if U64.equal(cdh_instructions, U64.literal(0)):
            return ""
          end if
          let cdh_iindex = U64.literal(0)
          let cdh_imore = U64.literal(1)
          while U64.less_than(U64.literal(0), cdh_imore):
            let cdh_instruction = cgj_array_item(bytes, cdh_instructions, cdh_iindex)
            if U64.equal(cdh_instruction, U64.literal(0)):
              set cdh_imore = U64.literal(0)
            else:
              let cdh_hex = cgs_literal_hex(bytes, cdh_instruction)
              if sico.text.starts_with(cdh_hex, "ERR:"):
                return "ERR:E-SH-CG-IR-EMIT"
              end if
              if U64.less_than(U64.literal(0), sico.text.length(cdh_hex)):
                let cdh_chunk = cdh_hex
                if cgs_list_holds(cdh_seen, cdh_hex):
                  set cdh_chunk = ""
                else:
                  set cdh_seen = sico.list.append(cdh_seen, cdh_hex)
                end if
                set cdh_out = sico.text.concat(cdh_out, cdh_chunk)
              end if
            end if
            set cdh_iindex = cg_next(cdh_iindex)
          end while
        end if
        set cdh_bindex = cg_next(cdh_bindex)
      end while
    end if
    set cdh_findex = cg_next(cdh_findex)
  end while
  return cdh_out
end function

// The arena base for a static data segment of `data_len` bytes: the segment
// length rounded up to eight bytes.
//
// The backend's bump allocator starts at the arena base, so the first core
// global and the post-run helper both carry this value.
function cgs_arena_base(data_len: U64) returns U64:
  let cab_padded = cgs_add(data_len, U64.literal(7))
  return U64.shl(U64.shr(cab_padded, U64.literal(3)), U64.literal(3))
end function

// The payload of the core module's data section: one active segment at
// memory offset 0 holding the static literal bytes.
function cgs_data_section_hex(data_hex: Text, data_len: U64) returns Text:
  let cdsh_out = "0100"
  set cdsh_out = sico.text.concat(cdsh_out, "41000b")
  set cdsh_out = sico.text.concat(cdsh_out, cg_leb_hex(data_len))
  set cdsh_out = sico.text.concat(cdsh_out, data_hex)
  return cdsh_out
end function

// ---------------------------------------------------------------------------
// STEP-0507: the multi-function module's derived sections.
//
// The backend emits every module function into the core module, in the
// module's function order, and then the three frozen arena helpers. The type
// section, the function table, the export indices and the code bodies are
// therefore derived from the ingested IR; the helper bodies, the memory and
// the Script ABI's `run` type stay frozen.
//
// The facts this section encodes were measured from the backend's production
// output (see docs/steps/STEP-0507-m22-w2-s5-multi-function-component.md):
// the types section lists the module functions first and the three frozen
// helper types last, the function table carries one entry per module function
// plus the three helpers, the exports keep their four names while their
// function indices follow the module function count, and every module
// function but `run` returns its flat value directly.
// ---------------------------------------------------------------------------

// The module function at `index` (the module's function order); 0 when the
// index is outside the function list.
function cgs_function_at_index(bytes: Bytes, index: U64) returns U64:
  let cfai_functions = cgj_member(bytes, U64.literal(0), "functions")
  if U64.equal(cfai_functions, U64.literal(0)):
    return U64.literal(0)
  end if
  return cgj_array_item(bytes, cfai_functions, index)
end function

// The 1-based position of the module function whose declaration id is the
// text `id`; 0 when the module carries no such function.
//
// The backend resolves a call's target through the module's own function
// list (the IR function id to the Wasm function index), so the guest walks
// that list instead of assuming that the id and the position agree.
function cgs_function_position(bytes: Bytes, id: Text) returns U64:
  let cfp_functions = cgj_member(bytes, U64.literal(0), "functions")
  if U64.equal(cfp_functions, U64.literal(0)):
    return U64.literal(0)
  end if
  let cfp_index = U64.literal(0)
  let cfp_position = U64.literal(0)
  let cfp_more = U64.literal(1)
  while U64.less_than(U64.literal(0), cfp_more):
    let cfp_item = cgj_array_item(bytes, cfp_functions, cfp_index)
    if U64.equal(cfp_item, U64.literal(0)):
      set cfp_more = U64.literal(0)
    else:
      set cfp_position = cgs_add(cfp_position, U64.literal(1))
      let cfp_id = cgj_value_text(bytes, cgj_member(bytes, cfp_item, "id"))
      if cg_is_word(cfp_id, id):
        return cfp_position
      end if
      set cfp_index = cg_next(cfp_index)
    end if
  end while
  return U64.literal(0)
end function

// The 1-based index of the `run` function in the module's function order; 0
// when the module carries no `run`.
function cgs_run_index(bytes: Bytes) returns U64:
  let cgsri_functions = cgj_member(bytes, U64.literal(0), "functions")
  if U64.equal(cgsri_functions, U64.literal(0)):
    return U64.literal(0)
  end if
  let cgsri_index = U64.literal(0)
  let cgsri_run = U64.literal(0)
  let cgsri_more = U64.literal(1)
  while U64.less_than(U64.literal(0), cgsri_more):
    let cgsri_item = cgj_array_item(bytes, cgsri_functions, cgsri_index)
    if U64.equal(cgsri_item, U64.literal(0)):
      set cgsri_more = U64.literal(0)
    else:
      let cgsri_name = cgj_ident_text(bytes, cgj_member(bytes, cgsri_item, "name"))
      if cg_is_word(cgsri_name, "run"):
        set cgsri_run = cgs_add(cgsri_index, U64.literal(1))
        set cgsri_more = U64.literal(0)
      else:
        set cgsri_index = cg_next(cgsri_index)
      end if
    end if
  end while
  return cgsri_run
end function

// The flat Wasm valtypes of the flat group hex: every group is `01` plus one
// valtype, so the valtype list is the last two characters of every group.
//
// The group kinds are read with `cgs_flat_slot_kind` instead of slicing the
// text: the guest frontend lowers that call, while a `match` on a host call
// is outside the self-hosting shape frontier.
function cgs_flat_valtypes(flat_hex: Text) returns Text:
  let cfv_len = sico.text.length(flat_hex)
  let cfv_groups = U64.shr(cfv_len, U64.literal(2))
  let cfv_consumed = U64.literal(0)
  let cfv_out = ""
  let cfv_group = U64.literal(0)
  while U64.less_than(cfv_group, cfv_groups):
    let cfv_kind = cgs_flat_slot_kind(flat_hex, cfv_group)
    if cg_is_word(cfv_kind, "i32"):
      set cfv_out = sico.text.concat(cfv_out, "7f")
    else:
      if cg_is_word(cfv_kind, "i64"):
        set cfv_out = sico.text.concat(cfv_out, "7e")
      else:
        return ""
      end if
    end if
    set cfv_consumed = cgs_add(cfv_consumed, U64.literal(4))
    set cfv_group = cg_next(cfv_group)
  end while
  if U64.equal(cfv_consumed, cfv_len):
    return cfv_out
  end if
  return ""
end function

// The core module type of the module function at `index`.
//
// The `run` function keeps the frozen Script ABI type (its result travels
// through the return area, so the core signature carries one pointer); every
// other function's type is derived from the flat parameter and result types.
function cgs_core_type_hex(bytes: Bytes, index: U64) returns Text:
  let ccth_fn = cgs_function_at_index(bytes, index)
  if U64.equal(ccth_fn, U64.literal(0)):
    return ""
  end if
  let ccth_name = cgj_ident_text(bytes, cgj_member(bytes, ccth_fn, "name"))
  if cg_is_word(ccth_name, "run"):
    return "60047f7f7f7f017f"
  end if
  let ccth_param_array = cgj_member(bytes, ccth_fn, "parameters")
  if U64.equal(ccth_param_array, U64.literal(0)):
    return ""
  end if
  let ccth_params = ""
  let ccth_param_slots = U64.literal(0)
  let ccth_pindex = U64.literal(0)
  let ccth_pmore = U64.literal(1)
  while U64.less_than(U64.literal(0), ccth_pmore):
    let ccth_param = cgj_array_item(bytes, ccth_param_array, ccth_pindex)
    if U64.equal(ccth_param, U64.literal(0)):
      set ccth_pmore = U64.literal(0)
    else:
      let ccth_param_ty = cgj_member(bytes, ccth_param, "ty")
      let ccth_flat = cgs_flat_hex(bytes, ccth_param_ty)
      if U64.equal(sico.text.length(ccth_flat), U64.literal(0)):
        return ""
      end if
      set ccth_params = sico.text.concat(ccth_params, ccth_flat)
      set ccth_param_slots = cgs_add(ccth_param_slots, cgs_type_slots(bytes, ccth_param_ty))
      set ccth_pindex = cg_next(ccth_pindex)
    end if
  end while
  let ccth_return_ty = cgj_member(bytes, ccth_fn, "return_type")
  if U64.equal(ccth_return_ty, U64.literal(0)):
    return ""
  end if
  let ccth_return_kind = cgj_ident_text(bytes, cgj_member(bytes, ccth_return_ty, "kind"))
  if cg_is_word(ccth_return_kind, "result"):
    return ""
  end if
  if cg_is_word(ccth_return_kind, "option"):
    return ""
  end if
  let ccth_results = cgs_flat_hex(bytes, ccth_return_ty)
  if U64.equal(sico.text.length(ccth_results), U64.literal(0)):
    return ""
  end if
  let ccth_result_slots = cgs_type_slots(bytes, ccth_return_ty)
  let ccth_out = "60"
  set ccth_out = sico.text.concat(ccth_out, cg_leb_hex(ccth_param_slots))
  set ccth_out = sico.text.concat(ccth_out, cgs_flat_valtypes(ccth_params))
  set ccth_out = sico.text.concat(ccth_out, cg_leb_hex(ccth_result_slots))
  set ccth_out = sico.text.concat(ccth_out, cgs_flat_valtypes(ccth_results))
  return ccth_out
end function

// The core module's type section: the module functions' types in the module's
// function order, then the three frozen arena helper types, then the emitted
// standard-library helper types.
//
// The helper types follow the backend's own alphabetical helper order
// (`sico.bytes.utf8_decode` < `sico.text.concat` < `sico.text.length`),
// because the backend sorts the used helper set before it numbers it.
function cgs_core_types_hex(bytes: Bytes) returns Text:
  let cctsh_count = cgs_function_count(bytes)
  if U64.equal(cctsh_count, U64.literal(0)):
    return ""
  end if
  let cctsh_utf8 = cgs_module_has_intrinsic(bytes, "sico.bytes.utf8_decode")
  let cctsh_concat = cgs_module_has_intrinsic(bytes, "sico.text.concat")
  let cctsh_total = cgs_add(cctsh_count, U64.literal(3))
  if U64.equal(cctsh_utf8, U64.literal(1)):
    set cctsh_total = cgs_add(cctsh_total, U64.literal(1))
  end if
  if U64.equal(cctsh_concat, U64.literal(1)):
    set cctsh_total = cgs_add(cctsh_total, U64.literal(1))
  end if
  let cctsh_length = cgs_module_has_intrinsic(bytes, "sico.text.length")
  if U64.equal(cctsh_length, U64.literal(1)):
    set cctsh_total = cgs_add(cctsh_total, U64.literal(1))
  end if
  let cctsh_out = cg_leb_hex(cctsh_total)
  let cctsh_index = U64.literal(0)
  while U64.less_than(cctsh_index, cctsh_count):
    let cctsh_type = cgs_core_type_hex(bytes, cctsh_index)
    if U64.equal(sico.text.length(cctsh_type), U64.literal(0)):
      return ""
    end if
    set cctsh_out = sico.text.concat(cctsh_out, cctsh_type)
    set cctsh_index = cg_next(cctsh_index)
  end while
  set cctsh_out = sico.text.concat(cctsh_out, "60017f017f")
  set cctsh_out = sico.text.concat(cctsh_out, "60047f7f7f7f017f")
  set cctsh_out = sico.text.concat(cctsh_out, "60017f00")
  if U64.equal(cctsh_utf8, U64.literal(1)):
    set cctsh_out = sico.text.concat(cctsh_out, "60027f7f017f")
  end if
  if U64.equal(cctsh_concat, U64.literal(1)):
    set cctsh_out = sico.text.concat(cctsh_out, "60047f7f7f7f027f7f")
  end if
  if U64.equal(cctsh_length, U64.literal(1)):
    set cctsh_out = sico.text.concat(cctsh_out, "60027f7f017f")
  end if
  return cctsh_out
end function

// The core module's function section: the module functions in the module's
// function order, then the three frozen arena helpers, then the emitted
// standard-library helpers.
//
// The type index of a core function is its own index: the type section lists
// the module functions first and the helper types last, in the same order.
function cgs_core_funcs_hex(bytes: Bytes) returns Text:
  let ccfsh_count = cgs_function_count(bytes)
  if U64.equal(ccfsh_count, U64.literal(0)):
    return ""
  end if
  let ccfsh_utf8 = cgs_module_has_intrinsic(bytes, "sico.bytes.utf8_decode")
  let ccfsh_concat = cgs_module_has_intrinsic(bytes, "sico.text.concat")
  let ccfsh_total = cgs_add(ccfsh_count, U64.literal(3))
  if U64.equal(ccfsh_utf8, U64.literal(1)):
    set ccfsh_total = cgs_add(ccfsh_total, U64.literal(1))
  end if
  if U64.equal(ccfsh_concat, U64.literal(1)):
    set ccfsh_total = cgs_add(ccfsh_total, U64.literal(1))
  end if
  let ccfsh_length = cgs_module_has_intrinsic(bytes, "sico.text.length")
  if U64.equal(ccfsh_length, U64.literal(1)):
    set ccfsh_total = cgs_add(ccfsh_total, U64.literal(1))
  end if
  let ccfsh_out = cg_leb_hex(ccfsh_total)
  let ccfsh_index = U64.literal(0)
  while U64.less_than(ccfsh_index, ccfsh_total):
    set ccfsh_out = sico.text.concat(ccfsh_out, cg_leb_hex(ccfsh_index))
    set ccfsh_index = cg_next(ccfsh_index)
  end while
  return ccfsh_out
end function

// The core module's export section: the frozen export names with the derived
// function indices.
//
// The memory export is frozen; `run` exports the module function's own
// position and the two arena helpers follow the module function count.
function cgs_core_exports_hex(bytes: Bytes) returns Text:
  let cceh_count = cgs_function_count(bytes)
  if U64.equal(cceh_count, U64.literal(0)):
    return ""
  end if
  let cceh_run = cgs_run_index(bytes)
  if U64.equal(cceh_run, U64.literal(0)):
    return ""
  end if
  let cceh_out = "04"
  set cceh_out = sico.text.concat(cceh_out, "066d656d6f72790200")
  set cceh_out = sico.text.concat(cceh_out, "0372756e00")
  set cceh_out = sico.text.concat(cceh_out, cg_leb_hex(cgs_sub(cceh_run, U64.literal(1))))
  set cceh_out = sico.text.concat(cceh_out, "0c636162695f7265616c6c6f6300")
  set cceh_out = sico.text.concat(cceh_out, cg_leb_hex(cgs_add(cceh_count, U64.literal(1))))
  set cceh_out = sico.text.concat(cceh_out, "0d636162695f706f73745f72756e00")
  set cceh_out = sico.text.concat(cceh_out, cg_leb_hex(cgs_add(cceh_count, U64.literal(2))))
  return cceh_out
end function

// The direct return of the value with the id text `value` in the module
// function `fn`: the returned value's slots, then `return`.
//
// The Script `run` returns through the result area instead (its own path);
// every other function returns its flat value directly, which is the
// backend's `emit_return` form for a non-`run` callee.
function cgs_flat_return_hex(bytes: Bytes, fn: U64, value: Text) returns Text:
  let cgfrh_slot = cgs_value_slot(bytes, fn, value)
  if U64.equal(cgfrh_slot, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cgfrh_ty = cgs_value_ty(bytes, fn, value)
  if U64.equal(cgfrh_ty, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cgfrh_slots = cgs_type_slots(bytes, cgfrh_ty)
  if U64.equal(cgfrh_slots, U64.literal(0)):
    return "ERR:E-SH-CG-IR-FLAT"
  end if
  let cgfrh_out = ""
  let cgfrh_index = U64.literal(0)
  while U64.less_than(cgfrh_index, cgfrh_slots):
    set cgfrh_out = sico.text.concat(cgfrh_out, cgs_local_get_hex(cgs_add(cgs_sub(cgfrh_slot, U64.literal(1)), cgfrh_index)))
    set cgfrh_index = cg_next(cgfrh_index)
  end while
  set cgfrh_out = sico.text.concat(cgfrh_out, "0f")
  return cgfrh_out
end function

// The branch terminator of a block: the condition, the two dispatch targets
// and the jump back to the dispatcher loop.
//
// The backend's `compile_terminator` writes the condition, an `if`, the two
// dispatch stores, an `else` and a `br 1`, so the guest writes the same
// bytes in the same order.
function cgs_branch_hex(bytes: Bytes, fn: U64, term: U64) returns Text:
  let cgbh_data = cgj_member(bytes, term, "data")
  if U64.equal(cgbh_data, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cgbh_condition = cgj_value_text(bytes, cgj_member(bytes, cgbh_data, "condition"))
  if cgs_decimal_bad(cgbh_condition):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cgbh_then = cgj_value_text(bytes, cgj_member(bytes, cgbh_data, "then_block"))
  if cgs_decimal_bad(cgbh_then):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cgbh_else = cgj_value_text(bytes, cgj_member(bytes, cgbh_data, "else_block"))
  if cgs_decimal_bad(cgbh_else):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cgbh_slot = cgs_value_slot(bytes, fn, cgbh_condition)
  if U64.equal(cgbh_slot, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cgbh_dispatcher = cgs_dispatcher_slot(bytes, fn)
  if U64.equal(cgbh_dispatcher, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cgbh_out = cgs_local_get_hex(cgs_sub(cgbh_slot, U64.literal(1)))
  set cgbh_out = sico.text.concat(cgbh_out, "0440")
  set cgbh_out = sico.text.concat(cgbh_out, cgs_i32_const_hex(cgs_decimal_u64(cgbh_then)))
  set cgbh_out = sico.text.concat(cgbh_out, cgs_local_set_hex(cgbh_dispatcher))
  set cgbh_out = sico.text.concat(cgbh_out, "05")
  set cgbh_out = sico.text.concat(cgbh_out, cgs_i32_const_hex(cgs_decimal_u64(cgbh_else)))
  set cgbh_out = sico.text.concat(cgbh_out, cgs_local_set_hex(cgbh_dispatcher))
  set cgbh_out = sico.text.concat(cgbh_out, "0b")
  set cgbh_out = sico.text.concat(cgbh_out, "0c01")
  return cgbh_out
end function

// The jump terminator of a block: the dispatch target and the jump back to
// the dispatcher loop.
//
// The backend's `compile_terminator` writes the target store and a `br 1`,
// so the guest writes the same bytes in the same order.
function cgs_jump_hex(bytes: Bytes, fn: U64, term: U64) returns Text:
  let cgjh_target = cgj_value_text(bytes, cgj_member(bytes, term, "data"))
  if cgs_decimal_bad(cgjh_target):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cgjh_dispatcher = cgs_dispatcher_slot(bytes, fn)
  if U64.equal(cgjh_dispatcher, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cgjh_out = cgs_i32_const_hex(cgs_decimal_u64(cgjh_target))
  set cgjh_out = sico.text.concat(cgjh_out, cgs_local_set_hex(cgjh_dispatcher))
  set cgjh_out = sico.text.concat(cgjh_out, "0c01")
  return cgjh_out
end function

// The bytes of a checked fixed-width addition or subtraction.
//
// The backend's `emit_checked_fixed` computes the wrapped sum in the payload
// slot, tests the overflow with the type's own comparison, and then writes the
// tag and the error payload in the two arms of the `if`, so the guest writes
// the same bytes in the same order.
//
// The backend covers the signed and the unsigned combinations. The guest
// covers the two unsigned ones and refuses the signed ones with a typed
// refusal instead of approximating them.
function cgs_checked_fixed_hex(bytes: Bytes, run: U64, instr: U64, data: U64, result0: U64, kind: Text) returns Text:
  let cfh_ty = cgj_member(bytes, instr, "ty")
  if U64.equal(cfh_ty, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cfh_ty_data = cgj_member(bytes, cfh_ty, "data")
  if U64.equal(cfh_ty_data, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cfh_ok = cgj_member(bytes, cfh_ty_data, "ok")
  if U64.equal(cfh_ok, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cfh_ok_kind = cgj_ident_text(bytes, cgj_member(bytes, cfh_ok, "kind"))
  let cfh_result_slots = cgs_type_slots(bytes, cfh_ty)
  let cfh_layout_ok = U64.literal(0)
  if U64.equal(cfh_result_slots, U64.literal(2)):
    set cfh_layout_ok = U64.literal(1)
  end if
  if U64.equal(cfh_layout_ok, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cfh_left_text = cgj_value_text(bytes, cgj_member(bytes, data, "left"))
  let cfh_right_text = cgj_value_text(bytes, cgj_member(bytes, data, "right"))
  let cfh_left_slot = cgs_value_slot(bytes, run, cfh_left_text)
  let cfh_right_slot = cgs_value_slot(bytes, run, cfh_right_text)
  if U64.equal(cfh_left_slot, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  if U64.equal(cfh_right_slot, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cfh_left_local = cgs_sub(cfh_left_slot, U64.literal(1))
  let cfh_right_local = cgs_sub(cfh_right_slot, U64.literal(1))
  let cfh_tag = result0
  let cfh_payload = cgs_add(result0, U64.literal(1))
  let cfh_out = cgs_local_get_hex(cfh_left_local)
  set cfh_out = sico.text.concat(cfh_out, cgs_local_get_hex(cfh_right_local))
  if cg_is_word(kind, "add"):
    set cfh_out = sico.text.concat(cfh_out, "7c")
  else:
    set cfh_out = sico.text.concat(cfh_out, "7d")
  end if
  set cfh_out = sico.text.concat(cfh_out, cgs_local_set_hex(cfh_payload))
  if cg_is_word(cfh_ok_kind, "u64"):
    if cg_is_word(kind, "add"):
      set cfh_out = sico.text.concat(cfh_out, cgs_local_get_hex(cfh_payload))
      set cfh_out = sico.text.concat(cfh_out, cgs_local_get_hex(cfh_left_local))
    else:
      set cfh_out = sico.text.concat(cfh_out, cgs_local_get_hex(cfh_left_local))
      set cfh_out = sico.text.concat(cfh_out, cgs_local_get_hex(cfh_right_local))
    end if
    set cfh_out = sico.text.concat(cfh_out, "54")
    set cfh_out = sico.text.concat(cfh_out, "0440")
    set cfh_out = sico.text.concat(cfh_out, cgs_i32_const_hex(U64.literal(1)))
    set cfh_out = sico.text.concat(cfh_out, cgs_local_set_hex(cfh_tag))
    if cg_is_word(kind, "add"):
      set cfh_out = sico.text.concat(cfh_out, cgs_i64_const_hex(U64.literal(0)))
    else:
      set cfh_out = sico.text.concat(cfh_out, cgs_i64_const_hex(U64.literal(1)))
    end if
    set cfh_out = sico.text.concat(cfh_out, cgs_local_set_hex(cfh_payload))
    set cfh_out = sico.text.concat(cfh_out, "05")
    set cfh_out = sico.text.concat(cfh_out, cgs_i32_const_hex(U64.literal(0)))
    set cfh_out = sico.text.concat(cfh_out, cgs_local_set_hex(cfh_tag))
    set cfh_out = sico.text.concat(cfh_out, "0b")
    return cfh_out
  end if
  return "ERR:E-SH-CG-IR-EMIT"
end function

// The bytes of a fixed-width less-than comparison.
//
// The backend's `emit_fixed_comparison` with `equal = false` compares the two
// operand slots with `i64.lt_s` for a signed operand and with `i64.lt_u` for
// an unsigned one, and stores the boolean result, so the guest writes the
// same bytes in the same order.
function cgs_less_fixed_hex(bytes: Bytes, run: U64, data: U64, result0: U64) returns Text:
  let clfh_left = cgj_value_text(bytes, cgj_member(bytes, data, "left"))
  let clfh_right = cgj_value_text(bytes, cgj_member(bytes, data, "right"))
  let clfh_left_slot = cgs_value_slot(bytes, run, clfh_left)
  if U64.equal(clfh_left_slot, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let clfh_right_slot = cgs_value_slot(bytes, run, clfh_right)
  if U64.equal(clfh_right_slot, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let clfh_left_ty = cgs_value_ty(bytes, run, clfh_left)
  if U64.equal(clfh_left_ty, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let clfh_kind_off = cgj_member(bytes, clfh_left_ty, "kind")
  if U64.equal(clfh_kind_off, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let clfh_out = cgs_local_get_hex(cgs_sub(clfh_left_slot, U64.literal(1)))
  set clfh_out = sico.text.concat(clfh_out, cgs_local_get_hex(cgs_sub(clfh_right_slot, U64.literal(1))))
  if cg_is_word(cgj_ident_text(bytes, clfh_kind_off), "i64"):
    set clfh_out = sico.text.concat(clfh_out, "53")
  else:
    set clfh_out = sico.text.concat(clfh_out, "54")
  end if
  set clfh_out = sico.text.concat(clfh_out, cgs_local_set_hex(result0))
  return clfh_out
end function

// The bytes of a boolean constant.
//
// The backend writes the constant with `i32.const` and stores it into the
// result slot, so the guest writes the same bytes in the same order. A
// constant that is neither `true` nor `false` is refused instead of being
// approximated.
