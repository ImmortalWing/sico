// The bytes of a `write_local` instruction: the source value's flat slots
// copied into the local cell's flat slots.
//
// The backend copies slot by slot -- `local.get` the source, `local.set` the
// cell -- and it refuses a source whose flat width differs from the cell's.
function cgs_write_local_hex(bytes: Bytes, fn: U64, instr: U64, data: U64) returns Text:
  let cwlh_local_text = cgj_value_text(bytes, cgj_member(bytes, data, "local"))
  if cgs_decimal_bad(cwlh_local_text):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cwlh_local = cgs_decimal_u64(cwlh_local_text)
  let cwlh_value_text = cgj_value_text(bytes, cgj_member(bytes, data, "value"))
  if cgs_decimal_bad(cwlh_value_text):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cwlh_source = cgs_value_slot(bytes, fn, cwlh_value_text)
  if U64.equal(cwlh_source, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cwlh_source0 = cgs_sub(cwlh_source, U64.literal(1))
  let cwlh_source_ty = cgs_value_ty(bytes, fn, cwlh_value_text)
  if U64.equal(cwlh_source_ty, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cwlh_source_width = cgs_type_slots(bytes, cwlh_source_ty)
  let cwlh_cell = cgs_cell_slot(bytes, fn, cwlh_local)
  if U64.equal(cwlh_cell, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cwlh_cell_width = cgs_cell_width(bytes, fn, cwlh_local)
  if U64.equal(cwlh_cell_width, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  if U64.equal(cwlh_cell_width, cwlh_source_width):
    let cwlh_out = ""
    let cwlh_index = U64.literal(0)
    while U64.less_than(cwlh_index, cwlh_cell_width):
      let cwlh_source_slot = cgs_add(cwlh_source0, cwlh_index)
      let cwlh_cell_slot = cgs_add(cwlh_cell, cwlh_index)
      let cwlh_get = cgs_local_get_hex(cwlh_source_slot)
      let cwlh_set = cgs_local_set_hex(cwlh_cell_slot)
      set cwlh_out = sico.text.concat(cwlh_out, cwlh_get)
      set cwlh_out = sico.text.concat(cwlh_out, cwlh_set)
