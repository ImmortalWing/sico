module codegen

// STEP-0487 S5 codegen skeleton (STEP-0486 wave): deterministic script
// Component emission from the guest, byte-oracled against
// crates/sico-codegen-wasm (RFC-0011). This slice emits the fixed component
// scaffolding (type/import/alias/instance/canonical/export sections, core
// module header + type/function/memory/global/export sections, arena helper
// bodies) plus the frozen minimal-echo run body. Sections that depend on
// the input IR (the run body first, then data/const segments, helper
// tables, transport modules) are built piecewise so later wave slices fill
// them in; anything outside the supported shape returns "" and the driver
// fails closed with "unsupported codegen source shape".

function cg_hex_digit(value: U64) returns Text:
  if U64.less_than(value, U64.literal(10)):
    return sico.u64.to_text(value)
  end if
  if U64.equal(value, U64.literal(10)):
    return "a"
  end if
  if U64.equal(value, U64.literal(11)):
    return "b"
  end if
  if U64.equal(value, U64.literal(12)):
    return "c"
  end if
  if U64.equal(value, U64.literal(13)):
    return "d"
  end if
  if U64.equal(value, U64.literal(14)):
    return "e"
  end if
  return "f"
end function

function cg_hex_byte(value: U64) returns Text:
  let high = U64.shr(value, U64.literal(4))
  let low = U64.bit_and(value, U64.literal(15))
  return sico.text.concat(cg_hex_digit(high), cg_hex_digit(low))
end function

// Unsigned LEB128 of a u32 as hex byte pairs, computed from the value
// (section sizes are derived, never hard-coded, at the call sites).
function cg_leb_hex(value: U64) returns Text:
  let n = value
  let out = ""
  let more = U64.literal(1)
  while U64.equal(more, U64.literal(1)):
    let low = U64.bit_and(n, U64.literal(127))
    set n = U64.shr(n, U64.literal(7))
    if U64.equal(n, U64.literal(0)):
      set out = sico.text.concat(out, cg_hex_byte(low))
      set more = U64.literal(0)
    else:
      set out = sico.text.concat(out, cg_hex_byte(U64.bit_or(low, U64.literal(128))))
    end if
  end while
  return out
end function

// One component/core section: id byte + LEB128 payload size + payload.
function cg_section_hex(id: U64, payload: Text) returns Text:
  let size = U64.shr(sico.text.length(payload), U64.literal(1))
  return sico.text.concat(cg_hex_byte(id), sico.text.concat(cg_leb_hex(size), payload))
end function

// ---- Fixed script-v0 component sections (frozen Script WIT, non-transport)
// Derived from crates/sico-codegen-wasm::canonical::{script_types_instance,
// wrap_script_component}; re-derive these when the WIT or wrapper changes.

function cg_types_script_hex() returns Text:
  return ""
end function

function cg_import_types_hex() returns Text:
  return "0100177369636f3a7363726970742f747970657340302e312e300500"
end function

function cg_alias_types_hex() returns Text:
  return "020300000c7363726970742d696e7075740300000d7363726970742d726573756c74"
end function

function cg_run_type_hex() returns Text:
  return "01400105696e707574010002"
end function

function cg_core_instance_hex() returns Text:
  return "01000000"
end function

function cg_alias_core_hex() returns Text:
  return "0400020100066d656d6f7279000001000c636162695f7265616c6c6f63000001000d636162695f706f73745f72756e000001000372756e"
end function

function cg_canonical_hex() returns Text:
  return "01000002040003000400050103"
end function

function cg_export_run_hex() returns Text:
  return "01000372756e010000"
end function

// ---- Fixed core module sections (script-v0 owned arena, non-transport)

function cg_core_types_hex() returns Text:
  return "0460047f7f7f7f017f60017f017f60047f7f7f7f017f60017f00"
end function

function cg_core_funcs_hex() returns Text:
  return "0400010203"
end function

function cg_core_memory_hex() returns Text:
  return "0101808802808802"
end function

function cg_core_globals_hex() returns Text:
  return "037f0141000b7f0141ffffffff070b7f0141000b"
end function

function cg_core_exports_hex() returns Text:
  return "04066d656d6f727902000372756e00000c636162695f7265616c6c6f6300020d636162695f706f73745f72756e0003"
end function

// Arena helper bodies, frozen by the STEP-0484 two-zone design. Re-derive
// from crates/sico-codegen-wasm::{emit_alloc, emit_realloc,
// emit_post_return} when the allocator changes.
function cg_alloc_body_hex() returns Text:
  return "01027f23024100470440200023014b0440000b230120006b417871210120012300490440000b2001240105230041076a4178712101200120006a22022001490440000b200223014b0440000b200224000b20010b"
end function

function cg_realloc_body_hex() returns Text:
  return "01027f230020026a417f6a410020026b712104200420036a22052004490440000b200523014b0440000b2005240020000440200420002001200320012003491bfc0a00000b20040b"
end function

function cg_post_body_hex() returns Text:
  return "004100240041ffffffff072401410024020b"
end function

// IR-dependent slot (STEP-0487): the run body for the frozen minimal echo
// fixture. Later wave slices replace this with a real lowering of the run
// function's IR (build_script_core's flattened-parameter copy, data
// segments, const aggregates, helper calls).
function cg_run_body_hex_minimal() returns Text:
  return ""
end function

// Assemble the core module: wasm header + fixed sections + the code section
// (entry sizes are LEB-derived from the body pieces).
function cg_core_module_hex() returns Text:
  let run_body = cg_run_body_hex_minimal()
  let alloc_body = cg_alloc_body_hex()
  let realloc_body = cg_realloc_body_hex()
  let post_body = cg_post_body_hex()
  let code_payload = "04"
  set code_payload = sico.text.concat(code_payload, cg_leb_hex(U64.shr(sico.text.length(run_body), U64.literal(1))))
  set code_payload = sico.text.concat(code_payload, run_body)
  set code_payload = sico.text.concat(code_payload, cg_leb_hex(U64.shr(sico.text.length(alloc_body), U64.literal(1))))
  set code_payload = sico.text.concat(code_payload, alloc_body)
  set code_payload = sico.text.concat(code_payload, cg_leb_hex(U64.shr(sico.text.length(realloc_body), U64.literal(1))))
  set code_payload = sico.text.concat(code_payload, realloc_body)
  set code_payload = sico.text.concat(code_payload, cg_leb_hex(U64.shr(sico.text.length(post_body), U64.literal(1))))
  set code_payload = sico.text.concat(code_payload, post_body)
  let core = "0061736d01000000"
  set core = sico.text.concat(core, cg_section_hex(U64.literal(1), cg_core_types_hex()))
  set core = sico.text.concat(core, cg_section_hex(U64.literal(3), cg_core_funcs_hex()))
  set core = sico.text.concat(core, cg_section_hex(U64.literal(5), cg_core_memory_hex()))
  set core = sico.text.concat(core, cg_section_hex(U64.literal(6), cg_core_globals_hex()))
  set core = sico.text.concat(core, cg_section_hex(U64.literal(7), cg_core_exports_hex()))
  set core = sico.text.concat(core, cg_section_hex(U64.literal(10), code_payload))
  return core
end function

// Component wrapper around the core module (fixed section ids per
// wasm-encoder's ComponentSectionId: Type 7, CoreModule 1, CoreInstance 2,
// Alias 6, CanonicalFunction 8, Import 10, Export 11).
function cg_component_hex() returns Text:
  let core = cg_core_module_hex()
  let component = "0061736d0d000100"
  set component = sico.text.concat(component, cg_section_hex(U64.literal(7), cg_types_script_hex()))
  set component = sico.text.concat(component, cg_section_hex(U64.literal(10), cg_import_types_hex()))
  set component = sico.text.concat(component, cg_section_hex(U64.literal(6), cg_alias_types_hex()))
  set component = sico.text.concat(component, cg_section_hex(U64.literal(7), cg_run_type_hex()))
  set component = sico.text.concat(component, cg_section_hex(U64.literal(1), core))
  set component = sico.text.concat(component, cg_section_hex(U64.literal(2), cg_core_instance_hex()))
  set component = sico.text.concat(component, cg_section_hex(U64.literal(6), cg_alias_core_hex()))
  set component = sico.text.concat(component, cg_section_hex(U64.literal(8), cg_canonical_hex()))
  set component = sico.text.concat(component, cg_section_hex(U64.literal(11), cg_export_run_hex()))
  return component
end function

// The frozen minimal fixture this skeleton emits (byte gate).
function cg_minimal_fixture_source() returns Text:
  let mfs = "record ScriptInput:"
  set mfs = sico.text.concat(mfs, "\n  field arguments: List[Text]")
  set mfs = sico.text.concat(mfs, "\n  field stdin: Bytes")
  set mfs = sico.text.concat(mfs, "\nend record")
  set mfs = sico.text.concat(mfs, "\n")
  set mfs = sico.text.concat(mfs, "\nrecord ScriptOutput:")
  set mfs = sico.text.concat(mfs, "\n  field stdout: Bytes")
  set mfs = sico.text.concat(mfs, "\n  field stderr: Bytes")
  set mfs = sico.text.concat(mfs, "\n  field exit_code: I64")
  set mfs = sico.text.concat(mfs, "\nend record")
  set mfs = sico.text.concat(mfs, "\n")
  set mfs = sico.text.concat(mfs, "\nenum ScriptErrorCode:")
  set mfs = sico.text.concat(mfs, "\n  case InvalidInput")
  set mfs = sico.text.concat(mfs, "\n  case ResourceLimit")
  set mfs = sico.text.concat(mfs, "\n  case DomainError")
  set mfs = sico.text.concat(mfs, "\n  case Cancelled")
  set mfs = sico.text.concat(mfs, "\nend enum")
  set mfs = sico.text.concat(mfs, "\n")
  set mfs = sico.text.concat(mfs, "\nrecord ScriptError:")
  set mfs = sico.text.concat(mfs, "\n  field code: ScriptErrorCode")
  set mfs = sico.text.concat(mfs, "\n  field message: Text")
  set mfs = sico.text.concat(mfs, "\nend record")
  set mfs = sico.text.concat(mfs, "\n")
  set mfs = sico.text.concat(mfs, "\nfunction run(input: ScriptInput) returns Result[ScriptOutput, ScriptError]:")
  set mfs = sico.text.concat(mfs, "\n  return ok(ScriptOutput(stdout: input.stdin, stderr: input.stdin, exit_code: I64.literal(0)))")
  set mfs = sico.text.concat(mfs, "\nend function")
  set mfs = sico.text.concat(mfs, "\n")
  return mfs
end function

// Entry point: exact-source gate + structured emission. Returns "" when the
// source is not the supported minimal shape (typed refusal by the driver).
function component_hex_for_minimal(source: Bytes) returns Text:
  if sico.bytes.equal(source, sico.text.encode(cg_minimal_fixture_source())):
    return cg_component_hex()
  end if
  return ""
end function

// ---------------------------------------------------------------------------
// STEP-0496: IR JSON scanner + `run` emission-plan extraction (IR ingestion,
// first slice of the STEP-0488 §4 item 5 contract).
//
// The canonical IR (`sico.ir.v0`) is single-line JSON. The scanner is
// byte-oriented on purpose: the guest has no text slice, but `sico.bytes.slice`
// exists, so every span is read through bytes.
//
// Primitives: skip one JSON value, depth-1 key lookup inside an object,
// indexed access into an array, the member keys of an object in document
// order, and the raw canonical text of any value. Anything outside the
// supported shape returns "" or an `ERR:` identity so the caller fails
// closed instead of approximating (ADR-0016 decision 6).
//
// The plan text is the verifiable intermediate: the guest derives it from the
// scanned IR, and the Rust oracle derives the same text from `sico_ir::Module`.
// Both sides must agree byte for byte.
//
//   param <id> <name> <type>
//   inst <result> <type>
//   op <operation>
//   term return <value-id>
//   record <record> <field> <type>
//
// Type text: `unit`/`bool`/`int`/`i64`/`u64`/`float64`/`string`/`bytes`,
// `list(<T>)`, `named(<Name>)`, `result(<ok>,<error>)`. Operation text:
// `copy <id>`, `const_int <json>`, `const_i64 <n>`, `const_u64 <n>`,
// `const_bool <b>`, `const_string <json>`, `const_bytes <json>`,
// `call <fn> args=[...]`, `intrinsic <name> args=[...]`,
// `project base=<id> field=<name>`, `construct name=<name> fields=[...]`,
// `variant name=<name> payload=[...]`.
//
// Names (record, field, parameter, variant, intrinsic) are Sico identifiers, so
// they are carried unquoted; a name that is not a plain identifier fails
// closed. Literal payloads keep their canonical JSON spelling so the guest
// never has to unescape.
// ---------------------------------------------------------------------------

function cg_is_word(a: Text, b: Text) returns Bool:
  return sico.bytes.equal(sico.text.encode(a), sico.text.encode(b))
end function

function cg_byte_eq(b: I64, code: I64) returns Bool:
  return I64.equal(b, code)
end function

function cg_next(i: U64) returns U64:
  match U64.checked_add(i, U64.literal(1)):
    case ok(cgn_next):
      return cgn_next
    case error(_):
      return i
  end match
end function

function cg_list_at(items: List[Text], index: U64) returns Text:
  match sico.list.get(items, index):
    case ok(cgl_item):
      return cgl_item
    case error(_):
      return ""
  end match
end function

function cg_byte_is_space(b: I64) returns Bool:
  let cbis_space = false
  if cg_byte_eq(b, I64.literal(32)):
    set cbis_space = true
  end if
  if cg_byte_eq(b, I64.literal(9)):
    set cbis_space = true
  end if
  if cg_byte_eq(b, I64.literal(10)):
    set cbis_space = true
  end if
  if cg_byte_eq(b, I64.literal(13)):
    set cbis_space = true
  end if
  return cbis_space
end function

function cg_byte_is_stop(b: I64) returns Bool:
  let cbstop_stop = false
  if cg_byte_eq(b, I64.literal(44)):
    set cbstop_stop = true
  end if
  if cg_byte_eq(b, I64.literal(125)):
    set cbstop_stop = true
  end if
  if cg_byte_eq(b, I64.literal(93)):
    set cbstop_stop = true
  end if
  if cg_byte_is_space(b):
    set cbstop_stop = true
  end if
  return cbstop_stop
end function

// Offset of the next significant byte (whitespace is skipped).
function cgj_ws(bytes: Bytes, start: U64) returns U64:
  let cgjw_len = sico.bytes.length(bytes)
  let cgjw_i = start
  while U64.less_than(cgjw_i, cgjw_len):
    let cgjw_b = sico.bytes.at(bytes, cgjw_i, I64.literal(0))
    if cg_byte_is_space(cgjw_b):
      set cgjw_i = cg_next(cgjw_i)
      continue
    end if
    return cgjw_i
  end while
  return cgjw_i
end function

// Offset after the closing quote of the JSON string starting at `start`;
// 0 when the string is unterminated.
function cgj_string_end(bytes: Bytes, start: U64) returns U64:
  let cgjse_len = sico.bytes.length(bytes)
  let cgjse_i = cg_next(start)
  let cgjse_escaped = false
  while U64.less_than(cgjse_i, cgjse_len):
    let cgjse_b = sico.bytes.at(bytes, cgjse_i, I64.literal(0))
    if cgjse_escaped:
      set cgjse_escaped = false
    else:
      if cg_byte_eq(cgjse_b, I64.literal(92)):
        set cgjse_escaped = true
      else:
        if cg_byte_eq(cgjse_b, I64.literal(34)):
          return cg_next(cgjse_i)
        end if
      end if
    end if
    set cgjse_i = cg_next(cgjse_i)
  end while
  return U64.literal(0)
end function

// Offset after the matching close of the object/array starting at `start`;
// 0 when the container is unterminated.
function cgj_container_end(bytes: Bytes, start: U64) returns U64:
  let cgce_len = sico.bytes.length(bytes)
  let cgce_i = cg_next(start)
  let cgce_depth = U64.literal(1)
  while U64.less_than(cgce_i, cgce_len):
    let cgce_b = sico.bytes.at(bytes, cgce_i, I64.literal(0))
    if cg_byte_eq(cgce_b, I64.literal(34)):
      let cgce_str_end = cgj_string_end(bytes, cgce_i)
      if U64.equal(cgce_str_end, U64.literal(0)):
        return U64.literal(0)
      end if
      set cgce_i = cgce_str_end
      continue
    end if
    if cg_byte_eq(cgce_b, I64.literal(123)):
      set cgce_depth = cg_next(cgce_depth)
    end if
    if cg_byte_eq(cgce_b, I64.literal(91)):
      set cgce_depth = cg_next(cgce_depth)
    end if
    if cg_byte_eq(cgce_b, I64.literal(125)):
      match U64.checked_sub(cgce_depth, U64.literal(1)):
        case ok(cgce_shallower):
          set cgce_depth = cgce_shallower
        case error(_):
          return U64.literal(0)
      end match
      if U64.equal(cgce_depth, U64.literal(0)):
        return cg_next(cgce_i)
      end if
    end if
    if cg_byte_eq(cgce_b, I64.literal(93)):
      match U64.checked_sub(cgce_depth, U64.literal(1)):
        case ok(cgce_bracket_shallower):
          set cgce_depth = cgce_bracket_shallower
        case error(_):
          return U64.literal(0)
      end match
      if U64.equal(cgce_depth, U64.literal(0)):
        return cg_next(cgce_i)
      end if
    end if
    set cgce_i = cg_next(cgce_i)
  end while
  return U64.literal(0)
end function

// Offset after the JSON value starting at `start`; 0 when the value is
// malformed or unterminated.
function cgj_value_end(bytes: Bytes, start: U64) returns U64:
  let cgve_len = sico.bytes.length(bytes)
  let cgve_i = cgj_ws(bytes, start)
  if U64.less_than(cgve_len, cgve_i):
    return U64.literal(0)
  end if
  let cgve_b = sico.bytes.at(bytes, cgve_i, I64.literal(0))
  if cg_byte_eq(cgve_b, I64.literal(34)):
    return cgj_string_end(bytes, cgve_i)
  end if
  if cg_byte_eq(cgve_b, I64.literal(123)):
    return cgj_container_end(bytes, cgve_i)
  end if
  if cg_byte_eq(cgve_b, I64.literal(91)):
    return cgj_container_end(bytes, cgve_i)
  end if
  let cgve_end = cgve_i
  while U64.less_than(cgve_end, cgve_len):
    let cgve_c = sico.bytes.at(bytes, cgve_end, I64.literal(0))
    if cg_byte_is_stop(cgve_c):
      return cgve_end
    end if
    set cgve_end = cg_next(cgve_end)
  end while
  return U64.literal(0)
end function

// Raw text of the byte span [start, to).
function cgj_span_text(bytes: Bytes, start: U64, to: U64) returns Text:
  let cgjst_len = U64.literal(0)
  match U64.checked_sub(to, start):
    case ok(cgjst_l):
      set cgjst_len = cgjst_l
    case error(_):
      return ""
  end match
  match sico.bytes.slice(bytes, start, cgjst_len):
    case ok(cgjst_slice):
      return sico.bytes.utf8_decode(cgjst_slice)
    case error(_):
      return ""
  end match
end function

// Canonical JSON text of the value at `off`; "" when the value is malformed.
function cgj_value_text(bytes: Bytes, off: U64) returns Text:
  let cgvt_end = cgj_value_end(bytes, off)
  if U64.equal(cgvt_end, U64.literal(0)):
    return ""
  end if
  return cgj_span_text(bytes, off, cgvt_end)
end function

// The unquoted content of the JSON string at `off` when it is a plain
// identifier (no escape sequence); "" otherwise, so a name that would need
// unescaping fails closed instead of being approximated.
function cgj_ident_text(bytes: Bytes, off: U64) returns Text:
  let cgjit_open = sico.bytes.at(bytes, off, I64.literal(0))
  if cg_byte_eq(cgjit_open, I64.literal(34)):
    let cgjit_end = cgj_string_end(bytes, off)
    if U64.equal(cgjit_end, U64.literal(0)):
      return ""
    end if
    let cgjit_content_len = U64.literal(0)
    match U64.checked_sub(cgjit_end, cg_next(cg_next(off))):
      case ok(cgjit_cl):
        set cgjit_content_len = cgjit_cl
      case error(_):
        return ""
    end match
    let cgjit_content = sico.text.encode("")
    match sico.bytes.slice(bytes, cg_next(off), cgjit_content_len):
      case ok(cgjit_slice):
        set cgjit_content = cgjit_slice
      case error(_):
        return ""
    end match
    let cgjit_text = sico.bytes.utf8_decode(cgjit_content)
    if sico.bytes.equal(sico.text.encode(cgjit_text), cgjit_content):
      return cgjit_text
    end if
  end if
  return ""
end function

// Depth-1 key lookup: the offset of the member's value inside the object at
// `obj`; 0 when the key is absent or the object is malformed.
function cgj_member(bytes: Bytes, obj: U64, key: Text) returns U64:
  let cgjm_len = sico.bytes.length(bytes)
  let cgjm_key_bytes = sico.text.encode(key)
  let cgjm_i = cgj_ws(bytes, cg_next(obj))
  while U64.less_than(cgjm_i, cgjm_len):
    let cgjm_b = sico.bytes.at(bytes, cgjm_i, I64.literal(0))
    if cg_byte_eq(cgjm_b, I64.literal(125)):
      return U64.literal(0)
    end if
    if cg_byte_eq(cgjm_b, I64.literal(34)):
      let cgjm_key_end = cgj_string_end(bytes, cgjm_i)
      if U64.equal(cgjm_key_end, U64.literal(0)):
        return U64.literal(0)
      end if
      let cgjm_key_len = U64.literal(0)
      match U64.checked_sub(cgjm_key_end, cg_next(cg_next(cgjm_i))):
        case ok(cgjm_kl):
          set cgjm_key_len = cgjm_kl
        case error(_):
          return U64.literal(0)
      end match
      let cgjm_same = false
      match sico.bytes.slice(bytes, cg_next(cgjm_i), cgjm_key_len):
        case ok(cgjm_slice):
          if sico.bytes.equal(cgjm_slice, cgjm_key_bytes):
            set cgjm_same = true
          end if
        case error(_):
          return U64.literal(0)
      end match
      let cgjm_colon = cgj_ws(bytes, cgjm_key_end)
      if cg_byte_eq(sico.bytes.at(bytes, cgjm_colon, I64.literal(0)), I64.literal(58)):
        let cgjm_value = cgj_ws(bytes, cg_next(cgjm_colon))
        if cgjm_same:
          return cgjm_value
        end if
        let cgjm_value_end = cgj_value_end(bytes, cgjm_value)
        if U64.equal(cgjm_value_end, U64.literal(0)):
          return U64.literal(0)
        end if
        set cgjm_i = cgj_ws(bytes, cgjm_value_end)
        let cgjm_comma = sico.bytes.at(bytes, cgjm_i, I64.literal(0))
        if cg_byte_eq(cgjm_comma, I64.literal(44)):
          set cgjm_i = cgj_ws(bytes, cg_next(cgjm_i))
          continue
        end if
        return U64.literal(0)
      end if
      return U64.literal(0)
    end if
    return U64.literal(0)
  end while
  return U64.literal(0)
end function

// The member keys of the object at `obj`, in document order.
function cgj_object_keys(bytes: Bytes, obj: U64) returns List[Text]:
  let cgjok_keys = sico.text.split_lines("")
  let cgjok_len = sico.bytes.length(bytes)
  let cgjok_i = cgj_ws(bytes, cg_next(obj))
  while U64.less_than(cgjok_i, cgjok_len):
    let cgjok_b = sico.bytes.at(bytes, cgjok_i, I64.literal(0))
    if cg_byte_eq(cgjok_b, I64.literal(125)):
      return cgjok_keys
    end if
    if cg_byte_eq(cgjok_b, I64.literal(34)):
      let cgjok_key_end = cgj_string_end(bytes, cgjok_i)
      if U64.equal(cgjok_key_end, U64.literal(0)):
        return cgjok_keys
      end if
      set cgjok_keys = sico.list.append(cgjok_keys, cgj_ident_text(bytes, cgjok_i))
      let cgjok_colon = cgj_ws(bytes, cgjok_key_end)
      if cg_byte_eq(sico.bytes.at(bytes, cgjok_colon, I64.literal(0)), I64.literal(58)):
        let cgjok_value = cgj_ws(bytes, cg_next(cgjok_colon))
        let cgjok_value_end = cgj_value_end(bytes, cgjok_value)
        if U64.equal(cgjok_value_end, U64.literal(0)):
          return cgjok_keys
        end if
        set cgjok_i = cgj_ws(bytes, cgjok_value_end)
        let cgjok_comma = sico.bytes.at(bytes, cgjok_i, I64.literal(0))
        if cg_byte_eq(cgjok_comma, I64.literal(44)):
          set cgjok_i = cgj_ws(bytes, cg_next(cgjok_i))
          continue
        end if
        return cgjok_keys
      end if
      return cgjok_keys
    end if
    return cgjok_keys
  end while
  return cgjok_keys
end function

// The offset of the index-th element of the array at `arr`; 0 when absent.
function cgj_array_item(bytes: Bytes, arr: U64, index: U64) returns U64:
  let cgai_len = sico.bytes.length(bytes)
  let cgai_i = cgj_ws(bytes, cg_next(arr))
  let cgai_pos = U64.literal(0)
  while U64.less_than(cgai_i, cgai_len):
    let cgai_b = sico.bytes.at(bytes, cgai_i, I64.literal(0))
    if cg_byte_eq(cgai_b, I64.literal(93)):
      return U64.literal(0)
    end if
    if U64.equal(cgai_pos, index):
      return cgai_i
    end if
    let cgai_value_end = cgj_value_end(bytes, cgai_i)
    if U64.equal(cgai_value_end, U64.literal(0)):
      return U64.literal(0)
    end if
    set cgai_i = cgj_ws(bytes, cgai_value_end)
    let cgai_c = sico.bytes.at(bytes, cgai_i, I64.literal(0))
    if cg_byte_eq(cgai_c, I64.literal(44)):
      set cgai_i = cgj_ws(bytes, cg_next(cgai_i))
      set cgai_pos = cg_next(cgai_pos)
      continue
    end if
    return U64.literal(0)
  end while
  return U64.literal(0)
end function

// Canonical text form of the IR type at `ty`; an `ERR:` identity when the type
// is outside the supported subset.
function cgp_type_text(bytes: Bytes, ty: U64) returns Text:
  let cgpt_kind_off = cgj_member(bytes, ty, "kind")
  if U64.equal(cgpt_kind_off, U64.literal(0)):
    return "ERR:E-SH-CG-IR-TYPE"
  end if
  let cgpt_kind = cgj_ident_text(bytes, cgpt_kind_off)
  if cg_is_word(cgpt_kind, "unit"):
    return "unit"
  end if
  if cg_is_word(cgpt_kind, "bool"):
    return "bool"
  end if
  if cg_is_word(cgpt_kind, "int"):
    return "int"
  end if
  if cg_is_word(cgpt_kind, "i64"):
    return "i64"
  end if
  if cg_is_word(cgpt_kind, "u64"):
    return "u64"
  end if
  if cg_is_word(cgpt_kind, "float64"):
    return "float64"
  end if
  if cg_is_word(cgpt_kind, "string"):
    return "string"
  end if
  if cg_is_word(cgpt_kind, "bytes"):
    return "bytes"
  end if
  if cg_is_word(cgpt_kind, "list"):
    let cgpt_list_data = cgj_member(bytes, ty, "data")
    if U64.equal(cgpt_list_data, U64.literal(0)):
      return "ERR:E-SH-CG-IR-TYPE"
    end if
    let cgpt_list_inner = cgp_type_text(bytes, cgpt_list_data)
    if sico.text.starts_with(cgpt_list_inner, "ERR:"):
      return cgpt_list_inner
    end if
    let cgpt_list_text = "list("
    set cgpt_list_text = sico.text.concat(cgpt_list_text, cgpt_list_inner)
    set cgpt_list_text = sico.text.concat(cgpt_list_text, ")")
    return cgpt_list_text
  end if
  if cg_is_word(cgpt_kind, "named"):
    let cgpt_named_data = cgj_member(bytes, ty, "data")
    if U64.equal(cgpt_named_data, U64.literal(0)):
      return "ERR:E-SH-CG-IR-TYPE"
    end if
    let cgpt_named_text = cgj_ident_text(bytes, cgpt_named_data)
    if U64.equal(sico.text.length(cgpt_named_text), U64.literal(0)):
      return "ERR:E-SH-CG-IR-TYPE"
    end if
    let cgpt_named_full = "named("
    set cgpt_named_full = sico.text.concat(cgpt_named_full, cgpt_named_text)
    set cgpt_named_full = sico.text.concat(cgpt_named_full, ")")
    return cgpt_named_full
  end if
  if cg_is_word(cgpt_kind, "result"):
    let cgpt_result_data = cgj_member(bytes, ty, "data")
    if U64.equal(cgpt_result_data, U64.literal(0)):
      return "ERR:E-SH-CG-IR-TYPE"
    end if
    let cgpt_ok = cgj_member(bytes, cgpt_result_data, "ok")
    let cgpt_error = cgj_member(bytes, cgpt_result_data, "error")
    if U64.equal(cgpt_ok, U64.literal(0)):
      return "ERR:E-SH-CG-IR-TYPE"
    end if
    if U64.equal(cgpt_error, U64.literal(0)):
      return "ERR:E-SH-CG-IR-TYPE"
    end if
    let cgpt_ok_text = cgp_type_text(bytes, cgpt_ok)
    if sico.text.starts_with(cgpt_ok_text, "ERR:"):
      return cgpt_ok_text
    end if
    let cgpt_error_text = cgp_type_text(bytes, cgpt_error)
    if sico.text.starts_with(cgpt_error_text, "ERR:"):
      return cgpt_error_text
    end if
    let cgpt_result_text = "result("
    set cgpt_result_text = sico.text.concat(cgpt_result_text, cgpt_ok_text)
    set cgpt_result_text = sico.text.concat(cgpt_result_text, ",")
    set cgpt_result_text = sico.text.concat(cgpt_result_text, cgpt_error_text)
    set cgpt_result_text = sico.text.concat(cgpt_result_text, ")")
    return cgpt_result_text
  end if
  return "ERR:E-SH-CG-IR-TYPE"
end function

// The comma-separated value ids of the array at `arr`, as text.
function cgp_id_list(bytes: Bytes, arr: U64) returns Text:
  let cgpil_text = ""
  let cgpil_index = U64.literal(0)
  let cgpil_more = U64.literal(1)
  while U64.less_than(U64.literal(0), cgpil_more):
    let cgpil_item = cgj_array_item(bytes, arr, cgpil_index)
    if U64.equal(cgpil_item, U64.literal(0)):
      set cgpil_more = U64.literal(0)
      continue
    end if
    if U64.less_than(U64.literal(0), cgpil_index):
      set cgpil_text = sico.text.concat(cgpil_text, ",")
    end if
    set cgpil_text = sico.text.concat(cgpil_text, cgj_value_text(bytes, cgpil_item))
    set cgpil_index = cg_next(cgpil_index)
  end while
  return cgpil_text
end function

// The comma-separated `<field>=<value-id>` pairs of the construct field array
// at `arr`; an `ERR:` identity when a field is malformed.
function cgp_field_list(bytes: Bytes, arr: U64) returns Text:
  let cgpfl_text = ""
  let cgpfl_index = U64.literal(0)
  let cgpfl_more = U64.literal(1)
  while U64.less_than(U64.literal(0), cgpfl_more):
    let cgpfl_item = cgj_array_item(bytes, arr, cgpfl_index)
    if U64.equal(cgpfl_item, U64.literal(0)):
      set cgpfl_more = U64.literal(0)
      continue
    end if
    let cgpfl_name = cgj_member(bytes, cgpfl_item, "name")
    let cgpfl_value = cgj_member(bytes, cgpfl_item, "value")
    if U64.equal(cgpfl_name, U64.literal(0)):
      return "ERR:E-SH-CG-IR-OP"
    end if
    if U64.equal(cgpfl_value, U64.literal(0)):
      return "ERR:E-SH-CG-IR-OP"
    end if
    let cgpfl_name_text = cgj_ident_text(bytes, cgpfl_name)
    if U64.equal(sico.text.length(cgpfl_name_text), U64.literal(0)):
      return "ERR:E-SH-CG-IR-OP"
    end if
    if U64.less_than(U64.literal(0), cgpfl_index):
      set cgpfl_text = sico.text.concat(cgpfl_text, ",")
    end if
    set cgpfl_text = sico.text.concat(cgpfl_text, cgpfl_name_text)
    set cgpfl_text = sico.text.concat(cgpfl_text, "=")
    set cgpfl_text = sico.text.concat(cgpfl_text, cgj_value_text(bytes, cgpfl_value))
    set cgpfl_index = cg_next(cgpfl_index)
  end while
  return cgpfl_text
end function

// Canonical text form of the IR operation at `op`; an `ERR:` identity when
// the operation is outside the supported subset.
function cgp_op_text(bytes: Bytes, op: U64) returns Text:
  let cgpo_op_off = cgj_member(bytes, op, "op")
  let cgpo_data_off = cgj_member(bytes, op, "data")
  if U64.equal(cgpo_op_off, U64.literal(0)):
    return "ERR:E-SH-CG-IR-OP"
  end if
  if U64.equal(cgpo_data_off, U64.literal(0)):
    return "ERR:E-SH-CG-IR-OP"
  end if
  let cgpo_name = cgj_ident_text(bytes, cgpo_op_off)
  if cg_is_word(cgpo_name, "copy"):
    return sico.text.concat("copy ", cgj_value_text(bytes, cgpo_data_off))
  end if
  if cg_is_word(cgpo_name, "const_int"):
    return sico.text.concat("const_int ", cgj_value_text(bytes, cgpo_data_off))
  end if
  if cg_is_word(cgpo_name, "const_i64"):
    return sico.text.concat("const_i64 ", cgj_value_text(bytes, cgpo_data_off))
  end if
  if cg_is_word(cgpo_name, "const_u64"):
    return sico.text.concat("const_u64 ", cgj_value_text(bytes, cgpo_data_off))
  end if
  if cg_is_word(cgpo_name, "const_bool"):
    return sico.text.concat("const_bool ", cgj_value_text(bytes, cgpo_data_off))
  end if
  if cg_is_word(cgpo_name, "const_string"):
    return sico.text.concat("const_string ", cgj_value_text(bytes, cgpo_data_off))
  end if
  if cg_is_word(cgpo_name, "const_bytes"):
    return sico.text.concat("const_bytes ", cgj_value_text(bytes, cgpo_data_off))
  end if
  if cg_is_word(cgpo_name, "call"):
    let cgpo_call_fn = cgj_member(bytes, cgpo_data_off, "function")
    let cgpo_call_args = cgj_member(bytes, cgpo_data_off, "arguments")
    if U64.equal(cgpo_call_fn, U64.literal(0)):
      return "ERR:E-SH-CG-IR-OP"
    end if
    if U64.equal(cgpo_call_args, U64.literal(0)):
      return "ERR:E-SH-CG-IR-OP"
    end if
    let cgpo_call_text = "call "
    set cgpo_call_text = sico.text.concat(cgpo_call_text, cgj_value_text(bytes, cgpo_call_fn))
    set cgpo_call_text = sico.text.concat(cgpo_call_text, " args=[")
    set cgpo_call_text = sico.text.concat(cgpo_call_text, cgp_id_list(bytes, cgpo_call_args))
    set cgpo_call_text = sico.text.concat(cgpo_call_text, "]")
    return cgpo_call_text
  end if
  if cg_is_word(cgpo_name, "intrinsic"):
    let cgpo_intrinsic_name = cgj_ident_text(bytes, cgj_member(bytes, cgpo_data_off, "name"))
    let cgpo_intrinsic_args = cgj_member(bytes, cgpo_data_off, "arguments")
    if U64.equal(sico.text.length(cgpo_intrinsic_name), U64.literal(0)):
      return "ERR:E-SH-CG-IR-OP"
    end if
    if U64.equal(cgpo_intrinsic_args, U64.literal(0)):
      return "ERR:E-SH-CG-IR-OP"
    end if
    let cgpo_intrinsic_text = "intrinsic "
    set cgpo_intrinsic_text = sico.text.concat(cgpo_intrinsic_text, cgpo_intrinsic_name)
    set cgpo_intrinsic_text = sico.text.concat(cgpo_intrinsic_text, " args=[")
    set cgpo_intrinsic_text = sico.text.concat(cgpo_intrinsic_text, cgp_id_list(bytes, cgpo_intrinsic_args))
    set cgpo_intrinsic_text = sico.text.concat(cgpo_intrinsic_text, "]")
    return cgpo_intrinsic_text
  end if
  if cg_is_word(cgpo_name, "project"):
    let cgpo_project_base = cgj_member(bytes, cgpo_data_off, "base")
    let cgpo_project_field = cgj_member(bytes, cgpo_data_off, "field")
    if U64.equal(cgpo_project_base, U64.literal(0)):
      return "ERR:E-SH-CG-IR-OP"
    end if
    if U64.equal(cgpo_project_field, U64.literal(0)):
      return "ERR:E-SH-CG-IR-OP"
    end if
    let cgpo_project_field_text = cgj_ident_text(bytes, cgpo_project_field)
    if U64.equal(sico.text.length(cgpo_project_field_text), U64.literal(0)):
      return "ERR:E-SH-CG-IR-OP"
    end if
    let cgpo_project_text = "project base="
    set cgpo_project_text = sico.text.concat(cgpo_project_text, cgj_value_text(bytes, cgpo_project_base))
    set cgpo_project_text = sico.text.concat(cgpo_project_text, " field=")
    set cgpo_project_text = sico.text.concat(cgpo_project_text, cgpo_project_field_text)
    return cgpo_project_text
  end if
  if cg_is_word(cgpo_name, "construct"):
    let cgpo_construct_name = cgj_ident_text(bytes, cgj_member(bytes, cgpo_data_off, "name"))
    let cgpo_construct_fields = cgj_member(bytes, cgpo_data_off, "fields")
    if U64.equal(sico.text.length(cgpo_construct_name), U64.literal(0)):
      return "ERR:E-SH-CG-IR-OP"
    end if
    if U64.equal(cgpo_construct_fields, U64.literal(0)):
      return "ERR:E-SH-CG-IR-OP"
    end if
    let cgpo_construct_fields_text = cgp_field_list(bytes, cgpo_construct_fields)
    if sico.text.starts_with(cgpo_construct_fields_text, "ERR:"):
      return cgpo_construct_fields_text
    end if
    let cgpo_construct_text = "construct name="
    set cgpo_construct_text = sico.text.concat(cgpo_construct_text, cgpo_construct_name)
    set cgpo_construct_text = sico.text.concat(cgpo_construct_text, " fields=[")
    set cgpo_construct_text = sico.text.concat(cgpo_construct_text, cgpo_construct_fields_text)
    set cgpo_construct_text = sico.text.concat(cgpo_construct_text, "]")
    return cgpo_construct_text
  end if
  if cg_is_word(cgpo_name, "variant"):
    let cgpo_variant_name = cgj_ident_text(bytes, cgj_member(bytes, cgpo_data_off, "name"))
    let cgpo_variant_payload = cgj_member(bytes, cgpo_data_off, "payload")
    if U64.equal(sico.text.length(cgpo_variant_name), U64.literal(0)):
      return "ERR:E-SH-CG-IR-OP"
    end if
    if U64.equal(cgpo_variant_payload, U64.literal(0)):
      return "ERR:E-SH-CG-IR-OP"
    end if
    let cgpo_variant_text = "variant name="
    set cgpo_variant_text = sico.text.concat(cgpo_variant_text, cgpo_variant_name)
    set cgpo_variant_text = sico.text.concat(cgpo_variant_text, " payload=[")
    set cgpo_variant_text = sico.text.concat(cgpo_variant_text, cgp_id_list(bytes, cgpo_variant_payload))
    set cgpo_variant_text = sico.text.concat(cgpo_variant_text, "]")
    return cgpo_variant_text
  end if
  return "ERR:E-SH-CG-IR-OP"
end function

// The canonical emission plan of the `run` function, extracted from the
// canonical IR JSON. One record per line:
//
//   param <id> <name> <type>
//   inst <result> <type>
//   op <operation>
//   term return <value-id>
//   record <record> <field> <type>
//
// Returns an `ERR:` identity when the IR carries no `run` function or a shape
// outside the supported subset (fail closed, never approximate).
function cgp_run_plan(ir: Text) returns Text:
  let cgpr_bytes = sico.text.encode(ir)
  let cgpr_functions = cgj_member(cgpr_bytes, U64.literal(0), "functions")
  if U64.equal(cgpr_functions, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cgpr_index = U64.literal(0)
  let cgpr_run = U64.literal(0)
  let cgpr_more = U64.literal(1)
  while U64.less_than(U64.literal(0), cgpr_more):
    let cgpr_item = cgj_array_item(cgpr_bytes, cgpr_functions, cgpr_index)
    if U64.equal(cgpr_item, U64.literal(0)):
      set cgpr_more = U64.literal(0)
      continue
    end if
    let cgpr_name_off = cgj_member(cgpr_bytes, cgpr_item, "name")
    if U64.equal(cgpr_name_off, U64.literal(0)):
      return "ERR:E-SH-CG-IR-PLAN"
    end if
    if cg_is_word(cgj_ident_text(cgpr_bytes, cgpr_name_off), "run"):
      set cgpr_run = cgpr_item
      set cgpr_more = U64.literal(0)
      continue
    end if
    set cgpr_index = cg_next(cgpr_index)
  end while
  if U64.equal(cgpr_run, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cgpr_text = ""
  let cgpr_parameters = cgj_member(cgpr_bytes, cgpr_run, "parameters")
  if U64.equal(cgpr_parameters, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cgpr_parameter_index = U64.literal(0)
  let cgpr_parameter_more = U64.literal(1)
  while U64.less_than(U64.literal(0), cgpr_parameter_more):
    let cgpr_parameter = cgj_array_item(cgpr_bytes, cgpr_parameters, cgpr_parameter_index)
    if U64.equal(cgpr_parameter, U64.literal(0)):
      set cgpr_parameter_more = U64.literal(0)
      continue
    end if
    let cgpr_parameter_id = cgj_member(cgpr_bytes, cgpr_parameter, "id")
    let cgpr_parameter_name = cgj_member(cgpr_bytes, cgpr_parameter, "name")
    let cgpr_parameter_ty = cgj_member(cgpr_bytes, cgpr_parameter, "ty")
    if U64.equal(cgpr_parameter_id, U64.literal(0)):
      return "ERR:E-SH-CG-IR-PLAN"
    end if
    if U64.equal(cgpr_parameter_name, U64.literal(0)):
      return "ERR:E-SH-CG-IR-PLAN"
    end if
    if U64.equal(cgpr_parameter_ty, U64.literal(0)):
      return "ERR:E-SH-CG-IR-PLAN"
    end if
    let cgpr_parameter_type = cgp_type_text(cgpr_bytes, cgpr_parameter_ty)
    if sico.text.starts_with(cgpr_parameter_type, "ERR:"):
      return cgpr_parameter_type
    end if
    let cgpr_parameter_name_text = cgj_ident_text(cgpr_bytes, cgpr_parameter_name)
    if U64.equal(sico.text.length(cgpr_parameter_name_text), U64.literal(0)):
      return "ERR:E-SH-CG-IR-PLAN"
    end if
    set cgpr_text = sico.text.concat(cgpr_text, "param ")
    set cgpr_text = sico.text.concat(cgpr_text, cgj_value_text(cgpr_bytes, cgpr_parameter_id))
    set cgpr_text = sico.text.concat(cgpr_text, " ")
    set cgpr_text = sico.text.concat(cgpr_text, cgpr_parameter_name_text)
    set cgpr_text = sico.text.concat(cgpr_text, " ")
    set cgpr_text = sico.text.concat(cgpr_text, cgpr_parameter_type)
    set cgpr_text = sico.text.concat(cgpr_text, "\n")
    set cgpr_parameter_index = cg_next(cgpr_parameter_index)
  end while
  let cgpr_blocks = cgj_member(cgpr_bytes, cgpr_run, "blocks")
  if U64.equal(cgpr_blocks, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cgpr_block_index = U64.literal(0)
  let cgpr_block_more = U64.literal(1)
  while U64.less_than(U64.literal(0), cgpr_block_more):
    let cgpr_block = cgj_array_item(cgpr_bytes, cgpr_blocks, cgpr_block_index)
    if U64.equal(cgpr_block, U64.literal(0)):
      set cgpr_block_more = U64.literal(0)
      continue
    end if
    let cgpr_instructions = cgj_member(cgpr_bytes, cgpr_block, "instructions")
    if U64.equal(cgpr_instructions, U64.literal(0)):
      return "ERR:E-SH-CG-IR-PLAN"
    end if
    let cgpr_instruction_index = U64.literal(0)
    let cgpr_instruction_more = U64.literal(1)
    while U64.less_than(U64.literal(0), cgpr_instruction_more):
      let cgpr_instruction = cgj_array_item(cgpr_bytes, cgpr_instructions, cgpr_instruction_index)
      if U64.equal(cgpr_instruction, U64.literal(0)):
        set cgpr_instruction_more = U64.literal(0)
        continue
      end if
      let cgpr_instruction_result = cgj_member(cgpr_bytes, cgpr_instruction, "result")
      let cgpr_instruction_ty = cgj_member(cgpr_bytes, cgpr_instruction, "ty")
      let cgpr_instruction_operation = cgj_member(cgpr_bytes, cgpr_instruction, "operation")
      if U64.equal(cgpr_instruction_result, U64.literal(0)):
        return "ERR:E-SH-CG-IR-PLAN"
      end if
      if U64.equal(cgpr_instruction_ty, U64.literal(0)):
        return "ERR:E-SH-CG-IR-PLAN"
      end if
      if U64.equal(cgpr_instruction_operation, U64.literal(0)):
        return "ERR:E-SH-CG-IR-PLAN"
      end if
      let cgpr_instruction_type = cgp_type_text(cgpr_bytes, cgpr_instruction_ty)
      if sico.text.starts_with(cgpr_instruction_type, "ERR:"):
        return cgpr_instruction_type
      end if
      let cgpr_instruction_op = cgp_op_text(cgpr_bytes, cgpr_instruction_operation)
      if sico.text.starts_with(cgpr_instruction_op, "ERR:"):
        return cgpr_instruction_op
      end if
      set cgpr_text = sico.text.concat(cgpr_text, "inst ")
      set cgpr_text = sico.text.concat(cgpr_text, cgj_value_text(cgpr_bytes, cgpr_instruction_result))
      set cgpr_text = sico.text.concat(cgpr_text, " ")
      set cgpr_text = sico.text.concat(cgpr_text, cgpr_instruction_type)
      set cgpr_text = sico.text.concat(cgpr_text, "\n")
      set cgpr_text = sico.text.concat(cgpr_text, "op ")
      set cgpr_text = sico.text.concat(cgpr_text, cgpr_instruction_op)
      set cgpr_text = sico.text.concat(cgpr_text, "\n")
      set cgpr_instruction_index = cg_next(cgpr_instruction_index)
    end while
    let cgpr_terminator = cgj_member(cgpr_bytes, cgpr_block, "terminator")
    if U64.equal(cgpr_terminator, U64.literal(0)):
      return "ERR:E-SH-CG-IR-PLAN"
    end if
    let cgpr_terminator_kind = cgj_member(cgpr_bytes, cgpr_terminator, "kind")
    let cgpr_terminator_data = cgj_member(cgpr_bytes, cgpr_terminator, "data")
    if U64.equal(cgpr_terminator_kind, U64.literal(0)):
      return "ERR:E-SH-CG-IR-PLAN"
    end if
    if U64.equal(cgpr_terminator_data, U64.literal(0)):
      return "ERR:E-SH-CG-IR-PLAN"
    end if
    if cg_is_word(cgj_ident_text(cgpr_bytes, cgpr_terminator_kind), "return"):
      let cgpr_terminator_value = cgj_value_text(cgpr_bytes, cgpr_terminator_data)
      if cg_is_word(cgpr_terminator_value, "null"):
        return "ERR:E-SH-CG-IR-TERMINATOR"
      end if
      set cgpr_text = sico.text.concat(cgpr_text, "term return ")
      set cgpr_text = sico.text.concat(cgpr_text, cgpr_terminator_value)
      set cgpr_text = sico.text.concat(cgpr_text, "\n")
    else:
      return "ERR:E-SH-CG-IR-TERMINATOR"
    end if
    set cgpr_block_index = cg_next(cgpr_block_index)
  end while
  let cgpr_records = cgj_member(cgpr_bytes, U64.literal(0), "records")
  if U64.equal(cgpr_records, U64.literal(0)):
    return cgpr_text
  end if
  let cgpr_record_names = cgj_object_keys(cgpr_bytes, cgpr_records)
  let cgpr_record_index = U64.literal(0)
  let cgpr_record_count = sico.list.length(cgpr_record_names)
  while U64.less_than(cgpr_record_index, cgpr_record_count):
    let cgpr_record_name = cg_list_at(cgpr_record_names, cgpr_record_index)
    if U64.equal(sico.text.length(cgpr_record_name), U64.literal(0)):
      return "ERR:E-SH-CG-IR-PLAN"
    end if
    let cgpr_record_fields = cgj_member(cgpr_bytes, cgpr_records, cgpr_record_name)
    if U64.equal(cgpr_record_fields, U64.literal(0)):
      return "ERR:E-SH-CG-IR-PLAN"
    end if
    let cgpr_field_index = U64.literal(0)
    let cgpr_field_more = U64.literal(1)
    while U64.less_than(U64.literal(0), cgpr_field_more):
      let cgpr_field = cgj_array_item(cgpr_bytes, cgpr_record_fields, cgpr_field_index)
      if U64.equal(cgpr_field, U64.literal(0)):
        set cgpr_field_more = U64.literal(0)
        continue
      end if
      let cgpr_field_name = cgj_member(cgpr_bytes, cgpr_field, "name")
      let cgpr_field_ty = cgj_member(cgpr_bytes, cgpr_field, "ty")
      if U64.equal(cgpr_field_name, U64.literal(0)):
        return "ERR:E-SH-CG-IR-PLAN"
      end if
      if U64.equal(cgpr_field_ty, U64.literal(0)):
        return "ERR:E-SH-CG-IR-PLAN"
      end if
      let cgpr_field_type = cgp_type_text(cgpr_bytes, cgpr_field_ty)
      if sico.text.starts_with(cgpr_field_type, "ERR:"):
        return cgpr_field_type
      end if
      let cgpr_field_name_text = cgj_ident_text(cgpr_bytes, cgpr_field_name)
      if U64.equal(sico.text.length(cgpr_field_name_text), U64.literal(0)):
        return "ERR:E-SH-CG-IR-PLAN"
      end if
      set cgpr_text = sico.text.concat(cgpr_text, "record ")
      set cgpr_text = sico.text.concat(cgpr_text, cgpr_record_name)
      set cgpr_text = sico.text.concat(cgpr_text, " ")
      set cgpr_text = sico.text.concat(cgpr_text, cgpr_field_name_text)
      set cgpr_text = sico.text.concat(cgpr_text, " ")
      set cgpr_text = sico.text.concat(cgpr_text, cgpr_field_type)
      set cgpr_text = sico.text.concat(cgpr_text, "\n")
      set cgpr_field_index = cg_next(cgpr_field_index)
    end while
    set cgpr_record_index = cg_next(cgpr_record_index)
  end while
  return cgpr_text
end function

// STEP-0499 S5 emission plan, first slice: the local declaration plan of the
// Script-profile `run` function.
//
// The Rust backend assigns Wasm slots to every IR value (parameters first,
// then instruction results in IR order), adds one dispatcher slot and the
// Script scratch pair, and writes every non-parameter slot as its own local
// declaration group. The guest recomputes the same plan from the ingested IR
// so the local declaration section can be compared byte for byte against the
// oracle's own emission.
//
// The plan is carried as the local declaration bytes themselves: one
// `count`/`valtype` group per slot, `01 7f` for an i32 slot and `01 7e` for
// an i64 slot.

// The offset of the `run` function in the IR; 0 when the IR carries none.
function cgs_run_function(bytes: Bytes) returns U64:
  let cgsrf_functions = cgj_member(bytes, U64.literal(0), "functions")
  if U64.equal(cgsrf_functions, U64.literal(0)):
    return U64.literal(0)
  end if
  let cgsrf_index = U64.literal(0)
  let cgsrf_run = U64.literal(0)
  let cgsrf_more = U64.literal(1)
  while U64.less_than(U64.literal(0), cgsrf_more):
    let cgsrf_item = cgj_array_item(bytes, cgsrf_functions, cgsrf_index)
    if U64.equal(cgsrf_item, U64.literal(0)):
      set cgsrf_more = U64.literal(0)
      continue
    end if
    let cgsrf_name_off = cgj_member(bytes, cgsrf_item, "name")
    if U64.equal(cgsrf_name_off, U64.literal(0)):
      return U64.literal(0)
    end if
    if cg_is_word(cgj_ident_text(bytes, cgsrf_name_off), "run"):
      set cgsrf_run = cgsrf_item
      set cgsrf_more = U64.literal(0)
      continue
    end if
    set cgsrf_index = cg_next(cgsrf_index)
  end while
  return cgsrf_run
end function

// The local declaration bytes of the IR type at `ty`; "" when the type is
// outside the Script v0 flattening subset (fail closed, never approximate).
function cgs_flat_hex(bytes: Bytes, ty: U64) returns Text:
  let cgsfh_kind_off = cgj_member(bytes, ty, "kind")
  if U64.equal(cgsfh_kind_off, U64.literal(0)):
    return ""
  end if
  let cgsfh_kind = cgj_ident_text(bytes, cgsfh_kind_off)
  if cg_is_word(cgsfh_kind, "bool"):
    return "017f"
  end if
  if cg_is_word(cgsfh_kind, "i64"):
    return "017e"
  end if
  if cg_is_word(cgsfh_kind, "u64"):
    return "017e"
  end if
  if cg_is_word(cgsfh_kind, "string"):
    return "017f017f"
  end if
  if cg_is_word(cgsfh_kind, "bytes"):
    return "017f017f"
  end if
  if cg_is_word(cgsfh_kind, "list"):
    let cgsfh_list_data = cgj_member(bytes, ty, "data")
    if U64.equal(cgsfh_list_data, U64.literal(0)):
      return ""
    end if
    let cgsfh_list_kind_off = cgj_member(bytes, cgsfh_list_data, "kind")
    if U64.equal(cgsfh_list_kind_off, U64.literal(0)):
      return ""
    end if
    let cgsfh_list_kind = cgj_ident_text(bytes, cgsfh_list_kind_off)
    if cg_is_word(cgsfh_list_kind, "string"):
      return "017f017f"
    end if
    if cg_is_word(cgsfh_list_kind, "i64"):
      return "017f017f"
    end if
    if cg_is_word(cgsfh_list_kind, "u64"):
      return "017f017f"
    end if
    return ""
  end if
  if cg_is_word(cgsfh_kind, "named"):
    let cgsfh_named_data = cgj_member(bytes, ty, "data")
    if U64.equal(cgsfh_named_data, U64.literal(0)):
      return ""
    end if
    let cgsfh_named_text = cgj_ident_text(bytes, cgsfh_named_data)
    if U64.equal(sico.text.length(cgsfh_named_text), U64.literal(0)):
      return ""
    end if
    let cgsfh_record_hex = cgs_record_hex(bytes, cgsfh_named_text)
    if U64.less_than(U64.literal(0), sico.text.length(cgsfh_record_hex)):
      return cgsfh_record_hex
    end if
    if cg_is_word(cgsfh_named_text, "ScriptErrorCode"):
      return "017f"
    end if
    return ""
  end if
  if cg_is_word(cgsfh_kind, "result"):
    let cgsfh_result_data = cgj_member(bytes, ty, "data")
    if U64.equal(cgsfh_result_data, U64.literal(0)):
      return ""
    end if
    let cgsfh_ok_off = cgj_member(bytes, cgsfh_result_data, "ok")
    let cgsfh_error_off = cgj_member(bytes, cgsfh_result_data, "error")
    if U64.equal(cgsfh_ok_off, U64.literal(0)):
      return ""
    end if
    if U64.equal(cgsfh_error_off, U64.literal(0)):
      return ""
    end if
    let cgsfh_ok_hex = cgs_flat_hex(bytes, cgsfh_ok_off)
    if U64.equal(sico.text.length(cgsfh_ok_hex), U64.literal(0)):
      return ""
    end if
    let cgsfh_error_hex = cgs_flat_hex(bytes, cgsfh_error_off)
    if U64.equal(sico.text.length(cgsfh_error_hex), U64.literal(0)):
      return ""
    end if
    let cgsfh_hex = "017f"
    set cgsfh_hex = sico.text.concat(cgsfh_hex, cgsfh_ok_hex)
    set cgsfh_hex = sico.text.concat(cgsfh_hex, cgsfh_error_hex)
    return cgsfh_hex
  end if
  return ""
end function

// The local declaration bytes of the module's own record `name`; "" when the
// record is absent or one of its fields does not flatten.
function cgs_record_hex(bytes: Bytes, name: Text) returns Text:
  let cgsrh_records = cgj_member(bytes, U64.literal(0), "records")
  if U64.equal(cgsrh_records, U64.literal(0)):
    return ""
  end if
  let cgsrh_fields = cgj_member(bytes, cgsrh_records, name)
  if U64.equal(cgsrh_fields, U64.literal(0)):
    return ""
  end if
  let cgsrh_hex = ""
  let cgsrh_index = U64.literal(0)
  let cgsrh_more = U64.literal(1)
  while U64.less_than(U64.literal(0), cgsrh_more):
    let cgsrh_field = cgj_array_item(bytes, cgsrh_fields, cgsrh_index)
    if U64.equal(cgsrh_field, U64.literal(0)):
      set cgsrh_more = U64.literal(0)
      continue
    end if
    let cgsrh_field_ty = cgj_member(bytes, cgsrh_field, "ty")
    if U64.equal(cgsrh_field_ty, U64.literal(0)):
      return ""
    end if
    let cgsrh_field_hex = cgs_flat_hex(bytes, cgsrh_field_ty)
    if U64.equal(sico.text.length(cgsrh_field_hex), U64.literal(0)):
      return ""
    end if
    set cgsrh_hex = sico.text.concat(cgsrh_hex, cgsrh_field_hex)
    set cgsrh_index = cg_next(cgsrh_index)
  end while
  return cgsrh_hex
end function

// The local declaration bytes of the Script-profile `run` function: one group
// per instruction slot in IR order, then the dispatcher slot and the Script
// scratch pair.
function cgs_local_hex(bytes: Bytes) returns Text:
  let cgslh_run = cgs_run_function(bytes)
  if U64.equal(cgslh_run, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cgslh_cells = cgj_member(bytes, cgslh_run, "locals")
  if U64.less_than(U64.literal(0), cgslh_cells):
    let cgslh_first_cell = cgj_array_item(bytes, cgslh_cells, U64.literal(0))
    if U64.less_than(U64.literal(0), cgslh_first_cell):
      return "ERR:E-SH-CG-IR-FLAT"
    end if
  end if
  let cgslh_blocks = cgj_member(bytes, cgslh_run, "blocks")
  if U64.equal(cgslh_blocks, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let cgslh_hex = ""
  let cgslh_block_index = U64.literal(0)
  let cgslh_block_more = U64.literal(1)
  while U64.less_than(U64.literal(0), cgslh_block_more):
    let cgslh_block = cgj_array_item(bytes, cgslh_blocks, cgslh_block_index)
    if U64.equal(cgslh_block, U64.literal(0)):
      set cgslh_block_more = U64.literal(0)
      continue
    end if
    let cgslh_instructions = cgj_member(bytes, cgslh_block, "instructions")
    if U64.equal(cgslh_instructions, U64.literal(0)):
      return "ERR:E-SH-CG-IR-PLAN"
    end if
    let cgslh_instruction_index = U64.literal(0)
    let cgslh_instruction_more = U64.literal(1)
    while U64.less_than(U64.literal(0), cgslh_instruction_more):
      let cgslh_instruction = cgj_array_item(bytes, cgslh_instructions, cgslh_instruction_index)
      if U64.equal(cgslh_instruction, U64.literal(0)):
        set cgslh_instruction_more = U64.literal(0)
        continue
      end if
      let cgslh_instruction_ty = cgj_member(bytes, cgslh_instruction, "ty")
      if U64.equal(cgslh_instruction_ty, U64.literal(0)):
        return "ERR:E-SH-CG-IR-PLAN"
      end if
      let cgslh_instruction_hex = cgs_flat_hex(bytes, cgslh_instruction_ty)
      if U64.equal(sico.text.length(cgslh_instruction_hex), U64.literal(0)):
        return "ERR:E-SH-CG-IR-FLAT"
      end if
      set cgslh_hex = sico.text.concat(cgslh_hex, cgslh_instruction_hex)
      set cgslh_instruction_index = cg_next(cgslh_instruction_index)
    end while
    set cgslh_block_index = cg_next(cgslh_block_index)
  end while
  set cgslh_hex = sico.text.concat(cgslh_hex, "017f")
  set cgslh_hex = sico.text.concat(cgslh_hex, "027f")
  return cgslh_hex
end function

// ---------------------------------------------------------------------------
// STEP-0502 S5 emission, second slice: the run body's instruction segment.
//
// The Rust backend emits the `run` function as a dispatcher shell (the entry
// block id into the dispatcher slot, then `block` and `loop`), then for every
// block a dispatch head (the dispatcher slot, the block id, `i32.eq` and
// `if`), then the block's instructions. The instruction segment is that part
// of the body: everything up to, but not including, the Script result-area
// return.
//
// The guest derives the same bytes from the ingested IR. The slot numbers come
// from the backend's own assignment (parameters first, then the instruction
// results in IR order, then the dispatcher slot), so the segment is directly
// comparable with the backend's emission.
//
// The supported subset is the one the reference Script shape uses: `project`
// of a declared record field, `const_i64` / `const_u64`, `construct` of a
// declared record, and the `ok` / `error` variants. Anything else fails closed
// with `ERR:E-SH-CG-IR-EMIT`.
// ---------------------------------------------------------------------------

// The sum of `left` and `right`; `left` when the addition overflows.
function cgs_add(left: U64, right: U64) returns U64:
  match U64.checked_add(left, right):
    case ok(cga_value):
      return cga_value
    case error(_):
      return left
  end match
end function

// The difference of `left` and `right`; 0 when the subtraction underflows.
function cgs_sub(left: U64, right: U64) returns U64:
  match U64.checked_sub(left, right):
    case ok(cgs_value):
      return cgs_value
    case error(_):
      return U64.literal(0)
  end match
end function

// The product of `left` and `right`; 0 when the multiplication overflows.
function cgs_mul(left: U64, right: U64) returns U64:
  match U64.checked_mul(left, right):
    case ok(cgm_value):
      return cgm_value
    case error(_):
      return U64.literal(0)
  end match
end function

// True when `byte` is an ASCII decimal digit.
function cgs_is_digit_byte(byte: I64) returns Bool:
  if I64.less_than(byte, I64.literal(48)):
    return false
  end if
  if I64.less_than(I64.literal(58), byte):
    return false
  end if
  return true
end function

// The decimal value of an ASCII digit byte.
function cgs_decimal_digit(byte: I64) returns U64:
  if I64.equal(byte, I64.literal(48)):
    return U64.literal(0)
  end if
  if I64.equal(byte, I64.literal(49)):
    return U64.literal(1)
  end if
  if I64.equal(byte, I64.literal(50)):
    return U64.literal(2)
  end if
  if I64.equal(byte, I64.literal(51)):
    return U64.literal(3)
  end if
  if I64.equal(byte, I64.literal(52)):
    return U64.literal(4)
  end if
  if I64.equal(byte, I64.literal(53)):
    return U64.literal(5)
  end if
  if I64.equal(byte, I64.literal(54)):
    return U64.literal(6)
  end if
  if I64.equal(byte, I64.literal(55)):
    return U64.literal(7)
  end if
  if I64.equal(byte, I64.literal(56)):
    return U64.literal(8)
  end if
  return U64.literal(9)
end function

// True when `value` is a canonical unsigned decimal of at most ten digits, so
// that the parse below cannot overflow.
function cgs_decimal_ok(value: Text) returns Bool:
  let cdo_len = sico.text.length(value)
  if U64.equal(cdo_len, U64.literal(0)):
    return false
  end if
  if U64.less_than(U64.literal(10), cdo_len):
    return false
  end if
  let cdo_bytes = sico.text.encode(value)
  let cdo_index = U64.literal(0)
  while U64.less_than(cdo_index, cdo_len):
    let cdo_byte = sico.bytes.at(cdo_bytes, cdo_index, I64.literal(0))
    if cgs_is_digit_byte(cdo_byte):
      set cdo_index = cg_next(cdo_index)
    else:
      return false
    end if
  end while
  return true
end function

// True when `value` is not a canonical unsigned decimal of at most ten digits.
function cgs_decimal_bad(value: Text) returns Bool:
  if cgs_decimal_ok(value):
    return false
  end if
  return true
end function

// The decimal value of a canonical unsigned decimal of at most ten digits.
function cgs_decimal_u64(value: Text) returns U64:
  let cdu_bytes = sico.text.encode(value)
  let cdu_len = sico.text.length(value)
  let cdu_index = U64.literal(0)
  let cdu_parsed = U64.literal(0)
  while U64.less_than(cdu_index, cdu_len):
    match U64.checked_mul(cdu_parsed, U64.literal(10)):
      case ok(cdu_shifted):
        let cdu_digit = cgs_decimal_digit(sico.bytes.at(cdu_bytes, cdu_index, I64.literal(0)))
        match U64.checked_add(cdu_shifted, cdu_digit):
          case ok(cdu_next):
            set cdu_parsed = cdu_next
          case error(_):
            return U64.literal(0)
        end match
      case error(_):
        return U64.literal(0)
    end match
    set cdu_index = cg_next(cdu_index)
  end while
  return cdu_parsed
end function

// Signed LEB128 of a non-negative value as hex byte pairs. The signed form
// differs from the unsigned one once bit 6 of the final byte would be set, so
// 64 encodes as `c000` and not as `40`.
function cgs_sleb_hex(value: U64) returns Text:
  let csh_n = value
  let csh_out = ""
  let csh_more = U64.literal(1)
  while U64.equal(csh_more, U64.literal(1)):
    let csh_low = U64.bit_and(csh_n, U64.literal(127))
    set csh_n = U64.shr(csh_n, U64.literal(7))
    let csh_byte = U64.bit_or(csh_low, U64.literal(128))
    if U64.equal(csh_n, U64.literal(0)):
      let csh_sign = U64.equal(U64.bit_and(csh_low, U64.literal(64)), U64.literal(0))
      if csh_sign:
        set csh_byte = csh_low
        set csh_more = U64.literal(0)
      end if
    end if
    set csh_out = sico.text.concat(csh_out, cg_hex_byte(csh_byte))
  end while
  return csh_out
end function

// The bytes of a `local.get` of the slot.
function cgs_local_get_hex(slot: U64) returns Text:
  return sico.text.concat("20", cg_leb_hex(slot))
end function

// The bytes of a `local.set` of the slot.
function cgs_local_set_hex(slot: U64) returns Text:
  return sico.text.concat("21", cg_leb_hex(slot))
end function

// The bytes of an `i32.const` of the value.
function cgs_i32_const_hex(value: U64) returns Text:
  return sico.text.concat("41", cgs_sleb_hex(value))
end function

// The bytes of an `i64.const` of the value.
function cgs_i64_const_hex(value: U64) returns Text:
  return sico.text.concat("42", cgs_sleb_hex(value))
end function

// The number of flat Wasm slots of the IR type at `ty`; 0 when the type is
// outside the Script v0 flattening subset.
function cgs_type_slots(bytes: Bytes, ty: U64) returns U64:
  let cts_hex = cgs_flat_hex(bytes, ty)
  if U64.equal(sico.text.length(cts_hex), U64.literal(0)):
    return U64.literal(0)
  end if
  return U64.shr(sico.text.length(cts_hex), U64.literal(2))
end function

// The record name of a `named` IR type; "" when the type is not a named one.
function cgs_named_text(bytes: Bytes, ty: U64) returns Text:
  let cnt_kind_off = cgj_member(bytes, ty, "kind")
  if U64.equal(cnt_kind_off, U64.literal(0)):
    return ""
  end if
  let cnt_kind = cgj_ident_text(bytes, cnt_kind_off)
  if cg_is_word(cnt_kind, "named"):
    return cgj_ident_text(bytes, cgj_member(bytes, ty, "data"))
  end if
  return ""
end function

// The 1-based Wasm slot of the value with the id text `id`; 0 when the IR
// carries no such value or one of the values does not flatten. Parameters come
// first, then the instruction results in IR order, which is the backend's own
// slot assignment.
function cgs_value_slot(bytes: Bytes, run: U64, id: Text) returns U64:
  let cvs_offset = U64.literal(0)
  let cvs_params = cgj_member(bytes, run, "parameters")
  if U64.less_than(U64.literal(0), cvs_params):
    let cvs_pindex = U64.literal(0)
    let cvs_pmore = U64.literal(1)
    while U64.less_than(U64.literal(0), cvs_pmore):
      let cvs_param = cgj_array_item(bytes, cvs_params, cvs_pindex)
      if U64.equal(cvs_param, U64.literal(0)):
        set cvs_pmore = U64.literal(0)
      else:
        let cvs_pid = cgj_value_text(bytes, cgj_member(bytes, cvs_param, "id"))
        if cg_is_word(cvs_pid, id):
          return cgs_add(cvs_offset, U64.literal(1))
        else:
          let cvs_pslots = cgs_type_slots(bytes, cgj_member(bytes, cvs_param, "ty"))
          if U64.equal(cvs_pslots, U64.literal(0)):
            return U64.literal(0)
          end if
          set cvs_offset = cgs_add(cvs_offset, cvs_pslots)
        end if
      end if
      set cvs_pindex = cg_next(cvs_pindex)
    end while
  end if
  let cvs_blocks = cgj_member(bytes, run, "blocks")
  if U64.equal(cvs_blocks, U64.literal(0)):
    return U64.literal(0)
  end if
  let cvs_bindex = U64.literal(0)
  let cvs_bmore = U64.literal(1)
  while U64.less_than(U64.literal(0), cvs_bmore):
    let cvs_block = cgj_array_item(bytes, cvs_blocks, cvs_bindex)
    if U64.equal(cvs_block, U64.literal(0)):
      set cvs_bmore = U64.literal(0)
    else:
      let cvs_instructions = cgj_member(bytes, cvs_block, "instructions")
      let cvs_iindex = U64.literal(0)
      let cvs_imore = U64.literal(1)
      while U64.less_than(U64.literal(0), cvs_imore):
        let cvs_instruction = cgj_array_item(bytes, cvs_instructions, cvs_iindex)
        if U64.equal(cvs_instruction, U64.literal(0)):
          set cvs_imore = U64.literal(0)
        else:
          let cvs_rid = cgj_value_text(bytes, cgj_member(bytes, cvs_instruction, "result"))
          if cg_is_word(cvs_rid, id):
            return cgs_add(cvs_offset, U64.literal(1))
          else:
            let cvs_rslots = cgs_type_slots(bytes, cgj_member(bytes, cvs_instruction, "ty"))
            if U64.equal(cvs_rslots, U64.literal(0)):
              return U64.literal(0)
            end if
            set cvs_offset = cgs_add(cvs_offset, cvs_rslots)
          end if
        end if
        set cvs_iindex = cg_next(cvs_iindex)
      end while
    end if
    set cvs_bindex = cg_next(cvs_bindex)
  end while
  return U64.literal(0)
end function

// The IR offset of the type of the value with the id text `id`; 0 when the IR
// carries no such value.
function cgs_value_ty(bytes: Bytes, run: U64, id: Text) returns U64:
  let cvt_params = cgj_member(bytes, run, "parameters")
  if U64.less_than(U64.literal(0), cvt_params):
    let cvt_pindex = U64.literal(0)
    let cvt_pmore = U64.literal(1)
    while U64.less_than(U64.literal(0), cvt_pmore):
      let cvt_param = cgj_array_item(bytes, cvt_params, cvt_pindex)
      if U64.equal(cvt_param, U64.literal(0)):
        set cvt_pmore = U64.literal(0)
      else:
        let cvt_pid = cgj_value_text(bytes, cgj_member(bytes, cvt_param, "id"))
        if cg_is_word(cvt_pid, id):
          return cgj_member(bytes, cvt_param, "ty")
        end if
      end if
      set cvt_pindex = cg_next(cvt_pindex)
    end while
  end if
  let cvt_blocks = cgj_member(bytes, run, "blocks")
  if U64.equal(cvt_blocks, U64.literal(0)):
    return U64.literal(0)
  end if
  let cvt_bindex = U64.literal(0)
  let cvt_bmore = U64.literal(1)
  while U64.less_than(U64.literal(0), cvt_bmore):
    let cvt_block = cgj_array_item(bytes, cvt_blocks, cvt_bindex)
    if U64.equal(cvt_block, U64.literal(0)):
      set cvt_bmore = U64.literal(0)
    else:
      let cvt_instructions = cgj_member(bytes, cvt_block, "instructions")
      let cvt_iindex = U64.literal(0)
      let cvt_imore = U64.literal(1)
      while U64.less_than(U64.literal(0), cvt_imore):
        let cvt_instruction = cgj_array_item(bytes, cvt_instructions, cvt_iindex)
        if U64.equal(cvt_instruction, U64.literal(0)):
          set cvt_imore = U64.literal(0)
        else:
          let cvt_rid = cgj_value_text(bytes, cgj_member(bytes, cvt_instruction, "result"))
          if cg_is_word(cvt_rid, id):
            return cgj_member(bytes, cvt_instruction, "ty")
          end if
        end if
        set cvt_iindex = cg_next(cvt_iindex)
      end while
    end if
    set cvt_bindex = cg_next(cvt_bindex)
  end while
  return U64.literal(0)
end function

// The total number of Wasm slots the `run` function's values occupy, which is
// where the backend puts the dispatcher slot; 0 when a value does not flatten.
function cgs_dispatcher_slot(bytes: Bytes, run: U64) returns U64:
  let cds_total = U64.literal(0)
  let cds_params = cgj_member(bytes, run, "parameters")
  if U64.less_than(U64.literal(0), cds_params):
    let cds_pindex = U64.literal(0)
    let cds_pmore = U64.literal(1)
    while U64.less_than(U64.literal(0), cds_pmore):
      let cds_param = cgj_array_item(bytes, cds_params, cds_pindex)
      if U64.equal(cds_param, U64.literal(0)):
        set cds_pmore = U64.literal(0)
      else:
        let cds_slots = cgs_type_slots(bytes, cgj_member(bytes, cds_param, "ty"))
        if U64.equal(cds_slots, U64.literal(0)):
          return U64.literal(0)
        end if
        set cds_total = cgs_add(cds_total, cds_slots)
      end if
      set cds_pindex = cg_next(cds_pindex)
    end while
  end if
  let cds_blocks = cgj_member(bytes, run, "blocks")
  if U64.equal(cds_blocks, U64.literal(0)):
    return U64.literal(0)
  end if
  let cds_bindex = U64.literal(0)
  let cds_bmore = U64.literal(1)
  while U64.less_than(U64.literal(0), cds_bmore):
    let cds_block = cgj_array_item(bytes, cds_blocks, cds_bindex)
    if U64.equal(cds_block, U64.literal(0)):
      set cds_bmore = U64.literal(0)
    else:
      let cds_instructions = cgj_member(bytes, cds_block, "instructions")
      let cds_iindex = U64.literal(0)
      let cds_imore = U64.literal(1)
      while U64.less_than(U64.literal(0), cds_imore):
        let cds_instruction = cgj_array_item(bytes, cds_instructions, cds_iindex)
        if U64.equal(cds_instruction, U64.literal(0)):
          set cds_imore = U64.literal(0)
        else:
          let cds_rslots = cgs_type_slots(bytes, cgj_member(bytes, cds_instruction, "ty"))
          if U64.equal(cds_rslots, U64.literal(0)):
            return U64.literal(0)
          end if
          set cds_total = cgs_add(cds_total, cds_rslots)
        end if
        set cds_iindex = cg_next(cds_iindex)
      end while
    end if
    set cds_bindex = cg_next(cds_bindex)
  end while
  return cds_total
end function

// The 1-based slot offset of the field `field` inside the record
// `record_name`'s flat layout; 0 when the record or the field is absent.
function cgs_record_field_offset(bytes: Bytes, record_name: Text, field: Text) returns U64:
  let crfo_records = cgj_member(bytes, U64.literal(0), "records")
  if U64.equal(crfo_records, U64.literal(0)):
    return U64.literal(0)
  end if
  let crfo_fields = cgj_member(bytes, crfo_records, record_name)
  if U64.equal(crfo_fields, U64.literal(0)):
    return U64.literal(0)
  end if
  let crfo_offset = U64.literal(0)
  let crfo_index = U64.literal(0)
  let crfo_more = U64.literal(1)
  while U64.less_than(U64.literal(0), crfo_more):
    let crfo_item = cgj_array_item(bytes, crfo_fields, crfo_index)
    if U64.equal(crfo_item, U64.literal(0)):
      set crfo_more = U64.literal(0)
    else:
      let crfo_name = cgj_ident_text(bytes, cgj_member(bytes, crfo_item, "name"))
      if cg_is_word(crfo_name, field):
        return cgs_add(crfo_offset, U64.literal(1))
      else:
        let crfo_slots = cgs_type_slots(bytes, cgj_member(bytes, crfo_item, "ty"))
        if U64.equal(crfo_slots, U64.literal(0)):
          return U64.literal(0)
        end if
        set crfo_offset = cgs_add(crfo_offset, crfo_slots)
      end if
    end if
    set crfo_index = cg_next(crfo_index)
  end while
  return U64.literal(0)
end function

// The number of flat Wasm slots of the field `field` inside the record
// `record_name`; 0 when the record or the field is absent.
function cgs_record_field_slots(bytes: Bytes, record_name: Text, field: Text) returns U64:
  let crfs_records = cgj_member(bytes, U64.literal(0), "records")
  if U64.equal(crfs_records, U64.literal(0)):
    return U64.literal(0)
  end if
  let crfs_fields = cgj_member(bytes, crfs_records, record_name)
  if U64.equal(crfs_fields, U64.literal(0)):
    return U64.literal(0)
  end if
  let crfs_index = U64.literal(0)
  let crfs_more = U64.literal(1)
  while U64.less_than(U64.literal(0), crfs_more):
    let crfs_item = cgj_array_item(bytes, crfs_fields, crfs_index)
    if U64.equal(crfs_item, U64.literal(0)):
      set crfs_more = U64.literal(0)
    else:
      let crfs_name = cgj_ident_text(bytes, cgj_member(bytes, crfs_item, "name"))
      if cg_is_word(crfs_name, field):
        return cgs_type_slots(bytes, cgj_member(bytes, crfs_item, "ty"))
      end if
    end if
    set crfs_index = cg_next(crfs_index)
  end while
  return U64.literal(0)
end function

// The "i32" or "i64" kind of the flat slot at `index` of the flat layout
// `flat`; "" when the layout has no such slot.
function cgs_flat_slot_kind(flat: Text, index: U64) returns Text:
  let cfsk_bytes = sico.text.encode(flat)
  let cfsk_start = cgs_mul(index, U64.literal(4))
  let cfsk_end = cgs_add(cfsk_start, U64.literal(4))
  if U64.less_than(sico.bytes.length(cfsk_bytes), cfsk_end):
    return ""
  end if
  let cfsk_group = cgj_span_text(cfsk_bytes, cfsk_start, cfsk_end)
  if cg_is_word(cfsk_group, "017f"):
    return "i32"
  end if
  if cg_is_word(cfsk_group, "017e"):
    return "i64"
  end if
  return ""
end function

// The bytes that zero the local slot `slot` of the given flat kind.
function cgs_zero_hex(slot: U64, kind: Text) returns Text:
  if cg_is_word(kind, "i32"):
    return sico.text.concat("4100", cgs_local_set_hex(slot))
  end if
  if cg_is_word(kind, "i64"):
    return sico.text.concat("4200", cgs_local_set_hex(slot))
  end if
  return ""
end function

// The bytes of a `project` instruction: the base's field slots copied into the
// result's slots.
function cgs_project_hex(bytes: Bytes, run: U64, instr: U64, data: U64, result0: U64) returns Text:
  let cph_base = cgj_value_text(bytes, cgj_member(bytes, data, "base"))
  let cph_field = cgj_ident_text(bytes, cgj_member(bytes, data, "field"))
  if U64.equal(sico.text.length(cph_field), U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cph_base_ty = cgs_value_ty(bytes, run, cph_base)
  if U64.equal(cph_base_ty, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cph_record = cgs_named_text(bytes, cph_base_ty)
  if U64.equal(sico.text.length(cph_record), U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cph_base_slot = cgs_value_slot(bytes, run, cph_base)
  if U64.equal(cph_base_slot, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cph_offset = cgs_record_field_offset(bytes, cph_record, cph_field)
  if U64.equal(cph_offset, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cph_count = cgs_record_field_slots(bytes, cph_record, cph_field)
  if U64.equal(cph_count, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cph_result_slots = cgs_type_slots(bytes, cgj_member(bytes, instr, "ty"))
  if U64.equal(cph_result_slots, cph_count):
    let cph_out = ""
    let cph_base0 = cgs_sub(cph_base_slot, U64.literal(1))
    let cph_offset0 = cgs_sub(cph_offset, U64.literal(1))
    let cph_index = U64.literal(0)
    while U64.less_than(cph_index, cph_count):
      let cph_src_base = cgs_add(cph_base0, cph_offset0)
      let cph_src = cgs_add(cph_src_base, cph_index)
      let cph_dst = cgs_add(result0, cph_index)
      set cph_out = sico.text.concat(cph_out, cgs_local_get_hex(cph_src))
      set cph_out = sico.text.concat(cph_out, cgs_local_set_hex(cph_dst))
      set cph_index = cg_next(cph_index)
    end while
    return cph_out
  end if
  return "ERR:E-SH-CG-IR-EMIT"
end function

// The bytes of a `construct` instruction: the field values copied, in the op's
// field order, into the result's slots.
function cgs_construct_hex(bytes: Bytes, run: U64, instr: U64, data: U64, result0: U64) returns Text:
  let cch_fields = cgj_member(bytes, data, "fields")
  if U64.equal(cch_fields, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cch_out = ""
  let cch_offset = U64.literal(0)
  let cch_index = U64.literal(0)
  let cch_more = U64.literal(1)
  while U64.less_than(U64.literal(0), cch_more):
    let cch_item = cgj_array_item(bytes, cch_fields, cch_index)
    if U64.equal(cch_item, U64.literal(0)):
      set cch_more = U64.literal(0)
    else:
      let cch_value = cgj_value_text(bytes, cgj_member(bytes, cch_item, "value"))
      let cch_src = cgs_value_slot(bytes, run, cch_value)
      let cch_ty = cgs_value_ty(bytes, run, cch_value)
      if U64.equal(cch_src, U64.literal(0)):
        return "ERR:E-SH-CG-IR-EMIT"
      end if
      if U64.equal(cch_ty, U64.literal(0)):
        return "ERR:E-SH-CG-IR-EMIT"
      end if
      let cch_count = cgs_type_slots(bytes, cch_ty)
      if U64.equal(cch_count, U64.literal(0)):
        return "ERR:E-SH-CG-IR-EMIT"
      end if
      let cch_src0 = cgs_sub(cch_src, U64.literal(1))
      let cch_i = U64.literal(0)
      while U64.less_than(cch_i, cch_count):
        let cch_from = cgs_add(cch_src0, cch_i)
        let cch_to_base = cgs_add(result0, cch_offset)
        let cch_to = cgs_add(cch_to_base, cch_i)
        set cch_out = sico.text.concat(cch_out, cgs_local_get_hex(cch_from))
        set cch_out = sico.text.concat(cch_out, cgs_local_set_hex(cch_to))
        set cch_i = cg_next(cch_i)
      end while
      set cch_offset = cgs_add(cch_offset, cch_count)
    end if
    set cch_index = cg_next(cch_index)
  end while
  let cch_result_slots = cgs_type_slots(bytes, cgj_member(bytes, instr, "ty"))
  if U64.equal(cch_result_slots, cch_offset):
    return cch_out
  end if
  return "ERR:E-SH-CG-IR-EMIT"
end function

// The bytes of a `variant` instruction: the discriminant, the payload copied
// into the active arm's slots and the inactive arm zeroed.
function cgs_variant_hex(bytes: Bytes, run: U64, instr: U64, data: U64, result0: U64) returns Text:
  let cvh_name = cgj_ident_text(bytes, cgj_member(bytes, data, "name"))
  let cvh_payload = cgj_member(bytes, data, "payload")
  if U64.equal(sico.text.length(cvh_name), U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  if U64.equal(cvh_payload, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cvh_known = U64.literal(0)
  let cvh_tag = U64.literal(0)
  if cg_is_word(cvh_name, "ok"):
    set cvh_known = U64.literal(1)
    set cvh_tag = U64.literal(0)
  else:
    if cg_is_word(cvh_name, "error"):
      set cvh_known = U64.literal(1)
      set cvh_tag = U64.literal(1)
    end if
  end if
  if U64.equal(cvh_known, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cvh_result_ty = cgj_member(bytes, instr, "ty")
  let cvh_result_data = cgj_member(bytes, cvh_result_ty, "data")
  let cvh_ok_flat = cgs_flat_hex(bytes, cgj_member(bytes, cvh_result_data, "ok"))
  let cvh_error_flat = cgs_flat_hex(bytes, cgj_member(bytes, cvh_result_data, "error"))
  if U64.equal(sico.text.length(cvh_ok_flat), U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  if U64.equal(sico.text.length(cvh_error_flat), U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cvh_ok_slots = U64.shr(sico.text.length(cvh_ok_flat), U64.literal(2))
  let cvh_error_slots = U64.shr(sico.text.length(cvh_error_flat), U64.literal(2))
  let cvh_dest_len = cgs_add(cvh_ok_slots, cvh_error_slots)
  let cvh_result_slots = cgs_type_slots(bytes, cvh_result_ty)
  let cvh_expected = cgs_add(cvh_dest_len, U64.literal(1))
  let cvh_mismatch = U64.literal(1)
  if U64.equal(cvh_result_slots, cvh_expected):
    set cvh_mismatch = U64.literal(0)
  end if
  if U64.equal(cvh_mismatch, U64.literal(1)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cvh_payload_len = U64.literal(0)
  let cvhl_index = U64.literal(0)
  let cvhl_more = U64.literal(1)
  while U64.less_than(U64.literal(0), cvhl_more):
    let cvhl_item = cgj_array_item(bytes, cvh_payload, cvhl_index)
    if U64.equal(cvhl_item, U64.literal(0)):
      set cvhl_more = U64.literal(0)
    else:
      let cvhl_value = cgj_value_text(bytes, cvhl_item)
      let cvhl_ty = cgs_value_ty(bytes, run, cvhl_value)
      if U64.equal(cvhl_ty, U64.literal(0)):
        return "ERR:E-SH-CG-IR-EMIT"
      end if
      let cvhl_count = cgs_type_slots(bytes, cvhl_ty)
      if U64.equal(cvhl_count, U64.literal(0)):
        return "ERR:E-SH-CG-IR-EMIT"
      end if
      set cvh_payload_len = cgs_add(cvh_payload_len, cvhl_count)
    end if
    set cvhl_index = cg_next(cvhl_index)
  end while
  let cvh_dest = cgs_add(result0, U64.literal(1))
  let cvh_start = U64.literal(0)
  if cg_is_word(cvh_name, "error"):
    if U64.less_than(cvh_payload_len, cvh_dest_len):
      set cvh_start = cgs_sub(cvh_dest_len, cvh_payload_len)
    end if
  end if
  let cvh_out = sico.text.concat(cgs_i32_const_hex(cvh_tag), cgs_local_set_hex(result0))
  let cvh_zero = U64.literal(0)
  while U64.less_than(cvh_zero, cvh_start):
    let cvh_kind = cgs_flat_slot_kind(cvh_ok_flat, cvh_zero)
    if cg_is_word(cvh_kind, ""):
      set cvh_kind = cgs_flat_slot_kind(cvh_error_flat, cgs_sub(cvh_zero, cvh_ok_slots))
    end if
    let cvh_zero_hex = cgs_zero_hex(cgs_add(cvh_dest, cvh_zero), cvh_kind)
    if U64.equal(sico.text.length(cvh_zero_hex), U64.literal(0)):
      return "ERR:E-SH-CG-IR-EMIT"
    end if
    set cvh_out = sico.text.concat(cvh_out, cvh_zero_hex)
    set cvh_zero = cg_next(cvh_zero)
  end while
  let cvh_offset = cvh_start
  let cvh_pindex = U64.literal(0)
  let cvh_pmore = U64.literal(1)
  while U64.less_than(U64.literal(0), cvh_pmore):
    let cvh_item = cgj_array_item(bytes, cvh_payload, cvh_pindex)
    if U64.equal(cvh_item, U64.literal(0)):
      set cvh_pmore = U64.literal(0)
    else:
      let cvh_value = cgj_value_text(bytes, cvh_item)
      let cvh_src = cgs_value_slot(bytes, run, cvh_value)
      let cvh_ty = cgs_value_ty(bytes, run, cvh_value)
      if U64.equal(cvh_src, U64.literal(0)):
        return "ERR:E-SH-CG-IR-EMIT"
      end if
      if U64.equal(cvh_ty, U64.literal(0)):
        return "ERR:E-SH-CG-IR-EMIT"
      end if
      let cvh_count = cgs_type_slots(bytes, cvh_ty)
      let cvh_src0 = cgs_sub(cvh_src, U64.literal(1))
      let cvh_i = U64.literal(0)
      while U64.less_than(cvh_i, cvh_count):
        let cvh_from = cgs_add(cvh_src0, cvh_i)
        let cvh_to_base = cgs_add(cvh_dest, cvh_offset)
        let cvh_to = cgs_add(cvh_to_base, cvh_i)
        set cvh_out = sico.text.concat(cvh_out, cgs_local_get_hex(cvh_from))
        set cvh_out = sico.text.concat(cvh_out, cgs_local_set_hex(cvh_to))
        set cvh_i = cg_next(cvh_i)
      end while
      set cvh_offset = cgs_add(cvh_offset, cvh_count)
    end if
    set cvh_pindex = cg_next(cvh_pindex)
  end while
  while U64.less_than(cvh_offset, cvh_dest_len):
    let cvh_kind2 = cgs_flat_slot_kind(cvh_ok_flat, cvh_offset)
    if cg_is_word(cvh_kind2, ""):
      set cvh_kind2 = cgs_flat_slot_kind(cvh_error_flat, cgs_sub(cvh_offset, cvh_ok_slots))
    end if
    let cvh_tail_hex = cgs_zero_hex(cgs_add(cvh_dest, cvh_offset), cvh_kind2)
    if U64.equal(sico.text.length(cvh_tail_hex), U64.literal(0)):
      return "ERR:E-SH-CG-IR-EMIT"
    end if
    set cvh_out = sico.text.concat(cvh_out, cvh_tail_hex)
    set cvh_offset = cg_next(cvh_offset)
  end while
  return cvh_out
end function

// The bytes of a `const_i64` or `const_u64` instruction.
function cgs_const_hex(bytes: Bytes, data: U64, result0: U64) returns Text:
  let cch_text = cgj_value_text(bytes, data)
  if cgs_decimal_bad(cch_text):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let cch_value = cgs_decimal_u64(cch_text)
  return sico.text.concat(cgs_i64_const_hex(cch_value), cgs_local_set_hex(result0))
end function

// The instruction bytes of the IR instruction at `instr`; an `ERR:` identity
// when the operation is outside the supported subset.
function cgs_op_hex(bytes: Bytes, run: U64, instr: U64) returns Text:
  let coph_operation = cgj_member(bytes, instr, "operation")
  if U64.equal(coph_operation, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let coph_kind = cgj_member(bytes, coph_operation, "op")
  let coph_data = cgj_member(bytes, coph_operation, "data")
  if U64.equal(coph_kind, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  if U64.equal(coph_data, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let coph_name = cgj_ident_text(bytes, coph_kind)
  let coph_result = cgj_value_text(bytes, cgj_member(bytes, instr, "result"))
  let coph_result_slot = cgs_value_slot(bytes, run, coph_result)
  if U64.equal(coph_result_slot, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let coph_result0 = cgs_sub(coph_result_slot, U64.literal(1))
  if cg_is_word(coph_name, "project"):
    return cgs_project_hex(bytes, run, instr, coph_data, coph_result0)
  end if
  if cg_is_word(coph_name, "construct"):
    return cgs_construct_hex(bytes, run, instr, coph_data, coph_result0)
  end if
  if cg_is_word(coph_name, "variant"):
    return cgs_variant_hex(bytes, run, instr, coph_data, coph_result0)
  end if
  if cg_is_word(coph_name, "const_i64"):
    return cgs_const_hex(bytes, coph_data, coph_result0)
  end if
  if cg_is_word(coph_name, "const_u64"):
    return cgs_const_hex(bytes, coph_data, coph_result0)
  end if
  return "ERR:E-SH-CG-IR-EMIT"
end function

// The instruction segment of the Script-profile `run` body: the dispatcher
// shell, the per-block dispatch heads and the block instructions, up to (but
// not including) the Script result-area return.
function cgs_run_instr_hex(bytes: Bytes) returns Text:
  let crih_run = cgs_run_function(bytes)
  if U64.equal(crih_run, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let crih_blocks = cgj_member(bytes, crih_run, "blocks")
  if U64.equal(crih_blocks, U64.literal(0)):
    return "ERR:E-SH-CG-IR-PLAN"
  end if
  let crih_entry_text = cgj_value_text(bytes, cgj_member(bytes, crih_run, "entry"))
  if cgs_decimal_bad(crih_entry_text):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let crih_entry = cgs_decimal_u64(crih_entry_text)
  let crih_dispatcher = cgs_dispatcher_slot(bytes, crih_run)
  if U64.equal(crih_dispatcher, U64.literal(0)):
    return "ERR:E-SH-CG-IR-EMIT"
  end if
  let crih_out = sico.text.concat(cgs_i32_const_hex(crih_entry), cgs_local_set_hex(crih_dispatcher))
  set crih_out = sico.text.concat(crih_out, "02400340")
  let crih_bindex = U64.literal(0)
  let crih_bmore = U64.literal(1)
  while U64.less_than(U64.literal(0), crih_bmore):
    let crih_block = cgj_array_item(bytes, crih_blocks, crih_bindex)
    if U64.equal(crih_block, U64.literal(0)):
      set crih_bmore = U64.literal(0)
    else:
      let crih_block_text = cgj_value_text(bytes, cgj_member(bytes, crih_block, "id"))
      if cgs_decimal_bad(crih_block_text):
        return "ERR:E-SH-CG-IR-EMIT"
      end if
      let crih_block_id = cgs_decimal_u64(crih_block_text)
      set crih_out = sico.text.concat(crih_out, cgs_local_get_hex(crih_dispatcher))
      set crih_out = sico.text.concat(crih_out, cgs_i32_const_hex(crih_block_id))
      set crih_out = sico.text.concat(crih_out, "460440")
      let crih_instructions = cgj_member(bytes, crih_block, "instructions")
      if U64.equal(crih_instructions, U64.literal(0)):
        return "ERR:E-SH-CG-IR-PLAN"
      end if
      let crih_iindex = U64.literal(0)
      let crih_imore = U64.literal(1)
      while U64.less_than(U64.literal(0), crih_imore):
        let crih_instruction = cgj_array_item(bytes, crih_instructions, crih_iindex)
        if U64.equal(crih_instruction, U64.literal(0)):
          set crih_imore = U64.literal(0)
        else:
          let crih_op = cgs_op_hex(bytes, crih_run, crih_instruction)
          if sico.text.starts_with(crih_op, "ERR:"):
            return crih_op
          end if
          set crih_out = sico.text.concat(crih_out, crih_op)
        end if
        set crih_iindex = cg_next(crih_iindex)
      end while
    end if
    set crih_bindex = cg_next(crih_bindex)
  end while
  return crih_out
end function
