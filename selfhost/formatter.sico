record ScriptInput:
  field arguments: List[Text]
  field stdin: Bytes
end record

record ScriptOutput:
  field stdout: Bytes
  field stderr: Bytes
  field exit_code: I64
end record

enum ScriptErrorCode:
  case InvalidInput
  case ResourceLimit
  case DomainError
  case Cancelled
end enum

record ScriptError:
  field code: ScriptErrorCode
  field message: Text
end record

function add(left: U64, right: U64) returns U64:
  match U64.checked_add(left, right):
    case ok(value):
      return value
    case error(_):
      return left
  end match
end function

function sub(left: U64, right: U64) returns U64:
  match U64.checked_sub(left, right):
    case ok(value):
      return value
    case error(_):
      return U64.literal(0)
  end match
end function

function same(left: Text, right: Text) returns Bool:
  return sico.bytes.equal(sico.text.encode(left), sico.text.encode(right))
end function

function ascii_letter(b: I64) returns Bool:
  if I64.less_than(b, I64.literal(65)):
    return false
  end if
  if I64.less_than(b, I64.literal(91)):
    return true
  end if
  if I64.less_than(b, I64.literal(97)):
    return false
  end if
  return I64.less_than(b, I64.literal(123))
end function

function ident_start(b: I64) returns Bool:
  if I64.equal(b, I64.literal(95)):
    return true
  end if
  return ascii_letter(b)
end function

function ident_continue(b: I64) returns Bool:
  if ident_start(b):
    return true
  end if
  if I64.less_than(b, I64.literal(48)):
    return false
  end if
  return I64.less_than(b, I64.literal(58))
end function

function word_kind(word: Text) returns Text:
  if same(word, "_"):
    return "Underscore"
  end if
  if same(word, "true"):
    return "True"
  end if
  if same(word, "false"):
    return "False"
  end if
  if same(word, "async"):
    return "Async"
  end if
  if same(word, "await"):
    return "Await"
  end if
  if same(word, "borrow"):
    return "Borrow"
  end if
  if same(word, "break"):
    return "Break"
  end if
  if same(word, "call"):
    return "Call"
  end if
  if same(word, "continue"):
    return "Continue"
  end if
  if same(word, "capabilities"):
    return "Capabilities"
  end if
  if same(word, "capability"):
    return "Capability"
  end if
  if same(word, "case"):
    return "Case"
  end if
  if same(word, "effects"):
    return "Effects"
  end if
  if same(word, "else"):
    return "Else"
  end if
  if same(word, "end"):
    return "End"
  end if
  if same(word, "enum"):
    return "Enum"
  end if
  if same(word, "error"):
    return "ErrorKeyword"
  end if
  if same(word, "export"):
    return "Export"
  end if
  if same(word, "from"):
    return "From"
  end if
  if same(word, "function"):
    return "Function"
  end if
  if same(word, "group"):
    return "Group"
  end if
  if same(word, "if"):
    return "If"
  end if
  if same(word, "ignore"):
    return "Ignore"
  end if
  if same(word, "interface"):
    return "Interface"
  end if
  if same(word, "invariant"):
    return "Invariant"
  end if
  if same(word, "let"):
    return "Let"
  end if
  if same(word, "match"):
    return "Match"
  end if
  if same(word, "move"):
    return "Move"
  end if
  if same(word, "newtype"):
    return "Newtype"
  end if
  if same(word, "none"):
    return "None"
  end if
  if same(word, "ok"):
    return "OkKeyword"
  end if
  if same(word, "record"):
    return "Record"
  end if
  if same(word, "resource"):
    return "Resource"
  end if
  if same(word, "return"):
    return "Return"
  end if
  if same(word, "returns"):
    return "Returns"
  end if
  if same(word, "self"):
    return "SelfKeyword"
  end if
  if same(word, "set"):
    return "Set"
  end if
  if same(word, "while"):
    return "While"
  end if
  if same(word, "module"):
    return "Module"
  end if
  if same(word, "use"):
    return "Use"
  end if
  if same(word, "for"):
    return "For"
  end if
  if same(word, "in"):
    return "In"
  end if
  if same(word, "spawn"):
    return "Spawn"
  end if
  if same(word, "task"):
    return "Task"
  end if
  if same(word, "try"):
    return "Try"
  end if
  if same(word, "using"):
    return "Using"
  end if
  return "Identifier"
end function

function scan_space(src: Bytes, start: U64, size: U64) returns U64:
  let cursor = start
  while U64.less_than(cursor, size):
    let b = sico.bytes.at(src, cursor, I64.literal(-1))
    if I64.equal(b, I64.literal(32)):
      set cursor = add(cursor, U64.literal(1))
    else:
      if I64.equal(b, I64.literal(9)):
        set cursor = add(cursor, U64.literal(1))
      else:
        return cursor
      end if
    end if
  end while
  return cursor
end function

function scan_ident(src: Bytes, start: U64, size: U64) returns U64:
  let cursor = start
  while U64.less_than(cursor, size):
    if ident_continue(sico.bytes.at(src, cursor, I64.literal(-1))):
      set cursor = add(cursor, U64.literal(1))
    else:
      return cursor
    end if
  end while
  return cursor
end function

function scan_integer(src: Bytes, start: U64, size: U64) returns U64:
  let cursor = start
  while U64.less_than(cursor, size):
    let b = sico.bytes.at(src, cursor, I64.literal(-1))
    if I64.less_than(b, I64.literal(48)):
      return cursor
    end if
    if I64.less_than(b, I64.literal(58)):
      set cursor = add(cursor, U64.literal(1))
    else:
      return cursor
    end if
  end while
  return cursor
end function

function scan_comment(src: Bytes, start: U64, size: U64) returns U64:
  let cursor = add(start, U64.literal(2))
  while U64.less_than(cursor, size):
    let b = sico.bytes.at(src, cursor, I64.literal(-1))
    if I64.equal(b, I64.literal(10)):
      return cursor
    end if
    if I64.equal(b, I64.literal(13)):
      return cursor
    end if
    set cursor = add(cursor, U64.literal(1))
  end while
  return cursor
end function

function scan_string(src: Bytes, start: U64, size: U64) returns U64:
  let cursor = add(start, U64.literal(1))
  let escaped = I64.literal(0)
  while U64.less_than(cursor, size):
    let b = sico.bytes.at(src, cursor, I64.literal(-1))
    if I64.equal(escaped, I64.literal(1)):
      set escaped = I64.literal(0)
      set cursor = add(cursor, U64.literal(1))
    else:
      if I64.equal(b, I64.literal(92)):
        set escaped = I64.literal(1)
        set cursor = add(cursor, U64.literal(1))
      else:
        if I64.equal(b, I64.literal(34)):
          return add(cursor, U64.literal(1))
        end if
        if I64.equal(b, I64.literal(10)):
          return cursor
        end if
        if I64.equal(b, I64.literal(13)):
          return cursor
        end if
        set cursor = add(cursor, U64.literal(1))
      end if
    end if
  end while
  return cursor
end function

function punctuation_kind(b: I64) returns Text:
  if I64.equal(b, I64.literal(40)):
    return "LeftParen"
  end if
  if I64.equal(b, I64.literal(41)):
    return "RightParen"
  end if
  if I64.equal(b, I64.literal(91)):
    return "LeftBracket"
  end if
  if I64.equal(b, I64.literal(93)):
    return "RightBracket"
  end if
  if I64.equal(b, I64.literal(58)):
    return "Colon"
  end if
  if I64.equal(b, I64.literal(44)):
    return "Comma"
  end if
  if I64.equal(b, I64.literal(46)):
    return "Dot"
  end if
  if I64.equal(b, I64.literal(64)):
    return "At"
  end if
  if I64.equal(b, I64.literal(43)):
    return "Plus"
  end if
  if I64.equal(b, I64.literal(45)):
    return "Minus"
  end if
  if I64.equal(b, I64.literal(61)):
    return "Equal"
  end if
  if I64.equal(b, I64.literal(63)):
    return "QuestionMark"
  end if
  return "Error"
end function

function item(items: List[Text], index: U64) returns Text:
  match sico.list.get(items, index):
    case ok(value):
      return value
    case error(_):
      return ""
  end match
end function

function append_pair(out: List[Text], kind: Text, raw: Text) returns List[Text]:
  return sico.list.append(sico.list.append(out, kind), raw)
end function

function line_tokens(line: Text) returns List[Text]:
  let src = sico.text.encode(line)
  let size = sico.bytes.length(src)
  let cursor = U64.literal(0)
  let out = sico.text.split_lines("")
  while U64.less_than(cursor, size):
    let start = cursor
    let finish = add(cursor, U64.literal(1))
    let kind = "Error"
    let emit = I64.literal(1)
    let b = sico.bytes.at(src, cursor, I64.literal(-1))
    let next = sico.bytes.at(src, finish, I64.literal(-1))
    if I64.equal(b, I64.literal(32)):
      set finish = scan_space(src, cursor, size)
      set emit = I64.literal(0)
    else:
      if I64.equal(b, I64.literal(9)):
        set finish = scan_space(src, cursor, size)
        set emit = I64.literal(0)
      else:
        if I64.equal(b, I64.literal(47)):
          if I64.equal(next, I64.literal(47)):
            set finish = size
            set kind = "LineComment"
          end if
        else:
          if ident_start(b):
            set finish = scan_ident(src, cursor, size)
            match sico.bytes.slice(src, cursor, sub(finish, cursor)):
              case ok(word_bytes):
                set kind = word_kind(sico.bytes.utf8_decode(word_bytes))
              case error(_):
                set kind = "Error"
            end match
          else:
            if I64.less_than(b, I64.literal(48)):
              set kind = kind
            else:
              if I64.less_than(b, I64.literal(58)):
                set kind = "Integer"
                set finish = scan_integer(src, cursor, size)
              end if
            end if
            if same(kind, "Integer"):
              set kind = kind
            else:
              if I64.equal(b, I64.literal(34)):
                set kind = "String"
                set finish = scan_string(src, cursor, size)
              else:
                if I64.equal(b, I64.literal(61)):
                  if I64.equal(next, I64.literal(61)):
                    set kind = "EqualEqual"
                    set finish = add(cursor, U64.literal(2))
                  else:
                    set kind = "Equal"
                  end if
                else:
                  if I64.equal(b, I64.literal(60)):
                    if I64.equal(next, I64.literal(61)):
                      set kind = "LessEqual"
                      set finish = add(cursor, U64.literal(2))
                    end if
                  else:
                    set kind = punctuation_kind(b)
                  end if
                end if
              end if
            end if
          end if
        end if
      end if
    end if
    if I64.equal(emit, I64.literal(1)):
      match sico.bytes.slice(src, start, sub(finish, start)):
        case ok(raw_bytes):
          set out = append_pair(out, kind, sico.bytes.utf8_decode(raw_bytes))
        case error(_):
          set out = out
      end match
    end if
    set cursor = finish
  end while
  return out
end function

function source_has_lex_error(src: Text) returns Bool:
  let lines = sico.text.split_lines(src)
  let line_index = U64.literal(0)
  let line_count = sico.list.length(lines)
  while U64.less_than(line_index, line_count):
    let tokens = line_tokens(item(lines, line_index))
    let token_index = U64.literal(0)
    let token_count = sico.list.length(tokens)
    while U64.less_than(token_index, token_count):
      if same(item(tokens, token_index), "Error"):
        return true
      end if
      set token_index = add(token_index, U64.literal(2))
    end while
    set line_index = add(line_index, U64.literal(1))
  end while
  return false
end function

function no_space_before(kind: Text) returns Bool:
  if same(kind, "RightParen"):
    return true
  end if
  if same(kind, "RightBracket"):
    return true
  end if
  if same(kind, "Comma"):
    return true
  end if
  if same(kind, "Dot"):
    return true
  end if
  if same(kind, "Colon"):
    return true
  end if
  return same(kind, "At")
end function

function no_space_after(kind: Text) returns Bool:
  if same(kind, "LeftParen"):
    return true
  end if
  if same(kind, "LeftBracket"):
    return true
  end if
  if same(kind, "Dot"):
    return true
  end if
  return same(kind, "At")
end function

function call_left(previous: Text, current: Text) returns Bool:
  let left = false
  if same(current, "LeftParen"):
    set left = true
  end if
  if same(current, "LeftBracket"):
    set left = true
  end if
  if left:
    if same(previous, "Identifier"):
      return true
    end if
    if same(previous, "OkKeyword"):
      return true
    end if
    if same(previous, "ErrorKeyword"):
      return true
    end if
    if same(previous, "RightParen"):
      return true
    end if
    return same(previous, "RightBracket")
  end if
  return false
end function

function format_code(tokens: List[Text], code_end: U64) returns Text:
  let cursor = U64.literal(0)
  let previous = ""
  let output = ""
  while U64.less_than(cursor, code_end):
    let kind = item(tokens, cursor)
    let raw = item(tokens, add(cursor, U64.literal(1)))
    if U64.equal(cursor, U64.literal(0)):
      set output = raw
    else:
      if no_space_before(kind):
        set output = sico.text.concat(output, raw)
      else:
        if no_space_after(previous):
          set output = sico.text.concat(output, raw)
        else:
          if call_left(previous, kind):
            set output = sico.text.concat(output, raw)
          else:
            set output = sico.text.concat(sico.text.concat(output, " "), raw)
          end if
        end if
      end if
    end if
    set previous = kind
    set cursor = add(cursor, U64.literal(2))
  end while
  return output
end function

function repeat_indent(level: U64) returns Text:
  let cursor = U64.literal(0)
  let output = ""
  while U64.less_than(cursor, level):
    set output = sico.text.concat(output, "  ")
    set cursor = add(cursor, U64.literal(1))
  end while
  return output
end function

function nearest_match(blocks: Map[Text,U64], depth: U64) returns Text:
  let cursor = depth
  while U64.less_than(U64.literal(0), cursor):
    set cursor = sub(cursor, U64.literal(1))
    let key = sico.u64.to_text(cursor)
    match sico.map.get[Text,U64](blocks, key):
      case ok(close):
        if U64.equal(close, U64.literal(6)):
          return sico.text.concat(":", key)
        end if
      case error(_):
        set cursor = cursor
    end match
  end while
  return ""
end function

function set_nearest_match(active: Map[Text,U64], blocks: Map[Text,U64], depth: U64, value: U64) returns Map[Text,U64]:
  let found = nearest_match(blocks, depth)
  if U64.less_than(U64.literal(0), sico.text.length(found)):
    let found_bytes = sico.text.encode(found)
    match sico.bytes.slice(found_bytes, U64.literal(1), sub(sico.bytes.length(found_bytes), U64.literal(1))):
      case ok(key_bytes):
        return sico.map.put[Text,U64](active, sico.bytes.utf8_decode(key_bytes), value)
      case error(_):
        return active
    end match
  end if
  return active
end function

function match_arm_levels(active: Map[Text,U64], depth: U64) returns U64:
  let cursor = U64.literal(0)
  let count = U64.literal(0)
  while U64.less_than(cursor, depth):
    match sico.map.get[Text,U64](active, sico.u64.to_text(cursor)):
      case ok(value):
        set count = add(count, value)
      case error(_):
        set count = count
    end match
    set cursor = add(cursor, U64.literal(1))
  end while
  return count
end function

function close_code(kind: Text) returns U64:
  if same(kind, "Record"):
    return U64.literal(1)
  end if
  if same(kind, "Enum"):
    return U64.literal(2)
  end if
  if same(kind, "Capability"):
    return U64.literal(3)
  end if
  if same(kind, "Resource"):
    return U64.literal(4)
  end if
  if same(kind, "Interface"):
    return U64.literal(5)
  end if
  if same(kind, "Match"):
    return U64.literal(6)
  end if
  if same(kind, "If"):
    return U64.literal(7)
  end if
  if same(kind, "Using"):
    return U64.literal(8)
  end if
  if same(kind, "Task"):
    return U64.literal(9)
  end if
  if same(kind, "Function"):
    return U64.literal(10)
  end if
  return U64.literal(0)
end function

function direct_close(first: Text) returns U64:
  if same(first, "Record"):
    return U64.literal(1)
  end if
  if same(first, "Enum"):
    return U64.literal(2)
  end if
  if same(first, "Capability"):
    return U64.literal(3)
  end if
  if same(first, "Resource"):
    return U64.literal(4)
  end if
  if same(first, "Interface"):
    return U64.literal(5)
  end if
  if same(first, "Match"):
    return U64.literal(6)
  end if
  if same(first, "If"):
    return U64.literal(7)
  end if
  if same(first, "Using"):
    return U64.literal(8)
  end if
  if same(first, "Task"):
    return U64.literal(9)
  end if
  return U64.literal(0)
end function

function opener_close(tokens: List[Text], code_end: U64) returns U64:
  if U64.less_than(code_end, U64.literal(2)):
    return U64.literal(0)
  end if
  if same(item(tokens, sub(code_end, U64.literal(2))), "Colon"):
    let close = direct_close(item(tokens, U64.literal(0)))
    if U64.less_than(U64.literal(0), close):
      return close
    end if
    let cursor = U64.literal(0)
    while U64.less_than(cursor, code_end):
      if same(item(tokens, cursor), "Function"):
        return U64.literal(10)
      end if
      set cursor = add(cursor, U64.literal(2))
    end while
  end if
  return U64.literal(0)
end function

function normalize_source(src: Text) returns Text:
  let lines = sico.text.split_lines(src)
  let line_count = sico.list.length(lines)
  let output = sico.text.split_lines("")
  let emitted = U64.literal(0)
  let pending_blank = U64.literal(0)
  let blocks = sico.map.empty[Text,U64]()
  let active = sico.map.empty[Text,U64]()
  let depth = U64.literal(0)
  let section_active = U64.literal(0)
  let line_index = U64.literal(0)
  while U64.less_than(line_index, line_count):
    let tokens = line_tokens(item(lines, line_index))
    let token_length = sico.list.length(tokens)
    if U64.equal(token_length, U64.literal(0)):
      if U64.less_than(U64.literal(0), emitted):
        set pending_blank = U64.literal(1)
      end if
    else:
      let comment_index = token_length
      let cursor = U64.literal(0)
      while U64.less_than(cursor, token_length):
        if same(item(tokens, cursor), "LineComment"):
          set comment_index = cursor
          set cursor = token_length
        else:
          set cursor = add(cursor, U64.literal(2))
        end if
      end while
      let code_end = comment_index
      let first = ""
      if U64.less_than(U64.literal(0), code_end):
        set first = item(tokens, U64.literal(0))
      end if
      if same(first, "End"):
        let close = ""
        if U64.less_than(U64.literal(2), code_end):
          set close = item(tokens, U64.literal(2))
        end if
        if U64.less_than(U64.literal(0), depth):
          let top = sub(depth, U64.literal(1))
          match sico.map.get[Text,U64](blocks, sico.u64.to_text(top)):
            case ok(expected_close):
              if U64.equal(close_code(close), expected_close):
                set depth = top
              end if
            case error(_):
              set depth = depth
          end match
        end if
        set section_active = U64.literal(0)
      end if
      if same(first, "Case"):
        set active = set_nearest_match(active, blocks, depth, U64.literal(0))
      end if
      let list_item = U64.literal(0)
      if U64.equal(section_active, U64.literal(1)):
        if same(first, "Identifier"):
          set list_item = U64.literal(1)
        end if
      end if
      if same(first, "Effects"):
        set section_active = U64.literal(0)
      else:
        if same(first, "Capabilities"):
          set section_active = U64.literal(0)
        else:
          if U64.less_than(U64.literal(0), code_end):
            if U64.equal(list_item, U64.literal(0)):
              set section_active = U64.literal(0)
            end if
          end if
        end if
      end if
      let indent_level = add(add(depth, match_arm_levels(active, depth)), list_item)
      let rendered = sico.text.concat(repeat_indent(indent_level), format_code(tokens, code_end))
      if U64.less_than(comment_index, token_length):
        if U64.less_than(U64.literal(0), code_end):
          set rendered = sico.text.concat(rendered, "  ")
        end if
        set rendered = sico.text.concat(rendered, sico.text.trim(item(tokens, add(comment_index, U64.literal(1)))))
      end if
      if U64.equal(pending_blank, U64.literal(1)):
        set output = sico.list.append(output, "")
        set pending_blank = U64.literal(0)
      end if
      set output = sico.list.append(output, rendered)
      set emitted = add(emitted, U64.literal(1))
      if same(first, "Case"):
        if U64.less_than(U64.literal(0), code_end):
          if same(item(tokens, sub(code_end, U64.literal(2))), "Colon"):
            set active = set_nearest_match(active, blocks, depth, U64.literal(1))
          end if
        end if
      end if
      if same(first, "Effects"):
        if U64.equal(code_end, U64.literal(4)):
          if same(item(tokens, U64.literal(2)), "Colon"):
            set section_active = U64.literal(1)
          end if
        end if
      else:
        if same(first, "Capabilities"):
          if U64.equal(code_end, U64.literal(4)):
            if same(item(tokens, U64.literal(2)), "Colon"):
              set section_active = U64.literal(1)
            end if
          end if
        end if
      end if
      let opener = opener_close(tokens, code_end)
      if U64.less_than(U64.literal(0), opener):
        let block_key = sico.u64.to_text(depth)
        set blocks = sico.map.put[Text,U64](blocks, block_key, opener)
        set active = sico.map.put[Text,U64](active, block_key, U64.literal(0))
        set depth = add(depth, U64.literal(1))
      end if
    end if
    set line_index = add(line_index, U64.literal(1))
  end while
  return sico.text.concat(sico.text.join(output, "\n"), "\n")
end function

function main(input: ScriptInput) returns Result[ScriptOutput, ScriptError]:
  if sico.bytes.is_utf8(input.stdin):
    let source = sico.bytes.utf8_decode(input.stdin)
    if source_has_lex_error(source):
      return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: "LEXICAL"))
    end if
    let normalized = normalize_source(source)
    return ok(ScriptOutput(stdout: sico.text.encode(normalized), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
  end if
  return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: "source is not UTF-8"))
end function
