module compiler_lexer

function add(left: U64, right: U64) returns U64:
  match U64.checked_add(left, right):
    case ok(value):
      return value
    case error(_):
      return left
  end match
end function

function sub(left: U64, right: U64) returns U64:
  match U64.checked_sub(left, right):
    case ok(value):
      return value
    case error(_):
      return U64.literal(0)
  end match
end function

function same(left: Text, right: Text) returns Bool:
  return sico.bytes.equal(sico.text.encode(left), sico.text.encode(right))
end function

function ascii_letter(b: I64) returns Bool:
  if I64.less_than(b, I64.literal(65)):
    return false
  end if
  if I64.less_than(b, I64.literal(91)):
    return true
  end if
  if I64.less_than(b, I64.literal(97)):
    return false
  end if
  return I64.less_than(b, I64.literal(123))
end function

function ascii_digit(b: I64) returns Bool:
  if I64.less_than(b, I64.literal(48)):
    return false
  end if
  return I64.less_than(b, I64.literal(58))
end function

function ident_start(b: I64) returns Bool:
  if I64.equal(b, I64.literal(95)):
    return true
  end if
  return ascii_letter(b)
end function

function ident_continue(b: I64) returns Bool:
  if ident_start(b):
    return true
  end if
  return ascii_digit(b)
end function

function word_kind(word: Text) returns Text:
  if same(word, "_"):
    return "Underscore"
  end if
  if same(word, "true"):
    return "True"
  end if
  if same(word, "false"):
    return "False"
  end if
  if same(word, "async"):
    return "Async"
  end if
  if same(word, "await"):
    return "Await"
  end if
  if same(word, "borrow"):
    return "Borrow"
  end if
  if same(word, "break"):
    return "Break"
  end if
  if same(word, "call"):
    return "Call"
  end if
  if same(word, "continue"):
    return "Continue"
  end if
  if same(word, "capabilities"):
    return "Capabilities"
  end if
  if same(word, "capability"):
    return "Capability"
  end if
  if same(word, "case"):
    return "Case"
  end if
  if same(word, "effects"):
    return "Effects"
  end if
  if same(word, "else"):
    return "Else"
  end if
  if same(word, "end"):
    return "End"
  end if
  if same(word, "enum"):
    return "Enum"
  end if
  if same(word, "error"):
    return "ErrorKeyword"
  end if
  if same(word, "export"):
    return "Export"
  end if
  if same(word, "from"):
    return "From"
  end if
  if same(word, "function"):
    return "Function"
  end if
  if same(word, "group"):
    return "Group"
  end if
  if same(word, "if"):
    return "If"
  end if
  if same(word, "ignore"):
    return "Ignore"
  end if
  if same(word, "interface"):
    return "Interface"
  end if
  if same(word, "invariant"):
    return "Invariant"
  end if
  if same(word, "let"):
    return "Let"
  end if
  if same(word, "match"):
    return "Match"
  end if
  if same(word, "move"):
    return "Move"
  end if
  if same(word, "newtype"):
    return "Newtype"
  end if
  if same(word, "none"):
    return "None"
  end if
  if same(word, "ok"):
    return "OkKeyword"
  end if
  if same(word, "record"):
    return "Record"
  end if
  if same(word, "resource"):
    return "Resource"
  end if
  if same(word, "return"):
    return "Return"
  end if
  if same(word, "returns"):
    return "Returns"
  end if
  if same(word, "self"):
    return "SelfKeyword"
  end if
  if same(word, "set"):
    return "Set"
  end if
  if same(word, "while"):
    return "While"
  end if
  if same(word, "module"):
    return "Module"
  end if
  if same(word, "use"):
    return "Use"
  end if
  if same(word, "for"):
    return "For"
  end if
  if same(word, "in"):
    return "In"
  end if
  if same(word, "spawn"):
    return "Spawn"
  end if
  if same(word, "task"):
    return "Task"
  end if
  if same(word, "try"):
    return "Try"
  end if
  if same(word, "using"):
    return "Using"
  end if
  return "Identifier"
end function

function scan_space(src: Bytes, start: U64, size: U64) returns U64:
  let cursor = start
  while U64.less_than(cursor, size):
    let b = sico.bytes.at(src, cursor, I64.literal(-1))
    if I64.equal(b, I64.literal(32)):
      set cursor = add(cursor, U64.literal(1))
    else:
      if I64.equal(b, I64.literal(9)):
        set cursor = add(cursor, U64.literal(1))
      else:
        return cursor
      end if
    end if
  end while
  return cursor
end function

function scan_ident(src: Bytes, start: U64, size: U64) returns U64:
  let cursor = start
  while U64.less_than(cursor, size):
    if ident_continue(sico.bytes.at(src, cursor, I64.literal(-1))):
      set cursor = add(cursor, U64.literal(1))
    else:
      return cursor
    end if
  end while
  return cursor
end function

function scan_integer(src: Bytes, start: U64, size: U64) returns U64:
  let cursor = start
  while U64.less_than(cursor, size):
    let b = sico.bytes.at(src, cursor, I64.literal(-1))
    if I64.less_than(b, I64.literal(48)):
      return cursor
    end if
    if I64.less_than(b, I64.literal(58)):
      set cursor = add(cursor, U64.literal(1))
    else:
      return cursor
    end if
  end while
  return cursor
end function

function scan_comment(src: Bytes, start: U64, size: U64) returns U64:
  let cursor = add(start, U64.literal(2))
  while U64.less_than(cursor, size):
    let b = sico.bytes.at(src, cursor, I64.literal(-1))
    if I64.equal(b, I64.literal(10)):
      return cursor
    end if
    if I64.equal(b, I64.literal(13)):
      return cursor
    end if
    set cursor = add(cursor, U64.literal(1))
  end while
  return cursor
end function

function scan_string(src: Bytes, start: U64, size: U64) returns U64:
  let cursor = add(start, U64.literal(1))
  let escaped = I64.literal(0)
  while U64.less_than(cursor, size):
    let b = sico.bytes.at(src, cursor, I64.literal(-1))
    if I64.equal(escaped, I64.literal(1)):
      set escaped = I64.literal(0)
      set cursor = add(cursor, U64.literal(1))
    else:
      if I64.equal(b, I64.literal(92)):
        set escaped = I64.literal(1)
        set cursor = add(cursor, U64.literal(1))
      else:
        if I64.equal(b, I64.literal(34)):
          return add(cursor, U64.literal(1))
        end if
        if I64.equal(b, I64.literal(10)):
          return cursor
        end if
        if I64.equal(b, I64.literal(13)):
          return cursor
        end if
        set cursor = add(cursor, U64.literal(1))
      end if
    end if
  end while
  return cursor
end function

function punctuation_kind(b: I64) returns Text:
  if I64.equal(b, I64.literal(40)):
    return "LeftParen"
  end if
  if I64.equal(b, I64.literal(41)):
    return "RightParen"
  end if
  if I64.equal(b, I64.literal(91)):
    return "LeftBracket"
  end if
  if I64.equal(b, I64.literal(93)):
    return "RightBracket"
  end if
  if I64.equal(b, I64.literal(58)):
    return "Colon"
  end if
  if I64.equal(b, I64.literal(44)):
    return "Comma"
  end if
  if I64.equal(b, I64.literal(46)):
    return "Dot"
  end if
  if I64.equal(b, I64.literal(64)):
    return "At"
  end if
  if I64.equal(b, I64.literal(43)):
    return "Plus"
  end if
  if I64.equal(b, I64.literal(45)):
    return "Minus"
  end if
  if I64.equal(b, I64.literal(61)):
    return "Equal"
  end if
  if I64.equal(b, I64.literal(63)):
    return "QuestionMark"
  end if
  return "Error"
end function

function append_token(out: List[Text], kind: Text, start: U64, finish: U64, src: Bytes) returns List[Text]:
  let length = sub(finish, start)
  let header = sico.text.concat(kind, "\t")
  set header = sico.text.concat(header, sico.u64.to_text(start))
  set header = sico.text.concat(header, "\t")
  set header = sico.text.concat(header, sico.u64.to_text(finish))
  set header = sico.text.concat(header, "\t")
  set header = sico.text.concat(header, sico.u64.to_text(length))
  set header = sico.text.concat(header, "\n")
  let framed = header
  if U64.equal(length, U64.literal(0)):
    return sico.list.append(out, sico.text.concat(framed, "\n"))
  end if
  match sico.bytes.slice(src, start, length):
    case ok(text):
      return sico.list.append(out, sico.text.concat(sico.text.concat(framed, sico.bytes.utf8_decode(text)), "\n"))
    case error(_):
      return out
  end match
end function

function token_finish(src: Bytes, start: U64, size: U64) returns U64:
  let next_index = add(start, U64.literal(1))
  let b = sico.bytes.at(src, start, I64.literal(-1))
  let next = sico.bytes.at(src, next_index, I64.literal(-1))
  if I64.equal(b, I64.literal(32)):
    return scan_space(src, start, size)
  end if
  if I64.equal(b, I64.literal(9)):
    return scan_space(src, start, size)
  end if
  if I64.equal(b, I64.literal(13)):
    return add(start, U64.literal(2))
  end if
  if I64.equal(b, I64.literal(47)):
    if I64.equal(next, I64.literal(47)):
      return scan_comment(src, start, size)
    end if
  end if
  if ident_start(b):
    return scan_ident(src, start, size)
  end if
  if ascii_digit(b):
    return scan_integer(src, start, size)
  end if
  if I64.equal(b, I64.literal(34)):
    return scan_string(src, start, size)
  end if
  if I64.equal(b, I64.literal(61)):
    if I64.equal(next, I64.literal(61)):
      return add(start, U64.literal(2))
    end if
  end if
  if I64.equal(b, I64.literal(60)):
    if I64.equal(next, I64.literal(61)):
      return add(start, U64.literal(2))
    end if
  end if
  return next_index
end function

function token_kind(src: Bytes, start: U64, finish: U64) returns Text:
  let b = sico.bytes.at(src, start, I64.literal(-1))
  let next = sico.bytes.at(src, add(start, U64.literal(1)), I64.literal(-1))
  if I64.equal(b, I64.literal(32)):
    return "Whitespace"
  end if
  if I64.equal(b, I64.literal(9)):
    return "Whitespace"
  end if
  if I64.equal(b, I64.literal(10)):
    return "Newline"
  end if
  if I64.equal(b, I64.literal(13)):
    return "Newline"
  end if
  if I64.equal(b, I64.literal(47)):
    if I64.equal(next, I64.literal(47)):
      return "LineComment"
    end if
  end if
  if ident_start(b):
    match sico.bytes.slice(src, start, sub(finish, start)):
      case ok(word_bytes):
        return word_kind(sico.bytes.utf8_decode(word_bytes))
      case error(_):
        return "Error"
    end match
  end if
  if ascii_digit(b):
    return "Integer"
  end if
  if I64.equal(b, I64.literal(34)):
    return "String"
  end if
  if I64.equal(b, I64.literal(61)):
    if I64.equal(next, I64.literal(61)):
      return "EqualEqual"
    end if
    return "Equal"
  end if
  if I64.equal(b, I64.literal(60)):
    if I64.equal(next, I64.literal(61)):
      return "LessEqual"
    end if
  end if
  return punctuation_kind(b)
end function

function lex(src: Bytes) returns Text:
  let size = sico.bytes.length(src)
  let cursor = U64.literal(0)
  let out = sico.text.split_lines("")
  while U64.less_than(cursor, size):
    let finish = token_finish(src, cursor, size)
    set out = append_token(out, token_kind(src, cursor, finish), cursor, finish, src)
    set cursor = finish
  end while
  return sico.text.join(append_token(out, "Eof", size, size, src), "")
end function

function has_error(src: Bytes) returns Bool:
  let size = sico.bytes.length(src)
  let cursor = U64.literal(0)
  while U64.less_than(cursor, size):
    let finish = token_finish(src, cursor, size)
    if same(token_kind(src, cursor, finish), "Error"):
      return true
    end if
    set cursor = finish
  end while
  return false
end function
