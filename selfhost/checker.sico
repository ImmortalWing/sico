record ScriptInput:
  field arguments: List[Text]
  field stdin: Bytes
end record

record ScriptOutput:
  field stdout: Bytes
  field stderr: Bytes
  field exit_code: I64
end record

enum ScriptErrorCode:
  case InvalidInput
  case ResourceLimit
  case DomainError
  case Cancelled
end enum

record ScriptError:
  field code: ScriptErrorCode
  field message: Text
end record

use compiler_lexer.has_error
use compiler_parser.syntax_diagnostic
use compiler_semantics.semantic_diagnostic

function main(input: ScriptInput) returns Result[ScriptOutput, ScriptError]:
  if compiler_lexer.has_error(input.stdin):
    return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: "LEXICAL"))
  end if
  let text = sico.bytes.utf8_decode(input.stdin)
  let syntax = compiler_parser.syntax_diagnostic(text)
  if U64.less_than(U64.literal(0), sico.text.length(syntax)):
    return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: syntax))
  end if
  let semantic = compiler_semantics.semantic_diagnostic(text)
  if U64.less_than(U64.literal(0), sico.text.length(semantic)):
    return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: semantic))
  end if
  return ok(ScriptOutput(stdout: sico.text.encode("check ok\n"), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
end function
