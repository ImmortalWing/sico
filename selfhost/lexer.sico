record ScriptInput:
  field arguments: List[Text]
  field stdin: Bytes
end record

record ScriptOutput:
  field stdout: Bytes
  field stderr: Bytes
  field exit_code: I64
end record

enum ScriptErrorCode:
  case InvalidInput
  case ResourceLimit
  case DomainError
  case Cancelled
end enum

record ScriptError:
  field code: ScriptErrorCode
  field message: Text
end record

function is_ident_byte(b: I64) returns Bool:
  if I64.equal(b, I64.literal(95)):
    return true
  end if
  if I64.less_than(b, I64.literal(97)):
    return false
  end if
  if I64.less_than(b, I64.literal(123)):
    return true
  end if
  if I64.less_than(b, I64.literal(65)):
    return false
  end if
  if I64.less_than(b, I64.literal(91)):
    return true
  end if
  return false
end function

function is_digit_byte(b: I64) returns Bool:
  if I64.less_than(b, I64.literal(48)):
    return false
  end if
  if I64.less_than(b, I64.literal(58)):
    return true
  end if
  return false
end function

function lex_classify(src: Bytes) returns Text:
  let byte_len = sico.text.length(sico.bytes.utf8_decode(src))
  let index = U64.literal(0)
  let ident_count = U64.literal(0)
  let int_count = U64.literal(0)
  let punct_count = U64.literal(0)
  let in_ident = I64.literal(0)
  let in_int = I64.literal(0)
  while U64.less_than(index, byte_len):
    let b = sico.bytes.at(src, index, I64.literal(0))
    if is_ident_byte(b):
      if I64.equal(in_ident, I64.literal(0)):
        match U64.checked_add(ident_count, U64.literal(1)):
          case ok(next):
            set ident_count = next
          case error(_):
            return "overflow"
        end match
        set in_ident = I64.literal(1)
      end if
      set in_int = I64.literal(0)
    else:
      if is_digit_byte(b):
        if I64.equal(in_int, I64.literal(0)):
          match U64.checked_add(int_count, U64.literal(1)):
            case ok(next):
              set int_count = next
            case error(_):
              return "overflow"
          end match
          set in_int = I64.literal(1)
        end if
      else:
        if I64.equal(b, I64.literal(32)):
          set punct_count = punct_count
        else:
          if I64.equal(b, I64.literal(10)):
            set punct_count = punct_count
          else:
            match U64.checked_add(punct_count, U64.literal(1)):
              case ok(next):
                set punct_count = next
              case error(_):
                return "overflow"
            end match
          end if
        end if
      end if
      set in_ident = I64.literal(0)
      set in_int = I64.literal(0)
    end if
    match U64.checked_add(index, U64.literal(1)):
      case ok(next):
        set index = next
      case error(_):
        return "overflow"
    end match
  end while
  return sico.text.format("ident={0} int={1} punct={2}", sico.list.append(sico.list.append(sico.list.append(sico.text.split_lines(""), sico.u64.to_text(ident_count)), sico.u64.to_text(int_count)), sico.u64.to_text(punct_count)))
end function

function main(input: ScriptInput) returns Result[ScriptOutput, ScriptError]:
  let out = lex_classify(input.stdin)
  return ok(ScriptOutput(stdout: sico.text.encode(out), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
end function
