record ScriptInput:
  field arguments: List[Text]
  field stdin: Bytes
end record

record ScriptOutput:
  field stdout: Bytes
  field stderr: Bytes
  field exit_code: I64
end record

enum ScriptErrorCode:
  case InvalidInput
  case ResourceLimit
  case DomainError
  case Cancelled
end enum

record ScriptError:
  field code: ScriptErrorCode
  field message: Text
end record

use compiler_parser.parse_metadata
use compiler_parser.lossless_tokens
use parser.lex_words
use parser.scalar_ir
use codegen.component_hex_for_minimal
use codegen.cgp_run_plan

function is_ident_byte(b: I64) returns Bool:
  if I64.equal(b, I64.literal(95)):
    return true
  end if
  if I64.less_than(b, I64.literal(48)):
    return false
  end if
  if I64.less_than(b, I64.literal(58)):
    return true
  end if
  if I64.less_than(b, I64.literal(65)):
    return false
  end if
  if I64.less_than(b, I64.literal(91)):
    return true
  end if
  if I64.less_than(b, I64.literal(97)):
    return false
  end if
  if I64.less_than(b, I64.literal(123)):
    return true
  end if
  return false
end function

function lex_words(src: Bytes) returns List[Text]:
  let byte_len = sico.text.length(sico.bytes.utf8_decode(src))
  let index = U64.literal(0)
  let words = sico.text.split_lines("")
  let in_ident = I64.literal(0)
  let word_start = U64.literal(0)
  let word_len = U64.literal(0)
  while U64.less_than(index, byte_len):
    let b = sico.bytes.at(src, index, I64.literal(0))
    if is_ident_byte(b):
      if I64.equal(in_ident, I64.literal(0)):
        set word_start = index
        set word_len = U64.literal(0)
        set in_ident = I64.literal(1)
      end if
      match U64.checked_add(word_len, U64.literal(1)):
        case ok(next):
          set word_len = next
        case error(_):
          return sico.text.split_lines("")
      end match
    else:
      if I64.equal(in_ident, I64.literal(1)):
        match sico.bytes.slice(src, word_start, word_len):
          case ok(slice_bytes):
            set words = sico.list.append(words, sico.bytes.utf8_decode(slice_bytes))
          case error(_):
            return sico.text.split_lines("")
        end match
      end if
      set in_ident = I64.literal(0)
    end if
    match U64.checked_add(index, U64.literal(1)):
      case ok(next):
        set index = next
      case error(_):
        return sico.text.split_lines("")
    end match
  end while
  if I64.equal(in_ident, I64.literal(1)):
    match sico.bytes.slice(src, word_start, word_len):
      case ok(slice_bytes):
        set words = sico.list.append(words, sico.bytes.utf8_decode(slice_bytes))
      case error(_):
        return sico.text.split_lines("")
    end match
  end if
  return words
end function

function word_at(words: List[Text], i: U64) returns Text:
  match sico.list.get(words, i):
    case ok(w):
      return w
    case error(_):
      return "?"
  end match
end function

function same_text(left: Text, right: Text) returns Bool:
  return sico.bytes.equal(sico.text.encode(left), sico.text.encode(right))
end function

function add_u64(left: U64, right: U64) returns U64:
  match U64.checked_add(left, right):
    case ok(value):
      return value
    case error(_):
      return U64.literal(0)
  end match
end function



function canonical_function_source(name: Text, params: Text, return_ty: Text, body_line: Text) returns Text:
  let source = sico.text.concat("function ", name)
  set source = sico.text.concat(source, "(")
  set source = sico.text.concat(source, params)
  set source = sico.text.concat(source, ") returns ")
  set source = sico.text.concat(source, return_ty)
  set source = sico.text.concat(source, ":\n  return ")
  set source = sico.text.concat(source, body_line)
  set source = sico.text.concat(source, "\nend function\n")
  return source
end function

function const_source(fname: Text, rtype: Text, literal: Text) returns Text:
  return canonical_function_source(fname, "", rtype, literal)
end function

function all_digits(text: Text) returns Bool:
  let bytes = sico.text.encode(text)
  let n = sico.text.length(text)
  if U64.equal(n, U64.literal(0)):
    return false
  end if
  let i = U64.literal(0)
  while U64.less_than(i, n):
    let b = sico.bytes.at(bytes, i, I64.literal(0))
    if I64.less_than(b, I64.literal(48)):
      return false
    end if
    if I64.less_than(b, I64.literal(58)):
      set i = add_u64(i, U64.literal(1))
    else:
      return false
    end if
  end while
  return true
end function

function decimal_at_most(value: Text, maximum: Text) returns Bool:
  let value_len = sico.text.length(value)
  let maximum_len = sico.text.length(maximum)
  if U64.less_than(value_len, maximum_len):
    return true
  end if
  if U64.less_than(maximum_len, value_len):
    return false
  end if
  let value_bytes = sico.text.encode(value)
  let maximum_bytes = sico.text.encode(maximum)
  let index = U64.literal(0)
  while U64.less_than(index, value_len):
    let value_byte = sico.bytes.at(value_bytes, index, I64.literal(0))
    let maximum_byte = sico.bytes.at(maximum_bytes, index, I64.literal(0))
    if I64.less_than(value_byte, maximum_byte):
      return true
    end if
    if I64.less_than(maximum_byte, value_byte):
      return false
    end if
    set index = add_u64(index, U64.literal(1))
  end while
  return true
end function

function decimal_digit(byte: I64) returns U64:
  if I64.equal(byte, I64.literal(48)):
    return U64.literal(0)
  end if
  if I64.equal(byte, I64.literal(49)):
    return U64.literal(1)
  end if
  if I64.equal(byte, I64.literal(50)):
    return U64.literal(2)
  end if
  if I64.equal(byte, I64.literal(51)):
    return U64.literal(3)
  end if
  if I64.equal(byte, I64.literal(52)):
    return U64.literal(4)
  end if
  if I64.equal(byte, I64.literal(53)):
    return U64.literal(5)
  end if
  if I64.equal(byte, I64.literal(54)):
    return U64.literal(6)
  end if
  if I64.equal(byte, I64.literal(55)):
    return U64.literal(7)
  end if
  if I64.equal(byte, I64.literal(56)):
    return U64.literal(8)
  end if
  return U64.literal(9)
end function

function decimal_u64(value: Text) returns U64:
  let bytes = sico.text.encode(value)
  let index = U64.literal(0)
  let parsed = U64.literal(0)
  while U64.less_than(index, sico.text.length(value)):
    match U64.checked_mul(parsed, U64.literal(10)):
      case ok(shifted):
        match U64.checked_add(shifted, decimal_digit(sico.bytes.at(bytes, index, I64.literal(0)))):
          case ok(next):
            set parsed = next
          case error(_):
            return U64.literal(0)
        end match
      case error(_):
        return U64.literal(0)
    end match
    set index = add_u64(index, U64.literal(1))
  end while
  return parsed
end function

function hex_digit(value: U64) returns Text:
  if U64.less_than(value, U64.literal(10)):
    return sico.u64.to_text(value)
  end if
  if U64.equal(value, U64.literal(10)):
    return "a"
  end if
  if U64.equal(value, U64.literal(11)):
    return "b"
  end if
  if U64.equal(value, U64.literal(12)):
    return "c"
  end if
  if U64.equal(value, U64.literal(13)):
    return "d"
  end if
  if U64.equal(value, U64.literal(14)):
    return "e"
  end if
  return "f"
end function

function hex_byte(value: U64) returns Text:
  let high = U64.shr(value, U64.literal(4))
  let low = U64.bit_and(value, U64.literal(15))
  return sico.text.concat(hex_digit(high), hex_digit(low))
end function

function hex_digit_i64(value: I64) returns Text:
  if I64.less_than(value, I64.literal(10)):
    return sico.i64.to_text(value)
  end if
  if I64.equal(value, I64.literal(10)):
    return "a"
  end if
  if I64.equal(value, I64.literal(11)):
    return "b"
  end if
  if I64.equal(value, I64.literal(12)):
    return "c"
  end if
  if I64.equal(value, I64.literal(13)):
    return "d"
  end if
  if I64.equal(value, I64.literal(14)):
    return "e"
  end if
  return "f"
end function

function hex_byte_i64(value: I64) returns Text:
  let high = I64.shr(value, I64.literal(4))
  let low = I64.bit_and(value, I64.literal(15))
  return sico.text.concat(hex_digit_i64(high), hex_digit_i64(low))
end function

function bytes_hex(value: Text) returns Text:
  let bytes = sico.text.encode(value)
  let index = U64.literal(0)
  let output = ""
  while U64.less_than(index, sico.text.length(value)):
    let byte = sico.bytes.at(bytes, index, I64.literal(0))
    set output = sico.text.concat(output, hex_byte_i64(byte))
    set index = add_u64(index, U64.literal(1))
  end while
  return output
end function

function uleb_hex(initial: U64) returns Text:
  let value = initial
  let output = ""
  let done = I64.literal(0)
  while I64.equal(done, I64.literal(0)):
    let byte = U64.bit_and(value, U64.literal(127))
    set value = U64.shr(value, U64.literal(7))
    if U64.equal(value, U64.literal(0)):
      set done = I64.literal(1)
    else:
      set byte = U64.bit_or(byte, U64.literal(128))
    end if
    set output = sico.text.concat(output, hex_byte(byte))
  end while
  return output
end function

function uleb_length(initial: U64) returns U64:
  let value = initial
  let count = U64.literal(1)
  while U64.less_than(U64.literal(127), value):
    set value = U64.shr(value, U64.literal(7))
    set count = add_u64(count, U64.literal(1))
  end while
  return count
end function

function positive_sleb_hex(initial: U64) returns Text:
  let value = initial
  let output = ""
  let done = I64.literal(0)
  while I64.equal(done, I64.literal(0)):
    let byte = U64.bit_and(value, U64.literal(127))
    set value = U64.shr(value, U64.literal(7))
    if U64.equal(value, U64.literal(0)):
      if U64.less_than(byte, U64.literal(64)):
        set done = I64.literal(1)
      end if
    end if
    if I64.equal(done, I64.literal(0)):
      set byte = U64.bit_or(byte, U64.literal(128))
    end if
    set output = sico.text.concat(output, hex_byte(byte))
  end while
  return output
end function

function positive_sleb_length(initial: U64) returns U64:
  match U64.checked_div(sico.text.length(positive_sleb_hex(initial)), U64.literal(2)):
    case ok(length):
      return length
    case error(_):
      return U64.literal(0)
  end match
end function

function hex_text_bytes(text: Text) returns U64:
  match U64.checked_div(sico.text.length(text), U64.literal(2)):
    case ok(length):
      return length
    case error(_):
      return U64.literal(0)
  end match
end function

function wasm_module_hex(name: Text, type_content: Text, body_len: U64, body_hex: Text) returns Text:
  let name_len = sico.text.length(name)
  let export_payload_len = add_u64(add_u64(U64.literal(3), name_len), uleb_length(name_len))
  let code_payload_len = add_u64(add_u64(U64.literal(1), uleb_length(body_len)), body_len)
  let output = "0061736d01000000"
  set output = sico.text.concat(output, "01")
  set output = sico.text.concat(output, uleb_hex(hex_text_bytes(type_content)))
  set output = sico.text.concat(output, type_content)
  set output = sico.text.concat(output, "03020100")
  set output = sico.text.concat(output, "07")
  set output = sico.text.concat(output, uleb_hex(export_payload_len))
  set output = sico.text.concat(output, "01")
  set output = sico.text.concat(output, uleb_hex(name_len))
  set output = sico.text.concat(output, bytes_hex(name))
  set output = sico.text.concat(output, "0000")
  set output = sico.text.concat(output, "0a")
  set output = sico.text.concat(output, uleb_hex(code_payload_len))
  set output = sico.text.concat(output, "01")
  set output = sico.text.concat(output, uleb_hex(body_len))
  return sico.text.concat(output, body_hex)
end function

function constant_core_hex(name: Text, value: U64) returns Text:
  let body_len = add_u64(U64.literal(32), positive_sleb_length(value))
  let body = "02017e017f41002101024003402001410046044042"
  set body = sico.text.concat(body, positive_sleb_hex(value))
  set body = sico.text.concat(body, "210020000f0b000b0b000b")
  return wasm_module_hex(name, "016000017e", body_len, body)
end function

function scalar_type_hex(text: Text) returns Text:
  if same_text(text, "I64"):
    return "7e"
  end if
  if same_text(text, "U64"):
    return "7e"
  end if
  if same_text(text, "Bool"):
    return "7f"
  end if
  return ""
end function

function int_constant_core_hex(source: Bytes, words: List[Text]) returns Text:
  if U64.equal(sico.list.length(words), U64.literal(8)):
    let ic_name = word_at(words, U64.literal(1))
    let ic_type = word_at(words, U64.literal(3))
    let ic_literal = word_at(words, U64.literal(5))
    if same_text(word_at(words, U64.literal(0)), "function"):
      if same_text(word_at(words, U64.literal(2)), "returns"):
        if same_text(ic_type, "Int"):
          if same_text(word_at(words, U64.literal(4)), "return"):
            if same_text(word_at(words, U64.literal(6)), "end"):
              if same_text(word_at(words, U64.literal(7)), "function"):
                if all_digits(ic_literal):
                  if decimal_at_most(ic_literal, "9223372036854775807"):
                    if sico.bytes.equal(source, sico.text.encode(const_source(ic_name, ic_type, ic_literal))):
                      return constant_core_hex(ic_name, decimal_u64(ic_literal))
                    end if
                  end if
                end if
              end if
            end if
          end if
        end if
      end if
    end if
  end if
  return ""
end function

function i64_const_core_hex(source: Bytes, words: List[Text]) returns Text:
  if U64.equal(sico.list.length(words), U64.literal(10)):
    let kc_name = word_at(words, U64.literal(1))
    let kc_literal = word_at(words, U64.literal(7))
    if same_text(word_at(words, U64.literal(0)), "function"):
      if same_text(word_at(words, U64.literal(2)), "returns"):
        if same_text(word_at(words, U64.literal(3)), "I64"):
          if same_text(word_at(words, U64.literal(4)), "return"):
            if same_text(word_at(words, U64.literal(5)), "I64"):
              if same_text(word_at(words, U64.literal(6)), "literal"):
                if same_text(word_at(words, U64.literal(8)), "end"):
                  if same_text(word_at(words, U64.literal(9)), "function"):
                    if all_digits(kc_literal):
                      if decimal_at_most(kc_literal, "9223372036854775807"):
                        let kc_canonical = canonical_function_source(kc_name, "", "I64", sico.text.concat("I64.literal(", sico.text.concat(kc_literal, ")")))
                        if sico.bytes.equal(source, sico.text.encode(kc_canonical)):
                          return constant_core_hex(kc_name, decimal_u64(kc_literal))
                        end if
                      end if
                    end if
                  end if
                end if
              end if
            end if
          end if
        end if
      end if
    end if
  end if
  return ""
end function

function u64_const_core_hex(source: Bytes, words: List[Text]) returns Text:
  if U64.equal(sico.list.length(words), U64.literal(10)):
    let uc_name = word_at(words, U64.literal(1))
    let uc_literal = word_at(words, U64.literal(7))
    if same_text(word_at(words, U64.literal(0)), "function"):
      if same_text(word_at(words, U64.literal(2)), "returns"):
        if same_text(word_at(words, U64.literal(3)), "U64"):
          if same_text(word_at(words, U64.literal(4)), "return"):
            if same_text(word_at(words, U64.literal(5)), "U64"):
              if same_text(word_at(words, U64.literal(6)), "literal"):
                if same_text(word_at(words, U64.literal(8)), "end"):
                  if same_text(word_at(words, U64.literal(9)), "function"):
                    if all_digits(uc_literal):
                      if decimal_at_most(uc_literal, "9223372036854775807"):
                        let uc_canonical = canonical_function_source(uc_name, "", "U64", sico.text.concat("U64.literal(", sico.text.concat(uc_literal, ")")))
                        if sico.bytes.equal(source, sico.text.encode(uc_canonical)):
                          return constant_core_hex(uc_name, decimal_u64(uc_literal))
                        end if
                      end if
                    end if
                  end if
                end if
              end if
            end if
          end if
        end if
      end if
    end if
  end if
  return ""
end function

function bool_const_core_hex(source: Bytes, words: List[Text]) returns Text:
  if U64.equal(sico.list.length(words), U64.literal(8)):
    let bc_name = word_at(words, U64.literal(1))
    let bc_literal = word_at(words, U64.literal(5))
    let bc_bit = "00"
    if same_text(bc_literal, "true"):
      set bc_bit = "01"
    else:
      if same_text(bc_literal, "false"):
        set bc_bit = "00"
      else:
        return ""
      end if
    end if
    if same_text(word_at(words, U64.literal(0)), "function"):
      if same_text(word_at(words, U64.literal(2)), "returns"):
        if same_text(word_at(words, U64.literal(3)), "Bool"):
          if same_text(word_at(words, U64.literal(4)), "return"):
            if same_text(word_at(words, U64.literal(6)), "end"):
              if same_text(word_at(words, U64.literal(7)), "function"):
                if sico.bytes.equal(source, sico.text.encode(canonical_function_source(bc_name, "", "Bool", bc_literal))):
                  let bc_body = "02017f017f410021010240034020014100460440"
                  set bc_body = sico.text.concat(bc_body, "41")
                  set bc_body = sico.text.concat(bc_body, bc_bit)
                  set bc_body = sico.text.concat(bc_body, "210020000f0b000b0b000b")
                  return wasm_module_hex(bc_name, "016000017f", U64.literal(33), bc_body)
                end if
              end if
            end if
          end if
        end if
      end if
    end if
  end if
  return ""
end function

function identity_core_hex(source: Bytes, words: List[Text]) returns Text:
  if U64.equal(sico.list.length(words), U64.literal(10)):
    let id_name = word_at(words, U64.literal(1))
    let id_param = word_at(words, U64.literal(2))
    let id_type = word_at(words, U64.literal(3))
    let id_hex = scalar_type_hex(id_type)
    if same_text(word_at(words, U64.literal(0)), "function"):
      if same_text(id_param, "value"):
        if same_text(word_at(words, U64.literal(4)), "returns"):
          if same_text(word_at(words, U64.literal(5)), id_type):
            if same_text(word_at(words, U64.literal(6)), "return"):
              if same_text(word_at(words, U64.literal(7)), "value"):
                if same_text(word_at(words, U64.literal(8)), "end"):
                  if same_text(word_at(words, U64.literal(9)), "function"):
                    if U64.equal(sico.text.length(id_hex), U64.literal(2)):
                      let id_params = sico.text.concat("value: ", id_type)
                      let id_canonical = canonical_function_source(id_name, id_params, id_type, "value")
                      if sico.bytes.equal(source, sico.text.encode(id_canonical)):
                        let id_type_content = "016001"
                        set id_type_content = sico.text.concat(id_type_content, id_hex)
                        set id_type_content = sico.text.concat(id_type_content, "01")
                        set id_type_content = sico.text.concat(id_type_content, id_hex)
                        let id_body = "01017f41002101024003402001410046044020000f0b000b0b000b"
                        return wasm_module_hex(id_name, id_type_content, U64.literal(27), id_body)
                      end if
                    end if
                  end if
                end if
              end if
            end if
          end if
        end if
      end if
    end if
  end if
  return ""
end function

function identity_pair_core_hex(source: Bytes, words: List[Text]) returns Text:
  if U64.equal(sico.list.length(words), U64.literal(12)):
    let ip_name = word_at(words, U64.literal(1))
    let ip_type = word_at(words, U64.literal(3))
    let ip_hex = scalar_type_hex(ip_type)
    let ip_second = word_at(words, U64.literal(9))
    let ip_slot = "00"
    if same_text(ip_second, "a"):
      set ip_slot = "00"
    else:
      if same_text(ip_second, "b"):
        set ip_slot = "01"
      else:
        return ""
      end if
    end if
    if same_text(word_at(words, U64.literal(0)), "function"):
      if same_text(word_at(words, U64.literal(2)), "a"):
        if same_text(word_at(words, U64.literal(4)), "b"):
          if same_text(word_at(words, U64.literal(6)), "returns"):
            if same_text(word_at(words, U64.literal(7)), ip_type):
              if same_text(word_at(words, U64.literal(8)), "return"):
                if same_text(word_at(words, U64.literal(10)), "end"):
                  if same_text(word_at(words, U64.literal(11)), "function"):
                    if U64.equal(sico.text.length(ip_hex), U64.literal(2)):
                      if same_text(word_at(words, U64.literal(5)), ip_type):
                        let ip_params = sico.text.concat(sico.text.concat("a: ", ip_type), sico.text.concat(", b: ", ip_type))
                        let ip_canonical = canonical_function_source(ip_name, ip_params, ip_type, ip_second)
                        if sico.bytes.equal(source, sico.text.encode(ip_canonical)):
                          let ip_type_content = "016002"
                          set ip_type_content = sico.text.concat(ip_type_content, ip_hex)
                          set ip_type_content = sico.text.concat(ip_type_content, ip_hex)
                          set ip_type_content = sico.text.concat(ip_type_content, "01")
                          set ip_type_content = sico.text.concat(ip_type_content, ip_hex)
                          let ip_body = "01017f41002102024003402002410046044020"
                          set ip_body = sico.text.concat(ip_body, ip_slot)
                          set ip_body = sico.text.concat(ip_body, "0f0b000b0b000b")
                          return wasm_module_hex(ip_name, ip_type_content, U64.literal(27), ip_body)
