function declared_core_hex(source: Bytes, words: List[Text]) returns Text:
  let dc_hex = int_constant_core_hex(source, words)
  if U64.equal(sico.text.length(dc_hex), U64.literal(0)):
    set dc_hex = i64_const_core_hex(source, words)
  end if
  if U64.equal(sico.text.length(dc_hex), U64.literal(0)):
    set dc_hex = u64_const_core_hex(source, words)
  end if
  if U64.equal(sico.text.length(dc_hex), U64.literal(0)):
    set dc_hex = bool_const_core_hex(source, words)
  end if
  if U64.equal(sico.text.length(dc_hex), U64.literal(0)):
    set dc_hex = identity_core_hex(source, words)
  end if
  if U64.equal(sico.text.length(dc_hex), U64.literal(0)):
    set dc_hex = identity_pair_core_hex(source, words)
  end if
  if U64.equal(sico.text.length(dc_hex), U64.literal(0)):
    set dc_hex = less_than_core_hex(source, words)
  end if
  if U64.equal(sico.text.length(dc_hex), U64.literal(0)):
    set dc_hex = checked_add_core_hex(source, words)
  end if
  if U64.equal(sico.text.length(dc_hex), U64.literal(0)):
    set dc_hex = checked_sub_core_hex(source, words)
  end if
  return dc_hex
end function


function main(input: ScriptInput) returns Result[ScriptOutput, ScriptError]:
  if U64.equal(sico.list.length(input.arguments), U64.literal(1)):
    if same_text(word_at(input.arguments, U64.literal(0)), "--emit-tokens"):
      if sico.bytes.is_utf8(input.stdin):
        return ok(ScriptOutput(stdout: sico.text.encode(compiler_parser.lossless_tokens(input.stdin)), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
      end if
      return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: "source is not UTF-8"))
    end if
    if same_text(word_at(input.arguments, U64.literal(0)), "--emit-ast-metadata"):
      if sico.bytes.is_utf8(input.stdin):
        return ok(ScriptOutput(stdout: sico.text.encode(compiler_parser.parse_metadata(sico.bytes.utf8_decode(input.stdin))), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
      end if
      return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: "source is not UTF-8"))
    end if
    if same_text(word_at(input.arguments, U64.literal(0)), "--emit-core-hex"):
      let codegen_words = lex_words(input.stdin)
      let codegen_hex = declared_core_hex(input.stdin, codegen_words)
      if U64.equal(sico.text.length(codegen_hex), U64.literal(0)):
        return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: "unsupported codegen source shape"))
      end if
      return ok(ScriptOutput(stdout: sico.text.encode(codegen_hex), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
    end if
    if same_text(word_at(input.arguments, U64.literal(0)), "--emit-component-hex"):
      let component_hex = codegen.component_hex_for_minimal(input.stdin)
      if U64.equal(sico.text.length(component_hex), U64.literal(0)):
        return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: "unsupported codegen source shape"))
      end if
      return ok(ScriptOutput(stdout: sico.text.encode(component_hex), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
    end if
    if same_text(word_at(input.arguments, U64.literal(0)), "--emit-ir-split"):
      let split_words = parser.lex_words(input.stdin)
      let split_ir = parser.scalar_ir(split_words, input.stdin)
      if sico.text.starts_with(split_ir, "ERR:"):
        return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: split_ir))
      end if
      let split_bytes = sico.text.encode(split_ir)
      let split_len = sico.bytes.length(split_bytes)
      let split_at = U64.literal(0)
      match U64.checked_div(split_len, U64.literal(2)):
        case ok(split_half):
          set split_at = split_half
        case error(_):
          return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: "IR length is not divisible"))
      end match
      let split_tail_len = U64.literal(0)
      match U64.checked_sub(split_len, split_at):
        case ok(split_tail_len_value):
          set split_tail_len = split_tail_len_value
        case error(_):
          return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: "IR length overflow"))
      end match
      let split_head = sico.text.encode("")
      match sico.bytes.slice(split_bytes, U64.literal(0), split_at):
        case ok(split_head_bytes):
          set split_head = split_head_bytes
        case error(_):
          return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: "IR head slice failed"))
      end match
      let split_tail = sico.text.encode("")
      match sico.bytes.slice(split_bytes, split_at, split_tail_len):
        case ok(split_tail_bytes):
          set split_tail = split_tail_bytes
        case error(_):
          return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: "IR tail slice failed"))
      end match
      return ok(ScriptOutput(stdout: split_head, stderr: split_tail, exit_code: I64.literal(0)))
    end if
    if same_text(word_at(input.arguments, U64.literal(0)), "--emit-ir-plan"):
      let plan_words = parser.lex_words(input.stdin)
      let plan_ir = parser.scalar_ir(plan_words, input.stdin)
      if sico.text.starts_with(plan_ir, "ERR:"):
        return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: plan_ir))
      end if
      let plan_text = codegen.cgp_run_plan(plan_ir)
      if sico.text.starts_with(plan_text, "ERR:"):
        return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: plan_text))
      end if
      return ok(ScriptOutput(stdout: sico.text.encode(plan_text), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
    end if
    if same_text(word_at(input.arguments, U64.literal(0)), "--emit-locals-hex"):
      let cglh_words = parser.lex_words(input.stdin)
      let cglh_ir = parser.scalar_ir(cglh_words, input.stdin)
      if sico.text.starts_with(cglh_ir, "ERR:"):
        return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: cglh_ir))
      end if
      let cglh_hex = codegen.cgs_local_hex(sico.text.encode(cglh_ir))
      if sico.text.starts_with(cglh_hex, "ERR:"):
        return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: cglh_hex))
      end if
      return ok(ScriptOutput(stdout: sico.text.encode(cglh_hex), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
    end if
    if same_text(word_at(input.arguments, U64.literal(0)), "--emit-run-instr-hex"):
      let crih_words = parser.lex_words(input.stdin)
      let crih_ir = parser.scalar_ir(crih_words, input.stdin)
      if sico.text.starts_with(crih_ir, "ERR:"):
        return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: crih_ir))
      end if
      let crih_hex = codegen.cgs_run_instr_hex(sico.text.encode(crih_ir))
      if sico.text.starts_with(crih_hex, "ERR:"):
        return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: crih_hex))
      end if
      return ok(ScriptOutput(stdout: sico.text.encode(crih_hex), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
    end if
  end if
  let general_words = parser.lex_words(input.stdin)
  let general_ir = parser.scalar_ir(general_words, input.stdin)
  if sico.text.starts_with(general_ir, "ERR:"):
    return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: general_ir))
  end if
  return ok(ScriptOutput(stdout: sico.text.encode(general_ir), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
end function
