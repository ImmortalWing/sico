record ScriptInput:
  field arguments: List[Text]
  field stdin: Bytes
end record

record ScriptOutput:
  field stdout: Bytes
  field stderr: Bytes
  field exit_code: I64
end record

enum ScriptErrorCode:
  case InvalidInput
  case ResourceLimit
  case DomainError
  case Cancelled
end enum

record ScriptError:
  field code: ScriptErrorCode
  field message: Text
end record

use compiler_parser.parse_metadata
use compiler_parser.lossless_tokens

function is_ident_byte(b: I64) returns Bool:
  if I64.equal(b, I64.literal(95)):
    return true
  end if
  if I64.less_than(b, I64.literal(48)):
    return false
  end if
  if I64.less_than(b, I64.literal(58)):
    return true
  end if
  if I64.less_than(b, I64.literal(65)):
    return false
  end if
  if I64.less_than(b, I64.literal(91)):
    return true
  end if
  if I64.less_than(b, I64.literal(97)):
    return false
  end if
  if I64.less_than(b, I64.literal(123)):
    return true
  end if
  return false
end function

function lex_words(src: Bytes) returns List[Text]:
  let byte_len = sico.text.length(sico.bytes.utf8_decode(src))
  let index = U64.literal(0)
  let words = sico.text.split_lines("")
  let in_ident = I64.literal(0)
  let word_start = U64.literal(0)
  let word_len = U64.literal(0)
  while U64.less_than(index, byte_len):
    let b = sico.bytes.at(src, index, I64.literal(0))
    if is_ident_byte(b):
      if I64.equal(in_ident, I64.literal(0)):
        set word_start = index
        set word_len = U64.literal(0)
        set in_ident = I64.literal(1)
      end if
      match U64.checked_add(word_len, U64.literal(1)):
        case ok(next):
          set word_len = next
        case error(_):
          return sico.text.split_lines("")
      end match
    else:
      if I64.equal(in_ident, I64.literal(1)):
        match sico.bytes.slice(src, word_start, word_len):
          case ok(slice_bytes):
            set words = sico.list.append(words, sico.bytes.utf8_decode(slice_bytes))
          case error(_):
            return sico.text.split_lines("")
        end match
      end if
      set in_ident = I64.literal(0)
    end if
    match U64.checked_add(index, U64.literal(1)):
      case ok(next):
        set index = next
      case error(_):
        return sico.text.split_lines("")
    end match
  end while
  if I64.equal(in_ident, I64.literal(1)):
    match sico.bytes.slice(src, word_start, word_len):
      case ok(slice_bytes):
        set words = sico.list.append(words, sico.bytes.utf8_decode(slice_bytes))
      case error(_):
        return sico.text.split_lines("")
    end match
  end if
  return words
end function

function word_at(words: List[Text], i: U64) returns Text:
  match sico.list.get(words, i):
    case ok(w):
      return w
    case error(_):
      return "?"
  end match
end function

function same_text(left: Text, right: Text) returns Bool:
  return sico.bytes.equal(sico.text.encode(left), sico.text.encode(right))
end function

function add_u64(left: U64, right: U64) returns U64:
  match U64.checked_add(left, right):
    case ok(value):
      return value
    case error(_):
      return U64.literal(0)
  end match
end function

function type_json(name: Text) returns Text:
  if same_text(name, "Int"):
    return "{\"kind\":\"int\"}"
  end if
  if same_text(name, "I64"):
    return "{\"kind\":\"i64\"}"
  end if
  if same_text(name, "U64"):
    return "{\"kind\":\"u64\"}"
  end if
  if same_text(name, "Bool"):
    return "{\"kind\":\"bool\"}"
  end if
  return ""
end function

function identity_source(fname: Text, pname: Text, ptype: Text) returns Text:
  let source = sico.text.concat("function ", fname)
  set source = sico.text.concat(source, sico.text.concat("(", pname))
  set source = sico.text.concat(source, sico.text.concat(": ", ptype))
  set source = sico.text.concat(source, sico.text.concat(") returns ", ptype))
  set source = sico.text.concat(source, sico.text.concat(":\n  return ", pname))
  return sico.text.concat(source, "\nend function\n")
end function

function const_source(fname: Text, rtype: Text, literal: Text) returns Text:
  let source = sico.text.concat("function ", fname)
  set source = sico.text.concat(source, sico.text.concat("() returns ", rtype))
  set source = sico.text.concat(source, sico.text.concat(":\n  return ", literal))
  return sico.text.concat(source, "\nend function\n")
end function

function all_digits(text: Text) returns Bool:
  let bytes = sico.text.encode(text)
  let n = sico.text.length(text)
  if U64.equal(n, U64.literal(0)):
    return false
  end if
  let i = U64.literal(0)
  while U64.less_than(i, n):
    let b = sico.bytes.at(bytes, i, I64.literal(0))
    if I64.less_than(b, I64.literal(48)):
      return false
    end if
    if I64.less_than(b, I64.literal(58)):
      set i = add_u64(i, U64.literal(1))
    else:
      return false
    end if
  end while
  return true
end function

function decimal_at_most(value: Text, maximum: Text) returns Bool:
  let value_len = sico.text.length(value)
  let maximum_len = sico.text.length(maximum)
  if U64.less_than(value_len, maximum_len):
    return true
  end if
  if U64.less_than(maximum_len, value_len):
    return false
  end if
  let value_bytes = sico.text.encode(value)
  let maximum_bytes = sico.text.encode(maximum)
  let index = U64.literal(0)
  while U64.less_than(index, value_len):
    let value_byte = sico.bytes.at(value_bytes, index, I64.literal(0))
    let maximum_byte = sico.bytes.at(maximum_bytes, index, I64.literal(0))
    if I64.less_than(value_byte, maximum_byte):
      return true
    end if
    if I64.less_than(maximum_byte, value_byte):
      return false
    end if
    set index = add_u64(index, U64.literal(1))
  end while
  return true
end function

function decimal_digit(byte: I64) returns U64:
  if I64.equal(byte, I64.literal(48)):
    return U64.literal(0)
  end if
  if I64.equal(byte, I64.literal(49)):
    return U64.literal(1)
  end if
  if I64.equal(byte, I64.literal(50)):
    return U64.literal(2)
  end if
  if I64.equal(byte, I64.literal(51)):
    return U64.literal(3)
  end if
  if I64.equal(byte, I64.literal(52)):
    return U64.literal(4)
  end if
  if I64.equal(byte, I64.literal(53)):
    return U64.literal(5)
  end if
  if I64.equal(byte, I64.literal(54)):
    return U64.literal(6)
  end if
  if I64.equal(byte, I64.literal(55)):
    return U64.literal(7)
  end if
  if I64.equal(byte, I64.literal(56)):
    return U64.literal(8)
  end if
  return U64.literal(9)
end function

function decimal_u64(value: Text) returns U64:
  let bytes = sico.text.encode(value)
  let index = U64.literal(0)
  let parsed = U64.literal(0)
  while U64.less_than(index, sico.text.length(value)):
    match U64.checked_mul(parsed, U64.literal(10)):
      case ok(shifted):
        match U64.checked_add(shifted, decimal_digit(sico.bytes.at(bytes, index, I64.literal(0)))):
          case ok(next):
            set parsed = next
          case error(_):
            return U64.literal(0)
        end match
      case error(_):
        return U64.literal(0)
    end match
    set index = add_u64(index, U64.literal(1))
  end while
  return parsed
end function

function hex_digit(value: U64) returns Text:
  if U64.less_than(value, U64.literal(10)):
    return sico.u64.to_text(value)
  end if
  if U64.equal(value, U64.literal(10)):
    return "a"
  end if
  if U64.equal(value, U64.literal(11)):
    return "b"
  end if
  if U64.equal(value, U64.literal(12)):
    return "c"
  end if
  if U64.equal(value, U64.literal(13)):
    return "d"
  end if
  if U64.equal(value, U64.literal(14)):
    return "e"
  end if
  return "f"
end function

function hex_byte(value: U64) returns Text:
  let high = U64.shr(value, U64.literal(4))
  let low = U64.bit_and(value, U64.literal(15))
  return sico.text.concat(hex_digit(high), hex_digit(low))
end function

function hex_digit_i64(value: I64) returns Text:
  if I64.less_than(value, I64.literal(10)):
    return sico.i64.to_text(value)
  end if
  if I64.equal(value, I64.literal(10)):
    return "a"
  end if
  if I64.equal(value, I64.literal(11)):
    return "b"
  end if
  if I64.equal(value, I64.literal(12)):
    return "c"
  end if
  if I64.equal(value, I64.literal(13)):
    return "d"
  end if
  if I64.equal(value, I64.literal(14)):
    return "e"
  end if
  return "f"
end function

function hex_byte_i64(value: I64) returns Text:
  let high = I64.shr(value, I64.literal(4))
  let low = I64.bit_and(value, I64.literal(15))
  return sico.text.concat(hex_digit_i64(high), hex_digit_i64(low))
end function

function bytes_hex(value: Text) returns Text:
  let bytes = sico.text.encode(value)
  let index = U64.literal(0)
  let output = ""
  while U64.less_than(index, sico.text.length(value)):
    let byte = sico.bytes.at(bytes, index, I64.literal(0))
    set output = sico.text.concat(output, hex_byte_i64(byte))
    set index = add_u64(index, U64.literal(1))
  end while
  return output
end function

function uleb_hex(initial: U64) returns Text:
  let value = initial
  let output = ""
  let done = I64.literal(0)
  while I64.equal(done, I64.literal(0)):
    let byte = U64.bit_and(value, U64.literal(127))
    set value = U64.shr(value, U64.literal(7))
    if U64.equal(value, U64.literal(0)):
      set done = I64.literal(1)
    else:
      set byte = U64.bit_or(byte, U64.literal(128))
    end if
    set output = sico.text.concat(output, hex_byte(byte))
  end while
  return output
end function

function uleb_length(initial: U64) returns U64:
  let value = initial
  let count = U64.literal(1)
  while U64.less_than(U64.literal(127), value):
    set value = U64.shr(value, U64.literal(7))
    set count = add_u64(count, U64.literal(1))
  end while
  return count
end function

function positive_sleb_hex(initial: U64) returns Text:
  let value = initial
  let output = ""
  let done = I64.literal(0)
  while I64.equal(done, I64.literal(0)):
    let byte = U64.bit_and(value, U64.literal(127))
    set value = U64.shr(value, U64.literal(7))
    if U64.equal(value, U64.literal(0)):
      if U64.less_than(byte, U64.literal(64)):
        set done = I64.literal(1)
      end if
    end if
    if I64.equal(done, I64.literal(0)):
      set byte = U64.bit_or(byte, U64.literal(128))
    end if
    set output = sico.text.concat(output, hex_byte(byte))
  end while
  return output
end function

function positive_sleb_length(initial: U64) returns U64:
  match U64.checked_div(sico.text.length(positive_sleb_hex(initial)), U64.literal(2)):
    case ok(length):
      return length
    case error(_):
      return U64.literal(0)
  end match
end function

function constant_core_hex(name: Text, value: U64) returns Text:
  let name_len = sico.text.length(name)
  let export_payload_len = add_u64(add_u64(U64.literal(3), name_len), uleb_length(name_len))
  let body_len = add_u64(U64.literal(32), positive_sleb_length(value))
  let code_payload_len = add_u64(add_u64(U64.literal(1), uleb_length(body_len)), body_len)
  let output = "0061736d010000000105016000017e03020100"
  set output = sico.text.concat(output, "07")
  set output = sico.text.concat(output, uleb_hex(export_payload_len))
  set output = sico.text.concat(output, "01")
  set output = sico.text.concat(output, uleb_hex(name_len))
  set output = sico.text.concat(output, bytes_hex(name))
  set output = sico.text.concat(output, "0000")
  set output = sico.text.concat(output, "0a")
  set output = sico.text.concat(output, uleb_hex(code_payload_len))
  set output = sico.text.concat(output, "01")
  set output = sico.text.concat(output, uleb_hex(body_len))
  set output = sico.text.concat(output, "02017e017f41002101024003402001410046044042")
  set output = sico.text.concat(output, positive_sleb_hex(value))
  return sico.text.concat(output, "210020000f0b000b0b000b")
end function

function add_source(fname: Text, left_name: Text, right_name: Text) returns Text:
  let source = sico.text.concat("function ", fname)
  set source = sico.text.concat(source, sico.text.concat("(", left_name))
  set source = sico.text.concat(source, ": Int, ")
  set source = sico.text.concat(source, sico.text.concat(right_name, ": Int) returns Int:\n  return "))
  set source = sico.text.concat(source, sico.text.concat(left_name, " + "))
  set source = sico.text.concat(source, right_name)
  return sico.text.concat(source, "\nend function\n")
end function

function main(input: ScriptInput) returns Result[ScriptOutput, ScriptError]:
  if U64.equal(sico.list.length(input.arguments), U64.literal(1)):
    if same_text(word_at(input.arguments, U64.literal(0)), "--emit-tokens"):
      if sico.bytes.is_utf8(input.stdin):
        return ok(ScriptOutput(stdout: sico.text.encode(compiler_parser.lossless_tokens(input.stdin)), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
      end if
      return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: "source is not UTF-8"))
    end if
    if same_text(word_at(input.arguments, U64.literal(0)), "--emit-ast-metadata"):
      if sico.bytes.is_utf8(input.stdin):
        return ok(ScriptOutput(stdout: sico.text.encode(compiler_parser.parse_metadata(sico.bytes.utf8_decode(input.stdin))), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
      end if
      return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: "source is not UTF-8"))
    end if
    if same_text(word_at(input.arguments, U64.literal(0)), "--emit-core-hex"):
      let codegen_words = lex_words(input.stdin)
      if U64.equal(sico.list.length(codegen_words), U64.literal(8)):
        let codegen_name = word_at(codegen_words, U64.literal(1))
        let codegen_type = word_at(codegen_words, U64.literal(3))
        let codegen_literal = word_at(codegen_words, U64.literal(5))
        if same_text(word_at(codegen_words, U64.literal(0)), "function"):
          if same_text(word_at(codegen_words, U64.literal(2)), "returns"):
            if same_text(codegen_type, "Int"):
              if same_text(word_at(codegen_words, U64.literal(4)), "return"):
                if same_text(word_at(codegen_words, U64.literal(6)), "end"):
                  if same_text(word_at(codegen_words, U64.literal(7)), "function"):
                    if all_digits(codegen_literal):
                      if decimal_at_most(codegen_literal, "9223372036854775807"):
                        if sico.bytes.equal(input.stdin, sico.text.encode(const_source(codegen_name, codegen_type, codegen_literal))):
                          let core_hex = constant_core_hex(codegen_name, decimal_u64(codegen_literal))
                          return ok(ScriptOutput(stdout: sico.text.encode(core_hex), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
                        end if
                      end if
                    end if
                  end if
                end if
              end if
            end if
          end if
        end if
      end if
      return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: "unsupported codegen source shape"))
    end if
  end if
  let words = lex_words(input.stdin)
  if U64.equal(sico.list.length(words), U64.literal(10)):
    let fname = word_at(words, U64.literal(1))
    let pname = word_at(words, U64.literal(2))
    let ptype = word_at(words, U64.literal(3))
    let rtype = word_at(words, U64.literal(5))
    let returned = word_at(words, U64.literal(7))
    let canonical_source = identity_source(fname, pname, ptype)
    let ty = type_json(ptype)
    if same_text(word_at(words, U64.literal(0)), "function"):
      if same_text(word_at(words, U64.literal(4)), "returns"):
        if same_text(word_at(words, U64.literal(6)), "return"):
          if same_text(word_at(words, U64.literal(8)), "end"):
            if same_text(word_at(words, U64.literal(9)), "function"):
              if same_text(ptype, rtype):
                if same_text(pname, returned):
                  if sico.bytes.equal(input.stdin, sico.text.encode(canonical_source)):
                    if U64.less_than(U64.literal(0), sico.text.length(ty)):
                      let source_len = sico.text.length(canonical_source)
                      let param_start = add_u64(U64.literal(10), sico.text.length(fname))
                      let param_end = add_u64(param_start, sico.text.length(pname))
                      let ir = "{\"schema\":\"sico.ir.v0\",\"source_name\":\"identity.sico\",\"source_len\":"
                      set ir = sico.text.concat(ir, sico.u64.to_text(source_len))
                      set ir = sico.text.concat(ir, ",\"functions\":[{\"id\":1,\"name\":\"")
                      set ir = sico.text.concat(ir, fname)
                      set ir = sico.text.concat(ir, "\",\"parameters\":[{\"id\":0,\"name\":\"")
                      set ir = sico.text.concat(ir, pname)
                      set ir = sico.text.concat(ir, "\",\"ty\":")
                      set ir = sico.text.concat(ir, ty)
                      set ir = sico.text.concat(ir, ",\"range\":{\"start\":")
                      set ir = sico.text.concat(ir, sico.u64.to_text(param_start))
                      set ir = sico.text.concat(ir, ",\"end\":")
                      set ir = sico.text.concat(ir, sico.u64.to_text(param_end))
                      set ir = sico.text.concat(ir, "}}],\"return_type\":")
                      set ir = sico.text.concat(ir, ty)
                      set ir = sico.text.concat(ir, ",\"effects\":[],\"entry\":0,\"blocks\":[{\"id\":0,\"instructions\":[],\"terminator\":{\"kind\":\"return\",\"data\":0},\"range\":{\"start\":0,\"end\":")
                      set ir = sico.text.concat(ir, sico.u64.to_text(source_len))
                      set ir = sico.text.concat(ir, "}}],\"range\":{\"start\":0,\"end\":")
                      set ir = sico.text.concat(ir, sico.u64.to_text(source_len))
                      set ir = sico.text.concat(ir, "}}]}")
                      return ok(ScriptOutput(stdout: sico.text.encode(ir), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
                    end if
                  end if
                end if
              end if
            end if
          end if
        end if
      end if
    end if
  end if
  if U64.equal(sico.list.length(words), U64.literal(8)):
    let const_fname = word_at(words, U64.literal(1))
    let const_rtype = word_at(words, U64.literal(3))
    let const_literal = word_at(words, U64.literal(5))
    let const_canonical_source = const_source(const_fname, const_rtype, const_literal)
    if same_text(word_at(words, U64.literal(0)), "function"):
      if same_text(word_at(words, U64.literal(2)), "returns"):
        if same_text(word_at(words, U64.literal(4)), "return"):
          if same_text(word_at(words, U64.literal(6)), "end"):
            if same_text(word_at(words, U64.literal(7)), "function"):
              if same_text(const_rtype, "Int"):
                if all_digits(const_literal):
                  if sico.bytes.equal(input.stdin, sico.text.encode(const_canonical_source)):
                    let const_source_len = sico.text.length(const_canonical_source)
                    let const_literal_start = add_u64(U64.literal(34), sico.text.length(const_fname))
                    let const_literal_end = add_u64(const_literal_start, sico.text.length(const_literal))
                    let const_ir = "{\"schema\":\"sico.ir.v0\",\"source_name\":\"identity.sico\",\"source_len\":"
                    set const_ir = sico.text.concat(const_ir, sico.u64.to_text(const_source_len))
                    set const_ir = sico.text.concat(const_ir, ",\"functions\":[{\"id\":1,\"name\":\"")
                    set const_ir = sico.text.concat(const_ir, const_fname)
                    set const_ir = sico.text.concat(const_ir, "\",\"parameters\":[],\"return_type\":{\"kind\":\"int\"},\"effects\":[],\"entry\":0,\"blocks\":[{\"id\":0,\"instructions\":[{\"result\":0,\"ty\":{\"kind\":\"int\"},\"operation\":{\"op\":\"const_int\",\"data\":\"")
                    set const_ir = sico.text.concat(const_ir, const_literal)
                    set const_ir = sico.text.concat(const_ir, "\"},\"range\":{\"start\":")
                    set const_ir = sico.text.concat(const_ir, sico.u64.to_text(const_literal_start))
                    set const_ir = sico.text.concat(const_ir, ",\"end\":")
                    set const_ir = sico.text.concat(const_ir, sico.u64.to_text(const_literal_end))
                    set const_ir = sico.text.concat(const_ir, "}}],\"terminator\":{\"kind\":\"return\",\"data\":0},\"range\":{\"start\":0,\"end\":")
                    set const_ir = sico.text.concat(const_ir, sico.u64.to_text(const_source_len))
                    set const_ir = sico.text.concat(const_ir, "}}],\"range\":{\"start\":0,\"end\":")
                    set const_ir = sico.text.concat(const_ir, sico.u64.to_text(const_source_len))
                    set const_ir = sico.text.concat(const_ir, "}}]}")
                    return ok(ScriptOutput(stdout: sico.text.encode(const_ir), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
                  end if
                end if
              end if
            end if
          end if
        end if
      end if
    end if
  end if
  if U64.equal(sico.list.length(words), U64.literal(13)):
    let add_fname = word_at(words, U64.literal(1))
    let add_left = word_at(words, U64.literal(2))
    let add_left_type = word_at(words, U64.literal(3))
    let add_right = word_at(words, U64.literal(4))
    let add_right_type = word_at(words, U64.literal(5))
    let add_return_type = word_at(words, U64.literal(7))
    let add_expr_left = word_at(words, U64.literal(9))
    let add_expr_right = word_at(words, U64.literal(10))
    let add_canonical_source = add_source(add_fname, add_left, add_right)
    if same_text(word_at(words, U64.literal(0)), "function"):
      if same_text(word_at(words, U64.literal(6)), "returns"):
