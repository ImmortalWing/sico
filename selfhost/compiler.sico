        end if
      end if
    end if
  end if
  return ""
end function

function less_than_core_hex(source: Bytes, words: List[Text]) returns Text:
  if U64.equal(sico.list.length(words), U64.literal(15)):
    let lt_name = word_at(words, U64.literal(1))
    let lt_type = word_at(words, U64.literal(3))
    let lt_hex = scalar_type_hex(lt_type)
    let lt_family = word_at(words, U64.literal(9))
    let lt_opcode = "53"
    if same_text(lt_family, "I64"):
      set lt_opcode = "53"
    else:
      if same_text(lt_family, "U64"):
        set lt_opcode = "54"
      else:
        return ""
      end if
    end if
    if same_text(word_at(words, U64.literal(0)), "function"):
      if same_text(word_at(words, U64.literal(2)), "a"):
        if same_text(word_at(words, U64.literal(4)), "b"):
          if same_text(word_at(words, U64.literal(6)), "returns"):
            if same_text(word_at(words, U64.literal(7)), "Bool"):
              if same_text(word_at(words, U64.literal(8)), "return"):
                if same_text(word_at(words, U64.literal(10)), "less_than"):
                  if same_text(word_at(words, U64.literal(11)), "a"):
                    if same_text(word_at(words, U64.literal(12)), "b"):
                      if same_text(word_at(words, U64.literal(13)), "end"):
                        if same_text(word_at(words, U64.literal(14)), "function"):
                          if U64.equal(sico.text.length(lt_hex), U64.literal(2)):
                            if same_text(word_at(words, U64.literal(5)), lt_type):
                              if same_text(lt_type, lt_family):
                                let lt_params = sico.text.concat(sico.text.concat("a: ", lt_type), sico.text.concat(", b: ", lt_type))
                                let lt_canonical = canonical_function_source(lt_name, lt_params, "Bool", sico.text.concat(lt_family, ".less_than(a, b)"))
                                if sico.bytes.equal(source, sico.text.encode(lt_canonical)):
                                  let lt_type_content = "016002"
                                  set lt_type_content = sico.text.concat(lt_type_content, lt_hex)
                                  set lt_type_content = sico.text.concat(lt_type_content, lt_hex)
                                  set lt_type_content = sico.text.concat(lt_type_content, "017f")
                                  let lt_body = "02017f017f41002103024003402003410046044020002001"
                                  set lt_body = sico.text.concat(lt_body, lt_opcode)
                                  set lt_body = sico.text.concat(lt_body, "210220020f0b000b0b000b")
                                  return wasm_module_hex(lt_name, lt_type_content, U64.literal(36), lt_body)
                                end if
                              end if
                            end if
                          end if
                        end if
                      end if
                    end if
                  end if
                end if
              end if
            end if
          end if
        end if
      end if
    end if
  end if
  return ""
end function

