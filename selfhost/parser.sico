function gw_instr_count(text: Text) returns U64:
  let gic_bytes = sico.text.encode(text)
  let gic_n = sico.bytes.length(gic_bytes)
  if U64.equal(gic_n, U64.literal(0)):
    return U64.literal(0)
  end if
  let gic_i = U64.literal(0)
  let gic_depth = U64.literal(0)
  let gic_commas = U64.literal(0)
  while U64.less_than(gic_i, gic_n):
    let gic_b = sico.bytes.at(gic_bytes, gic_i, I64.literal(0))
    if I64.equal(gic_b, I64.literal(123)):
      set gic_depth = next_index(gic_depth, gic_depth)
    end if
    if I64.equal(gic_b, I64.literal(125)):
      match U64.checked_sub(gic_depth, U64.literal(1)):
        case ok(gic_less):
          set gic_depth = gic_less
        case error(_):
          return U64.literal(0)
      end match
    end if
    if I64.equal(gic_b, I64.literal(44)):
      if U64.equal(gic_depth, U64.literal(0)):
        set gic_commas = next_index(gic_commas, gic_commas)
      end if
    end if
    set gic_i = next_index(gic_i, gic_n)
  end while
  match U64.checked_add(gic_commas, U64.literal(1)):
    case ok(gic_total):
      return gic_total
    case error(_):
      return U64.literal(0)
  end match
end function
function gw_decimal_value(text: Text) returns U64:
  let gdw_bytes = sico.text.encode(text)
  let gdw_len = sico.bytes.length(gdw_bytes)
  let gdw_i = U64.literal(0)
  let gdw_acc = U64.literal(0)
  while U64.less_than(gdw_i, gdw_len):
    let gdw_b = sico.bytes.at(gdw_bytes, gdw_i, I64.literal(0))
    let gdw_digit = U64.literal(0)
    if I64.equal(gdw_b, I64.literal(48)):
      set gdw_digit = U64.literal(0)
    else:
      if I64.equal(gdw_b, I64.literal(49)):
        set gdw_digit = U64.literal(1)
      else:
        if I64.equal(gdw_b, I64.literal(50)):
          set gdw_digit = U64.literal(2)
        else:
          if I64.equal(gdw_b, I64.literal(51)):
            set gdw_digit = U64.literal(3)
          else:
            if I64.equal(gdw_b, I64.literal(52)):
              set gdw_digit = U64.literal(4)
            else:
              if I64.equal(gdw_b, I64.literal(53)):
                set gdw_digit = U64.literal(5)
              else:
                if I64.equal(gdw_b, I64.literal(54)):
                  set gdw_digit = U64.literal(6)
                else:
                  if I64.equal(gdw_b, I64.literal(55)):
                    set gdw_digit = U64.literal(7)
                  else:
                    if I64.equal(gdw_b, I64.literal(56)):
                      set gdw_digit = U64.literal(8)
                    else:
                      if I64.equal(gdw_b, I64.literal(57)):
                        set gdw_digit = U64.literal(9)
                      end if
                    end if
                  end if
                end if
              end if
            end if
          end if
        end if
      end if
    end if
    match U64.checked_mul(gdw_acc, U64.literal(10)):
      case ok(gdw_shifted):
        match U64.checked_add(gdw_shifted, gdw_digit):
          case ok(gdw_next):
            set gdw_acc = gdw_next
          case error(_):
            return U64.literal(0)
        end match
      case error(_):
        return U64.literal(0)
    end match
    set gdw_i = next_index(gdw_i, gdw_len)
  end while
  return gdw_acc
end function

function gw_compare_packed(words: List[Text], src: Bytes, name_idx: U64, cond_idx: U64, line_end: U64, cond_start: U64, cell_names: List[Text], cell_kinds: List[Text], cell_locals: List[U64], parameter_count: U64, base: U64) returns Text:
  let gcp_ckind = ""
