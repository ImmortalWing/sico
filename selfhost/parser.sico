  set gmo_out = sico.text.concat(gmo_out, sico.text.concat("\n", word_at(words, gmo_bind)))
  set gmo_out = sico.text.concat(gmo_out, sico.text.concat("\n", sico.u64.to_text(gmo_value)))
  set gmo_out = sico.text.concat(gmo_out, sico.text.concat("\n", sico.u64.to_text(cur_blk)))
  return gmo_out
end function

