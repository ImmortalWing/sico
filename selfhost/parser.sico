  set sef_json = sico.text.concat(sef_json, return_kind)
  set sef_json = sico.text.concat(sef_json, "\"},\"effects\":[],\"entry\":0,\"blocks\":[{\"id\":0,\"instructions\":")
  set sef_json = sico.text.concat(sef_json, sef_instructions)
  set sef_json = sico.text.concat(sef_json, ",\"terminator\":{\"kind\":\"return\",\"data\":")
  set sef_json = sico.text.concat(sef_json, sico.u64.to_text(sef_return_value))
  set sef_json = sico.text.concat(sef_json, "},\"range\":{\"start\":")
  set sef_json = sico.text.concat(sef_json, sico.u64.to_text(fn_start))
  set sef_json = sico.text.concat(sef_json, ",\"end\":")
  set sef_json = sico.text.concat(sef_json, sico.u64.to_text(sef_fn_end))
  set sef_json = sico.text.concat(sef_json, "}}],\"range\":{\"start\":")
  set sef_json = sico.text.concat(sef_json, sico.u64.to_text(fn_start))
  set sef_json = sico.text.concat(sef_json, ",\"end\":")
  set sef_json = sico.text.concat(sef_json, sico.u64.to_text(sef_fn_end))
  set sef_json = sico.text.concat(sef_json, "}}")
  return sef_json
end function

function while_call_rhs_packed(words: List[Text], src: Bytes, name_idx: U64, receiver_idx: U64, line_end: U64, expr_start: U64, line_end_offset: U64, cell_names: List[Text], cell_kinds: List[Text], cell_locals: List[U64], parameter_count: U64, base: U64) returns Text:
  let words_len = sico.list.length(words)
  let swl_dummy = I64.literal(0)
  let scl_callee_idx = function_declaration_index(words, word_at(words, receiver_idx))
  if U64.equal(scl_callee_idx, words_len):
    return "ERR:E-SH-IR-CALL-TARGET"
  end if
  let scl_open_idx = next_index(receiver_idx, line_end)
  let scl_close_idx = matching_close(words, scl_open_idx, line_end)
  if U64.equal(next_index(scl_close_idx, line_end), line_end):
    set swl_dummy = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  let scl_args_start = next_index(scl_open_idx, line_end)
  let scl_kind = declared_return_kind(words, next_index(scl_callee_idx, words_len))
  if U64.equal(sico.text.length(scl_kind), U64.literal(0)):
    return "ERR:E-SH-IR-RETURN-TYPE"
  end if
  let scl_callee_params = count_params(words, scl_callee_idx)
  if U64.equal(scl_args_start, scl_close_idx):
    if U64.equal(scl_callee_params, U64.literal(0)):
    return sico.text.concat(scl_kind, sico.text.concat("\n", "[]\n-"))
    else:
      return "ERR:E-SH-IR-CALL-ARITY"
    end if
  else:
    let scl_json = "["
    let scl_emit = ""
    let scl_base = base
    let scl_position = U64.literal(0)
    let scl_seg_start = scl_args_start
    while U64.less_than(scl_seg_start, scl_close_idx):
      let scl_seg_end = scl_close_idx
      let scl_scan = scl_seg_start
      while U64.less_than(scl_scan, scl_close_idx):
        if is_word(word_at(words, scl_scan), "("):
          set scl_scan = next_index(matching_close(words, scl_scan, scl_close_idx), scl_close_idx)
        else:
          if is_word(word_at(words, scl_scan), ","):
            set scl_seg_end = scl_scan
            set scl_scan = scl_close_idx
          else:
            set scl_scan = next_index(scl_scan, scl_close_idx)
          end if
        end if
      end while
      if U64.less_than(scl_position, scl_callee_params):
        set swl_dummy = I64.literal(1)
      else:
        return "ERR:E-SH-IR-CALL-ARITY"
      end if
      let scl_atom = word_at(words, scl_seg_start)
      let scl_arg_kind = ""
      let scl_arg_value = scl_base
      let scl_arg_instr = ""
      let scl_advance = U64.literal(0)
      let scl_seg_offset = word_span_offset(words, src, expr_start, receiver_idx, scl_seg_start)
      let scl_lit = fixed_literal_argument(words, scl_seg_start)
      if sico.text.starts_with(scl_lit, "ERR:"):
        return scl_lit
      end if
      let scl_param = binding_parameter_index(words, name_idx, scl_atom)
      if U64.less_than(scl_param, parameter_count):
        set scl_arg_kind = binding_parameter_kind(words, name_idx, scl_atom)
        set scl_arg_value = scl_param
      else:
        let scl_cell = local_binding_index(cell_names, scl_atom)
        if U64.less_than(scl_cell, sico.list.length(cell_names)):
          set scl_arg_kind = word_at(cell_kinds, scl_cell)
          let scl_seg_end_offset = scl_seg_offset
          match U64.checked_add(scl_seg_offset, sico.bytes.length(sico.text.encode(scl_atom))):
            case ok(scl_after_atom):
              set scl_seg_end_offset = scl_after_atom
            case error(_):
              return "ERR:E-SH-IR-RANGE"
          end match
          set scl_arg_instr = read_local_instruction_json(scl_base, scl_arg_kind, u64_list_at(cell_locals, scl_cell, U64.literal(0)), scl_seg_offset, scl_seg_end_offset)
          set scl_arg_value = scl_base
          set scl_advance = U64.literal(1)
        else:
          set scl_arg_kind = constant_argument_kind(scl_atom)
          if U64.less_than(U64.literal(0), sico.text.length(scl_arg_kind)):
            let scl_const_end_offset = scl_seg_offset
            match U64.checked_add(scl_seg_offset, sico.bytes.length(sico.text.encode(scl_atom))):
              case ok(scl_after_atom):
                set scl_const_end_offset = scl_after_atom
              case error(_):
                return "ERR:E-SH-IR-RANGE"
            end match
            let scl_const_data = json_string_token(scl_atom)
            if is_word(scl_arg_kind, "int"):
              set scl_const_data = sico.text.concat("\"", sico.text.concat(scl_atom, "\""))
            else:
              if is_word(scl_arg_kind, "bool"):
                set scl_const_data = scl_atom
              end if
            end if
            set scl_arg_instr = scalar_const_instruction_json(scl_base, scl_arg_kind, scl_const_data, scl_seg_offset, scl_const_end_offset)
            set scl_arg_value = scl_base
            set scl_advance = U64.literal(1)
          else:
            if U64.less_than(U64.literal(0), sico.text.length(scl_lit)):
              set scl_arg_kind = scl_lit
              set scl_arg_instr = fixed_literal_operand_json(words, src, scl_seg_start, receiver_idx, expr_start, scl_base)
              set scl_arg_value = scl_base
              set scl_advance = U64.literal(1)
            else:
              return "ERR:E-SH-IR-CALL-ARGUMENT"
            end if
          end if
        end if
      end if
      let scl_seg_width = fixed_operation_operand_width(words, scl_seg_start, name_idx)
      let scl_after_value = scl_seg_start
      match U64.checked_add(scl_seg_start, scl_seg_width):
        case ok(scl_after_seg):
          set scl_after_value = scl_after_seg
        case error(_):
          return "ERR:E-SH-IR-CALL-SHAPE"
      end match
      if U64.equal(scl_after_value, scl_seg_end):
        set swl_dummy = I64.literal(1)
      else:
        return "ERR:E-SH-IR-CALL-SHAPE"
      end if
      let scl_expected = parameter_kind_by_id(words, scl_callee_idx, scl_position)
      if is_word(scl_arg_kind, scl_expected):
        set swl_dummy = I64.literal(1)
      else:
        return "ERR:E-SH-IR-CALL-TYPE"
      end if
      if U64.less_than(U64.literal(0), scl_position):
        set scl_json = sico.text.concat(scl_json, ",")
      end if
      set scl_json = sico.text.concat(scl_json, sico.u64.to_text(scl_arg_value))
      if U64.less_than(U64.literal(0), scl_advance):
        if U64.less_than(U64.literal(0), sico.text.length(scl_emit)):
          set scl_emit = sico.text.concat(scl_emit, ",")
        end if
        set scl_emit = sico.text.concat(scl_emit, scl_arg_instr)
        match U64.checked_add(scl_base, scl_advance):
          case ok(scl_advanced):
            set scl_base = scl_advanced
          case error(_):
            return "ERR:E-SH-IR-CALL-ARGUMENT"
        end match
      end if
      set scl_position = next_index(scl_position, scl_position)
      if U64.equal(scl_seg_end, scl_close_idx):
        if U64.equal(scl_position, scl_callee_params):
          set scl_json = sico.text.concat(scl_json, "]")
          break
        else:
          return "ERR:E-SH-IR-CALL-ARITY"
        end if
      else:
        if is_word(word_at(words, scl_seg_end), ","):
          set scl_seg_start = next_index(scl_seg_end, scl_close_idx)
        else:
          return "ERR:E-SH-IR-CALL-SHAPE"
        end if
      end if
    end while
    let scl_emit_out = scl_emit
    if U64.equal(sico.text.length(scl_emit_out), U64.literal(0)):
      set scl_emit_out = "-"
    end if
  return sico.text.concat(scl_kind, sico.text.concat("\n", sico.text.concat(scl_json, sico.text.concat("\n", scl_emit_out))))
  end if
end function
function control_while_function_ir(words: List[Text], src: Bytes, name_idx: U64, body_from: U64, body_end: U64, fn_start: U64, function_ordinal: U64, return_kind: Text, parameter_count: U64) returns Text:
  let swl_words_len = sico.list.length(words)
  let swl_cell_names = sico.text.split_lines("")
  let swl_cell_kinds = sico.text.split_lines("")
  let swl_cell_locals = sico.list.empty[U64]()
  let swl_cell_starts = sico.list.empty[U64]()
  let swl_cell_ends = sico.list.empty[U64]()
  let swl_cell_count = U64.literal(0)
  let swl_b0 = ""
  let swl_b1 = ""
  let swl_b2 = ""
  let swl_b4 = ""
