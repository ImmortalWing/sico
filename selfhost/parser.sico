    return "ERR:E-SH-IR-CALL-ARGUMENT"
  end if
  let sbl_cursor_cell = local_binding_index(cell_names, word_at(words, sbl_cursor))
  if U64.less_than(sbl_cursor_cell, sico.list.length(cell_names)):
    if is_word(word_at(cell_kinds, sbl_cursor_cell), "u64"):
