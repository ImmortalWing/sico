      let sws_keyword_offset = find_text_from(src, swk_word, swl_cursor)
      let sws_binding_offset = word_span_offset(words, src, sws_keyword_offset, swl_idx, sws_binding_idx)
      let sws_binding_end = sws_binding_offset
