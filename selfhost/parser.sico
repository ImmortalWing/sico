  let gcp_r_width = fixed_operation_operand_width(words, gcp_r_idx, name_idx)
  let gcp_close_idx = gcp_r_idx
  match U64.checked_add(gcp_r_idx, gcp_r_width):
    case ok(gcp_after_r):
