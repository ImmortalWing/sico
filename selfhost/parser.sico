function straight_let_function_ir(words: List[Text], src: Bytes, name_idx: U64, body_from: U64, body_end: U64, fn_start: U64, function_ordinal: U64, return_kind: Text, parameter_count: U64) returns Text:
  let sl_words_len = sico.list.length(words)
  let sl_let_idx = body_from
  while U64.less_than(sl_let_idx, body_end):
    if is_word(word_at(words, sl_let_idx), "let"):
      let sl_found_let = I64.literal(1)
