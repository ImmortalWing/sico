        end if
        if U64.less_than(U64.literal(0), count_until_end_function(words, body_from, "while")):
          let general_while_json = general_while_function_ir(words, src, name_idx, body_from, body_end_word, fn_start, function_ordinal, return_type_kind, parameter_count)
