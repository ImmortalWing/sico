record ScriptInput:
  field arguments: List[Text]
  field stdin: Bytes
end record

record ScriptOutput:
  field stdout: Bytes
  field stderr: Bytes
  field exit_code: I64
end record

enum ScriptErrorCode:
  case InvalidInput
  case ResourceLimit
  case DomainError
  case Cancelled
end enum

record ScriptError:
  field code: ScriptErrorCode
  field message: Text
end record

function is_ident_byte(b: I64) returns Bool:
  if I64.equal(b, I64.literal(95)):
    return true
  end if
  if I64.less_than(b, I64.literal(48)):
    return false
  end if
  if I64.less_than(b, I64.literal(58)):
    return true
  end if
  if I64.less_than(b, I64.literal(65)):
    return false
  end if
  if I64.less_than(b, I64.literal(91)):
    return true
  end if
  if I64.less_than(b, I64.literal(97)):
    return false
  end if
  if I64.less_than(b, I64.literal(123)):
    return true
  end if
  return false
end function

function is_punct_byte(b: I64) returns Bool:
  if I64.equal(b, I64.literal(45)):
    return true
  end if
  if I64.equal(b, I64.literal(61)):
    return true
  end if
  if I64.equal(b, I64.literal(46)):
    return true
  end if
  if I64.equal(b, I64.literal(40)):
    return true
  end if
  if I64.equal(b, I64.literal(41)):
    return true
  end if
  if I64.equal(b, I64.literal(44)):
    return true
  end if
  if I64.equal(b, I64.literal(58)):
    return true
  end if
  if I64.equal(b, I64.literal(91)):
    return true
  end if
  if I64.equal(b, I64.literal(93)):
    return true
  end if
  return false
end function

function is_word(w: Text, target: Text) returns Bool:
  return sico.bytes.equal(sico.text.encode(w), sico.text.encode(target))
end function

function is_declaration_start(prev: Text) returns Bool:
  if is_word(prev, "end"):
    return false
  end if
  return true
end function

function lex_words(src: Bytes) returns List[Text]:
  let byte_len = sico.bytes.length(src)
  let index = U64.literal(0)
  let words = sico.text.split_lines("")
  let in_ident = I64.literal(0)
  let in_string = I64.literal(0)
  let escaped = I64.literal(0)
  let word_start = U64.literal(0)
  let word_len = U64.literal(0)
  let string_start = U64.literal(0)
  let string_len = U64.literal(0)
  while U64.less_than(index, byte_len):
    let b = sico.bytes.at(src, index, I64.literal(0))
    if I64.equal(in_string, I64.literal(1)):
      match U64.checked_add(string_len, U64.literal(1)):
        case ok(next):
          set string_len = next
        case error(_):
          return sico.text.split_lines("ERR-overflow")
      end match
      if I64.equal(escaped, I64.literal(1)):
        if valid_escape_byte(b):
          set escaped = I64.literal(0)
        else:
          return sico.text.split_lines("ERR-string-escape")
        end if
      else:
        if I64.equal(b, I64.literal(92)):
          set escaped = I64.literal(1)
        else:
          if I64.equal(b, I64.literal(34)):
            match sico.bytes.slice(src, string_start, string_len):
              case ok(string_bytes):
                set words = sico.list.append(words, sico.bytes.utf8_decode(string_bytes))
              case error(_):
                return sico.text.split_lines("ERR-slice")
            end match
            set in_string = I64.literal(0)
          end if
        end if
      end if
    else:
      if is_ident_byte(b):
        if I64.equal(in_ident, I64.literal(0)):
          set word_start = index
          set word_len = U64.literal(0)
          set in_ident = I64.literal(1)
        end if
        match U64.checked_add(word_len, U64.literal(1)):
          case ok(next):
            set word_len = next
          case error(_):
            return sico.text.split_lines("ERR-overflow")
        end match
      else:
        if I64.equal(in_ident, I64.literal(1)):
          let captured_start = word_start
          let captured_len = word_len
          match sico.bytes.slice(src, captured_start, captured_len):
            case ok(slice_bytes):
              set words = sico.list.append(words, sico.bytes.utf8_decode(slice_bytes))
            case error(_):
              return sico.text.split_lines("ERR-slice")
          end match
          set in_ident = I64.literal(0)
        end if
        if I64.equal(b, I64.literal(34)):
          set string_start = index
          set string_len = U64.literal(1)
          set escaped = I64.literal(0)
          set in_string = I64.literal(1)
        else:
          if I64.equal(b, I64.literal(10)):
            set words = sico.list.append(words, "<nl>")
          else:
            if is_punct_byte(b):
              match sico.bytes.slice(src, index, U64.literal(1)):
                case ok(punct_bytes):
                  set words = sico.list.append(words, sico.bytes.utf8_decode(punct_bytes))
                case error(_):
                  return sico.text.split_lines("ERR-slice")
              end match
            end if
          end if
        end if
      end if
    end if
    match U64.checked_add(index, U64.literal(1)):
      case ok(next):
        set index = next
      case error(_):
        return sico.text.split_lines("ERR-overflow")
    end match
  end while
  if I64.equal(in_string, I64.literal(1)):
    return sico.text.split_lines("ERR-string")
  end if
  if I64.equal(in_ident, I64.literal(1)):
    match sico.bytes.slice(src, word_start, word_len):
      case ok(slice_bytes):
        set words = sico.list.append(words, sico.bytes.utf8_decode(slice_bytes))
      case error(_):
        return sico.text.split_lines("ERR-slice")
    end match
  end if
  return words
end function

function word_at(words: List[Text], i: U64) returns Text:
  match sico.list.get(words, i):
    case ok(w):
      return w
    case error(_):
      return "?"
  end match
end function

function next_index(i: U64, fallback: U64) returns U64:
  match U64.checked_add(i, U64.literal(1)):
    case ok(next):
      return next
    case error(_):
      return fallback
  end match
end function

function line_end(words: List[Text], from_idx: U64) returns U64:
  let n = sico.list.length(words)
  let i = from_idx
  while U64.less_than(i, n):
    if is_word(word_at(words, i), "<nl>"):
      return i
    end if
    set i = next_index(i, n)
  end while
  return n
end function

function is_digit_token(w: Text) returns Bool:
  let bytes = sico.text.encode(w)
  if U64.equal(sico.text.length(w), U64.literal(0)):
    return false
  end if
  let b = sico.bytes.at(bytes, U64.literal(0), I64.literal(0))
  if I64.less_than(b, I64.literal(48)):
    return false
  end if
  return I64.less_than(b, I64.literal(58))
end function

function is_string_token(w: Text) returns Bool:
  let bytes = sico.text.encode(w)
  let n = sico.bytes.length(bytes)
  if U64.less_than(n, U64.literal(2)):
    return false
  end if
  return I64.equal(sico.bytes.at(bytes, U64.literal(0), I64.literal(0)), I64.literal(34))
end function

function valid_escape_byte(b: I64) returns Bool:
  if I64.equal(b, I64.literal(34)):
    return true
  end if
  if I64.equal(b, I64.literal(92)):
    return true
  end if
  if I64.equal(b, I64.literal(110)):
    return true
  end if
  if I64.equal(b, I64.literal(114)):
    return true
  end if
  if I64.equal(b, I64.literal(116)):
    return true
  end if
  return I64.equal(b, I64.literal(48))
end function

function json_string_token(token: Text) returns Text:
  let bytes = sico.text.encode(token)
  let n = sico.bytes.length(bytes)
  let i = U64.literal(0)
  let segment_start = U64.literal(0)
  let out = ""
  while U64.less_than(i, n):
    let b = sico.bytes.at(bytes, i, I64.literal(0))
    if I64.equal(b, I64.literal(92)):
      let escape_idx = next_index(i, n)
      if U64.less_than(escape_idx, n):
        if I64.equal(sico.bytes.at(bytes, escape_idx, I64.literal(0)), I64.literal(48)):
          let prefix_len = U64.literal(0)
          match U64.checked_sub(i, segment_start):
            case ok(length):
              set prefix_len = length
            case error(_):
              set prefix_len = U64.literal(0)
          end match
          if U64.less_than(U64.literal(0), prefix_len):
            match sico.bytes.slice(bytes, segment_start, prefix_len):
              case ok(prefix):
                set out = sico.text.concat(out, sico.bytes.utf8_decode(prefix))
              case error(_):
                set out = token
            end match
          end if
          set out = sico.text.concat(out, "\\u0000")
          set i = next_index(escape_idx, n)
          set segment_start = i
          continue
        end if
      end if
    end if
    set i = next_index(i, n)
  end while
  let tail_len = U64.literal(0)
  match U64.checked_sub(n, segment_start):
    case ok(length):
      set tail_len = length
    case error(_):
      set tail_len = U64.literal(0)
  end match
  if U64.less_than(U64.literal(0), tail_len):
    match sico.bytes.slice(bytes, segment_start, tail_len):
      case ok(tail):
        set out = sico.text.concat(out, sico.bytes.utf8_decode(tail))
      case error(_):
        set out = token
    end match
  end if
  return out
end function

function matching_close(words: List[Text], open_idx: U64, end_idx: U64) returns U64:
  let i = open_idx
  let depth = U64.literal(0)
  while U64.less_than(i, end_idx):
    let w = word_at(words, i)
    if is_word(w, "("):
      match U64.checked_add(depth, U64.literal(1)):
        case ok(next):
          set depth = next
        case error(_):
          return end_idx
      end match
    else:
      if is_word(w, ")"):
        match U64.checked_sub(depth, U64.literal(1)):
          case ok(next):
            set depth = next
            if U64.equal(depth, U64.literal(0)):
              return i
            end if
          case error(_):
            return end_idx
        end match
      end if
    end if
    set i = next_index(i, end_idx)
  end while
  return end_idx
end function

function expression_shape_depth(words: List[Text], from_idx: U64, end_idx: U64, level: U64) returns Text:
  if U64.less_than(U64.literal(63), level):
    return "error:depth"
  end if
  if U64.equal(from_idx, end_idx):
    return "none"
  end if
  if U64.equal(next_index(from_idx, end_idx), end_idx):
    let atom = word_at(words, from_idx)
    if is_string_token(atom):
      return sico.text.concat("string:", atom)
    end if
    if is_digit_token(atom):
      return sico.text.concat("int:", atom)
    end if
    if is_word(atom, "true"):
      return "bool:true"
    end if
    if is_word(atom, "false"):
      return "bool:false"
    end if
    return sico.text.concat("name:", atom)
  end if
  let second = next_index(from_idx, end_idx)
  if U64.equal(next_index(second, end_idx), end_idx):
    if is_word(word_at(words, from_idx), "-"):
      let magnitude = word_at(words, second)
      if is_digit_token(magnitude):
        return sico.text.concat("int:-", magnitude)
      end if
    end if
  end if
  if is_word(word_at(words, from_idx), "("):
    let outer_close = matching_close(words, from_idx, end_idx)
    if U64.equal(next_index(outer_close, end_idx), end_idx):
      return expression_shape_depth(words, next_index(from_idx, end_idx), outer_close, next_index(level, level))
    end if
  end if
  let i = from_idx
  let callee = ""
  let open = end_idx
  while U64.less_than(i, end_idx):
    let w = word_at(words, i)
    if is_word(w, "("):
      set open = i
      break
    end if
    set callee = sico.text.concat(callee, w)
    set i = next_index(i, end_idx)
  end while
  if U64.equal(open, end_idx):
    return "unsupported"
  end if
  let close = matching_close(words, open, end_idx)
  if U64.equal(close, end_idx):
    return "error:close"
  end if
  if U64.less_than(next_index(close, end_idx), end_idx):
    return "unsupported"
  end if
  let args = ""
  let arg_start = next_index(open, close)
  set i = arg_start
  let nested = U64.literal(0)
  while U64.less_than(i, close):
    let arg_word = word_at(words, i)
    if is_word(arg_word, "("):
      set nested = next_index(nested, nested)
    else:
      if is_word(arg_word, ")"):
        match U64.checked_sub(nested, U64.literal(1)):
          case ok(next):
            set nested = next
          case error(_):
            return "error:close"
        end match
      else:
        if is_word(arg_word, ","):
          if U64.equal(nested, U64.literal(0)):
            if U64.less_than(U64.literal(0), sico.text.length(args)):
              set args = sico.text.concat(args, ",")
            end if
            set args = sico.text.concat(args, expression_shape_depth(words, arg_start, i, next_index(level, level)))
            set arg_start = next_index(i, close)
          end if
        end if
      end if
    end if
    set i = next_index(i, close)
  end while
  if U64.less_than(arg_start, close):
    if U64.less_than(U64.literal(0), sico.text.length(args)):
      set args = sico.text.concat(args, ",")
    end if
    set args = sico.text.concat(args, expression_shape_depth(words, arg_start, close, next_index(level, level)))
  end if
  return sico.text.concat("call:", sico.text.concat(callee, sico.text.concat("(", sico.text.concat(args, ")"))))
end function

function expression_shape(words: List[Text], from_idx: U64, end_idx: U64) returns Text:
  return expression_shape_depth(words, from_idx, end_idx, U64.literal(0))
end function

function return_shapes(words: List[Text], from_idx: U64) returns Text:
  let n = sico.list.length(words)
  let i = from_idx
  let shapes = ""
  while U64.less_than(i, n):
    let w = word_at(words, i)
    if is_word(w, "end"):
      let next = next_index(i, n)
      if U64.less_than(next, n):
        if is_word(word_at(words, next), "function"):
          return shapes
        end if
      end if
    end if
    if is_word(w, "return"):
      let start = next_index(i, n)
      let finish = line_end(words, start)
      if U64.less_than(U64.literal(0), sico.text.length(shapes)):
        set shapes = sico.text.concat(shapes, ",")
      end if
      set shapes = sico.text.concat(shapes, expression_shape(words, start, finish))
      set i = finish
    end if
    set i = next_index(i, n)
  end while
  return shapes
end function

function count_until_end_function(words: List[Text], from_idx: U64, target: Text) returns U64:
  let n = sico.list.length(words)
  let i = from_idx
  let count = U64.literal(0)
  let skip_next = I64.literal(0)
  while U64.less_than(i, n):
    match sico.list.get(words, i):
      case ok(w):
        if I64.equal(skip_next, I64.literal(1)):
          set skip_next = I64.literal(0)
        else:
          if is_word(w, "end"):
            match U64.checked_add(i, U64.literal(1)):
              case ok(next):
                if U64.less_than(next, n):
                  if is_word(word_at(words, next), "function"):
                    return count
                  else:
                    set skip_next = I64.literal(1)
                  end if
                else:
                  return count
                end if
              case error(_):
                return count
            end match
          else:
            if is_word(w, target):
              match U64.checked_add(count, U64.literal(1)):
                case ok(next):
                  set count = next
                case error(_):
                  return count
              end match
            end if
          end if
        end if
        match U64.checked_add(i, U64.literal(1)):
          case ok(next):
            set i = next
          case error(_):
            return count
        end match
      case error(_):
        return count
    end match
  end while
  return count
end function

function find_body_end(words: List[Text], from_idx: U64) returns U64:
  let n = sico.list.length(words)
  let i = from_idx
  while U64.less_than(i, n):
    match sico.list.get(words, i):
      case ok(w):
        if is_word(w, "end"):
          match U64.checked_add(i, U64.literal(1)):
            case ok(next):
              if U64.less_than(next, n):
                if is_word(word_at(words, next), "function"):
                  match U64.checked_add(next, U64.literal(1)):
                    case ok(past):
                      return past
                    case error(_):
                      return n
                  end match
                end if
              else:
                return n
              end if
            case error(_):
              return n
          end match
        end if
        match U64.checked_add(i, U64.literal(1)):
          case ok(next):
            set i = next
          case error(_):
            return n
        end match
      case error(_):
        return n
    end match
  end while
  return n
end function

function fn_entry(fname: Text, params: Text, words: List[Text], body_from: U64) returns Text:
  let c_for = count_until_end_function(words, body_from, "for")
  let c_while = count_until_end_function(words, body_from, "while")
  let c_if = count_until_end_function(words, body_from, "if")
  let c_match = count_until_end_function(words, body_from, "match")
  let c_let = count_until_end_function(words, body_from, "let")
  let c_set = count_until_end_function(words, body_from, "set")
  let c_return = count_until_end_function(words, body_from, "return")
  let expressions = return_shapes(words, body_from)
  let entry = sico.text.concat("fn:", sico.text.concat(fname, sico.text.concat("/", params)))
  set entry = sico.text.concat(entry, sico.text.concat("{for=", sico.u64.to_text(c_for)))
  set entry = sico.text.concat(entry, sico.text.concat(",while=", sico.u64.to_text(c_while)))
  set entry = sico.text.concat(entry, sico.text.concat(",if=", sico.u64.to_text(c_if)))
  set entry = sico.text.concat(entry, sico.text.concat(",match=", sico.u64.to_text(c_match)))
  set entry = sico.text.concat(entry, sico.text.concat(",let=", sico.u64.to_text(c_let)))
  set entry = sico.text.concat(entry, sico.text.concat(",set=", sico.u64.to_text(c_set)))
  set entry = sico.text.concat(entry, sico.text.concat(",return=", sico.u64.to_text(c_return)))
  set entry = sico.text.concat(entry, sico.text.concat(",expr=[", sico.text.concat(expressions, "]")))
  return sico.text.concat(entry, "};")
end function

function count_params(words: List[Text], from_idx: U64) returns U64:
  let n = sico.list.length(words)
  let i = from_idx
  let seen_open = I64.literal(0)
  let commas = U64.literal(0)
  let seen_any = I64.literal(0)
  while U64.less_than(i, n):
    match sico.list.get(words, i):
      case ok(w):
        if is_word(w, "("):
          set seen_open = I64.literal(1)
        else:
          if is_word(w, ")"):
            if I64.equal(seen_open, I64.literal(1)):
              if I64.equal(seen_any, I64.literal(1)):
                match U64.checked_add(commas, U64.literal(1)):
                  case ok(params):
                    return params
                  case error(_):
                    return commas
                end match
              end if
              return commas
            end if
          else:
            if I64.equal(seen_open, I64.literal(1)):
              if is_word(w, ","):
                match U64.checked_add(commas, U64.literal(1)):
                  case ok(next):
                    set commas = next
                  case error(_):
                    return commas
                end match
              else:
                set seen_any = I64.literal(1)
              end if
            end if
          end if
        end if
        match U64.checked_add(i, U64.literal(1)):
          case ok(next):
            set i = next
          case error(_):
            return commas
        end match
      case error(_):
        return commas
    end match
  end while
  return commas
end function

function summarize(words: List[Text]) returns Text:
  let n = sico.list.length(words)
  let i = U64.literal(0)
  let summary = ""
  let prev = ""
  while U64.less_than(i, n):
    match sico.list.get(words, i):
      case ok(w):
        if is_word(w, "function"):
          if is_declaration_start(prev):
            match U64.checked_add(i, U64.literal(1)):
              case ok(name_idx):
                if U64.less_than(name_idx, n):
                  let fname = word_at(words, name_idx)
                  let params = count_params(words, name_idx)
                  match U64.checked_add(name_idx, U64.literal(1)):
                    case ok(body_from):
                      set summary = sico.text.concat(summary, fn_entry(fname, sico.u64.to_text(params), words, body_from))
                      set i = find_body_end(words, body_from)
                      set prev = "function"
                      continue
                    case error(_):
                      return summary
                  end match
                end if
              case error(_):
                return summary
            end match
          end if
        end if
        set prev = w
        match U64.checked_add(i, U64.literal(1)):
          case ok(next):
            set i = next
          case error(_):
            return summary
        end match
      case error(_):
        return summary
    end match
  end while
  return summary
end function

function invalid_input(message: Text) returns Result[ScriptOutput, ScriptError]:
  return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: message))
end function

function is_canonical_magnitude(w: Text) returns Bool:
  let bytes = sico.text.encode(w)
  let n = sico.bytes.length(bytes)
  if U64.equal(n, U64.literal(0)):
    return false
  end if
  if U64.less_than(U64.literal(1), n):
    if I64.equal(sico.bytes.at(bytes, U64.literal(0), I64.literal(0)), I64.literal(48)):
      return false
    end if
  end if
  let i = U64.literal(0)
  while U64.less_than(i, n):
    let b = sico.bytes.at(bytes, i, I64.literal(0))
    if I64.less_than(b, I64.literal(48)):
      return false
    end if
    if I64.equal(b, I64.literal(58)):
      return false
    end if
    if I64.less_than(I64.literal(58), b):
      return false
    end if
    set i = next_index(i, n)
  end while
  return true
end function

function decimal_at_most(value: Text, maximum: Text) returns Bool:
  let value_bytes = sico.text.encode(value)
  let maximum_bytes = sico.text.encode(maximum)
  let value_len = sico.bytes.length(value_bytes)
  let maximum_len = sico.bytes.length(maximum_bytes)
  if U64.less_than(value_len, maximum_len):
    return true
  end if
  if U64.less_than(maximum_len, value_len):
    return false
  end if
  let i = U64.literal(0)
  while U64.less_than(i, value_len):
    let actual = sico.bytes.at(value_bytes, i, I64.literal(0))
    let limit = sico.bytes.at(maximum_bytes, i, I64.literal(0))
    if I64.less_than(actual, limit):
      return true
    end if
    if I64.less_than(limit, actual):
      return false
    end if
    set i = next_index(i, value_len)
  end while
  return true
end function

function has_return_at(src: Bytes, index: U64) returns Bool:
  let n = sico.bytes.length(src)
  let i1 = next_index(index, n)
  let i2 = next_index(i1, n)
  let i3 = next_index(i2, n)
  let i4 = next_index(i3, n)
  let i5 = next_index(i4, n)
  if U64.equal(i5, n):
    return false
  end if
  if I64.equal(sico.bytes.at(src, index, I64.literal(0)), I64.literal(114)):
    let matched_r = I64.literal(1)
  else:
    return false
  end if
  if I64.equal(sico.bytes.at(src, i1, I64.literal(0)), I64.literal(101)):
    let matched_e = I64.literal(1)
  else:
    return false
  end if
  if I64.equal(sico.bytes.at(src, i2, I64.literal(0)), I64.literal(116)):
    let matched_t = I64.literal(1)
  else:
    return false
  end if
  if I64.equal(sico.bytes.at(src, i3, I64.literal(0)), I64.literal(117)):
    let matched_u = I64.literal(1)
  else:
    return false
  end if
  if I64.equal(sico.bytes.at(src, i4, I64.literal(0)), I64.literal(114)):
    let matched_second_r = I64.literal(1)
  else:
    return false
  end if
  if I64.equal(sico.bytes.at(src, i5, I64.literal(0)), I64.literal(110)):
    let after = next_index(i5, n)
    if U64.less_than(after, n):
      if is_ident_byte(sico.bytes.at(src, after, I64.literal(0))):
        return false
      end if
    end if
    return true
  end if
  return false
end function

function return_expression_start(src: Bytes, from_idx: U64) returns U64:
  let n = sico.bytes.length(src)
  let i = from_idx
  while U64.less_than(i, n):
    if has_return_at(src, i):
      let j = i
      match U64.checked_add(i, U64.literal(6)):
        case ok(after_keyword):
          set j = after_keyword
        case error(_):
          return n
      end match
      while U64.less_than(j, n):
        let b = sico.bytes.at(src, j, I64.literal(0))
        if I64.equal(b, I64.literal(10)):
          return n
        end if
        if I64.equal(b, I64.literal(32)):
          set j = next_index(j, n)
        else:
          if I64.equal(b, I64.literal(9)):
            set j = next_index(j, n)
          else:
            if I64.equal(b, I64.literal(13)):
              set j = next_index(j, n)
            else:
              return j
            end if
          end if
        end if
      end while
      return n
    end if
    set i = next_index(i, n)
  end while
  return n
end function

function parameter_name_start(src: Bytes, from_idx: U64) returns U64:
  let n = sico.bytes.length(src)
  let i = from_idx
  while U64.less_than(i, n):
    if I64.equal(sico.bytes.at(src, i, I64.literal(0)), I64.literal(40)):
      let j = next_index(i, n)
      while U64.less_than(j, n):
        let b = sico.bytes.at(src, j, I64.literal(0))
        if I64.equal(b, I64.literal(32)):
          set j = next_index(j, n)
        else:
          if I64.equal(b, I64.literal(9)):
            set j = next_index(j, n)
          else:
            return j
          end if
        end if
      end while
      return n
    end if
    set i = next_index(i, n)
  end while
  return n
end function

function scalar_type_kind(type_name: Text) returns Text:
  if is_word(type_name, "Int"):
    return "int"
  end if
  if is_word(type_name, "Bool"):
    return "bool"
  end if
  if is_word(type_name, "Text"):
    return "string"
  end if
  if is_word(type_name, "I64"):
    return "i64"
  end if
  if is_word(type_name, "U64"):
    return "u64"
  end if
  return "ERR:E-SH-IR-PARAMETER-TYPE"
end function

function find_text_from(src: Bytes, needle: Text, from_idx: U64) returns U64:
  let source_len_find = sico.bytes.length(src)
  let needle_bytes_find = sico.text.encode(needle)
  let needle_len_find = sico.bytes.length(needle_bytes_find)
  if U64.equal(needle_len_find, U64.literal(0)):
    return source_len_find
  end if
  let candidate_find = from_idx
  while U64.less_than(candidate_find, source_len_find):
    let offset_find = U64.literal(0)
    let matched_find = I64.literal(1)
    while U64.less_than(offset_find, needle_len_find):
      let source_index_find = source_len_find
      match U64.checked_add(candidate_find, offset_find):
        case ok(found_index_find):
          set source_index_find = found_index_find
        case error(_):
          set matched_find = I64.literal(0)
      end match
      if U64.less_than(source_index_find, source_len_find):
        if I64.equal(sico.bytes.at(src, source_index_find, I64.literal(0)), sico.bytes.at(needle_bytes_find, offset_find, I64.literal(0))):
          let same_byte_find = I64.literal(1)
        else:
          set matched_find = I64.literal(0)
        end if
      else:
        set matched_find = I64.literal(0)
      end if
      set offset_find = next_index(offset_find, needle_len_find)
    end while
    if I64.equal(matched_find, I64.literal(1)):
      return candidate_find
    end if
    set candidate_find = next_index(candidate_find, source_len_find)
  end while
  return source_len_find
end function

function parameters_ir(words: List[Text], function_name_idx: U64, src: Bytes, search_from: U64) returns Text:
  let parameter_words_len = sico.list.length(words)
  let parameter_source_len = sico.bytes.length(src)
  let parameter_open_idx = next_index(function_name_idx, parameter_words_len)
  if is_word(word_at(words, parameter_open_idx), "("):
    let parameter_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-PARAMETERS"
  end if
  let parameter_token_idx = next_index(parameter_open_idx, parameter_words_len)
  let parameter_id = U64.literal(0)
  let parameter_search_from = parameter_name_start(src, search_from)
  let parameter_json = "["
  while U64.less_than(parameter_token_idx, parameter_words_len):
    if is_word(word_at(words, parameter_token_idx), ")"):
      return sico.text.concat(parameter_json, "]")
    end if
    let parameter_item_name = word_at(words, parameter_token_idx)
    let parameter_colon_idx = next_index(parameter_token_idx, parameter_words_len)
    let parameter_type_idx = next_index(parameter_colon_idx, parameter_words_len)
    let parameter_after_type_idx = next_index(parameter_type_idx, parameter_words_len)
    if is_word(word_at(words, parameter_colon_idx), ":"):
      let parameter_colon_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-PARAMETERS"
    end if
    let parameter_item_type = word_at(words, parameter_type_idx)
    let parameter_item_kind = scalar_type_kind(parameter_item_type)
    if sico.text.starts_with(parameter_item_kind, "ERR:"):
      return parameter_item_kind
    end if
    let parameter_item_start = find_text_from(src, parameter_item_name, parameter_search_from)
    if U64.equal(parameter_item_start, parameter_source_len):
      return "ERR:E-SH-IR-PARAMETER-RANGE"
    end if
    let parameter_item_end = parameter_item_start
    match U64.checked_add(parameter_item_start, sico.bytes.length(sico.text.encode(parameter_item_name))):
      case ok(parameter_name_after):
        set parameter_item_end = parameter_name_after
      case error(_):
        return "ERR:E-SH-IR-PARAMETER-RANGE"
    end match
    let parameter_type_start = find_text_from(src, parameter_item_type, parameter_item_end)
    if U64.equal(parameter_type_start, parameter_source_len):
      return "ERR:E-SH-IR-PARAMETER-RANGE"
    end if
    match U64.checked_add(parameter_type_start, sico.bytes.length(sico.text.encode(parameter_item_type))):
      case ok(parameter_type_after):
        set parameter_search_from = parameter_type_after
      case error(_):
        return "ERR:E-SH-IR-PARAMETER-RANGE"
    end match
    if U64.less_than(U64.literal(0), parameter_id):
      set parameter_json = sico.text.concat(parameter_json, ",")
    end if
    set parameter_json = sico.text.concat(parameter_json, "{\"id\":")
    set parameter_json = sico.text.concat(parameter_json, sico.u64.to_text(parameter_id))
    set parameter_json = sico.text.concat(parameter_json, ",\"name\":\"")
    set parameter_json = sico.text.concat(parameter_json, parameter_item_name)
    set parameter_json = sico.text.concat(parameter_json, "\",\"ty\":{\"kind\":\"")
    set parameter_json = sico.text.concat(parameter_json, parameter_item_kind)
    set parameter_json = sico.text.concat(parameter_json, "\"},\"range\":{\"start\":")
    set parameter_json = sico.text.concat(parameter_json, sico.u64.to_text(parameter_item_start))
    set parameter_json = sico.text.concat(parameter_json, ",\"end\":")
    set parameter_json = sico.text.concat(parameter_json, sico.u64.to_text(parameter_item_end))
    set parameter_json = sico.text.concat(parameter_json, "}}")
    set parameter_id = next_index(parameter_id, parameter_id)
    if is_word(word_at(words, parameter_after_type_idx), ","):
      set parameter_token_idx = next_index(parameter_after_type_idx, parameter_words_len)
    else:
      if is_word(word_at(words, parameter_after_type_idx), ")"):
        set parameter_token_idx = parameter_after_type_idx
      else:
        return "ERR:E-SH-IR-PARAMETERS"
      end if
    end if
  end while
  return "ERR:E-SH-IR-PARAMETERS"
end function

function binding_parameter_index(words: List[Text], function_name_idx: U64, binding: Text) returns U64:
  let binding_words_len = sico.list.length(words)
  let binding_open_idx = next_index(function_name_idx, binding_words_len)
  let binding_token_idx = next_index(binding_open_idx, binding_words_len)
  let binding_id = U64.literal(0)
  while U64.less_than(binding_token_idx, binding_words_len):
    if is_word(word_at(words, binding_token_idx), ")"):
      return binding_words_len
    end if
    if is_word(word_at(words, binding_token_idx), binding):
      return binding_id
    end if
    let binding_colon_idx = next_index(binding_token_idx, binding_words_len)
    let binding_type_idx = next_index(binding_colon_idx, binding_words_len)
    let binding_separator_idx = next_index(binding_type_idx, binding_words_len)
    if is_word(word_at(words, binding_separator_idx), ","):
      set binding_token_idx = next_index(binding_separator_idx, binding_words_len)
      set binding_id = next_index(binding_id, binding_id)
    else:
      return binding_words_len
    end if
  end while
  return binding_words_len
end function

function binding_parameter_kind(words: List[Text], function_name_idx: U64, binding: Text) returns Text:
  let binding_kind_words_len = sico.list.length(words)
  let binding_kind_open_idx = next_index(function_name_idx, binding_kind_words_len)
  let binding_kind_token_idx = next_index(binding_kind_open_idx, binding_kind_words_len)
  while U64.less_than(binding_kind_token_idx, binding_kind_words_len):
    if is_word(word_at(words, binding_kind_token_idx), ")"):
      return "ERR:E-SH-IR-UNRESOLVED"
    end if
    let binding_kind_colon_idx = next_index(binding_kind_token_idx, binding_kind_words_len)
    let binding_kind_type_idx = next_index(binding_kind_colon_idx, binding_kind_words_len)
    if is_word(word_at(words, binding_kind_token_idx), binding):
      return scalar_type_kind(word_at(words, binding_kind_type_idx))
    end if
    let binding_kind_separator_idx = next_index(binding_kind_type_idx, binding_kind_words_len)
    if is_word(word_at(words, binding_kind_separator_idx), ","):
      set binding_kind_token_idx = next_index(binding_kind_separator_idx, binding_kind_words_len)
    else:
      return "ERR:E-SH-IR-UNRESOLVED"
    end if
  end while
  return "ERR:E-SH-IR-UNRESOLVED"
end function

function parameter_kind_by_id(words: List[Text], function_name_idx: U64, wanted_id: U64) returns Text:
  let kind_id_words_len = sico.list.length(words)
  let kind_id_open_idx = next_index(function_name_idx, kind_id_words_len)
  let kind_id_token_idx = next_index(kind_id_open_idx, kind_id_words_len)
  let kind_id_current = U64.literal(0)
  while U64.less_than(kind_id_token_idx, kind_id_words_len):
    if is_word(word_at(words, kind_id_token_idx), ")"):
      return "ERR:E-SH-IR-CALL-ARITY"
    end if
    let kind_id_colon_idx = next_index(kind_id_token_idx, kind_id_words_len)
    let kind_id_type_idx = next_index(kind_id_colon_idx, kind_id_words_len)
    if U64.equal(kind_id_current, wanted_id):
      return scalar_type_kind(word_at(words, kind_id_type_idx))
    end if
    let kind_id_separator_idx = next_index(kind_id_type_idx, kind_id_words_len)
    if is_word(word_at(words, kind_id_separator_idx), ","):
      set kind_id_token_idx = next_index(kind_id_separator_idx, kind_id_words_len)
      set kind_id_current = next_index(kind_id_current, kind_id_current)
    else:
      return "ERR:E-SH-IR-CALL-ARITY"
    end if
  end while
  return "ERR:E-SH-IR-CALL-ARITY"
end function

function function_declaration_index(words: List[Text], target: Text) returns U64:
  let find_words_len = sico.list.length(words)
  let find_i = U64.literal(0)
  let find_prev = ""
  while U64.less_than(find_i, find_words_len):
    let find_token = word_at(words, find_i)
    if is_word(find_token, "function"):
      if is_declaration_start(find_prev):
        let find_name_idx = next_index(find_i, find_words_len)
        if U64.less_than(find_name_idx, find_words_len):
          if is_word(word_at(words, find_name_idx), target):
            return find_name_idx
          end if
        end if
      end if
    end if
    set find_prev = find_token
    set find_i = next_index(find_i, find_words_len)
  end while
  return find_words_len
end function

function function_declaration_ordinal(words: List[Text], target_name_idx: U64) returns U64:
  let ordinal_words_len = sico.list.length(words)
  let ordinal_i = U64.literal(0)
  let ordinal_prev = ""
  let ordinal_count = U64.literal(0)
  while U64.less_than(ordinal_i, ordinal_words_len):
    let ordinal_token = word_at(words, ordinal_i)
    if is_word(ordinal_token, "function"):
      if is_declaration_start(ordinal_prev):
        let ordinal_name_idx = next_index(ordinal_i, ordinal_words_len)
        if U64.less_than(ordinal_name_idx, ordinal_words_len):
          if U64.equal(ordinal_name_idx, target_name_idx):
            return next_index(ordinal_count, ordinal_count)
          end if
          set ordinal_count = next_index(ordinal_count, ordinal_count)
        end if
      end if
    end if
    set ordinal_prev = ordinal_token
    set ordinal_i = next_index(ordinal_i, ordinal_words_len)
  end while
  return U64.literal(0)
end function

function checked_op_name(word: Text) returns Text:
  if is_word(word, "checked_add"):
    return "checked_add"
  end if
  if is_word(word, "checked_sub"):
    return "checked_sub"
  end if
  if is_word(word, "checked_mul"):
    return "checked_mul"
  end if
  if is_word(word, "checked_div"):
    return "checked_div"
  end if
  return ""
end function

function result_type_json(ok_kind: Text) returns Text:
  let rtj_open = "{\"kind\":\"result\",\"data\":{\"ok\":{\"kind\":\""
  let rtj_mid = "\"},\"error\":{\"kind\":\"named\",\"data\":\"NumericError\"}}}"
  let rtj_left = sico.text.concat(rtj_open, ok_kind)
  return sico.text.concat(rtj_left, rtj_mid)
end function

function declared_return_kind(words: List[Text], body_from: U64) returns Text:
  let sig_words_len = sico.list.length(words)
  let sig_end = line_end(words, body_from)
  let sig_i = body_from
  let sig_kind = ""
  while U64.less_than(sig_i, sig_end):
    if is_word(word_at(words, sig_i), "returns"):
      let type_idx = next_index(sig_i, sig_end)
      if U64.less_than(type_idx, sig_end):
        let type_word = word_at(words, type_idx)
        if is_word(type_word, "Result"):
          let result_open_idx = next_index(type_idx, sig_end)
          if U64.less_than(result_open_idx, sig_end):
            if is_word(word_at(words, result_open_idx), "["):
              let result_ok_idx = next_index(result_open_idx, sig_end)
              let result_comma_idx = next_index(result_ok_idx, sig_end)
              let result_err_idx = next_index(result_comma_idx, sig_end)
              let result_close_idx = next_index(result_err_idx, sig_end)
              if U64.less_than(result_close_idx, sig_end):
                if is_word(word_at(words, result_comma_idx), ","):
                  if is_word(word_at(words, result_close_idx), "]"):
                    let result_ok_kind = scalar_type_kind(word_at(words, result_ok_idx))
                    if sico.text.starts_with(result_ok_kind, "ERR:"):
                      let result_ok_err = I64.literal(1)
                    else:
                      set sig_kind = result_type_json(result_ok_kind)
                    end if
                  end if
                end if
              end if
            end if
          end if
        else:
          if is_word(type_word, "Int"):
            set sig_kind = "int"
          else:
            if is_word(type_word, "Bool"):
              set sig_kind = "bool"
            else:
              if is_word(type_word, "Text"):
                set sig_kind = "string"
              else:
                if is_word(type_word, "I64"):
                  set sig_kind = "i64"
                else:
                  if is_word(type_word, "U64"):
                    set sig_kind = "u64"
                  end if
                end if
              end if
            end if
          end if
        end if
      end if
    end if
    set sig_i = next_index(sig_i, sig_end)
  end while
  return sig_kind
end function

function word_span_offset(words: List[Text], src: Bytes, anchor_offset: U64, anchor_idx: U64, target_idx: U64) returns U64:
  let wso_words_len = sico.list.length(words)
  let wso_offset = anchor_offset
  let wso_idx = anchor_idx
  while U64.less_than(wso_idx, target_idx):
    let wso_next_idx = next_index(wso_idx, wso_words_len)
    let wso_token_end = wso_offset
    if is_word(word_at(words, wso_idx), "<nl>"):
      let wso_on_newline = I64.literal(1)
    else:
      match U64.checked_add(wso_offset, sico.bytes.length(sico.text.encode(word_at(words, wso_idx)))):
        case ok(wso_after_token):
          set wso_token_end = wso_after_token
        case error(_):
          return wso_offset
      end match
    end if
    if is_word(word_at(words, wso_next_idx), "<nl>"):
      set wso_offset = find_newline_from(src, wso_token_end)
    else:
      set wso_offset = find_text_from(src, word_at(words, wso_next_idx), wso_token_end)
    end if
    set wso_idx = wso_next_idx
  end while
  return wso_offset
end function

function argument_instruction_count(words: List[Text], expr_start: U64, expr_end: U64, caller_name_idx: U64) returns U64:
  let aic_words_len = sico.list.length(words)
  let aic_atom = word_at(words, expr_start)
  if U64.less_than(binding_parameter_index(words, caller_name_idx, aic_atom), count_params(words, caller_name_idx)):
    return U64.literal(0)
  end if
  if U64.less_than(U64.literal(0), sico.text.length(constant_argument_kind(aic_atom))):
    return U64.literal(1)
  end if
  if U64.less_than(U64.literal(0), sico.text.length(fixed_literal_argument(words, expr_start))):
    return U64.literal(1)
  end if
  if U64.less_than(expr_start, expr_end):
    if is_word(word_at(words, next_index(expr_start, aic_words_len)), "("):
      let aic_callee_idx = function_declaration_index(words, aic_atom)
      if U64.equal(aic_callee_idx, aic_words_len):
        return U64.literal(0)
      end if
      let aic_close_idx = matching_close(words, next_index(expr_start, aic_words_len), expr_end)
      let aic_total = U64.literal(1)
      let aic_seg_start = next_index(next_index(expr_start, aic_words_len), aic_words_len)
      while U64.less_than(aic_seg_start, aic_close_idx):
        let aic_seg_end = aic_close_idx
        let aic_scan = aic_seg_start
        while U64.less_than(aic_scan, aic_close_idx):
          if is_word(word_at(words, aic_scan), "("):
            set aic_scan = next_index(matching_close(words, aic_scan, aic_close_idx), aic_close_idx)
          else:
            if is_word(word_at(words, aic_scan), ","):
              set aic_seg_end = aic_scan
              set aic_scan = aic_close_idx
            else:
              set aic_scan = next_index(aic_scan, aic_close_idx)
            end if
          end if
        end while
        match U64.checked_add(aic_total, argument_instruction_count(words, aic_seg_start, aic_seg_end, caller_name_idx)):
          case ok(aic_summed):
            set aic_total = aic_summed
          case error(_):
            return aic_total
        end match
        set aic_seg_start = next_index(aic_seg_end, aic_close_idx)
      end while
      return aic_total
    end if
  end if
  return U64.literal(0)
end function

function argument_region_instruction_count(words: List[Text], args_start: U64, args_end: U64, caller_name_idx: U64) returns U64:
  let region_words_len = sico.list.length(words)
  let region_total = U64.literal(0)
  let region_seg_start = args_start
  while U64.less_than(region_seg_start, args_end):
    let region_seg_end = args_end
    let region_scan = region_seg_start
    while U64.less_than(region_scan, args_end):
      if is_word(word_at(words, region_scan), "("):
        set region_scan = next_index(matching_close(words, region_scan, args_end), args_end)
      else:
        if is_word(word_at(words, region_scan), ","):
          set region_seg_end = region_scan
          set region_scan = args_end
        else:
          set region_scan = next_index(region_scan, args_end)
        end if
      end if
    end while
    match U64.checked_add(region_total, argument_instruction_count(words, region_seg_start, region_seg_end, caller_name_idx)):
      case ok(region_summed):
        set region_total = region_summed
      case error(_):
        return region_total
    end match
    set region_seg_start = next_index(region_seg_end, args_end)
  end while
  return region_total
end function

function argument_values(words: List[Text], args_start: U64, args_end: U64, caller_name_idx: U64, callee_name_idx: U64) returns Text:
  let av_words_len = sico.list.length(words)
  let av_wrapper_base = count_params(words, caller_name_idx)
  match U64.checked_add(av_wrapper_base, fixed_let_count_between(words, next_index(caller_name_idx, av_words_len), args_start)):
    case ok(av_wrapper_after_lets):
      set av_wrapper_base = av_wrapper_after_lets
    case error(_):
      return "ERR:E-SH-IR-CALL-ARGUMENT"
  end match
  return argument_values_base(words, args_start, args_end, caller_name_idx, callee_name_idx, av_wrapper_base)
end function

function argument_values_base(words: List[Text], args_start: U64, args_end: U64, caller_name_idx: U64, callee_name_idx: U64, constant_base: U64) returns Text:
  let av_words_len = sico.list.length(words)
  let caller_param_count = count_params(words, caller_name_idx)
  let callee_param_count = count_params(words, callee_name_idx)
  if U64.equal(args_start, args_end):
    if U64.equal(callee_param_count, U64.literal(0)):
      return "[]"
    end if
    return "ERR:E-SH-IR-CALL-ARITY"
  end if
  let values_json = "["
  let value_position = U64.literal(0)
  let value_base = constant_base
  let av_body_from = next_index(caller_name_idx, av_words_len)
  let av_seg_start = args_start
  while U64.less_than(av_seg_start, args_end):
    let av_seg_end = args_end
    let av_scan = av_seg_start
    while U64.less_than(av_scan, args_end):
      if is_word(word_at(words, av_scan), "("):
        set av_scan = next_index(matching_close(words, av_scan, args_end), args_end)
      else:
        if is_word(word_at(words, av_scan), ","):
          set av_seg_end = av_scan
          set av_scan = args_end
        else:
          set av_scan = next_index(av_scan, args_end)
        end if
      end if
    end while
    if U64.less_than(value_position, callee_param_count):
      let av_position_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-CALL-ARITY"
    end if
    let av_atom = word_at(words, av_seg_start)
    let av_kind = ""
    let av_value = U64.literal(0)
    let av_advance = U64.literal(0)
    if U64.less_than(binding_parameter_index(words, caller_name_idx, av_atom), caller_param_count):
      set av_kind = binding_parameter_kind(words, caller_name_idx, av_atom)
      set av_value = binding_parameter_index(words, caller_name_idx, av_atom)
    else:
      let av_let_id = fixed_let_binding_id(words, av_body_from, args_start, av_atom, caller_param_count)
      if U64.less_than(av_let_id, av_words_len):
        set av_kind = fixed_let_binding_kind(words, av_body_from, args_start, av_atom)
        set av_value = av_let_id
      else:
        set av_kind = constant_argument_kind(av_atom)
        if U64.less_than(U64.literal(0), sico.text.length(av_kind)):
          set av_value = value_base
          set av_advance = U64.literal(1)
        else:
          set av_kind = fixed_literal_argument(words, av_seg_start)
          if sico.text.starts_with(av_kind, "ERR:"):
            return av_kind
          end if
          if U64.less_than(U64.literal(0), sico.text.length(av_kind)):
            set av_value = value_base
            set av_advance = U64.literal(1)
          else:
            if U64.less_than(av_seg_end, av_words_len):
              if is_word(word_at(words, next_index(av_seg_start, av_words_len)), "("):
                let av_callee_idx = function_declaration_index(words, av_atom)
                if U64.equal(av_callee_idx, av_words_len):
                  return "ERR:E-SH-IR-CALL-TARGET"
                end if
                set av_kind = declared_return_kind(words, next_index(av_callee_idx, av_words_len))
                let av_seg_count = argument_instruction_count(words, av_seg_start, av_seg_end, caller_name_idx)
                match U64.checked_add(value_base, av_seg_count):
                  case ok(av_summed):
                    match U64.checked_sub(av_summed, U64.literal(1)):
                      case ok(av_call_value):
                        set av_value = av_call_value
                      case error(_):
                        return "ERR:E-SH-IR-CALL-ARGUMENT"
                    end match
                  case error(_):
                    return "ERR:E-SH-IR-CALL-ARGUMENT"
                end match
                set av_advance = av_seg_count
              end if
            end if
            if U64.equal(av_advance, U64.literal(0)):
              return "ERR:E-SH-IR-CALL-ARGUMENT"
            end if
          end if
        end if
      end if
    end if
    let av_expected_kind = parameter_kind_by_id(words, callee_name_idx, value_position)
    if is_word(av_kind, av_expected_kind):
      let av_type_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-CALL-TYPE"
    end if
    if U64.less_than(U64.literal(0), value_position):
      set values_json = sico.text.concat(values_json, ",")
    end if
    set values_json = sico.text.concat(values_json, sico.u64.to_text(av_value))
    match U64.checked_add(value_base, av_advance):
      case ok(av_advanced):
        set value_base = av_advanced
      case error(_):
        return "ERR:E-SH-IR-CALL-ARGUMENT"
    end match
    set value_position = next_index(value_position, value_position)
    if U64.equal(av_seg_end, args_end):
      if U64.equal(value_position, callee_param_count):
        return sico.text.concat(values_json, "]")
      end if
      return "ERR:E-SH-IR-CALL-ARITY"
    end if
    if is_word(word_at(words, av_seg_end), ","):
      set av_seg_start = next_index(av_seg_end, args_end)
    else:
      return "ERR:E-SH-IR-CALL-SHAPE"
    end if
  end while
  return "ERR:E-SH-IR-CALL-ARITY"
end function

function constant_argument_kind(atom: Text) returns Text:
  if is_canonical_magnitude(atom):
    return "int"
  end if
  if is_word(atom, "true"):
    return "bool"
  end if
  if is_word(atom, "false"):
    return "bool"
  end if
  if is_string_token(atom):
    return "string"
  end if
  return ""
end function

function fixed_literal_argument(words: List[Text], atom_idx: U64) returns Text:
  let det_words_len = sico.list.length(words)
  let det_dot_idx = next_index(atom_idx, det_words_len)
  let det_name_idx = next_index(det_dot_idx, det_words_len)
  let det_open_idx = next_index(det_name_idx, det_words_len)
  let det_sign_idx = next_index(det_open_idx, det_words_len)
  let det_kind = ""
  if is_word(word_at(words, atom_idx), "I64"):
    set det_kind = "i64"
  else:
    if is_word(word_at(words, atom_idx), "U64"):
      set det_kind = "u64"
    end if
  end if
  if U64.equal(sico.text.length(det_kind), U64.literal(0)):
    return ""
  end if
  if is_word(word_at(words, det_dot_idx), "."):
    let det_dot_ok = I64.literal(1)
  else:
    return ""
  end if
  if is_word(word_at(words, det_name_idx), "literal"):
    let det_name_ok = I64.literal(1)
  else:
    return ""
  end if
  if is_word(word_at(words, det_open_idx), "("):
    let det_open_ok = I64.literal(1)
  else:
    return ""
  end if
  if is_word(word_at(words, det_sign_idx), "-"):
    if is_word(det_kind, "u64"):
      return "ERR:E-SH-IR-CALL-SHAPE"
    end if
    let det_magnitude_idx = next_index(det_sign_idx, det_words_len)
    let det_negative_close_idx = next_index(det_magnitude_idx, det_words_len)
    if is_canonical_magnitude(word_at(words, det_magnitude_idx)):
      let det_negative_mag_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-CALL-SHAPE"
    end if
    if is_word(word_at(words, det_negative_close_idx), ")"):
      let det_close_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-CALL-SHAPE"
    end if
    if decimal_at_most(word_at(words, det_magnitude_idx), "9223372036854775808"):
      let det_range_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-I64-RANGE"
    end if
    return det_kind
  end if
  if is_canonical_magnitude(word_at(words, det_sign_idx)):
    let det_mag_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  let det_close_idx = next_index(det_sign_idx, det_words_len)
  if is_word(word_at(words, det_close_idx), ")"):
    let det_positive_close_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  if is_word(det_kind, "i64"):
    if decimal_at_most(word_at(words, det_sign_idx), "9223372036854775807"):
      let det_i64_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-I64-RANGE"
    end if
  else:
    if decimal_at_most(word_at(words, det_sign_idx), "18446744073709551615"):
      let det_u64_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-U64-RANGE"
    end if
  end if
  return det_kind
end function

function argument_instructions(words: List[Text], src: Bytes, anchor_idx: U64, anchor_offset: U64, args_start: U64, args_end: U64, caller_name_idx: U64, base: U64) returns Text:
  let ai_words_len = sico.list.length(words)
  let out_json = ""
  let seg_base = base
  let ai_seg_start = args_start
  while U64.less_than(ai_seg_start, args_end):
    let ai_seg_end = args_end
    let ai_scan = ai_seg_start
    while U64.less_than(ai_scan, args_end):
      if is_word(word_at(words, ai_scan), "("):
        set ai_scan = next_index(matching_close(words, ai_scan, args_end), args_end)
      else:
        if is_word(word_at(words, ai_scan), ","):
          set ai_seg_end = ai_scan
          set ai_scan = args_end
        else:
          set ai_scan = next_index(ai_scan, args_end)
        end if
      end if
    end while
    let ai_atom = word_at(words, ai_seg_start)
    let ai_advance = U64.literal(0)
    if U64.less_than(binding_parameter_index(words, caller_name_idx, ai_atom), count_params(words, caller_name_idx)):
      let ai_binding_skipped = I64.literal(1)
    else:
      let ai_atom_kind = constant_argument_kind(ai_atom)
      if U64.less_than(U64.literal(0), sico.text.length(ai_atom_kind)):
        let ai_token_offset = word_span_offset(words, src, anchor_offset, anchor_idx, ai_seg_start)
        let ai_token_end = ai_token_offset
        match U64.checked_add(ai_token_offset, sico.bytes.length(sico.text.encode(ai_atom))):
          case ok(ai_after_token):
            set ai_token_end = ai_after_token
          case error(_):
            return out_json
        end match
        if U64.less_than(U64.literal(0), sico.text.length(out_json)):
          set out_json = sico.text.concat(out_json, ",")
        end if
        set out_json = sico.text.concat(out_json, "{\"result\":")
        set out_json = sico.text.concat(out_json, sico.u64.to_text(seg_base))
        set out_json = sico.text.concat(out_json, ",\"ty\":{\"kind\":\"")
        set out_json = sico.text.concat(out_json, ai_atom_kind)
        set out_json = sico.text.concat(out_json, "\"},\"operation\":{\"op\":\"const_")
        set out_json = sico.text.concat(out_json, ai_atom_kind)
        set out_json = sico.text.concat(out_json, "\",\"data\":")
        if is_word(ai_atom_kind, "int"):
          set out_json = sico.text.concat(out_json, "\"")
          set out_json = sico.text.concat(out_json, ai_atom)
          set out_json = sico.text.concat(out_json, "\"")
        else:
          if is_word(ai_atom_kind, "bool"):
            set out_json = sico.text.concat(out_json, ai_atom)
          else:
            set out_json = sico.text.concat(out_json, json_string_token(ai_atom))
          end if
        end if
        set out_json = sico.text.concat(out_json, "},\"range\":{\"start\":")
        set out_json = sico.text.concat(out_json, sico.u64.to_text(ai_token_offset))
        set out_json = sico.text.concat(out_json, ",\"end\":")
        set out_json = sico.text.concat(out_json, sico.u64.to_text(ai_token_end))
        set out_json = sico.text.concat(out_json, "}}")
        set ai_advance = U64.literal(1)
      else:
        let ai_literal_kind = fixed_literal_argument(words, ai_seg_start)
        if sico.text.starts_with(ai_literal_kind, "ERR:"):
          let ai_literal_err_dead = I64.literal(1)
        else:
          if U64.less_than(U64.literal(0), sico.text.length(ai_literal_kind)):
            let ai_sign_idx = next_index(next_index(next_index(next_index(ai_seg_start, ai_words_len), ai_words_len), ai_words_len), ai_words_len)
            let ai_is_negative = is_word(word_at(words, ai_sign_idx), "-")
            let ai_sign_offset = word_span_offset(words, src, anchor_offset, anchor_idx, ai_sign_idx)
            let ai_digits_word = ""
            let ai_digits_offset = ai_sign_offset
            if ai_is_negative:
              let ai_magnitude_idx = next_index(ai_sign_idx, ai_words_len)
              set ai_digits_word = word_at(words, ai_magnitude_idx)
              match U64.checked_add(ai_sign_offset, U64.literal(1)):
                case ok(ai_after_sign):
                  set ai_digits_offset = ai_after_sign
                case error(_):
                  return out_json
              end match
            else:
              set ai_digits_word = word_at(words, ai_sign_idx)
            end if
            let ai_digits_end = ai_digits_offset
            match U64.checked_add(ai_digits_offset, sico.bytes.length(sico.text.encode(ai_digits_word))):
              case ok(ai_after_digits):
                set ai_digits_end = ai_after_digits
              case error(_):
                return out_json
            end match
            let ai_data = ai_digits_word
            if ai_is_negative:
              set ai_data = sico.text.concat("-", ai_digits_word)
            end if
            if U64.less_than(U64.literal(0), sico.text.length(out_json)):
              set out_json = sico.text.concat(out_json, ",")
            end if
            set out_json = sico.text.concat(out_json, "{\"result\":")
            set out_json = sico.text.concat(out_json, sico.u64.to_text(seg_base))
            set out_json = sico.text.concat(out_json, ",\"ty\":{\"kind\":\"")
            set out_json = sico.text.concat(out_json, ai_literal_kind)
            set out_json = sico.text.concat(out_json, "\"},\"operation\":{\"op\":\"const_")
            set out_json = sico.text.concat(out_json, ai_literal_kind)
            set out_json = sico.text.concat(out_json, "\",\"data\":")
            set out_json = sico.text.concat(out_json, ai_data)
            set out_json = sico.text.concat(out_json, "},\"range\":{\"start\":")
            set out_json = sico.text.concat(out_json, sico.u64.to_text(ai_sign_offset))
            set out_json = sico.text.concat(out_json, ",\"end\":")
            set out_json = sico.text.concat(out_json, sico.u64.to_text(ai_digits_end))
            set out_json = sico.text.concat(out_json, "}}")
            set ai_advance = U64.literal(1)
          else:
            if U64.less_than(ai_seg_end, ai_words_len):
              if is_word(word_at(words, next_index(ai_seg_start, ai_words_len)), "("):
                let ai_callee_idx = function_declaration_index(words, ai_atom)
                if U64.equal(ai_callee_idx, ai_words_len):
                  let ai_dead_callee = I64.literal(1)
                else:
                  let ai_open_idx = next_index(ai_seg_start, ai_words_len)
                  let ai_close_idx = matching_close(words, ai_open_idx, ai_seg_end)
                  let ai_nested_args_start = next_index(ai_open_idx, ai_words_len)
                  let ai_name_offset = word_span_offset(words, src, anchor_offset, anchor_idx, ai_seg_start)
                  let ai_open_offset = word_span_offset(words, src, anchor_offset, anchor_idx, ai_open_idx)
                  let ai_close_offset = word_span_offset(words, src, anchor_offset, anchor_idx, ai_close_idx)
                  let ai_inner = argument_instructions(words, src, ai_open_idx, ai_open_offset, ai_nested_args_start, ai_close_idx, caller_name_idx, seg_base)
                  let ai_seg_count = argument_instruction_count(words, ai_seg_start, ai_seg_end, caller_name_idx)
                  match U64.checked_add(seg_base, ai_seg_count):
                    case ok(ai_summed):
                      match U64.checked_sub(ai_summed, U64.literal(1)):
                        case ok(ai_result_value):
                          let ai_nested_json = argument_values_base(words, ai_nested_args_start, ai_close_idx, caller_name_idx, ai_callee_idx, seg_base)
                          let ai_nested_kind = declared_return_kind(words, next_index(ai_callee_idx, ai_words_len))
                          let ai_nested_ordinal = function_declaration_ordinal(words, ai_callee_idx)
                          let ai_range_end = ai_close_offset
                          match U64.checked_add(ai_close_offset, U64.literal(1)):
                            case ok(ai_after_close):
                              set ai_range_end = ai_after_close
                            case error(_):
                              return out_json
                          end match
                          if U64.less_than(U64.literal(0), sico.text.length(ai_inner)):
                            if U64.less_than(U64.literal(0), sico.text.length(out_json)):
                              set out_json = sico.text.concat(out_json, ",")
                            end if
                            set out_json = sico.text.concat(out_json, ai_inner)
                          end if
                          if U64.less_than(U64.literal(0), sico.text.length(out_json)):
                            set out_json = sico.text.concat(out_json, ",")
                          end if
                          set out_json = sico.text.concat(out_json, "{\"result\":")
                          set out_json = sico.text.concat(out_json, sico.u64.to_text(ai_result_value))
                          set out_json = sico.text.concat(out_json, ",\"ty\":{\"kind\":\"")
                          set out_json = sico.text.concat(out_json, ai_nested_kind)
                          set out_json = sico.text.concat(out_json, "\"},\"operation\":{\"op\":\"call\",\"data\":{\"function\":")
                          set out_json = sico.text.concat(out_json, sico.u64.to_text(ai_nested_ordinal))
                          set out_json = sico.text.concat(out_json, ",\"arguments\":")
                          set out_json = sico.text.concat(out_json, ai_nested_json)
                          set out_json = sico.text.concat(out_json, "}},\"range\":{\"start\":")
                          set out_json = sico.text.concat(out_json, sico.u64.to_text(ai_name_offset))
                          set out_json = sico.text.concat(out_json, ",\"end\":")
                          set out_json = sico.text.concat(out_json, sico.u64.to_text(ai_range_end))
                          set out_json = sico.text.concat(out_json, "}}")
                          set ai_advance = ai_seg_count
                        case error(_):
                          return out_json
                      end match
                    case error(_):
                      return out_json
                  end match
                end if
              end if
            end if
          end if
        end if
      end if
    end if
    match U64.checked_add(seg_base, ai_advance):
      case ok(ai_advanced_base):
        set seg_base = ai_advanced_base
      case error(_):
        return out_json
    end match
    let ai_after_seg = next_index(ai_seg_end, args_end)
    if U64.equal(ai_after_seg, args_end):
      set ai_seg_start = args_end
    else:
      if is_word(word_at(words, ai_seg_end), ","):
        set ai_seg_start = ai_after_seg
      else:
        set ai_seg_start = args_end
      end if
    end if
  end while
  return out_json
end function

function fixed_op_name(word: Text) returns Text:
  if is_word(word, "bit_and"):
    return "bit_and"
  end if
  if is_word(word, "bit_or"):
    return "bit_or"
  end if
  if is_word(word, "bit_xor"):
    return "bit_xor"
  end if
  if is_word(word, "shl"):
    return "shl"
  end if
  if is_word(word, "shr"):
    return "shr"
  end if
  return ""
end function

function fixed_operation_operand_width(words: List[Text], atom_idx: U64, caller_name_idx: U64) returns U64:
  let fow_words_len = sico.list.length(words)
  let fow_param_count = count_params(words, caller_name_idx)
  let fow_atom = word_at(words, atom_idx)
  if U64.less_than(binding_parameter_index(words, caller_name_idx, fow_atom), fow_param_count):
    return U64.literal(1)
  end if
  let fow_literal_kind = fixed_literal_argument(words, atom_idx)
  if U64.equal(sico.text.length(fow_literal_kind), U64.literal(0)):
    return U64.literal(1)
  end if
  let fow_sign_idx = next_index(next_index(next_index(next_index(atom_idx, fow_words_len), fow_words_len), fow_words_len), fow_words_len)
  if is_word(word_at(words, fow_sign_idx), "-"):
    return U64.literal(7)
  end if
  return U64.literal(6)
end function

function fixed_operation_operand_atom_idx(words: List[Text], from_idx: U64, caller_name_idx: U64, position: U64) returns U64:
  let foa_words_len = sico.list.length(words)
  let foa_first_idx = next_index(next_index(next_index(next_index(from_idx, foa_words_len), foa_words_len), foa_words_len), foa_words_len)
  if U64.equal(position, U64.literal(0)):
    return foa_first_idx
  end if
  let foa_width = fixed_operation_operand_width(words, foa_first_idx, caller_name_idx)
  match U64.checked_add(foa_first_idx, foa_width):
    case ok(foa_after_first):
      return next_index(foa_after_first, foa_words_len)
    case error(_):
      return foa_words_len
  end match
end function

function fixed_operation_operand_check(words: List[Text], from_idx: U64, end_idx: U64, caller_name_idx: U64, receiver_kind: Text) returns Text:
  let check_words_len = sico.list.length(words)
  let caller_param_count = count_params(words, caller_name_idx)
  let check_open_idx = next_index(next_index(next_index(from_idx, check_words_len), check_words_len), check_words_len)
  if is_word(word_at(words, check_open_idx), "("):
    let check_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  let first_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, U64.literal(0))
  let first_width = fixed_operation_operand_width(words, first_idx, caller_name_idx)
  let comma_idx = first_idx
  match U64.checked_add(first_idx, first_width):
    case ok(check_after_first):
      set comma_idx = check_after_first
    case error(_):
      return "ERR:E-SH-IR-CALL-SHAPE"
  end match
  let second_idx = next_index(comma_idx, check_words_len)
  let second_width = fixed_operation_operand_width(words, second_idx, caller_name_idx)
  let close_idx = second_idx
  match U64.checked_add(second_idx, second_width):
    case ok(check_after_second):
      set close_idx = check_after_second
    case error(_):
      return "ERR:E-SH-IR-CALL-SHAPE"
  end match
  let after_close_idx = next_index(close_idx, check_words_len)
  if U64.equal(after_close_idx, end_idx):
    let check_shape_two_operands = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-ARITY"
  end if
  if is_word(word_at(words, close_idx), ")"):
    let check_close_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  if is_word(word_at(words, comma_idx), ","):
    let check_comma_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  let first_atom = word_at(words, first_idx)
  let first_kind = ""
  let first_id = binding_parameter_index(words, caller_name_idx, first_atom)
  if U64.less_than(first_id, caller_param_count):
    set first_kind = binding_parameter_kind(words, caller_name_idx, first_atom)
  else:
    set first_kind = fixed_let_binding_kind(words, next_index(caller_name_idx, check_words_len), from_idx, first_atom)
    if U64.equal(sico.text.length(first_kind), U64.literal(0)):
      set first_kind = fixed_literal_argument(words, first_idx)
      if sico.text.starts_with(first_kind, "ERR:"):
        return first_kind
      end if
      if U64.equal(sico.text.length(first_kind), U64.literal(0)):
        return "ERR:E-SH-IR-CALL-ARGUMENT"
      end if
    end if
  end if
  if is_word(first_kind, receiver_kind):
    let check_first_kind = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TYPE"
  end if
  let second_atom = word_at(words, second_idx)
  let second_kind = ""
  let second_id = binding_parameter_index(words, caller_name_idx, second_atom)
  if U64.less_than(second_id, caller_param_count):
    set second_kind = binding_parameter_kind(words, caller_name_idx, second_atom)
  else:
    set second_kind = fixed_let_binding_kind(words, next_index(caller_name_idx, check_words_len), from_idx, second_atom)
    if U64.equal(sico.text.length(second_kind), U64.literal(0)):
      set second_kind = fixed_literal_argument(words, second_idx)
      if sico.text.starts_with(second_kind, "ERR:"):
        return second_kind
      end if
      if U64.equal(sico.text.length(second_kind), U64.literal(0)):
        return "ERR:E-SH-IR-CALL-ARGUMENT"
      end if
    end if
  end if
  if is_word(second_kind, receiver_kind):
    let check_second_kind = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TYPE"
  end if
  return ""
end function

function fixed_operation_operand_value(words: List[Text], from_idx: U64, end_idx: U64, caller_name_idx: U64, position: U64) returns U64:
  let fid_words_len = sico.list.length(words)
  let fid_atom_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, position)
  let fid_param_count = count_params(words, caller_name_idx)
  let fid_atom = word_at(words, fid_atom_idx)
  let fid_id = binding_parameter_index(words, caller_name_idx, fid_atom)
  if U64.less_than(fid_id, fid_param_count):
    return fid_id
  end if
  let fid_body_from = next_index(caller_name_idx, fid_words_len)
  let fid_let_id = fixed_let_binding_id(words, fid_body_from, from_idx, fid_atom, fid_param_count)
  if U64.less_than(fid_let_id, fid_words_len):
    return fid_let_id
  end if
  let fid_value = fid_param_count
  match U64.checked_add(fid_param_count, fixed_let_count_between(words, fid_body_from, from_idx)):
    case ok(fid_after_lets):
      set fid_value = fid_after_lets
    case error(_):
      return fid_value
  end match
  if U64.equal(position, U64.literal(1)):
    let fid_first_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, U64.literal(0))
    let fid_first_width = fixed_operation_operand_width(words, fid_first_idx, caller_name_idx)
    if U64.equal(fid_first_width, U64.literal(1)):
      let fid_first_is_binding = I64.literal(1)
    else:
      match U64.checked_add(fid_value, U64.literal(1)):
        case ok(fid_advanced):
          set fid_value = fid_advanced
        case error(_):
          return fid_value
      end match
    end if
  end if
  return fid_value
end function

function fixed_operation_literal_count(words: List[Text], from_idx: U64, caller_name_idx: U64) returns U64:
  let flc_words_len = sico.list.length(words)
  let flc_count = U64.literal(0)
  let flc_first_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, U64.literal(0))
  let flc_second_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, U64.literal(1))
  let flc_first_width = fixed_operation_operand_width(words, flc_first_idx, caller_name_idx)
  let flc_second_width = fixed_operation_operand_width(words, flc_second_idx, caller_name_idx)
  if U64.equal(flc_first_width, U64.literal(1)):
    let flc_first_is_binding = I64.literal(1)
  else:
    set flc_count = next_index(flc_count, flc_count)
  end if
  if U64.equal(flc_second_width, U64.literal(1)):
    let flc_second_is_binding = I64.literal(1)
  else:
    set flc_count = next_index(flc_count, flc_count)
  end if
  return flc_count
end function

function fixed_operation_literal_instructions(words: List[Text], src: Bytes, from_idx: U64, caller_name_idx: U64, first_result_id: U64, anchor_idx: U64, anchor_offset: U64) returns Text:
  let fli_words_len = sico.list.length(words)
  let fli_param_count = count_params(words, caller_name_idx)
  let fli_out = ""
  let fli_result = first_result_id
  let fli_first_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, U64.literal(0))
  let fli_second_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, U64.literal(1))
  let fli_first_width = fixed_operation_operand_width(words, fli_first_idx, caller_name_idx)
  let fli_second_width = fixed_operation_operand_width(words, fli_second_idx, caller_name_idx)
  let fli_first_atom = word_at(words, fli_first_idx)
  let fli_second_atom = word_at(words, fli_second_idx)
  if U64.less_than(binding_parameter_index(words, caller_name_idx, fli_first_atom), fli_param_count):
    let fli_first_is_binding = I64.literal(1)
  else:
    let fli_first_kind = fixed_literal_argument(words, fli_first_idx)
    if sico.text.starts_with(fli_first_kind, "ERR:"):
      let fli_first_err_dead = I64.literal(1)
    else:
      if U64.less_than(U64.literal(0), sico.text.length(fli_first_kind)):
        let fli_sign_idx = next_index(next_index(next_index(next_index(fli_first_idx, fli_words_len), fli_words_len), fli_words_len), fli_words_len)
        let fli_is_negative = is_word(word_at(words, fli_sign_idx), "-")
        let fli_sign_offset = word_span_offset(words, src, anchor_offset, anchor_idx, fli_sign_idx)
        let fli_digits_word = ""
        let fli_digits_offset = fli_sign_offset
        if fli_is_negative:
          let fli_magnitude_idx = next_index(fli_sign_idx, fli_words_len)
          set fli_digits_word = word_at(words, fli_magnitude_idx)
          match U64.checked_add(fli_sign_offset, U64.literal(1)):
            case ok(fli_after_sign):
              set fli_digits_offset = fli_after_sign
            case error(_):
              return fli_out
          end match
        else:
          set fli_digits_word = word_at(words, fli_sign_idx)
        end if
        let fli_digits_end = fli_digits_offset
        match U64.checked_add(fli_digits_offset, sico.bytes.length(sico.text.encode(fli_digits_word))):
          case ok(fli_after_digits):
            set fli_digits_end = fli_after_digits
          case error(_):
            return fli_out
        end match
        let fli_data = fli_digits_word
        if fli_is_negative:
          set fli_data = sico.text.concat("-", fli_digits_word)
        end if
        set fli_out = sico.text.concat(fli_out, "{\"result\":")
        set fli_out = sico.text.concat(fli_out, sico.u64.to_text(fli_result))
        set fli_out = sico.text.concat(fli_out, ",\"ty\":{\"kind\":\"")
        set fli_out = sico.text.concat(fli_out, fli_first_kind)
        set fli_out = sico.text.concat(fli_out, "\"},\"operation\":{\"op\":\"const_")
        set fli_out = sico.text.concat(fli_out, fli_first_kind)
        set fli_out = sico.text.concat(fli_out, "\",\"data\":")
        set fli_out = sico.text.concat(fli_out, fli_data)
        set fli_out = sico.text.concat(fli_out, "},\"range\":{\"start\":")
        set fli_out = sico.text.concat(fli_out, sico.u64.to_text(fli_sign_offset))
        set fli_out = sico.text.concat(fli_out, ",\"end\":")
        set fli_out = sico.text.concat(fli_out, sico.u64.to_text(fli_digits_end))
        set fli_out = sico.text.concat(fli_out, "}}")
        set fli_result = next_index(fli_result, fli_result)
      end if
    end if
  end if
  if U64.less_than(binding_parameter_index(words, caller_name_idx, fli_second_atom), fli_param_count):
    let fli_second_is_binding = I64.literal(1)
  else:
    let fli_second_kind = fixed_literal_argument(words, fli_second_idx)
    if sico.text.starts_with(fli_second_kind, "ERR:"):
      let fli_second_err_dead = I64.literal(1)
    else:
      if U64.less_than(U64.literal(0), sico.text.length(fli_second_kind)):
        let fli_second_sign_idx = next_index(next_index(next_index(next_index(fli_second_idx, fli_words_len), fli_words_len), fli_words_len), fli_words_len)
        let fli_second_is_negative = is_word(word_at(words, fli_second_sign_idx), "-")
        let fli_second_sign_offset = word_span_offset(words, src, anchor_offset, anchor_idx, fli_second_sign_idx)
        let fli_second_digits_word = ""
        let fli_second_digits_offset = fli_second_sign_offset
        if fli_second_is_negative:
          let fli_second_magnitude_idx = next_index(fli_second_sign_idx, fli_words_len)
          set fli_second_digits_word = word_at(words, fli_second_magnitude_idx)
          match U64.checked_add(fli_second_sign_offset, U64.literal(1)):
            case ok(fli_second_after_sign):
              set fli_second_digits_offset = fli_second_after_sign
            case error(_):
              return fli_out
          end match
        else:
          set fli_second_digits_word = word_at(words, fli_second_sign_idx)
        end if
        let fli_second_digits_end = fli_second_digits_offset
        match U64.checked_add(fli_second_digits_offset, sico.bytes.length(sico.text.encode(fli_second_digits_word))):
          case ok(fli_second_after_digits):
            set fli_second_digits_end = fli_second_after_digits
          case error(_):
            return fli_out
        end match
        let fli_second_data = fli_second_digits_word
        if fli_second_is_negative:
          set fli_second_data = sico.text.concat("-", fli_second_digits_word)
        end if
        if U64.less_than(U64.literal(0), sico.text.length(fli_out)):
          set fli_out = sico.text.concat(fli_out, ",")
        end if
        set fli_out = sico.text.concat(fli_out, "{\"result\":")
        set fli_out = sico.text.concat(fli_out, sico.u64.to_text(fli_result))
        set fli_out = sico.text.concat(fli_out, ",\"ty\":{\"kind\":\"")
        set fli_out = sico.text.concat(fli_out, fli_second_kind)
        set fli_out = sico.text.concat(fli_out, "\"},\"operation\":{\"op\":\"const_")
        set fli_out = sico.text.concat(fli_out, fli_second_kind)
        set fli_out = sico.text.concat(fli_out, "\",\"data\":")
        set fli_out = sico.text.concat(fli_out, fli_second_data)
        set fli_out = sico.text.concat(fli_out, "},\"range\":{\"start\":")
        set fli_out = sico.text.concat(fli_out, sico.u64.to_text(fli_second_sign_offset))
        set fli_out = sico.text.concat(fli_out, ",\"end\":")
        set fli_out = sico.text.concat(fli_out, sico.u64.to_text(fli_second_digits_end))
        set fli_out = sico.text.concat(fli_out, "}}")
        set fli_result = next_index(fli_result, fli_result)
      end if
    end if
  end if
  return fli_out
end function

function index_plus(i: U64, amount: U64, fallback: U64) returns U64:
  let result = i
  let count = U64.literal(0)
  while U64.less_than(count, amount):
    set result = next_index(result, fallback)
    if U64.equal(result, fallback):
      return fallback
    end if
    set count = next_index(count, amount)
  end while
  return result
end function

function previous_index(i: U64, fallback: U64) returns U64:
  match U64.checked_sub(i, U64.literal(1)):
    case ok(previous):
      return previous
    case error(_):
      return fallback
  end match
end function

function fixed_let_count_between(words: List[Text], body_from: U64, body_end: U64) returns U64:
  let flc_i = body_from
  let flc_count = U64.literal(0)
  while U64.less_than(flc_i, body_end):
    if is_word(word_at(words, flc_i), "let"):
      let flc_rhs_idx = index_plus(flc_i, U64.literal(3), body_end)
      let flc_rhs_end = line_end(words, flc_rhs_idx)
      if U64.equal(next_index(flc_rhs_idx, flc_rhs_end), flc_rhs_end):
        let flc_alias = I64.literal(1)
      else:
        if U64.less_than(U64.literal(0), sico.text.length(fixed_literal_argument(words, flc_rhs_idx))):
          set flc_count = next_index(flc_count, flc_count)
        else:
          match U64.checked_add(flc_count, fixed_let_rhs_instruction_count(words, flc_rhs_idx, flc_rhs_end, previous_index(body_from, body_from))):
            case ok(flc_counted):
              set flc_count = flc_counted
            case error(_):
              return flc_count
          end match
        end if
      end if
    end if
    set flc_i = next_index(flc_i, body_end)
  end while
  return flc_count
end function

function fixed_let_binding_id(words: List[Text], body_from: U64, body_end: U64, binding: Text, parameter_count: U64) returns U64:
  let flb_i = body_from
  while U64.less_than(flb_i, body_end):
    if is_word(word_at(words, flb_i), "let"):
      let flb_name_idx = next_index(flb_i, body_end)
      if is_word(word_at(words, flb_name_idx), binding):
        let flb_rhs_idx = index_plus(flb_i, U64.literal(3), body_end)
        let flb_rhs_end = line_end(words, flb_rhs_idx)
        if U64.equal(next_index(flb_rhs_idx, flb_rhs_end), flb_rhs_end):
          let flb_alias = word_at(words, flb_rhs_idx)
          let flb_parameter = binding_parameter_index(words, previous_index(body_from, body_from), flb_alias)
          if U64.less_than(flb_parameter, parameter_count):
            return flb_parameter
          end if
          return fixed_let_binding_id(words, body_from, flb_i, flb_alias, parameter_count)
        end if
        if U64.less_than(U64.literal(0), sico.text.length(fixed_literal_argument(words, flb_rhs_idx))):
          match U64.checked_add(parameter_count, fixed_let_count_between(words, body_from, flb_i)):
            case ok(flb_result):
              return flb_result
            case error(_):
              return sico.list.length(words)
          end match
        end if
        let flb_expr_count = fixed_let_rhs_instruction_count(words, flb_rhs_idx, flb_rhs_end, previous_index(body_from, body_from))
        if U64.less_than(U64.literal(0), flb_expr_count):
          let flb_expr_base = parameter_count
          match U64.checked_add(parameter_count, fixed_let_count_between(words, body_from, flb_i)):
            case ok(flb_expr_base_after):
              set flb_expr_base = flb_expr_base_after
            case error(_):
              return sico.list.length(words)
          end match
          match U64.checked_add(flb_expr_base, flb_expr_count):
            case ok(flb_expr_end):
              match U64.checked_sub(flb_expr_end, U64.literal(1)):
                case ok(flb_expr_value):
                  return flb_expr_value
                case error(_):
                  return sico.list.length(words)
              end match
            case error(_):
              return sico.list.length(words)
          end match
        end if
        return sico.list.length(words)
      end if
    end if
    set flb_i = next_index(flb_i, body_end)
  end while
  return sico.list.length(words)
end function

function fixed_let_binding_kind(words: List[Text], body_from: U64, body_end: U64, binding: Text) returns Text:
  let flk_i = body_from
  while U64.less_than(flk_i, body_end):
    if is_word(word_at(words, flk_i), "let"):
      let flk_name_idx = next_index(flk_i, body_end)
      if is_word(word_at(words, flk_name_idx), binding):
        let flk_rhs_idx = index_plus(flk_i, U64.literal(3), body_end)
        let flk_rhs_end = line_end(words, flk_rhs_idx)
        if U64.equal(next_index(flk_rhs_idx, flk_rhs_end), flk_rhs_end):
          let flk_alias = word_at(words, flk_rhs_idx)
          let flk_parameter_kind = binding_parameter_kind(words, previous_index(body_from, body_from), flk_alias)
          if sico.text.starts_with(flk_parameter_kind, "ERR:"):
            return fixed_let_binding_kind(words, body_from, flk_i, flk_alias)
          end if
          return flk_parameter_kind
        end if
        if U64.less_than(U64.literal(0), sico.text.length(fixed_literal_argument(words, flk_rhs_idx))):
          return fixed_literal_argument(words, flk_rhs_idx)
        end if
        let flk_rhs_kind = fixed_let_rhs_kind(words, flk_rhs_idx, flk_rhs_end)
        if is_word(flk_rhs_kind, "op"):
          let flk_op_kind = scalar_type_kind(word_at(words, flk_rhs_idx))
          if sico.text.starts_with(flk_op_kind, "ERR:"):
            return ""
          end if
          if U64.less_than(U64.literal(0), sico.text.length(checked_op_name(word_at(words, index_plus(flk_rhs_idx, U64.literal(2), sico.list.length(words)))))):
            return result_type_json(flk_op_kind)
          end if
          return flk_op_kind
        end if
        if is_word(flk_rhs_kind, "call"):
          let flk_callee_idx = function_declaration_index(words, word_at(words, flk_rhs_idx))
          if U64.equal(flk_callee_idx, sico.list.length(words)):
            return ""
          end if
          return declared_return_kind(words, next_index(flk_callee_idx, sico.list.length(words)))
        end if
        return ""
      end if
    end if
    set flk_i = next_index(flk_i, body_end)
  end while
  return ""
end function

function fixed_let_rhs_kind(words: List[Text], rhs_idx: U64, rhs_end_idx: U64) returns Text:
  let frk_words_len = sico.list.length(words)
  if U64.equal(next_index(rhs_idx, rhs_end_idx), rhs_end_idx):
    return "alias"
  end if
  let frk_receiver = word_at(words, rhs_idx)
  if is_word(word_at(words, next_index(rhs_idx, frk_words_len)), "."):
    if is_word(frk_receiver, "I64"):
      let frk_receiver_i64 = I64.literal(1)
    else:
      if is_word(frk_receiver, "U64"):
        let frk_receiver_u64 = I64.literal(1)
      else:
        return ""
      end if
    end if
    if is_word(word_at(words, index_plus(rhs_idx, U64.literal(3), frk_words_len)), "("):
      let frk_name = word_at(words, index_plus(rhs_idx, U64.literal(2), frk_words_len))
      if is_word(frk_name, "literal"):
        return "literal"
      end if
      if U64.less_than(U64.literal(0), sico.text.length(fixed_op_name(frk_name))):
        return "op"
      end if
      if U64.less_than(U64.literal(0), sico.text.length(checked_op_name(frk_name))):
        return "op"
      end if
    end if
    return ""
  end if
  if is_word(word_at(words, next_index(rhs_idx, frk_words_len)), "("):
    return "call"
  end if
  return ""
end function

function fixed_let_rhs_instruction_count(words: List[Text], rhs_idx: U64, rhs_end_idx: U64, caller_name_idx: U64) returns U64:
  let fric_kind = fixed_let_rhs_kind(words, rhs_idx, rhs_end_idx)
  if is_word(fric_kind, "literal"):
    return U64.literal(1)
  end if
  if is_word(fric_kind, "op"):
    match U64.checked_add(fixed_operation_literal_count(words, rhs_idx, caller_name_idx), U64.literal(1)):
      case ok(fric_op_total):
        return fric_op_total
      case error(_):
        return U64.literal(0)
    end match
  end if
  if is_word(fric_kind, "call"):
    let fric_words_len = sico.list.length(words)
    let fric_open_idx = next_index(rhs_idx, fric_words_len)
    let fric_close_idx = matching_close(words, fric_open_idx, rhs_end_idx)
    match U64.checked_add(argument_region_instruction_count(words, next_index(fric_open_idx, fric_words_len), fric_close_idx, caller_name_idx), U64.literal(1)):
      case ok(fric_call_total):
        return fric_call_total
      case error(_):
        return U64.literal(0)
    end match
  end if
  return U64.literal(0)
end function

function fixed_operation_operand_value_base(words: List[Text], rhs_idx: U64, caller_name_idx: U64, position: U64, base: U64) returns U64:
  let fov_words_len = sico.list.length(words)
  let fov_param_count = count_params(words, caller_name_idx)
  let fov_atom_idx = fixed_operation_operand_atom_idx(words, rhs_idx, caller_name_idx, position)
  let fov_atom = word_at(words, fov_atom_idx)
  let fov_id = binding_parameter_index(words, caller_name_idx, fov_atom)
  if U64.less_than(fov_id, fov_param_count):
    return fov_id
  end if
  let fov_let_id = fixed_let_binding_id(words, next_index(caller_name_idx, fov_words_len), rhs_idx, fov_atom, fov_param_count)
  if U64.less_than(fov_let_id, fov_words_len):
    return fov_let_id
  end if
  let fov_value = base
  if U64.equal(position, U64.literal(1)):
    let fov_first_idx = fixed_operation_operand_atom_idx(words, rhs_idx, caller_name_idx, U64.literal(0))
    let fov_first_width = fixed_operation_operand_width(words, fov_first_idx, caller_name_idx)
    if U64.equal(fov_first_width, U64.literal(1)):
      let fov_first_is_binding = I64.literal(1)
    else:
      match U64.checked_add(fov_value, U64.literal(1)):
        case ok(fov_advanced):
          set fov_value = fov_advanced
        case error(_):
          return fov_value
      end match
    end if
  end if
  return fov_value
end function

function fixed_let_instructions(words: List[Text], src: Bytes, body_from: U64, body_end: U64, fn_start: U64, parameter_count: U64) returns Text:
  let flet_i = body_from
  let flet_ordinal = U64.literal(0)
  let flet_json = ""
  let flet_search_from = fn_start
  while U64.less_than(flet_i, body_end):
    if is_word(word_at(words, flet_i), "let"):
      let flet_name_idx = next_index(flet_i, body_end)
      let flet_equal_idx = index_plus(flet_i, U64.literal(2), body_end)
      let flet_receiver_idx = index_plus(flet_i, U64.literal(3), body_end)
      let flet_line_end_idx = line_end(words, flet_receiver_idx)
      let flet_duplicate_scan_all = next_index(flet_i, body_end)
      while U64.less_than(flet_duplicate_scan_all, body_end):
        if is_word(word_at(words, flet_duplicate_scan_all), "let"):
          let flet_duplicate_name_all = next_index(flet_duplicate_scan_all, body_end)
          if is_word(word_at(words, flet_duplicate_name_all), word_at(words, flet_name_idx)):
            return "ERR:E-SH-IR-STATEMENT"
          end if
        end if
        set flet_duplicate_scan_all = next_index(flet_duplicate_scan_all, body_end)
      end while
      if is_word(word_at(words, flet_equal_idx), "="):
        let flet_equal_ok = I64.literal(1)
      else:
        return "ERR:E-SH-IR-STATEMENT"
      end if
      if U64.equal(next_index(flet_receiver_idx, flet_line_end_idx), flet_line_end_idx):
        let flet_alias = word_at(words, flet_receiver_idx)
        let flet_alias_parameter = binding_parameter_index(words, previous_index(body_from, body_from), flet_alias)
        let flet_alias_id = sico.list.length(words)
        if U64.less_than(flet_alias_parameter, parameter_count):
          set flet_alias_id = flet_alias_parameter
        else:
          set flet_alias_id = fixed_let_binding_id(words, body_from, flet_i, flet_alias, parameter_count)
        end if
        if U64.equal(flet_alias_id, sico.list.length(words)):
          return "ERR:E-SH-IR-STATEMENT"
        end if
        let flet_alias_line_start = find_text_from(src, "let", flet_search_from)
        set flet_search_from = return_expression_end(src, flet_alias_line_start)
        set flet_i = flet_line_end_idx
        continue
      end if
      let flet_rhs_kind = fixed_let_rhs_kind(words, flet_receiver_idx, flet_line_end_idx)
      if is_word(flet_rhs_kind, "op"):
        let flet_op_caller_idx = previous_index(body_from, body_from)
        let flet_op_receiver_kind = scalar_type_kind(word_at(words, flet_receiver_idx))
        if is_word(flet_op_receiver_kind, "i64"):
          let flet_op_receiver_i64 = I64.literal(1)
        else:
          if is_word(flet_op_receiver_kind, "u64"):
            let flet_op_receiver_u64 = I64.literal(1)
          else:
            return "ERR:E-SH-IR-STATEMENT"
          end if
        end if
        let flet_operand_check = fixed_operation_operand_check(words, flet_receiver_idx, flet_line_end_idx, flet_op_caller_idx, flet_op_receiver_kind)
        if sico.text.starts_with(flet_operand_check, "ERR:"):
          return flet_operand_check
        end if
        let flet_op_base = parameter_count
        match U64.checked_add(parameter_count, fixed_let_count_between(words, body_from, flet_i)):
          case ok(flet_op_base_after):
            set flet_op_base = flet_op_base_after
          case error(_):
            return "ERR:E-SH-IR-RANGE"
        end match
        let flet_op_line_start = find_text_from(src, "let", flet_search_from)
        let flet_op_rhs_offset = word_span_offset(words, src, flet_op_line_start, flet_i, flet_receiver_idx)
        let flet_op_literal_total = fixed_operation_literal_count(words, flet_receiver_idx, flet_op_caller_idx)
        let flet_op_constants = fixed_operation_literal_instructions(words, src, flet_receiver_idx, flet_op_caller_idx, flet_op_base, flet_receiver_idx, flet_op_rhs_offset)
        let flet_op_value = flet_op_base
        match U64.checked_add(flet_op_base, flet_op_literal_total):
          case ok(flet_op_value_after):
            set flet_op_value = flet_op_value_after
          case error(_):
            return "ERR:E-SH-IR-RANGE"
        end match
        let flet_op_open_idx = index_plus(flet_receiver_idx, U64.literal(3), body_end)
        let flet_op_close_idx = matching_close(words, flet_op_open_idx, flet_line_end_idx)
        let flet_op_close_offset = word_span_offset(words, src, flet_op_rhs_offset, flet_receiver_idx, flet_op_close_idx)
        let flet_op_range_end = flet_op_close_offset
        match U64.checked_add(flet_op_close_offset, U64.literal(1)):
          case ok(flet_op_range_after):
            set flet_op_range_end = flet_op_range_after
          case error(_):
            return "ERR:E-SH-IR-RANGE"
        end match
        let flet_op_name = word_at(words, index_plus(flet_receiver_idx, U64.literal(2), body_end))
        if U64.less_than(U64.literal(0), sico.text.length(flet_op_constants)):
          if U64.less_than(U64.literal(0), sico.text.length(flet_json)):
            set flet_json = sico.text.concat(flet_json, ",")
          end if
          set flet_json = sico.text.concat(flet_json, flet_op_constants)
        end if
        if U64.less_than(U64.literal(0), sico.text.length(flet_json)):
          set flet_json = sico.text.concat(flet_json, ",")
        end if
        set flet_json = sico.text.concat(flet_json, "{\"result\":")
        set flet_json = sico.text.concat(flet_json, sico.u64.to_text(flet_op_value))
        if U64.less_than(U64.literal(0), sico.text.length(checked_op_name(flet_op_name))):
          set flet_json = sico.text.concat(flet_json, ",\"ty\":")
          set flet_json = sico.text.concat(flet_json, result_type_json(flet_op_receiver_kind))
        else:
          set flet_json = sico.text.concat(flet_json, ",\"ty\":{\"kind\":\"")
          set flet_json = sico.text.concat(flet_json, flet_op_receiver_kind)
          set flet_json = sico.text.concat(flet_json, "\"}")
        end if
        set flet_json = sico.text.concat(flet_json, ",\"operation\":{\"op\":\"")
        set flet_json = sico.text.concat(flet_json, flet_op_name)
        set flet_json = sico.text.concat(flet_json, "\",\"data\":")
        if is_word(flet_op_name, "shl"):
          set flet_json = sico.text.concat(flet_json, "{\"value\":")
        else:
          if is_word(flet_op_name, "shr"):
            set flet_json = sico.text.concat(flet_json, "{\"value\":")
          else:
            set flet_json = sico.text.concat(flet_json, "{\"left\":")
          end if
        end if
        set flet_json = sico.text.concat(flet_json, sico.u64.to_text(fixed_operation_operand_value_base(words, flet_receiver_idx, flet_op_caller_idx, U64.literal(0), flet_op_base)))
        if is_word(flet_op_name, "shl"):
          set flet_json = sico.text.concat(flet_json, ",\"amount\":")
        else:
          if is_word(flet_op_name, "shr"):
            set flet_json = sico.text.concat(flet_json, ",\"amount\":")
          else:
            set flet_json = sico.text.concat(flet_json, ",\"right\":")
          end if
        end if
        set flet_json = sico.text.concat(flet_json, sico.u64.to_text(fixed_operation_operand_value_base(words, flet_receiver_idx, flet_op_caller_idx, U64.literal(1), flet_op_base)))
        set flet_json = sico.text.concat(flet_json, "}},\"range\":{\"start\":")
        set flet_json = sico.text.concat(flet_json, sico.u64.to_text(flet_op_rhs_offset))
        set flet_json = sico.text.concat(flet_json, ",\"end\":")
        set flet_json = sico.text.concat(flet_json, sico.u64.to_text(flet_op_range_end))
        set flet_json = sico.text.concat(flet_json, "}}")
        set flet_search_from = return_expression_end(src, flet_op_line_start)
        set flet_i = flet_line_end_idx
        continue
      end if
      if is_word(flet_rhs_kind, "call"):
        let flet_call_words_len = sico.list.length(words)
        let flet_call_caller_idx = previous_index(body_from, body_from)
        let flet_call_callee_idx = function_declaration_index(words, word_at(words, flet_receiver_idx))
        if U64.equal(flet_call_callee_idx, flet_call_words_len):
          return "ERR:E-SH-IR-CALL-TARGET"
        end if
        let flet_call_open_idx = next_index(flet_receiver_idx, flet_call_words_len)
        let flet_call_close_idx = matching_close(words, flet_call_open_idx, flet_line_end_idx)
        let flet_call_base = parameter_count
        match U64.checked_add(parameter_count, fixed_let_count_between(words, body_from, flet_i)):
          case ok(flet_call_base_after):
            set flet_call_base = flet_call_base_after
          case error(_):
            return "ERR:E-SH-IR-RANGE"
        end match
        let flet_call_args_json = argument_values_base(words, next_index(flet_call_open_idx, flet_call_words_len), flet_call_close_idx, flet_call_caller_idx, flet_call_callee_idx, flet_call_base)
        if sico.text.starts_with(flet_call_args_json, "ERR:"):
          return flet_call_args_json
        end if
        let flet_call_line_start = find_text_from(src, "let", flet_search_from)
        let flet_call_rhs_offset = word_span_offset(words, src, flet_call_line_start, flet_i, flet_receiver_idx)
        let flet_call_arg_total = fixed_let_rhs_instruction_count(words, flet_receiver_idx, flet_line_end_idx, flet_call_caller_idx)
        let flet_call_value = flet_call_base
        match U64.checked_add(flet_call_base, flet_call_arg_total):
          case ok(flet_call_summed):
            match U64.checked_sub(flet_call_summed, U64.literal(1)):
              case ok(flet_call_result):
                set flet_call_value = flet_call_result
              case error(_):
                return "ERR:E-SH-IR-RANGE"
            end match
          case error(_):
            return "ERR:E-SH-IR-RANGE"
        end match
        let flet_call_constants = argument_instructions(words, src, flet_receiver_idx, flet_call_rhs_offset, next_index(flet_call_open_idx, flet_call_words_len), flet_call_close_idx, flet_call_caller_idx, flet_call_base)
        let flet_call_kind = declared_return_kind(words, next_index(flet_call_callee_idx, flet_call_words_len))
        if U64.equal(sico.text.length(flet_call_kind), U64.literal(0)):
          return "ERR:E-SH-IR-CALL-TYPE"
        end if
        let flet_call_close_offset = word_span_offset(words, src, flet_call_rhs_offset, flet_receiver_idx, flet_call_close_idx)
        let flet_call_range_end = flet_call_close_offset
        match U64.checked_add(flet_call_close_offset, U64.literal(1)):
          case ok(flet_call_range_after):
            set flet_call_range_end = flet_call_range_after
          case error(_):
            return "ERR:E-SH-IR-RANGE"
        end match
        if U64.less_than(U64.literal(0), sico.text.length(flet_call_constants)):
          if U64.less_than(U64.literal(0), sico.text.length(flet_json)):
            set flet_json = sico.text.concat(flet_json, ",")
          end if
          set flet_json = sico.text.concat(flet_json, flet_call_constants)
        end if
        if U64.less_than(U64.literal(0), sico.text.length(flet_json)):
          set flet_json = sico.text.concat(flet_json, ",")
        end if
        set flet_json = sico.text.concat(flet_json, "{\"result\":")
        set flet_json = sico.text.concat(flet_json, sico.u64.to_text(flet_call_value))
        if sico.text.starts_with(flet_call_kind, "{"):
          set flet_json = sico.text.concat(flet_json, ",\"ty\":")
          set flet_json = sico.text.concat(flet_json, flet_call_kind)
        else:
          set flet_json = sico.text.concat(flet_json, ",\"ty\":{\"kind\":\"")
          set flet_json = sico.text.concat(flet_json, flet_call_kind)
          set flet_json = sico.text.concat(flet_json, "\"}")
        end if
        set flet_json = sico.text.concat(flet_json, ",\"operation\":{\"op\":\"call\",\"data\":{\"function\":")
        set flet_json = sico.text.concat(flet_json, sico.u64.to_text(function_declaration_ordinal(words, flet_call_callee_idx)))
        set flet_json = sico.text.concat(flet_json, ",\"arguments\":")
        set flet_json = sico.text.concat(flet_json, flet_call_args_json)
        set flet_json = sico.text.concat(flet_json, "}},\"range\":{\"start\":")
        set flet_json = sico.text.concat(flet_json, sico.u64.to_text(flet_call_rhs_offset))
        set flet_json = sico.text.concat(flet_json, ",\"end\":")
        set flet_json = sico.text.concat(flet_json, sico.u64.to_text(flet_call_range_end))
        set flet_json = sico.text.concat(flet_json, "}}")
        set flet_search_from = return_expression_end(src, flet_call_line_start)
        set flet_i = flet_line_end_idx
        continue
      end if
      if is_word(flet_rhs_kind, "literal"):
        let flet_literal_shape_ok = I64.literal(1)
      else:
        return "ERR:E-SH-IR-STATEMENT"
      end if
      let flet_dot_idx = index_plus(flet_i, U64.literal(4), body_end)
      let flet_literal_name_idx = index_plus(flet_i, U64.literal(5), body_end)
      let flet_open_idx = index_plus(flet_i, U64.literal(6), body_end)
      let flet_magnitude_idx = index_plus(flet_i, U64.literal(7), body_end)
      let flet_close_idx = index_plus(flet_i, U64.literal(8), body_end)
      let flet_newline_idx = index_plus(flet_i, U64.literal(9), body_end)
      if is_word(word_at(words, flet_dot_idx), "."):
          if is_word(word_at(words, flet_literal_name_idx), "literal"):
            if is_word(word_at(words, flet_open_idx), "("):
              if is_word(word_at(words, flet_close_idx), ")"):
                if is_word(word_at(words, flet_newline_idx), "<nl>"):
                  let flet_shape_ok = I64.literal(1)
                else:
                  return "ERR:E-SH-IR-STATEMENT"
                end if
              else:
                return "ERR:E-SH-IR-STATEMENT"
              end if
            else:
              return "ERR:E-SH-IR-STATEMENT"
            end if
          else:
            return "ERR:E-SH-IR-STATEMENT"
          end if
        else:
          return "ERR:E-SH-IR-STATEMENT"
        end if
      let flet_kind = scalar_type_kind(word_at(words, flet_receiver_idx))
      if is_word(flet_kind, "i64"):
        let flet_kind_ok = I64.literal(1)
      else:
        if is_word(flet_kind, "u64"):
          let flet_kind_u64_ok = I64.literal(1)
        else:
          return "ERR:E-SH-IR-STATEMENT"
        end if
      end if
      let flet_magnitude = word_at(words, flet_magnitude_idx)
      if is_canonical_magnitude(flet_magnitude):
        if is_word(flet_kind, "i64"):
          if decimal_at_most(flet_magnitude, "9223372036854775807"):
            let flet_i64_range_ok = I64.literal(1)
          else:
            return "ERR:E-SH-IR-I64-RANGE"
          end if
        else:
          if decimal_at_most(flet_magnitude, "18446744073709551615"):
            let flet_u64_range_ok = I64.literal(1)
          else:
            return "ERR:E-SH-IR-U64-RANGE"
          end if
        end if
      else:
        return "ERR:E-SH-IR-STATEMENT"
      end if
      let flet_duplicate_scan = next_index(flet_i, body_end)
      while U64.less_than(flet_duplicate_scan, body_end):
        if is_word(word_at(words, flet_duplicate_scan), "let"):
          let flet_duplicate_name_idx = next_index(flet_duplicate_scan, body_end)
          if is_word(word_at(words, flet_duplicate_name_idx), word_at(words, flet_name_idx)):
            return "ERR:E-SH-IR-STATEMENT"
          end if
        end if
        set flet_duplicate_scan = next_index(flet_duplicate_scan, body_end)
      end while
      let flet_line_start = find_text_from(src, "let", flet_search_from)
      let flet_literal_start = find_text_from(src, "literal", flet_line_start)
      let flet_magnitude_start = find_text_from(src, flet_magnitude, flet_literal_start)
      let flet_magnitude_end = index_plus(flet_magnitude_start, sico.text.length(flet_magnitude), sico.bytes.length(src))
      let flet_result = parameter_count
      match U64.checked_add(parameter_count, flet_ordinal):
        case ok(flet_value_id):
          set flet_result = flet_value_id
        case error(_):
          return "ERR:E-SH-IR-RANGE"
      end match
      if U64.less_than(U64.literal(0), flet_ordinal):
        set flet_json = sico.text.concat(flet_json, ",")
      end if
      set flet_json = sico.text.concat(flet_json, "{\"result\":")
      set flet_json = sico.text.concat(flet_json, sico.u64.to_text(flet_result))
      set flet_json = sico.text.concat(flet_json, ",\"ty\":{\"kind\":\"")
      set flet_json = sico.text.concat(flet_json, flet_kind)
      set flet_json = sico.text.concat(flet_json, "\"},\"operation\":{\"op\":\"const_")
      set flet_json = sico.text.concat(flet_json, flet_kind)
      set flet_json = sico.text.concat(flet_json, "\",\"data\":")
      set flet_json = sico.text.concat(flet_json, flet_magnitude)
      set flet_json = sico.text.concat(flet_json, "},\"range\":{\"start\":")
      set flet_json = sico.text.concat(flet_json, sico.u64.to_text(flet_magnitude_start))
      set flet_json = sico.text.concat(flet_json, ",\"end\":")
      set flet_json = sico.text.concat(flet_json, sico.u64.to_text(flet_magnitude_end))
      set flet_json = sico.text.concat(flet_json, "}}")
      set flet_search_from = return_expression_end(src, flet_line_start)
      set flet_ordinal = next_index(flet_ordinal, flet_ordinal)
    end if
    set flet_i = next_index(flet_i, body_end)
  end while
  return flet_json
end function

function return_expression_end(src: Bytes, start_idx: U64) returns U64:
  let expression_source_len = sico.bytes.length(src)
  let expression_scan_idx = start_idx
  let expression_last = start_idx
  while U64.less_than(expression_scan_idx, expression_source_len):
    let expression_byte = sico.bytes.at(src, expression_scan_idx, I64.literal(0))
    if I64.equal(expression_byte, I64.literal(10)):
      return expression_last
    end if
    if I64.equal(expression_byte, I64.literal(13)):
      let expression_cr = I64.literal(1)
    else:
      if I64.equal(expression_byte, I64.literal(32)):
        let expression_space = I64.literal(1)
      else:
        if I64.equal(expression_byte, I64.literal(9)):
          let expression_tab = I64.literal(1)
        else:
          set expression_last = next_index(expression_scan_idx, expression_source_len)
        end if
      end if
    end if
    set expression_scan_idx = next_index(expression_scan_idx, expression_source_len)
  end while
  return expression_last
end function

function general_cell_lookup(words: List[Text], body_from: U64, bound_idx: U64, name: Text) returns U64:
  let gcl_i = body_from
  let gcl_ordinal = U64.literal(0)
  while U64.less_than(gcl_i, bound_idx):
    if is_word(word_at(words, gcl_i), "let"):
      let gcl_name_idx = next_index(gcl_i, bound_idx)
      if is_word(word_at(words, gcl_name_idx), name):
        return gcl_ordinal
      end if
      set gcl_ordinal = next_index(gcl_ordinal, gcl_ordinal)
    end if
    set gcl_i = next_index(gcl_i, bound_idx)
  end while
  return sico.list.length(words)
end function

function general_type_json(kind: Text) returns Text:
  if sico.text.starts_with(kind, "{"):
    return kind
  end if
  let gtj_left = sico.text.concat("{\"kind\":\"", kind)
  return sico.text.concat(gtj_left, "\"}")
end function

function general_emission(value: U64, count: U64, kind: Text, json: Text) returns List[Text]:
  let gem_parts = sico.text.split_lines("")
  set gem_parts = sico.list.append(gem_parts, sico.u64.to_text(value))
  set gem_parts = sico.list.append(gem_parts, sico.u64.to_text(count))
  set gem_parts = sico.list.append(gem_parts, kind)
  set gem_parts = sico.list.append(gem_parts, json)
  return gem_parts
end function

function general_field(parts: List[Text], index: U64) returns Text:
  match sico.list.get(parts, index):
    case ok(field):
      return field
    case error(_):
      return ""
  end match
end function

function general_digit_value(d: I64) returns U64:
  if I64.equal(d, I64.literal(48)):
    return U64.literal(0)
  end if
  if I64.equal(d, I64.literal(49)):
    return U64.literal(1)
  end if
  if I64.equal(d, I64.literal(50)):
    return U64.literal(2)
  end if
  if I64.equal(d, I64.literal(51)):
    return U64.literal(3)
  end if
  if I64.equal(d, I64.literal(52)):
    return U64.literal(4)
  end if
  if I64.equal(d, I64.literal(53)):
    return U64.literal(5)
  end if
  if I64.equal(d, I64.literal(54)):
    return U64.literal(6)
  end if
  if I64.equal(d, I64.literal(55)):
    return U64.literal(7)
  end if
  if I64.equal(d, I64.literal(56)):
    return U64.literal(8)
  end if
  if I64.equal(d, I64.literal(57)):
    return U64.literal(9)
  end if
  return U64.literal(16)
end function

function general_parse_u64(text: Text) returns U64:
  let gpu_bytes = sico.text.encode(text)
  let gpu_len = sico.bytes.length(gpu_bytes)
  let gpu_value = U64.literal(0)
  let gpu_i = U64.literal(0)
  while U64.less_than(gpu_i, gpu_len):
    let gpu_digit = general_digit_value(sico.bytes.at(gpu_bytes, gpu_i, I64.literal(0)))
    if U64.less_than(U64.literal(15), gpu_digit):
      return gpu_value
    end if
    match U64.checked_mul(gpu_value, U64.literal(10)):
      case ok(gpu_scaled):
        set gpu_value = gpu_scaled
      case error(_):
        return gpu_value
    end match
    match U64.checked_add(gpu_value, gpu_digit):
      case ok(gpu_summed):
        set gpu_value = gpu_summed
      case error(_):
        return gpu_value
    end match
    set gpu_i = next_index(gpu_i, gpu_len)
  end while
  return gpu_value
end function

function find_newline_from(src: Bytes, from_idx: U64) returns U64:
  let fnf_len = sico.bytes.length(src)
  let fnf_i = from_idx
  while U64.less_than(fnf_i, fnf_len):
    if I64.equal(sico.bytes.at(src, fnf_i, I64.literal(0)), I64.literal(10)):
      match U64.checked_add(fnf_i, U64.literal(1)):
        case ok(fnf_after):
          return fnf_after
        case error(_):
          return fnf_len
      end match
    end if
    set fnf_i = next_index(fnf_i, fnf_len)
  end while
  return fnf_len
end function

function general_expression(words: List[Text], src: Bytes, name_idx: U64, body_from: U64, expr_start: U64, expr_end: U64, next_value: U64, anchor_idx: U64, anchor_offset: U64) returns List[Text]:
  let ge_words_len = sico.list.length(words)
  if U64.equal(expr_start, expr_end):
    return general_emission(next_value, U64.literal(0), "", "ERR:E-SH-IR-EXPRESSION")
  end if
  let ge_first = word_at(words, expr_start)
  let ge_second_idx = next_index(expr_start, ge_words_len)
  if U64.equal(ge_second_idx, expr_end):
    if is_canonical_magnitude(ge_first):
      let ge_int_end = anchor_offset
      match U64.checked_add(anchor_offset, sico.text.length(ge_first)):
        case ok(ge_int_after):
          set ge_int_end = ge_int_after
        case error(_):
          return general_emission(next_value, U64.literal(0), "", "ERR:E-SH-IR-RANGE")
      end match
      let ge_int_json = "{\"result\":"
      set ge_int_json = sico.text.concat(ge_int_json, sico.u64.to_text(next_value))
      set ge_int_json = sico.text.concat(ge_int_json, ",\"ty\":{\"kind\":\"int\"},\"operation\":{\"op\":\"const_int\",\"data\":\"")
      set ge_int_json = sico.text.concat(ge_int_json, ge_first)
      set ge_int_json = sico.text.concat(ge_int_json, "\"},\"range\":{\"start\":")
      set ge_int_json = sico.text.concat(ge_int_json, sico.u64.to_text(anchor_offset))
      set ge_int_json = sico.text.concat(ge_int_json, ",\"end\":")
      set ge_int_json = sico.text.concat(ge_int_json, sico.u64.to_text(ge_int_end))
      set ge_int_json = sico.text.concat(ge_int_json, "}}")
      return general_emission(next_value, U64.literal(1), "int", ge_int_json)
    end if
    if is_word(ge_first, "true"):
      let ge_true_end = anchor_offset
      match U64.checked_add(anchor_offset, sico.text.length(ge_first)):
        case ok(ge_true_after):
          set ge_true_end = ge_true_after
        case error(_):
          return general_emission(next_value, U64.literal(0), "", "ERR:E-SH-IR-RANGE")
      end match
      let ge_true_json = "{\"result\":"
      set ge_true_json = sico.text.concat(ge_true_json, sico.u64.to_text(next_value))
      set ge_true_json = sico.text.concat(ge_true_json, ",\"ty\":{\"kind\":\"bool\"},\"operation\":{\"op\":\"const_bool\",\"data\":true},\"range\":{\"start\":")
      set ge_true_json = sico.text.concat(ge_true_json, sico.u64.to_text(anchor_offset))
      set ge_true_json = sico.text.concat(ge_true_json, ",\"end\":")
      set ge_true_json = sico.text.concat(ge_true_json, sico.u64.to_text(ge_true_end))
      set ge_true_json = sico.text.concat(ge_true_json, "}}")
      return general_emission(next_value, U64.literal(1), "bool", ge_true_json)
    end if
    if is_word(ge_first, "false"):
      let ge_false_end = anchor_offset
      match U64.checked_add(anchor_offset, sico.text.length(ge_first)):
        case ok(ge_false_after):
          set ge_false_end = ge_false_after
        case error(_):
          return general_emission(next_value, U64.literal(0), "", "ERR:E-SH-IR-RANGE")
      end match
      let ge_false_json = "{\"result\":"
      set ge_false_json = sico.text.concat(ge_false_json, sico.u64.to_text(next_value))
      set ge_false_json = sico.text.concat(ge_false_json, ",\"ty\":{\"kind\":\"bool\"},\"operation\":{\"op\":\"const_bool\",\"data\":false},\"range\":{\"start\":")
      set ge_false_json = sico.text.concat(ge_false_json, sico.u64.to_text(anchor_offset))
      set ge_false_json = sico.text.concat(ge_false_json, ",\"end\":")
      set ge_false_json = sico.text.concat(ge_false_json, sico.u64.to_text(ge_false_end))
      set ge_false_json = sico.text.concat(ge_false_json, "}}")
      return general_emission(next_value, U64.literal(1), "bool", ge_false_json)
    end if
    if is_string_token(ge_first):
      let ge_string_end = anchor_offset
      match U64.checked_add(anchor_offset, sico.text.length(ge_first)):
        case ok(ge_string_after):
          set ge_string_end = ge_string_after
        case error(_):
          return general_emission(next_value, U64.literal(0), "", "ERR:E-SH-IR-RANGE")
      end match
      let ge_string_json = "{\"result\":"
      set ge_string_json = sico.text.concat(ge_string_json, sico.u64.to_text(next_value))
      set ge_string_json = sico.text.concat(ge_string_json, ",\"ty\":{\"kind\":\"string\"},\"operation\":{\"op\":\"const_string\",\"data\":")
      set ge_string_json = sico.text.concat(ge_string_json, json_string_token(ge_first))
      set ge_string_json = sico.text.concat(ge_string_json, "},\"range\":{\"start\":")
      set ge_string_json = sico.text.concat(ge_string_json, sico.u64.to_text(anchor_offset))
      set ge_string_json = sico.text.concat(ge_string_json, ",\"end\":")
      set ge_string_json = sico.text.concat(ge_string_json, sico.u64.to_text(ge_string_end))
      set ge_string_json = sico.text.concat(ge_string_json, "}}")
      return general_emission(next_value, U64.literal(1), "string", ge_string_json)
    end if
    let ge_param_count = count_params(words, name_idx)
    let ge_param_id = binding_parameter_index(words, name_idx, ge_first)
    if U64.less_than(ge_param_id, ge_param_count):
      let ge_param_kind = binding_parameter_kind(words, name_idx, ge_first)
      if sico.text.starts_with(ge_param_kind, "ERR:"):
        return general_emission(next_value, U64.literal(0), "", ge_param_kind)
      end if
      return general_emission(ge_param_id, U64.literal(0), ge_param_kind, "")
    end if
    let ge_cell_index = general_cell_lookup(words, body_from, expr_start, ge_first)
    if U64.less_than(ge_cell_index, ge_words_len):
      let ge_cell_kind = fixed_let_binding_kind(words, body_from, expr_start, ge_first)
      if U64.equal(sico.text.length(ge_cell_kind), U64.literal(0)):
        return general_emission(next_value, U64.literal(0), "", "ERR:E-SH-IR-UNRESOLVED")
      end if
      let ge_cell_end = anchor_offset
      match U64.checked_add(anchor_offset, sico.text.length(ge_first)):
        case ok(ge_cell_after):
          set ge_cell_end = ge_cell_after
        case error(_):
          return general_emission(next_value, U64.literal(0), "", "ERR:E-SH-IR-RANGE")
      end match
      let ge_cell_json = "{\"result\":"
      set ge_cell_json = sico.text.concat(ge_cell_json, sico.u64.to_text(next_value))
      set ge_cell_json = sico.text.concat(ge_cell_json, ",\"ty\":")
      set ge_cell_json = sico.text.concat(ge_cell_json, general_type_json(ge_cell_kind))
      set ge_cell_json = sico.text.concat(ge_cell_json, ",\"operation\":{\"op\":\"read_local\",\"data\":{\"local\":")
      set ge_cell_json = sico.text.concat(ge_cell_json, sico.u64.to_text(ge_cell_index))
      set ge_cell_json = sico.text.concat(ge_cell_json, "}},\"range\":{\"start\":")
      set ge_cell_json = sico.text.concat(ge_cell_json, sico.u64.to_text(anchor_offset))
      set ge_cell_json = sico.text.concat(ge_cell_json, ",\"end\":")
      set ge_cell_json = sico.text.concat(ge_cell_json, sico.u64.to_text(ge_cell_end))
      set ge_cell_json = sico.text.concat(ge_cell_json, "}}")
      return general_emission(next_value, U64.literal(1), ge_cell_kind, ge_cell_json)
    end if
    return general_emission(next_value, U64.literal(0), "", "ERR:E-SH-IR-UNRESOLVED")
  end if
  if is_word(word_at(words, ge_second_idx), "."):
    let ge_literal_kind = fixed_literal_argument(words, expr_start)
    if sico.text.starts_with(ge_literal_kind, "ERR:"):
      return general_emission(next_value, U64.literal(0), "", ge_literal_kind)
    end if
    if U64.less_than(U64.literal(0), sico.text.length(ge_literal_kind)):
      let ge_sign_idx = index_plus(expr_start, U64.literal(4), ge_words_len)
      let ge_is_negative = is_word(word_at(words, ge_sign_idx), "-")
      let ge_sign_offset = word_span_offset(words, src, anchor_offset, anchor_idx, ge_sign_idx)
      let ge_digits_word = ""
      let ge_digits_offset = ge_sign_offset
      if ge_is_negative:
        let ge_magnitude_idx = next_index(ge_sign_idx, ge_words_len)
        set ge_digits_word = word_at(words, ge_magnitude_idx)
        match U64.checked_add(ge_sign_offset, U64.literal(1)):
          case ok(ge_after_sign):
            set ge_digits_offset = ge_after_sign
          case error(_):
            return general_emission(next_value, U64.literal(0), "", "ERR:E-SH-IR-RANGE")
        end match
      else:
        set ge_digits_word = word_at(words, ge_sign_idx)
      end if
      let ge_digits_end = ge_digits_offset
      match U64.checked_add(ge_digits_offset, sico.text.length(ge_digits_word)):
        case ok(ge_after_digits):
          set ge_digits_end = ge_after_digits
        case error(_):
          return general_emission(next_value, U64.literal(0), "", "ERR:E-SH-IR-RANGE")
      end match
      let ge_data = ge_digits_word
      if ge_is_negative:
        set ge_data = sico.text.concat("-", ge_digits_word)
      end if
      let ge_literal_json = "{\"result\":"
      set ge_literal_json = sico.text.concat(ge_literal_json, sico.u64.to_text(next_value))
      set ge_literal_json = sico.text.concat(ge_literal_json, ",\"ty\":{\"kind\":\"")
      set ge_literal_json = sico.text.concat(ge_literal_json, ge_literal_kind)
      set ge_literal_json = sico.text.concat(ge_literal_json, "\"},\"operation\":{\"op\":\"const_")
      set ge_literal_json = sico.text.concat(ge_literal_json, ge_literal_kind)
      set ge_literal_json = sico.text.concat(ge_literal_json, "\",\"data\":")
      set ge_literal_json = sico.text.concat(ge_literal_json, ge_data)
      set ge_literal_json = sico.text.concat(ge_literal_json, "},\"range\":{\"start\":")
      set ge_literal_json = sico.text.concat(ge_literal_json, sico.u64.to_text(ge_sign_offset))
      set ge_literal_json = sico.text.concat(ge_literal_json, ",\"end\":")
      set ge_literal_json = sico.text.concat(ge_literal_json, sico.u64.to_text(ge_digits_end))
      set ge_literal_json = sico.text.concat(ge_literal_json, "}}")
      return general_emission(next_value, U64.literal(1), ge_literal_kind, ge_literal_json)
    end if
    let ge_op_token_idx = index_plus(expr_start, U64.literal(2), ge_words_len)
    let ge_op_name = fixed_op_name(word_at(words, ge_op_token_idx))
    let ge_checked_name = checked_op_name(word_at(words, ge_op_token_idx))
    if U64.less_than(U64.literal(0), sico.text.length(ge_op_name)):
      if U64.less_than(U64.literal(0), sico.text.length(ge_checked_name)):
        let ge_dead_shape = I64.literal(1)
      else:
        if is_word(word_at(words, index_plus(expr_start, U64.literal(3), ge_words_len)), "("):
          let ge_receiver_kind = scalar_type_kind(ge_first)
          if sico.text.starts_with(ge_receiver_kind, "ERR:"):
            return general_emission(next_value, U64.literal(0), "", "ERR:E-SH-IR-EXPRESSION")
          end if
          let ge_operand_check = fixed_operation_operand_check(words, expr_start, expr_end, name_idx, ge_receiver_kind)
          if sico.text.starts_with(ge_operand_check, "ERR:"):
            return general_emission(next_value, U64.literal(0), "", ge_operand_check)
          end if
          let ge_open_idx = index_plus(expr_start, U64.literal(3), ge_words_len)
          let ge_close_idx = matching_close(words, ge_open_idx, expr_end)
          let ge_close_offset = word_span_offset(words, src, anchor_offset, anchor_idx, ge_close_idx)
          let ge_range_end = ge_close_offset
          match U64.checked_add(ge_close_offset, U64.literal(1)):
            case ok(ge_after_close):
              set ge_range_end = ge_after_close
            case error(_):
              return general_emission(next_value, U64.literal(0), "", "ERR:E-SH-IR-RANGE")
          end match
          let ge_first_idx = fixed_operation_operand_atom_idx(words, expr_start, name_idx, U64.literal(0))
          let ge_first_width = fixed_operation_operand_width(words, ge_first_idx, name_idx)
          let ge_first_end = ge_first_idx
          match U64.checked_add(ge_first_idx, ge_first_width):
            case ok(ge_first_after):
              set ge_first_end = ge_first_after
            case error(_):
              return general_emission(next_value, U64.literal(0), "", "ERR:E-SH-IR-RANGE")
          end match
          let ge_first_offset = word_span_offset(words, src, anchor_offset, anchor_idx, ge_first_idx)
          let ge_left_parts = general_expression(words, src, name_idx, body_from, ge_first_idx, ge_first_end, next_value, ge_first_idx, ge_first_offset)
          let ge_left_value = general_parse_u64(general_field(ge_left_parts, U64.literal(0)))
          let ge_left_count = general_parse_u64(general_field(ge_left_parts, U64.literal(1)))
          let ge_left_json = general_field(ge_left_parts, U64.literal(3))
          if sico.text.starts_with(ge_left_json, "ERR:"):
            return ge_left_parts
          end if
          let ge_operand_second_idx = fixed_operation_operand_atom_idx(words, expr_start, name_idx, U64.literal(1))
          let ge_operand_second_width = fixed_operation_operand_width(words, ge_operand_second_idx, name_idx)
          let ge_operand_second_end = ge_operand_second_idx
          match U64.checked_add(ge_operand_second_idx, ge_operand_second_width):
            case ok(ge_second_after):
              set ge_operand_second_end = ge_second_after
            case error(_):
              return general_emission(next_value, U64.literal(0), "", "ERR:E-SH-IR-RANGE")
          end match
          let ge_operand_second_offset = word_span_offset(words, src, anchor_offset, anchor_idx, ge_operand_second_idx)
          let ge_running = next_value
          match U64.checked_add(next_value, ge_left_count):
            case ok(ge_running_after):
              set ge_running = ge_running_after
            case error(_):
              return general_emission(next_value, U64.literal(0), "", "ERR:E-SH-IR-RANGE")
          end match
          let ge_right_parts = general_expression(words, src, name_idx, body_from, ge_operand_second_idx, ge_operand_second_end, ge_running, ge_operand_second_idx, ge_operand_second_offset)
          let ge_right_value = general_parse_u64(general_field(ge_right_parts, U64.literal(0)))
          let ge_right_count = general_parse_u64(general_field(ge_right_parts, U64.literal(1)))
          let ge_right_json = general_field(ge_right_parts, U64.literal(3))
          if sico.text.starts_with(ge_right_json, "ERR:"):
            return ge_right_parts
          end if
          let ge_op_value = ge_running
          match U64.checked_add(ge_running, ge_right_count):
            case ok(ge_op_value_after):
              set ge_op_value = ge_op_value_after
            case error(_):
              return general_emission(next_value, U64.literal(0), "", "ERR:E-SH-IR-RANGE")
          end match
          let ge_op_count = ge_left_count
          match U64.checked_add(ge_op_count, ge_right_count):
            case ok(ge_op_count_after):
              set ge_op_count = ge_op_count_after
            case error(_):
              return general_emission(next_value, U64.literal(0), "", "ERR:E-SH-IR-RANGE")
          end match
          let ge_total = ge_op_count
          match U64.checked_add(ge_op_count, U64.literal(1)):
            case ok(ge_total_after):
              set ge_total = ge_total_after
            case error(_):
              return general_emission(next_value, U64.literal(0), "", "ERR:E-SH-IR-RANGE")
          end match
          let ge_out = ge_left_json
          if U64.less_than(U64.literal(0), sico.text.length(ge_right_json)):
            if U64.less_than(U64.literal(0), sico.text.length(ge_out)):
              set ge_out = sico.text.concat(ge_out, ",")
            end if
            set ge_out = sico.text.concat(ge_out, ge_right_json)
          end if
          if U64.less_than(U64.literal(0), sico.text.length(ge_out)):
            set ge_out = sico.text.concat(ge_out, ",")
          end if
          set ge_out = sico.text.concat(ge_out, "{\"result\":")
          set ge_out = sico.text.concat(ge_out, sico.u64.to_text(ge_op_value))
          set ge_out = sico.text.concat(ge_out, ",\"ty\":{\"kind\":\"")
          set ge_out = sico.text.concat(ge_out, ge_receiver_kind)
          set ge_out = sico.text.concat(ge_out, "\"},\"operation\":{\"op\":\"")
          set ge_out = sico.text.concat(ge_out, ge_op_name)
          set ge_out = sico.text.concat(ge_out, "\",\"data\":")
          if is_word(ge_op_name, "shl"):
            set ge_out = sico.text.concat(ge_out, "{\"value\":")
          else:
            if is_word(ge_op_name, "shr"):
              set ge_out = sico.text.concat(ge_out, "{\"value\":")
            else:
              set ge_out = sico.text.concat(ge_out, "{\"left\":")
            end if
          end if
          set ge_out = sico.text.concat(ge_out, sico.u64.to_text(ge_left_value))
          if is_word(ge_op_name, "shl"):
            set ge_out = sico.text.concat(ge_out, ",\"amount\":")
          else:
            if is_word(ge_op_name, "shr"):
              set ge_out = sico.text.concat(ge_out, ",\"amount\":")
            else:
              set ge_out = sico.text.concat(ge_out, ",\"right\":")
            end if
          end if
          set ge_out = sico.text.concat(ge_out, sico.u64.to_text(ge_right_value))
          set ge_out = sico.text.concat(ge_out, "}},\"range\":{\"start\":")
          set ge_out = sico.text.concat(ge_out, sico.u64.to_text(anchor_offset))
          set ge_out = sico.text.concat(ge_out, ",\"end\":")
