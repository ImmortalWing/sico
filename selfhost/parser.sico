              set instructions_json = sico.text.concat(instructions_json, sico.u64.to_text(result_value))
              set instructions_json = sico.text.concat(instructions_json, ",\"ty\":{\"kind\":\"u64\"},\"operation\":{\"op\":\"const_u64\",\"data\":")
