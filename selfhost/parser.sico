function general_list_set(parts: List[Text], index: U64, value: Text) returns List[Text]:
  let gls_out = sico.text.split_lines("")
  let gls_len = sico.list.length(parts)
  let gls_i = U64.literal(0)
  while U64.less_than(gls_i, gls_len):
    if U64.equal(gls_i, index):
      set gls_out = sico.list.append(gls_out, value)
    else:
      match sico.list.get(parts, gls_i):
        case ok(gls_entry):
          set gls_out = sico.list.append(gls_out, gls_entry)
        case error(_):
          set gls_out = sico.list.append(gls_out, "")
      end match
    end if
    set gls_i = next_index(gls_i, gls_len)
  end while
  return gls_out
end function

function fixed_cmp_name(word: Text) returns Text:
  if is_word(word, "equal"):
    return "equal_fixed"
  end if
  if is_word(word, "less_than"):
    return "less_fixed"
  end if
  return ""
end function

function general_find_region(words: List[Text], body_end_word: U64, if_line: U64) returns List[Text]:
  let gfr_else = body_end_word
  let gfr_end = body_end_word
  let gfr_depth = U64.literal(0)
  let gfr_done = U64.literal(0)
  let gfr_line_end = line_end(words, if_line)
  let gfr_line = next_index(gfr_line_end, body_end_word)
  while U64.less_than(gfr_line, body_end_word):
    if U64.equal(gfr_done, U64.literal(1)):
      set gfr_line = body_end_word
      continue
    end if
    let gfr_first = word_at(words, gfr_line)
    if is_word(gfr_first, "if"):
      set gfr_depth = next_index(gfr_depth, gfr_depth)
    end if
    if is_word(gfr_first, "while"):
      set gfr_depth = next_index(gfr_depth, gfr_depth)
    end if
    if is_word(gfr_first, "for"):
      set gfr_depth = next_index(gfr_depth, gfr_depth)
    end if
    if is_word(gfr_first, "match"):
      set gfr_depth = next_index(gfr_depth, gfr_depth)
    end if
    if is_word(gfr_first, "else"):
      if U64.equal(gfr_depth, U64.literal(0)):
        if U64.equal(gfr_else, body_end_word):
          set gfr_else = gfr_line
        else:
          let gfr_else_seen = I64.literal(1)
        end if
      else:
        let gfr_else_nested = I64.literal(1)
      end if
    end if
    if is_word(gfr_first, "end"):
      if U64.equal(gfr_depth, U64.literal(0)):
        set gfr_end = gfr_line
        set gfr_done = U64.literal(1)
      else:
        match U64.checked_sub(gfr_depth, U64.literal(1)):
          case ok(gfr_depth_after):
            set gfr_depth = gfr_depth_after
          case error(_):
            return general_emission(body_end_word, body_end_word, "", "")
        end match
      end if
    end if
    let gfr_advance = line_end(words, gfr_line)
    set gfr_line = next_index(gfr_advance, body_end_word)
  end while
  return general_emission(gfr_else, gfr_end, "", "")
end function

function general_materialize(words: List[Text], fn_name: Text, blk_instr: List[Text], blk_tkind: List[Text], blk_ta: List[Text], blk_tb: List[Text], blk_tc: List[Text], blk_rs: List[Text], blk_re: List[Text], blk_stamp: List[Text], blk_marked: List[Text], blk_count: U64, stamp_seq: U64, m_blk: List[Text], m_pat: List[Text], m_rs: List[Text], m_re: List[Text], fn_start: U64, fn_end: U64, parameters_json: Text, function_ordinal: U64, return_kind: Text, locals: Text) returns Text:
  let order = sico.text.split_lines("")
  let gsf_seq_scan = U64.literal(0)
  while U64.less_than(gsf_seq_scan, stamp_seq):
    set gsf_seq_scan = next_index(gsf_seq_scan, gsf_seq_scan)
    let gsf_seq_target = gsf_seq_scan
    let gsf_seq_b = U64.literal(0)
    let gsf_seq_found = U64.literal(0)
    while U64.less_than(gsf_seq_b, blk_count):
      if U64.equal(gsf_seq_found, U64.literal(0)):
        let gsf_seq_marked = general_field(blk_marked, gsf_seq_b)
        if is_word(gsf_seq_marked, "1"):
          let gsf_seq_stamp = general_parse_u64(general_field(blk_stamp, gsf_seq_b))
          if U64.equal(gsf_seq_stamp, gsf_seq_target):
            set order = sico.list.append(order, sico.u64.to_text(gsf_seq_b))
            set gsf_seq_found = U64.literal(1)
          else:
            let gsf_seq_stamp_diff = I64.literal(1)
          end if
        else:
          let gsf_seq_unmarked = I64.literal(1)
        end if
      else:
        let gsf_seq_found_dead = I64.literal(1)
      end if
      set gsf_seq_b = next_index(gsf_seq_b, blk_count)
    end while
  end while
  let gsf_trail_b = U64.literal(0)
  while U64.less_than(gsf_trail_b, blk_count):
    let gsf_trail_marked = general_field(blk_marked, gsf_trail_b)
    if is_word(gsf_trail_marked, "0"):
      set order = sico.list.append(order, sico.u64.to_text(gsf_trail_b))
    else:
      let gsf_trail_marked_dead = I64.literal(1)
    end if
    set gsf_trail_b = next_index(gsf_trail_b, blk_count)
  end while
  let gsf_blocks_json = ""
  let order_len = sico.list.length(order)
  let order_k = U64.literal(0)
  while U64.less_than(order_k, order_len):
    let gsf_blk_b = general_parse_u64(general_field(order, order_k))
    let gsf_blk_json_instr = general_field(blk_instr, gsf_blk_b)
    let gsf_blk_json_tkind = general_field(blk_tkind, gsf_blk_b)
    let gsf_blk_json_ta = general_parse_u64(general_field(blk_ta, gsf_blk_b))
    let gsf_blk_json_tb = general_parse_u64(general_field(blk_tb, gsf_blk_b))
    let gsf_blk_json_tc = general_parse_u64(general_field(blk_tc, gsf_blk_b))
    let gsf_blk_json_rs = general_parse_u64(general_field(blk_rs, gsf_blk_b))
    let gsf_blk_json_re = general_parse_u64(general_field(blk_re, gsf_blk_b))
    let gsf_blk_term = "{\"kind\":\"unreachable\"}"
    if is_word(gsf_blk_json_tkind, "return"):
      set gsf_blk_term = "{\"kind\":\"return\",\"data\":"
      set gsf_blk_term = sico.text.concat(gsf_blk_term, sico.u64.to_text(gsf_blk_json_ta))
      set gsf_blk_term = sico.text.concat(gsf_blk_term, "}")
    else:
      if is_word(gsf_blk_json_tkind, "jump"):
        let gsf_blk_term_scan = U64.literal(0)
        let gsf_blk_term_pos = U64.literal(0)
        while U64.less_than(gsf_blk_term_scan, order_len):
          if U64.equal(gsf_blk_term_pos, U64.literal(0)):
            let gsf_blk_term_entry = general_parse_u64(general_field(order, gsf_blk_term_scan))
            if U64.equal(gsf_blk_term_entry, gsf_blk_json_ta):
              set gsf_blk_term_pos = next_index(gsf_blk_term_scan, gsf_blk_term_scan)
            else:
              let gsf_blk_term_entry_diff = I64.literal(1)
            end if
          else:
            let gsf_blk_term_pos_dead = I64.literal(1)
          end if
          set gsf_blk_term_scan = next_index(gsf_blk_term_scan, order_len)
        end while
        set gsf_blk_term = "{\"kind\":\"jump\",\"data\":"
        set gsf_blk_term = sico.text.concat(gsf_blk_term, sico.u64.to_text(previous_index(gsf_blk_term_pos, gsf_blk_term_pos)))
        set gsf_blk_term = sico.text.concat(gsf_blk_term, "}")
      else:
        if is_word(gsf_blk_json_tkind, "branch"):
          let gsf_blk_term_then_scan = U64.literal(0)
          let gsf_blk_term_then_pos = U64.literal(0)
          while U64.less_than(gsf_blk_term_then_scan, order_len):
            if U64.equal(gsf_blk_term_then_pos, U64.literal(0)):
              let gsf_blk_term_then_entry = general_parse_u64(general_field(order, gsf_blk_term_then_scan))
              if U64.equal(gsf_blk_term_then_entry, gsf_blk_json_tb):
                set gsf_blk_term_then_pos = next_index(gsf_blk_term_then_scan, gsf_blk_term_then_scan)
              else:
                let gsf_blk_term_then_diff = I64.literal(1)
              end if
            else:
              let gsf_blk_term_then_dead = I64.literal(1)
            end if
            set gsf_blk_term_then_scan = next_index(gsf_blk_term_then_scan, order_len)
          end while
          let gsf_blk_term_else_scan = U64.literal(0)
          let gsf_blk_term_else_pos = U64.literal(0)
          while U64.less_than(gsf_blk_term_else_scan, order_len):
            if U64.equal(gsf_blk_term_else_pos, U64.literal(0)):
              let gsf_blk_term_else_entry = general_parse_u64(general_field(order, gsf_blk_term_else_scan))
              if U64.equal(gsf_blk_term_else_entry, gsf_blk_json_tc):
                set gsf_blk_term_else_pos = next_index(gsf_blk_term_else_scan, gsf_blk_term_else_scan)
              else:
                let gsf_blk_term_else_diff = I64.literal(1)
              end if
            else:
              let gsf_blk_term_else_dead = I64.literal(1)
            end if
            set gsf_blk_term_else_scan = next_index(gsf_blk_term_else_scan, order_len)
          end while
          set gsf_blk_term = "{\"kind\":\"branch\",\"data\":{\"condition\":"
          set gsf_blk_term = sico.text.concat(gsf_blk_term, sico.u64.to_text(gsf_blk_json_ta))
          set gsf_blk_term = sico.text.concat(gsf_blk_term, ",\"then_block\":")
          set gsf_blk_term = sico.text.concat(gsf_blk_term, sico.u64.to_text(previous_index(gsf_blk_term_then_pos, gsf_blk_term_then_pos)))
          set gsf_blk_term = sico.text.concat(gsf_blk_term, ",\"else_block\":")
          set gsf_blk_term = sico.text.concat(gsf_blk_term, sico.u64.to_text(previous_index(gsf_blk_term_else_pos, gsf_blk_term_else_pos)))
          set gsf_blk_term = sico.text.concat(gsf_blk_term, "}}")
        else:
          let gsf_blk_term_unreachable = I64.literal(1)
        end if
      end if
    end if
    if U64.less_than(U64.literal(0), sico.text.length(gsf_blocks_json)):
      set gsf_blocks_json = sico.text.concat(gsf_blocks_json, ",")
    end if
    set gsf_blocks_json = sico.text.concat(gsf_blocks_json, "{\"id\":")
    set gsf_blocks_json = sico.text.concat(gsf_blocks_json, sico.u64.to_text(order_k))
    set gsf_blocks_json = sico.text.concat(gsf_blocks_json, ",\"instructions\":[")
    set gsf_blocks_json = sico.text.concat(gsf_blocks_json, gsf_blk_json_instr)
    set gsf_blocks_json = sico.text.concat(gsf_blocks_json, "],\"terminator\":")
    set gsf_blocks_json = sico.text.concat(gsf_blocks_json, gsf_blk_term)
    set gsf_blocks_json = sico.text.concat(gsf_blocks_json, ",\"range\":{\"start\":")
    set gsf_blocks_json = sico.text.concat(gsf_blocks_json, sico.u64.to_text(gsf_blk_json_rs))
    set gsf_blocks_json = sico.text.concat(gsf_blocks_json, ",\"end\":")
    set gsf_blocks_json = sico.text.concat(gsf_blocks_json, sico.u64.to_text(gsf_blk_json_re))
    set gsf_blocks_json = sico.text.concat(gsf_blocks_json, "}}")
    set order_k = next_index(order_k, order_len)
  end while
  let gsf_json = "{\"id\":"
  set gsf_json = sico.text.concat(gsf_json, sico.u64.to_text(function_ordinal))
  set gsf_json = sico.text.concat(gsf_json, ",\"name\":\"")
  set gsf_json = sico.text.concat(gsf_json, fn_name)
  set gsf_json = sico.text.concat(gsf_json, "\",\"parameters\":")
  set gsf_json = sico.text.concat(gsf_json, parameters_json)
  set gsf_json = sico.text.concat(gsf_json, ",\"return_type\":")
  set gsf_json = sico.text.concat(gsf_json, general_type_json(return_kind))
  set gsf_json = sico.text.concat(gsf_json, ",\"effects\":[]")
  if U64.less_than(U64.literal(0), sico.text.length(locals)):
    set gsf_json = sico.text.concat(gsf_json, ",\"locals\":[")
    set gsf_json = sico.text.concat(gsf_json, locals)
    set gsf_json = sico.text.concat(gsf_json, "]")
  end if
  set gsf_json = sico.text.concat(gsf_json, ",\"entry\":0,\"blocks\":[")
  set gsf_json = sico.text.concat(gsf_json, gsf_blocks_json)
  set gsf_json = sico.text.concat(gsf_json, "],\"range\":{\"start\":")
  set gsf_json = sico.text.concat(gsf_json, sico.u64.to_text(fn_start))
  set gsf_json = sico.text.concat(gsf_json, ",\"end\":")
  set gsf_json = sico.text.concat(gsf_json, sico.u64.to_text(fn_end))
  set gsf_json = sico.text.concat(gsf_json, "}}")
  return gsf_json
end function

function general_straight_function_ir(words: List[Text], src: Bytes, fn_token_idx: U64, fn_start: U64, name_idx: U64, function_ordinal: U64, body_from: U64, body_end_word: U64, parameters_json: Text, return_kind: Text, parameter_count: U64) returns Text:
  let gsf_words_len = sico.list.length(words)
  let gsf_next = parameter_count
  let gsf_locals = ""
  let gsf_ordinal = U64.literal(0)
  let gsf_stamp_seq = U64.literal(0)
  let gsf_blk_count = U64.literal(0)
  let gsf_blk_instr = sico.text.split_lines("")
  let gsf_blk_tkind = sico.text.split_lines("")
  let gsf_blk_ta = sico.text.split_lines("")
  let gsf_blk_tb = sico.text.split_lines("")
  let gsf_blk_tc = sico.text.split_lines("")
  let gsf_blk_rs = sico.text.split_lines("")
  let gsf_blk_re = sico.text.split_lines("")
  let gsf_blk_stamp = sico.text.split_lines("")
  let gsf_blk_marked = sico.text.split_lines("")
  let gsf_m_blk = sico.text.split_lines("")
  let gsf_m_pat = sico.text.split_lines("")
  let gsf_m_rs = sico.text.split_lines("")
  let gsf_m_re = sico.text.split_lines("")
  let gsf_source_len = sico.bytes.length(src)
  let gsf_end_function_offset = find_text_from(src, "end function", fn_start)
  let gsf_fn_end = gsf_end_function_offset
  match U64.checked_add(gsf_end_function_offset, U64.literal(13)):
    case ok(gsf_fn_end_after):
      set gsf_fn_end = gsf_fn_end_after
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  if U64.less_than(gsf_source_len, gsf_fn_end):
    set gsf_fn_end = gsf_source_len
  end if
  set gsf_blk_instr = sico.list.append(gsf_blk_instr, "")
  set gsf_blk_tkind = sico.list.append(gsf_blk_tkind, "none")
  set gsf_blk_ta = sico.list.append(gsf_blk_ta, "")
  set gsf_blk_tb = sico.list.append(gsf_blk_tb, "")
  set gsf_blk_tc = sico.list.append(gsf_blk_tc, "")
  set gsf_blk_rs = sico.list.append(gsf_blk_rs, sico.u64.to_text(fn_start))
  set gsf_blk_re = sico.list.append(gsf_blk_re, sico.u64.to_text(gsf_fn_end))
  set gsf_blk_stamp = sico.list.append(gsf_blk_stamp, "")
  set gsf_blk_marked = sico.list.append(gsf_blk_marked, "0")
  set gsf_blk_count = next_index(gsf_blk_count, gsf_blk_count)
  set gsf_stamp_seq = next_index(gsf_stamp_seq, gsf_stamp_seq)
  set gsf_blk_stamp = general_list_set(gsf_blk_stamp, U64.literal(0), sico.u64.to_text(gsf_stamp_seq))
  set gsf_blk_marked = general_list_set(gsf_blk_marked, U64.literal(0), "1")
  let gsf_current = U64.literal(0)
  let gsf_has_current = U64.literal(1)
  let gsf_fr_kind = sico.text.split_lines("")
  let gsf_fr_a = sico.text.split_lines("")
  let gsf_fr_b = sico.text.split_lines("")
  let gsf_fr_c = sico.text.split_lines("")
  let gsf_fr_len = U64.literal(0)
  let gsf_cur_idx = fn_token_idx
  let gsf_cur_offset = fn_start
  let gsf_i = body_from
  while U64.less_than(gsf_i, body_end_word):
    let gsf_first = word_at(words, gsf_i)
    if is_word(gsf_first, "<nl>"):
      set gsf_i = next_index(gsf_i, body_end_word)
      continue
    end if
    while U64.less_than(gsf_cur_idx, gsf_i):
      let gsf_cur_next = next_index(gsf_cur_idx, gsf_words_len)
      let gsf_cur_token_end = gsf_cur_offset
      if is_word(word_at(words, gsf_cur_idx), "<nl>"):
        let gsf_cur_on_newline = I64.literal(1)
      else:
        match U64.checked_add(gsf_cur_offset, sico.text.length(word_at(words, gsf_cur_idx))):
          case ok(gsf_cur_after):
            set gsf_cur_token_end = gsf_cur_after
          case error(_):
            return "ERR:E-SH-IR-RANGE"
        end match
      end if
      if is_word(word_at(words, gsf_cur_next), "<nl>"):
        set gsf_cur_offset = find_newline_from(src, gsf_cur_token_end)
      else:
        set gsf_cur_offset = find_text_from(src, word_at(words, gsf_cur_next), gsf_cur_token_end)
      end if
      set gsf_cur_idx = gsf_cur_next
    end while
    let gsf_line_end_idx = line_end(words, gsf_i)
    if U64.less_than(body_end_word, gsf_line_end_idx):
      set gsf_line_end_idx = body_end_word
    end if
    let gsf_line_first_offset = gsf_cur_offset
    let gsf_line_last_idx = previous_index(gsf_line_end_idx, gsf_i)
    let gsf_line_last_offset = word_span_offset(words, src, gsf_line_first_offset, gsf_i, gsf_line_last_idx)
    let gsf_line_end_offset = gsf_line_last_offset
    match U64.checked_add(gsf_line_last_offset, sico.text.length(word_at(words, gsf_line_last_idx))):
      case ok(gsf_line_end_after):
        set gsf_line_end_offset = gsf_line_end_after
      case error(_):
        return "ERR:E-SH-IR-RANGE"
    end match
    if is_word(gsf_first, "let"):
      if U64.equal(gsf_has_current, U64.literal(0)):
        return "ERR:E-SH-IR-STATEMENT"
      end if
      let gsf_name_idx = next_index(gsf_i, gsf_words_len)
      let gsf_equal_idx = index_plus(gsf_i, U64.literal(2), body_end_word)
      let gsf_rhs_idx = index_plus(gsf_i, U64.literal(3), body_end_word)
      if is_word(word_at(words, gsf_equal_idx), "="):
        let gsf_equal_ok = I64.literal(1)
      else:
        return "ERR:E-SH-IR-STATEMENT"
      end if
      let gsf_duplicate_scan = next_index(gsf_i, body_end_word)
      while U64.less_than(gsf_duplicate_scan, body_end_word):
        if is_word(word_at(words, gsf_duplicate_scan), "let"):
          let gsf_duplicate_name_idx = next_index(gsf_duplicate_scan, body_end_word)
          if is_word(word_at(words, gsf_duplicate_name_idx), word_at(words, gsf_name_idx)):
            return "ERR:E-SH-IR-STATEMENT"
          end if
        end if
        set gsf_duplicate_scan = next_index(gsf_duplicate_scan, body_end_word)
      end while
      let gsf_rhs_offset = word_span_offset(words, src, gsf_line_first_offset, gsf_i, gsf_rhs_idx)
      let gsf_rhs_parts = general_expression(words, src, name_idx, body_from, gsf_rhs_idx, gsf_line_end_idx, gsf_next, gsf_rhs_idx, gsf_rhs_offset)
      let gsf_rhs_value = general_parse_u64(general_field(gsf_rhs_parts, U64.literal(0)))
      let gsf_rhs_count = general_parse_u64(general_field(gsf_rhs_parts, U64.literal(1)))
      let gsf_rhs_kind = general_field(gsf_rhs_parts, U64.literal(2))
      let gsf_rhs_json = general_field(gsf_rhs_parts, U64.literal(3))
      if sico.text.starts_with(gsf_rhs_json, "ERR:"):
        return gsf_rhs_json
      end if
      let gsf_block_instr = general_field(gsf_blk_instr, gsf_current)
      if U64.less_than(U64.literal(0), sico.text.length(gsf_rhs_json)):
        if U64.less_than(U64.literal(0), sico.text.length(gsf_block_instr)):
          set gsf_block_instr = sico.text.concat(gsf_block_instr, ",")
        end if
        set gsf_block_instr = sico.text.concat(gsf_block_instr, gsf_rhs_json)
        set gsf_blk_instr = general_list_set(gsf_blk_instr, gsf_current, gsf_block_instr)
      end if
      let gsf_name_offset = word_span_offset(words, src, gsf_line_first_offset, gsf_i, gsf_name_idx)
      let gsf_name_end = gsf_name_offset
      match U64.checked_add(gsf_name_offset, sico.text.length(word_at(words, gsf_name_idx))):
        case ok(gsf_name_after):
          set gsf_name_end = gsf_name_after
        case error(_):
          return "ERR:E-SH-IR-RANGE"
      end match
      if U64.less_than(U64.literal(0), sico.text.length(gsf_locals)):
        set gsf_locals = sico.text.concat(gsf_locals, ",")
      end if
      set gsf_locals = sico.text.concat(gsf_locals, "{\"name\":\"")
      set gsf_locals = sico.text.concat(gsf_locals, word_at(words, gsf_name_idx))
      set gsf_locals = sico.text.concat(gsf_locals, "\",\"ty\":")
      set gsf_locals = sico.text.concat(gsf_locals, general_type_json(gsf_rhs_kind))
      set gsf_locals = sico.text.concat(gsf_locals, ",\"range\":{\"start\":")
      set gsf_locals = sico.text.concat(gsf_locals, sico.u64.to_text(gsf_name_offset))
      set gsf_locals = sico.text.concat(gsf_locals, ",\"end\":")
      set gsf_locals = sico.text.concat(gsf_locals, sico.u64.to_text(gsf_name_end))
      set gsf_locals = sico.text.concat(gsf_locals, "}}")
      let gsf_write_value = gsf_next
      match U64.checked_add(gsf_next, gsf_rhs_count):
        case ok(gsf_write_after):
          set gsf_write_value = gsf_write_after
        case error(_):
          return "ERR:E-SH-IR-RANGE"
      end match
      set gsf_block_instr = general_field(gsf_blk_instr, gsf_current)
      if U64.less_than(U64.literal(0), sico.text.length(gsf_block_instr)):
        set gsf_block_instr = sico.text.concat(gsf_block_instr, ",")
      end if
