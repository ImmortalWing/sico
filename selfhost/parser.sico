  if is_intrinsic_path(words, gmo_subject, "bytes", "slice"):
    let gmo_slice_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TARGET"
  end if
  let gmo_off = find_text_from(src, "match", gcursor)
  let gmo_start = word_span_offset(words, src, gmo_off, gi, gmo_subject)
  let gmo_subj_end = return_expression_end(src, gmo_start)
  let gmo_pack = gw_slice_subject_packed(words, src, name_idx, gmo_subject, gmo_line, gmo_start, gmo_subj_end, cell_names, cell_kinds, cell_locals, parameter_count, gnext)
  if sico.text.starts_with(gmo_pack, "ERR:"):
    return gmo_pack
  end if
  let gmo_parts = sico.text.split_lines(gmo_pack)
  let gmo_value = gw_decimal_value(word_at(gmo_parts, U64.literal(0)))
  let gmo_count = gw_decimal_value(word_at(gmo_parts, U64.literal(1)))
  let gmo_pieces = word_at(gmo_parts, U64.literal(2))
  if is_word(gmo_pieces, "-"):
    set gmo_pieces = ""
  end if
  let gmo_hinstrs = cur_instrs
  if U64.less_than(U64.literal(0), sico.text.length(gmo_pieces)):
    if U64.less_than(U64.literal(0), sico.text.length(gmo_hinstrs)):
      set gmo_hinstrs = sico.text.concat(gmo_hinstrs, ",")
    end if
    set gmo_hinstrs = sico.text.concat(gmo_hinstrs, gmo_pieces)
  end if
  let gmo_write = gnext
  match U64.checked_add(gnext, gmo_count):
    case ok(gmo_write_slot):
      set gmo_write = gmo_write_slot
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  if U64.less_than(U64.literal(0), sico.text.length(gmo_hinstrs)):
    set gmo_hinstrs = sico.text.concat(gmo_hinstrs, ",")
  end if
  set gmo_hinstrs = sico.text.concat(gmo_hinstrs, write_local_instruction_json(gmo_write, gcell_count, gmo_value, gmo_off, gmo_subj_end))
  let gmo_okcase = next_index(gmo_line, body_end)
  let gmo_okname = next_index(gmo_okcase, body_end)
  let gmo_okopen = next_index(gmo_okname, body_end)
  let gmo_bind = next_index(gmo_okopen, body_end)
  let gmo_okclose = next_index(gmo_bind, body_end)
  let gmo_okcolon = next_index(gmo_okclose, body_end)
  if is_word(word_at(words, gmo_okcase), "case"):
    let gmo_case_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, gmo_okname), "ok"):
    let gmo_okname_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, gmo_okopen), "("):
    let gmo_okopen_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, gmo_bind), "_"):
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, gmo_okclose), ")"):
    let gmo_okclose_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, gmo_okcolon), ":"):
    let gmo_okcolon_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  let gmo_case_off = find_text_from(src, "case", gmo_subj_end)
  let gmo_case_colon = find_text_from(src, ":", gmo_case_off)
  let gmo_case_end = next_index(gmo_case_colon, sico.bytes.length(src))
  let gmo_ok_id = next_index(cur_blk, cur_blk)
  let gmo_read = next_index(gmo_write, gmo_write)
  let gmo_project = next_index(gmo_read, gmo_read)
  let gmo_spill = next_index(gmo_project, gmo_project)
  let gmo_result_ty = "{\"kind\":\"result\",\"data\":{\"ok\":{\"kind\":\"bytes\"},\"error\":{\"kind\":\"named\",\"data\":\"NumericError\"}}}"
  let gmo_prologue = "{\"result\":"
  set gmo_prologue = sico.text.concat(gmo_prologue, sico.u64.to_text(gmo_read))
  set gmo_prologue = sico.text.concat(gmo_prologue, ",\"ty\":")
  set gmo_prologue = sico.text.concat(gmo_prologue, gmo_result_ty)
  set gmo_prologue = sico.text.concat(gmo_prologue, ",\"operation\":{\"op\":\"read_local\",\"data\":{\"local\":")
  set gmo_prologue = sico.text.concat(gmo_prologue, sico.u64.to_text(gcell_count))
  set gmo_prologue = sico.text.concat(gmo_prologue, "}},\"range\":{\"start\":")
  set gmo_prologue = sico.text.concat(gmo_prologue, sico.u64.to_text(gmo_case_off))
  set gmo_prologue = sico.text.concat(gmo_prologue, ",\"end\":")
  set gmo_prologue = sico.text.concat(gmo_prologue, sico.u64.to_text(gmo_case_end))
  set gmo_prologue = sico.text.concat(gmo_prologue, "}},{\"result\":")
  set gmo_prologue = sico.text.concat(gmo_prologue, sico.u64.to_text(gmo_project))
  set gmo_prologue = sico.text.concat(gmo_prologue, ",\"ty\":{\"kind\":\"bytes\"},\"operation\":{\"op\":\"project\",\"data\":{\"base\":")
  set gmo_prologue = sico.text.concat(gmo_prologue, sico.u64.to_text(gmo_read))
  set gmo_prologue = sico.text.concat(gmo_prologue, ",\"field\":\"ok\"}},\"range\":{\"start\":")
  set gmo_prologue = sico.text.concat(gmo_prologue, sico.u64.to_text(gmo_case_off))
  set gmo_prologue = sico.text.concat(gmo_prologue, ",\"end\":")
  set gmo_prologue = sico.text.concat(gmo_prologue, sico.u64.to_text(gmo_case_end))
  set gmo_prologue = sico.text.concat(gmo_prologue, "}},{\"result\":")
  set gmo_prologue = sico.text.concat(gmo_prologue, sico.u64.to_text(gmo_spill))
  set gmo_prologue = sico.text.concat(gmo_prologue, ",\"ty\":{\"kind\":\"unit\"},\"operation\":{\"op\":\"write_local\",\"data\":{\"local\":")
  set gmo_prologue = sico.text.concat(gmo_prologue, sico.u64.to_text(next_index(gcell_count, gcell_count)))
  set gmo_prologue = sico.text.concat(gmo_prologue, ",\"value\":")
  set gmo_prologue = sico.text.concat(gmo_prologue, sico.u64.to_text(gmo_project))
  set gmo_prologue = sico.text.concat(gmo_prologue, "}},\"range\":{\"start\":")
  set gmo_prologue = sico.text.concat(gmo_prologue, sico.u64.to_text(gmo_case_off))
  set gmo_prologue = sico.text.concat(gmo_prologue, ",\"end\":")
  set gmo_prologue = sico.text.concat(gmo_prologue, sico.u64.to_text(gmo_case_end))
  set gmo_prologue = sico.text.concat(gmo_prologue, "}}")
  let gmo_after_case = next_index(line_end(words, gmo_okcolon), body_end)
  let gmo_nl = gmo_after_case
  while U64.less_than(gmo_nl, body_end):
    if is_word(word_at(words, gmo_nl), "<nl>"):
      set gmo_nl = next_index(gmo_nl, body_end)
    else:
      break
    end if
  end while
  let gmo_cells = gcell_count
  match U64.checked_add(gcell_count, U64.literal(2)):
    case ok(gmo_after_cells):
      set gmo_cells = gmo_after_cells
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  let gmo_out = sico.u64.to_text(gmo_nl)
  set gmo_out = sico.text.concat(gmo_out, sico.text.concat("\n", sico.u64.to_text(gmo_case_end)))
  set gmo_out = sico.text.concat(gmo_out, sico.text.concat("\n", sico.u64.to_text(next_index(gmo_spill, gmo_spill))))
  set gmo_out = sico.text.concat(gmo_out, sico.text.concat("\n", sico.u64.to_text(gmo_cells)))
  set gmo_out = sico.text.concat(gmo_out, sico.text.concat("\n", gmo_hinstrs))
  set gmo_out = sico.text.concat(gmo_out, sico.text.concat("\n", gmo_prologue))
  set gmo_out = sico.text.concat(gmo_out, sico.text.concat("\n", sico.u64.to_text(gmo_case_off)))
  set gmo_out = sico.text.concat(gmo_out, sico.text.concat("\n", sico.u64.to_text(gmo_case_end)))
