  if I64.equal(match_open, I64.literal(1)):
    return "ERR:E-SH-IR-CONTROL"
  end if
  if is_word(region, "entry"):
    return "ERR:E-SH-IR-STATEMENT"
  end if
  if is_word(region, "after"):
    return "ERR:E-SH-IR-STATEMENT"
