    let gic_p_intr = intrinsic_instruction_json(base, ret_kind, intr_name, sico.text.concat("[", sico.text.concat(sico.u64.to_text(gic_param), "]")), expr_start, line_end_offset)
    return sico.text.concat("1\n", sico.text.concat(sico.u64.to_text(base), sico.text.concat("\n", sico.text.concat(ret_kind, sico.text.concat("\n", gic_p_intr)))))
  else:
