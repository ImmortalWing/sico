    let ok_close_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, ok_colon), ":"):
    let ok_colon_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(binding_name, "_"):
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, ok_return), "return"):
    let ok_return_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, ok_value), binding_name):
    let binding_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, error_case), "case"):
