function control_if_function_ir(words: List[Text], src: Bytes, name_idx: U64, body_from: U64, body_end: U64, fn_start: U64, function_ordinal: U64, return_kind: Text, parameter_count: U64) returns Text:
  let sif_words_len = sico.list.length(words)
  let sif_cell_names = sico.text.split_lines("")
  let sif_cell_kinds = sico.text.split_lines("")
  let sif_cell_locals = sico.list.empty[U64]()
  let sif_cell_starts = sico.list.empty[U64]()
  let sif_cell_ends = sico.list.empty[U64]()
  let sif_cell_count = U64.literal(0)
  let sif_b0 = ""
  let sif_b1 = ""
  let sif_b2 = ""
  let sif_b3 = ""
  let sif_em0 = U64.literal(0)
  let sif_em1 = U64.literal(0)
  let sif_em2 = U64.literal(0)
  let sif_em3 = U64.literal(0)
  let sif_next = parameter_count
  let sif_target = U64.literal(0)
  let sif_form = ""
  let sif_has_else = false
  let sif_final_done = false
  let sif_ret1_done = false
  let sif_ret2_done = false
  let sif_ret1_value = U64.literal(0)
  let sif_ret2_value = U64.literal(0)
  let sif_final_value = U64.literal(0)
  let sif_cond_value = U64.literal(0)
  let sif_if_start = fn_start
  let sif_if_end = fn_start
  let sif_cursor = fn_start
  let sif_idx = body_from
  while U64.less_than(sif_idx, body_end):
    if is_word(word_at(words, sif_idx), "let"):
      break
    end if
    if is_word(word_at(words, sif_idx), "if"):
      break
    end if
    if is_word(word_at(words, sif_idx), "set"):
      break
    end if
    set sif_idx = next_index(sif_idx, body_end)
  end while
  while U64.less_than(sif_idx, body_end):
    let swk_word = word_at(words, sif_idx)
    if is_word(swk_word, "<nl>"):
      set sif_idx = next_index(sif_idx, body_end)
      continue
    end if
    let swk_is_stmt = false
    let swk_is_set = false
    if is_word(swk_word, "let"):
      set swk_is_stmt = true
    else:
      if is_word(swk_word, "set"):
        set swk_is_stmt = true
        set swk_is_set = true
      end if
    end if
