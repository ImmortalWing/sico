record ScriptInput:
  field arguments: List[Text]
  field stdin: Bytes
end record

record ScriptOutput:
  field stdout: Bytes
  field stderr: Bytes
  field exit_code: I64
end record

enum ScriptErrorCode:
  case InvalidInput
  case ResourceLimit
  case DomainError
  case Cancelled
end enum

record ScriptError:
  field code: ScriptErrorCode
  field message: Text
end record

function is_ident_byte(b: I64) returns Bool:
  if I64.equal(b, I64.literal(95)):
    return true
  end if
  if I64.less_than(b, I64.literal(48)):
    return false
  end if
  if I64.less_than(b, I64.literal(58)):
    return true
  end if
  if I64.less_than(b, I64.literal(65)):
    return false
  end if
  if I64.less_than(b, I64.literal(91)):
    return true
  end if
  if I64.less_than(b, I64.literal(97)):
    return false
  end if
  if I64.less_than(b, I64.literal(123)):
    return true
  end if
  return false
end function

function is_punct_byte(b: I64) returns Bool:
  if I64.equal(b, I64.literal(45)):
    return true
  end if
  if I64.equal(b, I64.literal(46)):
    return true
  end if
  if I64.equal(b, I64.literal(40)):
    return true
  end if
  if I64.equal(b, I64.literal(41)):
    return true
  end if
  if I64.equal(b, I64.literal(44)):
    return true
  end if
  if I64.equal(b, I64.literal(58)):
    return true
  end if
  if I64.equal(b, I64.literal(91)):
    return true
  end if
  if I64.equal(b, I64.literal(93)):
    return true
  end if
  return false
end function

function is_word(w: Text, target: Text) returns Bool:
  return sico.bytes.equal(sico.text.encode(w), sico.text.encode(target))
end function

function is_declaration_start(prev: Text) returns Bool:
  if is_word(prev, "end"):
    return false
  end if
  return true
end function

function lex_words(src: Bytes) returns List[Text]:
  let byte_len = sico.bytes.length(src)
  let index = U64.literal(0)
  let words = sico.text.split_lines("")
  let in_ident = I64.literal(0)
  let in_string = I64.literal(0)
  let escaped = I64.literal(0)
  let word_start = U64.literal(0)
  let word_len = U64.literal(0)
  let string_start = U64.literal(0)
  let string_len = U64.literal(0)
  while U64.less_than(index, byte_len):
    let b = sico.bytes.at(src, index, I64.literal(0))
    if I64.equal(in_string, I64.literal(1)):
      match U64.checked_add(string_len, U64.literal(1)):
        case ok(next):
          set string_len = next
        case error(_):
          return sico.text.split_lines("ERR-overflow")
      end match
      if I64.equal(escaped, I64.literal(1)):
        if valid_escape_byte(b):
          set escaped = I64.literal(0)
        else:
          return sico.text.split_lines("ERR-string-escape")
        end if
      else:
        if I64.equal(b, I64.literal(92)):
          set escaped = I64.literal(1)
        else:
          if I64.equal(b, I64.literal(34)):
            match sico.bytes.slice(src, string_start, string_len):
              case ok(string_bytes):
                set words = sico.list.append(words, sico.bytes.utf8_decode(string_bytes))
              case error(_):
                return sico.text.split_lines("ERR-slice")
            end match
            set in_string = I64.literal(0)
          end if
        end if
      end if
    else:
      if is_ident_byte(b):
        if I64.equal(in_ident, I64.literal(0)):
          set word_start = index
          set word_len = U64.literal(0)
          set in_ident = I64.literal(1)
        end if
        match U64.checked_add(word_len, U64.literal(1)):
          case ok(next):
            set word_len = next
          case error(_):
            return sico.text.split_lines("ERR-overflow")
        end match
      else:
        if I64.equal(in_ident, I64.literal(1)):
          let captured_start = word_start
          let captured_len = word_len
          match sico.bytes.slice(src, captured_start, captured_len):
            case ok(slice_bytes):
              set words = sico.list.append(words, sico.bytes.utf8_decode(slice_bytes))
            case error(_):
              return sico.text.split_lines("ERR-slice")
          end match
          set in_ident = I64.literal(0)
        end if
        if I64.equal(b, I64.literal(34)):
          set string_start = index
          set string_len = U64.literal(1)
          set escaped = I64.literal(0)
          set in_string = I64.literal(1)
        else:
          if I64.equal(b, I64.literal(10)):
            set words = sico.list.append(words, "<nl>")
          else:
            if is_punct_byte(b):
              match sico.bytes.slice(src, index, U64.literal(1)):
                case ok(punct_bytes):
                  set words = sico.list.append(words, sico.bytes.utf8_decode(punct_bytes))
                case error(_):
                  return sico.text.split_lines("ERR-slice")
              end match
            end if
          end if
        end if
      end if
    end if
    match U64.checked_add(index, U64.literal(1)):
      case ok(next):
        set index = next
      case error(_):
        return sico.text.split_lines("ERR-overflow")
    end match
  end while
  if I64.equal(in_string, I64.literal(1)):
    return sico.text.split_lines("ERR-string")
  end if
  if I64.equal(in_ident, I64.literal(1)):
    match sico.bytes.slice(src, word_start, word_len):
      case ok(slice_bytes):
        set words = sico.list.append(words, sico.bytes.utf8_decode(slice_bytes))
      case error(_):
        return sico.text.split_lines("ERR-slice")
    end match
  end if
  return words
end function

function word_at(words: List[Text], i: U64) returns Text:
  match sico.list.get(words, i):
    case ok(w):
      return w
    case error(_):
      return "?"
  end match
end function

function next_index(i: U64, fallback: U64) returns U64:
  match U64.checked_add(i, U64.literal(1)):
    case ok(next):
      return next
    case error(_):
      return fallback
  end match
end function

function line_end(words: List[Text], from_idx: U64) returns U64:
  let n = sico.list.length(words)
  let i = from_idx
  while U64.less_than(i, n):
    if is_word(word_at(words, i), "<nl>"):
      return i
    end if
    set i = next_index(i, n)
  end while
  return n
end function

function is_digit_token(w: Text) returns Bool:
  let bytes = sico.text.encode(w)
  if U64.equal(sico.text.length(w), U64.literal(0)):
    return false
  end if
  let b = sico.bytes.at(bytes, U64.literal(0), I64.literal(0))
  if I64.less_than(b, I64.literal(48)):
    return false
  end if
  return I64.less_than(b, I64.literal(58))
end function

function is_string_token(w: Text) returns Bool:
  let bytes = sico.text.encode(w)
  let n = sico.bytes.length(bytes)
  if U64.less_than(n, U64.literal(2)):
    return false
  end if
  return I64.equal(sico.bytes.at(bytes, U64.literal(0), I64.literal(0)), I64.literal(34))
end function

function valid_escape_byte(b: I64) returns Bool:
  if I64.equal(b, I64.literal(34)):
    return true
  end if
  if I64.equal(b, I64.literal(92)):
    return true
  end if
  if I64.equal(b, I64.literal(110)):
    return true
  end if
  if I64.equal(b, I64.literal(114)):
    return true
  end if
  if I64.equal(b, I64.literal(116)):
    return true
  end if
  return I64.equal(b, I64.literal(48))
end function

function json_string_token(token: Text) returns Text:
  let bytes = sico.text.encode(token)
  let n = sico.bytes.length(bytes)
  let i = U64.literal(0)
  let segment_start = U64.literal(0)
  let out = ""
  while U64.less_than(i, n):
    let b = sico.bytes.at(bytes, i, I64.literal(0))
    if I64.equal(b, I64.literal(92)):
      let escape_idx = next_index(i, n)
      if U64.less_than(escape_idx, n):
        if I64.equal(sico.bytes.at(bytes, escape_idx, I64.literal(0)), I64.literal(48)):
          let prefix_len = U64.literal(0)
          match U64.checked_sub(i, segment_start):
            case ok(length):
              set prefix_len = length
            case error(_):
              set prefix_len = U64.literal(0)
          end match
          if U64.less_than(U64.literal(0), prefix_len):
            match sico.bytes.slice(bytes, segment_start, prefix_len):
              case ok(prefix):
                set out = sico.text.concat(out, sico.bytes.utf8_decode(prefix))
              case error(_):
                set out = token
            end match
          end if
          set out = sico.text.concat(out, "\\u0000")
          set i = next_index(escape_idx, n)
          set segment_start = i
          continue
        end if
      end if
    end if
    set i = next_index(i, n)
  end while
  let tail_len = U64.literal(0)
  match U64.checked_sub(n, segment_start):
    case ok(length):
      set tail_len = length
    case error(_):
      set tail_len = U64.literal(0)
  end match
  if U64.less_than(U64.literal(0), tail_len):
    match sico.bytes.slice(bytes, segment_start, tail_len):
      case ok(tail):
        set out = sico.text.concat(out, sico.bytes.utf8_decode(tail))
      case error(_):
        set out = token
    end match
  end if
  return out
end function

function matching_close(words: List[Text], open_idx: U64, end_idx: U64) returns U64:
  let i = open_idx
  let depth = U64.literal(0)
  while U64.less_than(i, end_idx):
    let w = word_at(words, i)
    if is_word(w, "("):
      match U64.checked_add(depth, U64.literal(1)):
        case ok(next):
          set depth = next
        case error(_):
          return end_idx
      end match
    else:
      if is_word(w, ")"):
        match U64.checked_sub(depth, U64.literal(1)):
          case ok(next):
            set depth = next
            if U64.equal(depth, U64.literal(0)):
              return i
            end if
          case error(_):
            return end_idx
        end match
      end if
    end if
    set i = next_index(i, end_idx)
  end while
  return end_idx
end function

function expression_shape_depth(words: List[Text], from_idx: U64, end_idx: U64, level: U64) returns Text:
  if U64.less_than(U64.literal(63), level):
    return "error:depth"
  end if
  if U64.equal(from_idx, end_idx):
    return "none"
  end if
  if U64.equal(next_index(from_idx, end_idx), end_idx):
    let atom = word_at(words, from_idx)
    if is_string_token(atom):
      return sico.text.concat("string:", atom)
    end if
    if is_digit_token(atom):
      return sico.text.concat("int:", atom)
    end if
    if is_word(atom, "true"):
      return "bool:true"
    end if
    if is_word(atom, "false"):
      return "bool:false"
    end if
    return sico.text.concat("name:", atom)
  end if
  let second = next_index(from_idx, end_idx)
  if U64.equal(next_index(second, end_idx), end_idx):
    if is_word(word_at(words, from_idx), "-"):
      let magnitude = word_at(words, second)
      if is_digit_token(magnitude):
        return sico.text.concat("int:-", magnitude)
      end if
    end if
  end if
  if is_word(word_at(words, from_idx), "("):
    let outer_close = matching_close(words, from_idx, end_idx)
    if U64.equal(next_index(outer_close, end_idx), end_idx):
      return expression_shape_depth(words, next_index(from_idx, end_idx), outer_close, next_index(level, level))
    end if
  end if
  let i = from_idx
  let callee = ""
  let open = end_idx
  while U64.less_than(i, end_idx):
    let w = word_at(words, i)
    if is_word(w, "("):
      set open = i
      break
    end if
    set callee = sico.text.concat(callee, w)
    set i = next_index(i, end_idx)
  end while
  if U64.equal(open, end_idx):
    return "unsupported"
  end if
  let close = matching_close(words, open, end_idx)
  if U64.equal(close, end_idx):
    return "error:close"
  end if
  if U64.less_than(next_index(close, end_idx), end_idx):
    return "unsupported"
  end if
  let args = ""
  let arg_start = next_index(open, close)
  set i = arg_start
  let nested = U64.literal(0)
  while U64.less_than(i, close):
    let arg_word = word_at(words, i)
    if is_word(arg_word, "("):
      set nested = next_index(nested, nested)
    else:
      if is_word(arg_word, ")"):
        match U64.checked_sub(nested, U64.literal(1)):
          case ok(next):
            set nested = next
          case error(_):
            return "error:close"
        end match
      else:
        if is_word(arg_word, ","):
          if U64.equal(nested, U64.literal(0)):
            if U64.less_than(U64.literal(0), sico.text.length(args)):
              set args = sico.text.concat(args, ",")
            end if
            set args = sico.text.concat(args, expression_shape_depth(words, arg_start, i, next_index(level, level)))
            set arg_start = next_index(i, close)
          end if
        end if
      end if
    end if
    set i = next_index(i, close)
  end while
  if U64.less_than(arg_start, close):
    if U64.less_than(U64.literal(0), sico.text.length(args)):
      set args = sico.text.concat(args, ",")
    end if
    set args = sico.text.concat(args, expression_shape_depth(words, arg_start, close, next_index(level, level)))
  end if
  return sico.text.concat("call:", sico.text.concat(callee, sico.text.concat("(", sico.text.concat(args, ")"))))
end function

function expression_shape(words: List[Text], from_idx: U64, end_idx: U64) returns Text:
  return expression_shape_depth(words, from_idx, end_idx, U64.literal(0))
end function

function return_shapes(words: List[Text], from_idx: U64) returns Text:
  let n = sico.list.length(words)
  let i = from_idx
  let shapes = ""
  while U64.less_than(i, n):
    let w = word_at(words, i)
    if is_word(w, "end"):
      let next = next_index(i, n)
      if U64.less_than(next, n):
        if is_word(word_at(words, next), "function"):
          return shapes
        end if
      end if
    end if
    if is_word(w, "return"):
      let start = next_index(i, n)
      let finish = line_end(words, start)
      if U64.less_than(U64.literal(0), sico.text.length(shapes)):
        set shapes = sico.text.concat(shapes, ",")
      end if
      set shapes = sico.text.concat(shapes, expression_shape(words, start, finish))
      set i = finish
    end if
    set i = next_index(i, n)
  end while
  return shapes
end function

function count_until_end_function(words: List[Text], from_idx: U64, target: Text) returns U64:
  let n = sico.list.length(words)
  let i = from_idx
  let count = U64.literal(0)
  let skip_next = I64.literal(0)
  while U64.less_than(i, n):
    match sico.list.get(words, i):
      case ok(w):
        if I64.equal(skip_next, I64.literal(1)):
          set skip_next = I64.literal(0)
        else:
          if is_word(w, "end"):
            match U64.checked_add(i, U64.literal(1)):
              case ok(next):
                if U64.less_than(next, n):
                  if is_word(word_at(words, next), "function"):
                    return count
                  else:
                    set skip_next = I64.literal(1)
                  end if
                else:
                  return count
                end if
              case error(_):
                return count
            end match
          else:
            if is_word(w, target):
              match U64.checked_add(count, U64.literal(1)):
                case ok(next):
                  set count = next
                case error(_):
                  return count
              end match
            end if
          end if
        end if
        match U64.checked_add(i, U64.literal(1)):
          case ok(next):
            set i = next
          case error(_):
            return count
        end match
      case error(_):
        return count
    end match
  end while
  return count
end function

function find_body_end(words: List[Text], from_idx: U64) returns U64:
  let n = sico.list.length(words)
  let i = from_idx
  while U64.less_than(i, n):
    match sico.list.get(words, i):
      case ok(w):
        if is_word(w, "end"):
          match U64.checked_add(i, U64.literal(1)):
            case ok(next):
              if U64.less_than(next, n):
                if is_word(word_at(words, next), "function"):
                  match U64.checked_add(next, U64.literal(1)):
                    case ok(past):
                      return past
                    case error(_):
                      return n
                  end match
                end if
              else:
                return n
              end if
            case error(_):
              return n
          end match
        end if
        match U64.checked_add(i, U64.literal(1)):
          case ok(next):
            set i = next
          case error(_):
            return n
        end match
      case error(_):
        return n
    end match
  end while
  return n
end function

function fn_entry(fname: Text, params: Text, words: List[Text], body_from: U64) returns Text:
  let c_for = count_until_end_function(words, body_from, "for")
  let c_while = count_until_end_function(words, body_from, "while")
  let c_if = count_until_end_function(words, body_from, "if")
  let c_match = count_until_end_function(words, body_from, "match")
  let c_let = count_until_end_function(words, body_from, "let")
  let c_set = count_until_end_function(words, body_from, "set")
  let c_return = count_until_end_function(words, body_from, "return")
  let expressions = return_shapes(words, body_from)
  let entry = sico.text.concat("fn:", sico.text.concat(fname, sico.text.concat("/", params)))
  set entry = sico.text.concat(entry, sico.text.concat("{for=", sico.u64.to_text(c_for)))
  set entry = sico.text.concat(entry, sico.text.concat(",while=", sico.u64.to_text(c_while)))
  set entry = sico.text.concat(entry, sico.text.concat(",if=", sico.u64.to_text(c_if)))
  set entry = sico.text.concat(entry, sico.text.concat(",match=", sico.u64.to_text(c_match)))
  set entry = sico.text.concat(entry, sico.text.concat(",let=", sico.u64.to_text(c_let)))
  set entry = sico.text.concat(entry, sico.text.concat(",set=", sico.u64.to_text(c_set)))
  set entry = sico.text.concat(entry, sico.text.concat(",return=", sico.u64.to_text(c_return)))
  set entry = sico.text.concat(entry, sico.text.concat(",expr=[", sico.text.concat(expressions, "]")))
  return sico.text.concat(entry, "};")
end function

function count_params(words: List[Text], from_idx: U64) returns U64:
  let n = sico.list.length(words)
  let i = from_idx
  let seen_open = I64.literal(0)
  let commas = U64.literal(0)
  let seen_any = I64.literal(0)
  while U64.less_than(i, n):
    match sico.list.get(words, i):
      case ok(w):
        if is_word(w, "("):
          set seen_open = I64.literal(1)
        else:
          if is_word(w, ")"):
            if I64.equal(seen_open, I64.literal(1)):
              if I64.equal(seen_any, I64.literal(1)):
                match U64.checked_add(commas, U64.literal(1)):
                  case ok(params):
                    return params
                  case error(_):
                    return commas
                end match
              end if
              return commas
            end if
          else:
            if I64.equal(seen_open, I64.literal(1)):
              if is_word(w, ","):
                match U64.checked_add(commas, U64.literal(1)):
                  case ok(next):
                    set commas = next
                  case error(_):
                    return commas
                end match
              else:
                set seen_any = I64.literal(1)
              end if
            end if
          end if
        end if
        match U64.checked_add(i, U64.literal(1)):
          case ok(next):
            set i = next
          case error(_):
            return commas
        end match
      case error(_):
        return commas
    end match
  end while
  return commas
end function

function summarize(words: List[Text]) returns Text:
  let n = sico.list.length(words)
  let i = U64.literal(0)
  let summary = ""
  let prev = ""
  while U64.less_than(i, n):
    match sico.list.get(words, i):
      case ok(w):
        if is_word(w, "function"):
          if is_declaration_start(prev):
            match U64.checked_add(i, U64.literal(1)):
              case ok(name_idx):
                if U64.less_than(name_idx, n):
                  let fname = word_at(words, name_idx)
                  let params = count_params(words, name_idx)
                  match U64.checked_add(name_idx, U64.literal(1)):
                    case ok(body_from):
                      set summary = sico.text.concat(summary, fn_entry(fname, sico.u64.to_text(params), words, body_from))
                      set i = find_body_end(words, body_from)
                      set prev = "function"
                      continue
                    case error(_):
                      return summary
                  end match
                end if
              case error(_):
                return summary
            end match
          end if
        end if
        set prev = w
        match U64.checked_add(i, U64.literal(1)):
          case ok(next):
            set i = next
          case error(_):
            return summary
        end match
      case error(_):
        return summary
    end match
  end while
  return summary
end function

function invalid_input(message: Text) returns Result[ScriptOutput, ScriptError]:
  return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: message))
end function

function is_canonical_magnitude(w: Text) returns Bool:
  let bytes = sico.text.encode(w)
  let n = sico.bytes.length(bytes)
  if U64.equal(n, U64.literal(0)):
    return false
  end if
  if U64.less_than(U64.literal(1), n):
    if I64.equal(sico.bytes.at(bytes, U64.literal(0), I64.literal(0)), I64.literal(48)):
      return false
    end if
  end if
  let i = U64.literal(0)
  while U64.less_than(i, n):
    let b = sico.bytes.at(bytes, i, I64.literal(0))
    if I64.less_than(b, I64.literal(48)):
      return false
    end if
    if I64.equal(b, I64.literal(58)):
      return false
    end if
    if I64.less_than(I64.literal(58), b):
      return false
    end if
    set i = next_index(i, n)
  end while
  return true
end function

function decimal_at_most(value: Text, maximum: Text) returns Bool:
  let value_bytes = sico.text.encode(value)
  let maximum_bytes = sico.text.encode(maximum)
  let value_len = sico.bytes.length(value_bytes)
  let maximum_len = sico.bytes.length(maximum_bytes)
  if U64.less_than(value_len, maximum_len):
    return true
  end if
  if U64.less_than(maximum_len, value_len):
    return false
  end if
  let i = U64.literal(0)
  while U64.less_than(i, value_len):
    let actual = sico.bytes.at(value_bytes, i, I64.literal(0))
    let limit = sico.bytes.at(maximum_bytes, i, I64.literal(0))
    if I64.less_than(actual, limit):
      return true
    end if
    if I64.less_than(limit, actual):
      return false
    end if
    set i = next_index(i, value_len)
  end while
  return true
end function

function has_return_at(src: Bytes, index: U64) returns Bool:
  let n = sico.bytes.length(src)
  let i1 = next_index(index, n)
  let i2 = next_index(i1, n)
  let i3 = next_index(i2, n)
  let i4 = next_index(i3, n)
  let i5 = next_index(i4, n)
  if U64.equal(i5, n):
    return false
  end if
  if I64.equal(sico.bytes.at(src, index, I64.literal(0)), I64.literal(114)):
    let matched_r = I64.literal(1)
  else:
    return false
  end if
  if I64.equal(sico.bytes.at(src, i1, I64.literal(0)), I64.literal(101)):
    let matched_e = I64.literal(1)
  else:
    return false
  end if
  if I64.equal(sico.bytes.at(src, i2, I64.literal(0)), I64.literal(116)):
    let matched_t = I64.literal(1)
  else:
    return false
  end if
  if I64.equal(sico.bytes.at(src, i3, I64.literal(0)), I64.literal(117)):
    let matched_u = I64.literal(1)
  else:
    return false
  end if
  if I64.equal(sico.bytes.at(src, i4, I64.literal(0)), I64.literal(114)):
    let matched_second_r = I64.literal(1)
  else:
    return false
  end if
  if I64.equal(sico.bytes.at(src, i5, I64.literal(0)), I64.literal(110)):
    let after = next_index(i5, n)
    if U64.less_than(after, n):
      if is_ident_byte(sico.bytes.at(src, after, I64.literal(0))):
        return false
      end if
    end if
    return true
  end if
  return false
end function

function return_expression_start(src: Bytes, from_idx: U64) returns U64:
  let n = sico.bytes.length(src)
  let i = from_idx
  while U64.less_than(i, n):
    if has_return_at(src, i):
      let j = i
      match U64.checked_add(i, U64.literal(6)):
        case ok(after_keyword):
          set j = after_keyword
        case error(_):
          return n
      end match
      while U64.less_than(j, n):
        let b = sico.bytes.at(src, j, I64.literal(0))
        if I64.equal(b, I64.literal(10)):
          return n
        end if
        if I64.equal(b, I64.literal(32)):
          set j = next_index(j, n)
        else:
          if I64.equal(b, I64.literal(9)):
            set j = next_index(j, n)
          else:
            if I64.equal(b, I64.literal(13)):
              set j = next_index(j, n)
            else:
              return j
            end if
          end if
        end if
      end while
      return n
    end if
    set i = next_index(i, n)
  end while
  return n
end function

function parameter_name_start(src: Bytes, from_idx: U64) returns U64:
  let n = sico.bytes.length(src)
  let i = from_idx
  while U64.less_than(i, n):
    if I64.equal(sico.bytes.at(src, i, I64.literal(0)), I64.literal(40)):
      let j = next_index(i, n)
      while U64.less_than(j, n):
        let b = sico.bytes.at(src, j, I64.literal(0))
        if I64.equal(b, I64.literal(32)):
          set j = next_index(j, n)
        else:
          if I64.equal(b, I64.literal(9)):
            set j = next_index(j, n)
          else:
            return j
          end if
        end if
      end while
      return n
    end if
    set i = next_index(i, n)
  end while
  return n
end function

function scalar_type_kind(type_name: Text) returns Text:
  if is_word(type_name, "Int"):
    return "int"
  end if
  if is_word(type_name, "Bool"):
    return "bool"
  end if
  if is_word(type_name, "Text"):
    return "string"
  end if
  if is_word(type_name, "I64"):
    return "i64"
  end if
  if is_word(type_name, "U64"):
    return "u64"
  end if
  return "ERR:E-SH-IR-PARAMETER-TYPE"
end function

function find_text_from(src: Bytes, needle: Text, from_idx: U64) returns U64:
  let source_len_find = sico.bytes.length(src)
  let needle_bytes_find = sico.text.encode(needle)
  let needle_len_find = sico.bytes.length(needle_bytes_find)
  if U64.equal(needle_len_find, U64.literal(0)):
    return source_len_find
  end if
  let candidate_find = from_idx
  while U64.less_than(candidate_find, source_len_find):
    let offset_find = U64.literal(0)
    let matched_find = I64.literal(1)
    while U64.less_than(offset_find, needle_len_find):
      let source_index_find = source_len_find
      match U64.checked_add(candidate_find, offset_find):
        case ok(found_index_find):
          set source_index_find = found_index_find
        case error(_):
          set matched_find = I64.literal(0)
      end match
      if U64.less_than(source_index_find, source_len_find):
        if I64.equal(sico.bytes.at(src, source_index_find, I64.literal(0)), sico.bytes.at(needle_bytes_find, offset_find, I64.literal(0))):
          let same_byte_find = I64.literal(1)
        else:
          set matched_find = I64.literal(0)
        end if
      else:
        set matched_find = I64.literal(0)
      end if
      set offset_find = next_index(offset_find, needle_len_find)
    end while
    if I64.equal(matched_find, I64.literal(1)):
      return candidate_find
    end if
    set candidate_find = next_index(candidate_find, source_len_find)
  end while
  return source_len_find
end function

function parameters_ir(words: List[Text], function_name_idx: U64, src: Bytes, search_from: U64) returns Text:
  let parameter_words_len = sico.list.length(words)
  let parameter_source_len = sico.bytes.length(src)
  let parameter_open_idx = next_index(function_name_idx, parameter_words_len)
  if is_word(word_at(words, parameter_open_idx), "("):
    let parameter_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-PARAMETERS"
  end if
  let parameter_token_idx = next_index(parameter_open_idx, parameter_words_len)
  let parameter_id = U64.literal(0)
  let parameter_search_from = parameter_name_start(src, search_from)
  let parameter_json = "["
  while U64.less_than(parameter_token_idx, parameter_words_len):
    if is_word(word_at(words, parameter_token_idx), ")"):
      return sico.text.concat(parameter_json, "]")
    end if
    let parameter_item_name = word_at(words, parameter_token_idx)
    let parameter_colon_idx = next_index(parameter_token_idx, parameter_words_len)
    let parameter_type_idx = next_index(parameter_colon_idx, parameter_words_len)
    let parameter_after_type_idx = next_index(parameter_type_idx, parameter_words_len)
    if is_word(word_at(words, parameter_colon_idx), ":"):
      let parameter_colon_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-PARAMETERS"
    end if
    let parameter_item_type = word_at(words, parameter_type_idx)
    let parameter_item_kind = scalar_type_kind(parameter_item_type)
    if sico.text.starts_with(parameter_item_kind, "ERR:"):
      return parameter_item_kind
    end if
    let parameter_item_start = find_text_from(src, parameter_item_name, parameter_search_from)
    if U64.equal(parameter_item_start, parameter_source_len):
      return "ERR:E-SH-IR-PARAMETER-RANGE"
    end if
    let parameter_item_end = parameter_item_start
    match U64.checked_add(parameter_item_start, sico.bytes.length(sico.text.encode(parameter_item_name))):
      case ok(parameter_name_after):
        set parameter_item_end = parameter_name_after
      case error(_):
        return "ERR:E-SH-IR-PARAMETER-RANGE"
    end match
    let parameter_type_start = find_text_from(src, parameter_item_type, parameter_item_end)
    if U64.equal(parameter_type_start, parameter_source_len):
      return "ERR:E-SH-IR-PARAMETER-RANGE"
    end if
    match U64.checked_add(parameter_type_start, sico.bytes.length(sico.text.encode(parameter_item_type))):
      case ok(parameter_type_after):
        set parameter_search_from = parameter_type_after
      case error(_):
        return "ERR:E-SH-IR-PARAMETER-RANGE"
    end match
    if U64.less_than(U64.literal(0), parameter_id):
      set parameter_json = sico.text.concat(parameter_json, ",")
    end if
    set parameter_json = sico.text.concat(parameter_json, "{\"id\":")
    set parameter_json = sico.text.concat(parameter_json, sico.u64.to_text(parameter_id))
    set parameter_json = sico.text.concat(parameter_json, ",\"name\":\"")
    set parameter_json = sico.text.concat(parameter_json, parameter_item_name)
    set parameter_json = sico.text.concat(parameter_json, "\",\"ty\":{\"kind\":\"")
    set parameter_json = sico.text.concat(parameter_json, parameter_item_kind)
    set parameter_json = sico.text.concat(parameter_json, "\"},\"range\":{\"start\":")
    set parameter_json = sico.text.concat(parameter_json, sico.u64.to_text(parameter_item_start))
    set parameter_json = sico.text.concat(parameter_json, ",\"end\":")
    set parameter_json = sico.text.concat(parameter_json, sico.u64.to_text(parameter_item_end))
    set parameter_json = sico.text.concat(parameter_json, "}}")
    set parameter_id = next_index(parameter_id, parameter_id)
    if is_word(word_at(words, parameter_after_type_idx), ","):
      set parameter_token_idx = next_index(parameter_after_type_idx, parameter_words_len)
    else:
      if is_word(word_at(words, parameter_after_type_idx), ")"):
        set parameter_token_idx = parameter_after_type_idx
      else:
        return "ERR:E-SH-IR-PARAMETERS"
      end if
    end if
  end while
  return "ERR:E-SH-IR-PARAMETERS"
end function

function binding_parameter_index(words: List[Text], function_name_idx: U64, binding: Text) returns U64:
  let binding_words_len = sico.list.length(words)
  let binding_open_idx = next_index(function_name_idx, binding_words_len)
  let binding_token_idx = next_index(binding_open_idx, binding_words_len)
  let binding_id = U64.literal(0)
  while U64.less_than(binding_token_idx, binding_words_len):
    if is_word(word_at(words, binding_token_idx), ")"):
      return binding_words_len
    end if
    if is_word(word_at(words, binding_token_idx), binding):
      return binding_id
    end if
    let binding_colon_idx = next_index(binding_token_idx, binding_words_len)
    let binding_type_idx = next_index(binding_colon_idx, binding_words_len)
    let binding_separator_idx = next_index(binding_type_idx, binding_words_len)
    if is_word(word_at(words, binding_separator_idx), ","):
      set binding_token_idx = next_index(binding_separator_idx, binding_words_len)
      set binding_id = next_index(binding_id, binding_id)
    else:
      return binding_words_len
    end if
  end while
  return binding_words_len
end function

function binding_parameter_kind(words: List[Text], function_name_idx: U64, binding: Text) returns Text:
  let binding_kind_words_len = sico.list.length(words)
  let binding_kind_open_idx = next_index(function_name_idx, binding_kind_words_len)
  let binding_kind_token_idx = next_index(binding_kind_open_idx, binding_kind_words_len)
  while U64.less_than(binding_kind_token_idx, binding_kind_words_len):
    if is_word(word_at(words, binding_kind_token_idx), ")"):
      return "ERR:E-SH-IR-UNRESOLVED"
    end if
    let binding_kind_colon_idx = next_index(binding_kind_token_idx, binding_kind_words_len)
    let binding_kind_type_idx = next_index(binding_kind_colon_idx, binding_kind_words_len)
    if is_word(word_at(words, binding_kind_token_idx), binding):
      return scalar_type_kind(word_at(words, binding_kind_type_idx))
    end if
    let binding_kind_separator_idx = next_index(binding_kind_type_idx, binding_kind_words_len)
    if is_word(word_at(words, binding_kind_separator_idx), ","):
      set binding_kind_token_idx = next_index(binding_kind_separator_idx, binding_kind_words_len)
    else:
      return "ERR:E-SH-IR-UNRESOLVED"
    end if
  end while
  return "ERR:E-SH-IR-UNRESOLVED"
end function

function parameter_kind_by_id(words: List[Text], function_name_idx: U64, wanted_id: U64) returns Text:
  let kind_id_words_len = sico.list.length(words)
  let kind_id_open_idx = next_index(function_name_idx, kind_id_words_len)
  let kind_id_token_idx = next_index(kind_id_open_idx, kind_id_words_len)
  let kind_id_current = U64.literal(0)
  while U64.less_than(kind_id_token_idx, kind_id_words_len):
    if is_word(word_at(words, kind_id_token_idx), ")"):
      return "ERR:E-SH-IR-CALL-ARITY"
    end if
    let kind_id_colon_idx = next_index(kind_id_token_idx, kind_id_words_len)
    let kind_id_type_idx = next_index(kind_id_colon_idx, kind_id_words_len)
    if U64.equal(kind_id_current, wanted_id):
      return scalar_type_kind(word_at(words, kind_id_type_idx))
    end if
    let kind_id_separator_idx = next_index(kind_id_type_idx, kind_id_words_len)
    if is_word(word_at(words, kind_id_separator_idx), ","):
      set kind_id_token_idx = next_index(kind_id_separator_idx, kind_id_words_len)
      set kind_id_current = next_index(kind_id_current, kind_id_current)
    else:
      return "ERR:E-SH-IR-CALL-ARITY"
    end if
  end while
  return "ERR:E-SH-IR-CALL-ARITY"
end function

function function_declaration_index(words: List[Text], target: Text) returns U64:
  let find_words_len = sico.list.length(words)
  let find_i = U64.literal(0)
  let find_prev = ""
  while U64.less_than(find_i, find_words_len):
    let find_token = word_at(words, find_i)
    if is_word(find_token, "function"):
      if is_declaration_start(find_prev):
        let find_name_idx = next_index(find_i, find_words_len)
        if U64.less_than(find_name_idx, find_words_len):
          if is_word(word_at(words, find_name_idx), target):
            return find_name_idx
          end if
        end if
      end if
    end if
    set find_prev = find_token
    set find_i = next_index(find_i, find_words_len)
  end while
  return find_words_len
end function

function function_declaration_ordinal(words: List[Text], target_name_idx: U64) returns U64:
  let ordinal_words_len = sico.list.length(words)
  let ordinal_i = U64.literal(0)
  let ordinal_prev = ""
  let ordinal_count = U64.literal(0)
  while U64.less_than(ordinal_i, ordinal_words_len):
    let ordinal_token = word_at(words, ordinal_i)
    if is_word(ordinal_token, "function"):
      if is_declaration_start(ordinal_prev):
        let ordinal_name_idx = next_index(ordinal_i, ordinal_words_len)
        if U64.less_than(ordinal_name_idx, ordinal_words_len):
          if U64.equal(ordinal_name_idx, target_name_idx):
            return next_index(ordinal_count, ordinal_count)
          end if
          set ordinal_count = next_index(ordinal_count, ordinal_count)
        end if
      end if
    end if
    set ordinal_prev = ordinal_token
    set ordinal_i = next_index(ordinal_i, ordinal_words_len)
  end while
  return U64.literal(0)
end function

function declared_return_kind(words: List[Text], body_from: U64) returns Text:
  let sig_words_len = sico.list.length(words)
  let sig_end = line_end(words, body_from)
  let sig_i = body_from
  let sig_kind = ""
  while U64.less_than(sig_i, sig_end):
    if is_word(word_at(words, sig_i), "returns"):
      let type_idx = next_index(sig_i, sig_end)
      if U64.less_than(type_idx, sig_end):
        let type_word = word_at(words, type_idx)
        if is_word(type_word, "Int"):
          set sig_kind = "int"
        else:
          if is_word(type_word, "Bool"):
            set sig_kind = "bool"
          else:
            if is_word(type_word, "Text"):
              set sig_kind = "string"
            else:
              if is_word(type_word, "I64"):
                set sig_kind = "i64"
              else:
                if is_word(type_word, "U64"):
                  set sig_kind = "u64"
                end if
              end if
            end if
          end if
        end if
      end if
    end if
    set sig_i = next_index(sig_i, sig_end)
  end while
  return sig_kind
end function

function word_span_offset(words: List[Text], src: Bytes, anchor_offset: U64, anchor_idx: U64, target_idx: U64) returns U64:
  let wso_words_len = sico.list.length(words)
  let wso_offset = anchor_offset
  let wso_idx = anchor_idx
  while U64.less_than(wso_idx, target_idx):
    let wso_next_idx = next_index(wso_idx, wso_words_len)
    let wso_token_end = wso_offset
    match U64.checked_add(wso_offset, sico.bytes.length(sico.text.encode(word_at(words, wso_idx)))):
      case ok(wso_after_token):
        set wso_token_end = wso_after_token
      case error(_):
        return wso_offset
    end match
    set wso_offset = find_text_from(src, word_at(words, wso_next_idx), wso_token_end)
    set wso_idx = wso_next_idx
  end while
  return wso_offset
end function

function argument_instruction_count(words: List[Text], expr_start: U64, expr_end: U64, caller_name_idx: U64) returns U64:
  let aic_words_len = sico.list.length(words)
  let aic_atom = word_at(words, expr_start)
  if U64.less_than(binding_parameter_index(words, caller_name_idx, aic_atom), count_params(words, caller_name_idx)):
    return U64.literal(0)
  end if
  if U64.less_than(U64.literal(0), sico.text.length(constant_argument_kind(aic_atom))):
    return U64.literal(1)
  end if
  if U64.less_than(U64.literal(0), sico.text.length(fixed_literal_argument(words, expr_start))):
    return U64.literal(1)
  end if
  if U64.less_than(expr_start, expr_end):
    if is_word(word_at(words, next_index(expr_start, aic_words_len)), "("):
      let aic_callee_idx = function_declaration_index(words, aic_atom)
      if U64.equal(aic_callee_idx, aic_words_len):
        return U64.literal(0)
      end if
      let aic_close_idx = matching_close(words, next_index(expr_start, aic_words_len), expr_end)
      let aic_total = U64.literal(1)
      let aic_seg_start = next_index(next_index(expr_start, aic_words_len), aic_words_len)
      while U64.less_than(aic_seg_start, aic_close_idx):
        let aic_seg_end = aic_close_idx
        let aic_scan = aic_seg_start
        while U64.less_than(aic_scan, aic_close_idx):
          if is_word(word_at(words, aic_scan), "("):
            set aic_scan = next_index(matching_close(words, aic_scan, aic_close_idx), aic_close_idx)
          else:
            if is_word(word_at(words, aic_scan), ","):
              set aic_seg_end = aic_scan
              set aic_scan = aic_close_idx
            else:
              set aic_scan = next_index(aic_scan, aic_close_idx)
            end if
          end if
        end while
        match U64.checked_add(aic_total, argument_instruction_count(words, aic_seg_start, aic_seg_end, caller_name_idx)):
          case ok(aic_summed):
            set aic_total = aic_summed
          case error(_):
            return aic_total
        end match
        set aic_seg_start = next_index(aic_seg_end, aic_close_idx)
      end while
      return aic_total
    end if
  end if
  return U64.literal(0)
end function

function argument_region_instruction_count(words: List[Text], args_start: U64, args_end: U64, caller_name_idx: U64) returns U64:
  let region_words_len = sico.list.length(words)
  let region_total = U64.literal(0)
  let region_seg_start = args_start
  while U64.less_than(region_seg_start, args_end):
    let region_seg_end = args_end
    let region_scan = region_seg_start
    while U64.less_than(region_scan, args_end):
      if is_word(word_at(words, region_scan), "("):
        set region_scan = next_index(matching_close(words, region_scan, args_end), args_end)
      else:
        if is_word(word_at(words, region_scan), ","):
          set region_seg_end = region_scan
          set region_scan = args_end
        else:
          set region_scan = next_index(region_scan, args_end)
        end if
      end if
    end while
    match U64.checked_add(region_total, argument_instruction_count(words, region_seg_start, region_seg_end, caller_name_idx)):
      case ok(region_summed):
        set region_total = region_summed
      case error(_):
        return region_total
    end match
    set region_seg_start = next_index(region_seg_end, args_end)
  end while
  return region_total
end function

function argument_values(words: List[Text], args_start: U64, args_end: U64, caller_name_idx: U64, callee_name_idx: U64) returns Text:
  let av_words_len = sico.list.length(words)
  let caller_param_count = count_params(words, caller_name_idx)
  let callee_param_count = count_params(words, callee_name_idx)
  if U64.equal(args_start, args_end):
    if U64.equal(callee_param_count, U64.literal(0)):
      return "[]"
    end if
    return "ERR:E-SH-IR-CALL-ARITY"
  end if
  let values_json = "["
  let value_position = U64.literal(0)
  let value_base = caller_param_count
  let av_seg_start = args_start
  while U64.less_than(av_seg_start, args_end):
    let av_seg_end = args_end
    let av_scan = av_seg_start
    while U64.less_than(av_scan, args_end):
      if is_word(word_at(words, av_scan), "("):
        set av_scan = next_index(matching_close(words, av_scan, args_end), args_end)
      else:
        if is_word(word_at(words, av_scan), ","):
          set av_seg_end = av_scan
          set av_scan = args_end
        else:
          set av_scan = next_index(av_scan, args_end)
        end if
      end if
    end while
    if U64.less_than(value_position, callee_param_count):
      let av_position_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-CALL-ARITY"
    end if
    let av_atom = word_at(words, av_seg_start)
    let av_kind = ""
    let av_value = U64.literal(0)
    let av_advance = U64.literal(0)
    if U64.less_than(binding_parameter_index(words, caller_name_idx, av_atom), caller_param_count):
      set av_kind = binding_parameter_kind(words, caller_name_idx, av_atom)
      set av_value = binding_parameter_index(words, caller_name_idx, av_atom)
    else:
      set av_kind = constant_argument_kind(av_atom)
      if U64.less_than(U64.literal(0), sico.text.length(av_kind)):
        set av_value = value_base
        set av_advance = U64.literal(1)
      else:
        set av_kind = fixed_literal_argument(words, av_seg_start)
        if sico.text.starts_with(av_kind, "ERR:"):
          return av_kind
        end if
        if U64.less_than(U64.literal(0), sico.text.length(av_kind)):
          set av_value = value_base
          set av_advance = U64.literal(1)
        else:
          if U64.less_than(av_seg_end, av_words_len):
            if is_word(word_at(words, next_index(av_seg_start, av_words_len)), "("):
              let av_callee_idx = function_declaration_index(words, av_atom)
              if U64.equal(av_callee_idx, av_words_len):
                return "ERR:E-SH-IR-CALL-TARGET"
              end if
              set av_kind = declared_return_kind(words, next_index(av_callee_idx, av_words_len))
              let av_seg_count = argument_instruction_count(words, av_seg_start, av_seg_end, caller_name_idx)
              match U64.checked_add(value_base, av_seg_count):
                case ok(av_summed):
                  match U64.checked_sub(av_summed, U64.literal(1)):
                    case ok(av_call_value):
                      set av_value = av_call_value
                    case error(_):
                      return "ERR:E-SH-IR-CALL-ARGUMENT"
                  end match
                case error(_):
                  return "ERR:E-SH-IR-CALL-ARGUMENT"
              end match
              set av_advance = av_seg_count
            end if
          end if
          if U64.equal(av_advance, U64.literal(0)):
            return "ERR:E-SH-IR-CALL-ARGUMENT"
          end if
        end if
      end if
    end if
    let av_expected_kind = parameter_kind_by_id(words, callee_name_idx, value_position)
    if is_word(av_kind, av_expected_kind):
      let av_type_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-CALL-TYPE"
    end if
    if U64.less_than(U64.literal(0), value_position):
      set values_json = sico.text.concat(values_json, ",")
    end if
    set values_json = sico.text.concat(values_json, sico.u64.to_text(av_value))
    match U64.checked_add(value_base, av_advance):
      case ok(av_advanced):
        set value_base = av_advanced
      case error(_):
        return "ERR:E-SH-IR-CALL-ARGUMENT"
    end match
    set value_position = next_index(value_position, value_position)
    if U64.equal(av_seg_end, args_end):
      if U64.equal(value_position, callee_param_count):
        return sico.text.concat(values_json, "]")
      end if
      return "ERR:E-SH-IR-CALL-ARITY"
    end if
    if is_word(word_at(words, av_seg_end), ","):
      set av_seg_start = next_index(av_seg_end, args_end)
    else:
      return "ERR:E-SH-IR-CALL-SHAPE"
    end if
  end while
  return "ERR:E-SH-IR-CALL-ARITY"
end function

function constant_argument_kind(atom: Text) returns Text:
  if is_canonical_magnitude(atom):
    return "int"
  end if
  if is_word(atom, "true"):
    return "bool"
  end if
  if is_word(atom, "false"):
    return "bool"
  end if
  if is_string_token(atom):
    return "string"
  end if
  return ""
end function

function fixed_literal_argument(words: List[Text], atom_idx: U64) returns Text:
  let det_words_len = sico.list.length(words)
  let det_dot_idx = next_index(atom_idx, det_words_len)
  let det_name_idx = next_index(det_dot_idx, det_words_len)
  let det_open_idx = next_index(det_name_idx, det_words_len)
  let det_sign_idx = next_index(det_open_idx, det_words_len)
  let det_kind = ""
  if is_word(word_at(words, atom_idx), "I64"):
    set det_kind = "i64"
  else:
    if is_word(word_at(words, atom_idx), "U64"):
      set det_kind = "u64"
    end if
  end if
  if U64.equal(sico.text.length(det_kind), U64.literal(0)):
    return ""
  end if
  if is_word(word_at(words, det_dot_idx), "."):
    let det_dot_ok = I64.literal(1)
  else:
    return ""
  end if
  if is_word(word_at(words, det_name_idx), "literal"):
    let det_name_ok = I64.literal(1)
  else:
    return ""
  end if
  if is_word(word_at(words, det_open_idx), "("):
    let det_open_ok = I64.literal(1)
  else:
    return ""
  end if
  if is_word(word_at(words, det_sign_idx), "-"):
    if is_word(det_kind, "u64"):
      return "ERR:E-SH-IR-CALL-SHAPE"
    end if
    let det_magnitude_idx = next_index(det_sign_idx, det_words_len)
    let det_negative_close_idx = next_index(det_magnitude_idx, det_words_len)
    if is_canonical_magnitude(word_at(words, det_magnitude_idx)):
      let det_negative_mag_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-CALL-SHAPE"
    end if
    if is_word(word_at(words, det_negative_close_idx), ")"):
      let det_close_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-CALL-SHAPE"
    end if
    if decimal_at_most(word_at(words, det_magnitude_idx), "9223372036854775808"):
      let det_range_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-I64-RANGE"
    end if
    return det_kind
  end if
  if is_canonical_magnitude(word_at(words, det_sign_idx)):
    let det_mag_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  let det_close_idx = next_index(det_sign_idx, det_words_len)
  if is_word(word_at(words, det_close_idx), ")"):
    let det_positive_close_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  if is_word(det_kind, "i64"):
    if decimal_at_most(word_at(words, det_sign_idx), "9223372036854775807"):
      let det_i64_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-I64-RANGE"
    end if
  else:
    if decimal_at_most(word_at(words, det_sign_idx), "18446744073709551615"):
      let det_u64_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-U64-RANGE"
    end if
  end if
  return det_kind
end function

function argument_instructions(words: List[Text], src: Bytes, anchor_idx: U64, anchor_offset: U64, args_start: U64, args_end: U64, caller_name_idx: U64, base: U64) returns Text:
  let ai_words_len = sico.list.length(words)
  let out_json = ""
  let seg_base = base
  let ai_seg_start = args_start
  while U64.less_than(ai_seg_start, args_end):
    let ai_seg_end = args_end
    let ai_scan = ai_seg_start
    while U64.less_than(ai_scan, args_end):
      if is_word(word_at(words, ai_scan), "("):
        set ai_scan = next_index(matching_close(words, ai_scan, args_end), args_end)
      else:
        if is_word(word_at(words, ai_scan), ","):
          set ai_seg_end = ai_scan
          set ai_scan = args_end
        else:
          set ai_scan = next_index(ai_scan, args_end)
        end if
      end if
    end while
    let ai_atom = word_at(words, ai_seg_start)
    let ai_advance = U64.literal(0)
    if U64.less_than(binding_parameter_index(words, caller_name_idx, ai_atom), count_params(words, caller_name_idx)):
      let ai_binding_skipped = I64.literal(1)
    else:
      let ai_atom_kind = constant_argument_kind(ai_atom)
      if U64.less_than(U64.literal(0), sico.text.length(ai_atom_kind)):
        let ai_token_offset = word_span_offset(words, src, anchor_offset, anchor_idx, ai_seg_start)
        let ai_token_end = ai_token_offset
        match U64.checked_add(ai_token_offset, sico.bytes.length(sico.text.encode(ai_atom))):
          case ok(ai_after_token):
            set ai_token_end = ai_after_token
          case error(_):
            return out_json
        end match
        if U64.less_than(U64.literal(0), sico.text.length(out_json)):
          set out_json = sico.text.concat(out_json, ",")
        end if
        set out_json = sico.text.concat(out_json, "{\"result\":")
        set out_json = sico.text.concat(out_json, sico.u64.to_text(seg_base))
        set out_json = sico.text.concat(out_json, ",\"ty\":{\"kind\":\"")
        set out_json = sico.text.concat(out_json, ai_atom_kind)
        set out_json = sico.text.concat(out_json, "\"},\"operation\":{\"op\":\"const_")
        set out_json = sico.text.concat(out_json, ai_atom_kind)
        set out_json = sico.text.concat(out_json, "\",\"data\":")
        if is_word(ai_atom_kind, "int"):
          set out_json = sico.text.concat(out_json, "\"")
          set out_json = sico.text.concat(out_json, ai_atom)
          set out_json = sico.text.concat(out_json, "\"")
        else:
          if is_word(ai_atom_kind, "bool"):
            set out_json = sico.text.concat(out_json, ai_atom)
          else:
            set out_json = sico.text.concat(out_json, json_string_token(ai_atom))
          end if
        end if
        set out_json = sico.text.concat(out_json, "},\"range\":{\"start\":")
        set out_json = sico.text.concat(out_json, sico.u64.to_text(ai_token_offset))
        set out_json = sico.text.concat(out_json, ",\"end\":")
        set out_json = sico.text.concat(out_json, sico.u64.to_text(ai_token_end))
        set out_json = sico.text.concat(out_json, "}}")
        set ai_advance = U64.literal(1)
      else:
        let ai_literal_kind = fixed_literal_argument(words, ai_seg_start)
        if sico.text.starts_with(ai_literal_kind, "ERR:"):
          let ai_literal_err_dead = I64.literal(1)
        else:
          if U64.less_than(U64.literal(0), sico.text.length(ai_literal_kind)):
            let ai_sign_idx = next_index(next_index(next_index(next_index(ai_seg_start, ai_words_len), ai_words_len), ai_words_len), ai_words_len)
            let ai_is_negative = is_word(word_at(words, ai_sign_idx), "-")
            let ai_sign_offset = word_span_offset(words, src, anchor_offset, anchor_idx, ai_sign_idx)
            let ai_digits_word = ""
            let ai_digits_offset = ai_sign_offset
            if ai_is_negative:
              let ai_magnitude_idx = next_index(ai_sign_idx, ai_words_len)
              set ai_digits_word = word_at(words, ai_magnitude_idx)
              match U64.checked_add(ai_sign_offset, U64.literal(1)):
                case ok(ai_after_sign):
                  set ai_digits_offset = ai_after_sign
                case error(_):
                  return out_json
              end match
            else:
              set ai_digits_word = word_at(words, ai_sign_idx)
            end if
            let ai_digits_end = ai_digits_offset
            match U64.checked_add(ai_digits_offset, sico.bytes.length(sico.text.encode(ai_digits_word))):
              case ok(ai_after_digits):
                set ai_digits_end = ai_after_digits
              case error(_):
                return out_json
            end match
            let ai_data = ai_digits_word
            if ai_is_negative:
              set ai_data = sico.text.concat("-", ai_digits_word)
            end if
            if U64.less_than(U64.literal(0), sico.text.length(out_json)):
              set out_json = sico.text.concat(out_json, ",")
            end if
            set out_json = sico.text.concat(out_json, "{\"result\":")
            set out_json = sico.text.concat(out_json, sico.u64.to_text(seg_base))
            set out_json = sico.text.concat(out_json, ",\"ty\":{\"kind\":\"")
            set out_json = sico.text.concat(out_json, ai_literal_kind)
            set out_json = sico.text.concat(out_json, "\"},\"operation\":{\"op\":\"const_")
            set out_json = sico.text.concat(out_json, ai_literal_kind)
            set out_json = sico.text.concat(out_json, "\",\"data\":")
            set out_json = sico.text.concat(out_json, ai_data)
            set out_json = sico.text.concat(out_json, "},\"range\":{\"start\":")
            set out_json = sico.text.concat(out_json, sico.u64.to_text(ai_sign_offset))
            set out_json = sico.text.concat(out_json, ",\"end\":")
            set out_json = sico.text.concat(out_json, sico.u64.to_text(ai_digits_end))
            set out_json = sico.text.concat(out_json, "}}")
            set ai_advance = U64.literal(1)
          else:
            if U64.less_than(ai_seg_end, ai_words_len):
              if is_word(word_at(words, next_index(ai_seg_start, ai_words_len)), "("):
                let ai_callee_idx = function_declaration_index(words, ai_atom)
                if U64.equal(ai_callee_idx, ai_words_len):
                  let ai_dead_callee = I64.literal(1)
                else:
                  let ai_open_idx = next_index(ai_seg_start, ai_words_len)
                  let ai_close_idx = matching_close(words, ai_open_idx, ai_seg_end)
                  let ai_nested_args_start = next_index(ai_open_idx, ai_words_len)
                  let ai_name_offset = word_span_offset(words, src, anchor_offset, anchor_idx, ai_seg_start)
                  let ai_open_offset = word_span_offset(words, src, anchor_offset, anchor_idx, ai_open_idx)
                  let ai_close_offset = word_span_offset(words, src, anchor_offset, anchor_idx, ai_close_idx)
                  let ai_inner = argument_instructions(words, src, ai_open_idx, ai_open_offset, ai_nested_args_start, ai_close_idx, caller_name_idx, seg_base)
                  let ai_seg_count = argument_instruction_count(words, ai_seg_start, ai_seg_end, caller_name_idx)
                  match U64.checked_add(seg_base, ai_seg_count):
                    case ok(ai_summed):
                      match U64.checked_sub(ai_summed, U64.literal(1)):
                        case ok(ai_result_value):
                          let ai_nested_json = argument_values(words, ai_nested_args_start, ai_close_idx, caller_name_idx, ai_callee_idx)
                          let ai_nested_kind = declared_return_kind(words, next_index(ai_callee_idx, ai_words_len))
                          let ai_nested_ordinal = function_declaration_ordinal(words, ai_callee_idx)
                          let ai_range_end = ai_close_offset
                          match U64.checked_add(ai_close_offset, U64.literal(1)):
                            case ok(ai_after_close):
                              set ai_range_end = ai_after_close
                            case error(_):
                              return out_json
                          end match
                          if U64.less_than(U64.literal(0), sico.text.length(ai_inner)):
                            if U64.less_than(U64.literal(0), sico.text.length(out_json)):
                              set out_json = sico.text.concat(out_json, ",")
                            end if
                            set out_json = sico.text.concat(out_json, ai_inner)
                          end if
                          if U64.less_than(U64.literal(0), sico.text.length(out_json)):
                            set out_json = sico.text.concat(out_json, ",")
                          end if
                          set out_json = sico.text.concat(out_json, "{\"result\":")
                          set out_json = sico.text.concat(out_json, sico.u64.to_text(ai_result_value))
                          set out_json = sico.text.concat(out_json, ",\"ty\":{\"kind\":\"")
                          set out_json = sico.text.concat(out_json, ai_nested_kind)
                          set out_json = sico.text.concat(out_json, "\"},\"operation\":{\"op\":\"call\",\"data\":{\"function\":")
                          set out_json = sico.text.concat(out_json, sico.u64.to_text(ai_nested_ordinal))
                          set out_json = sico.text.concat(out_json, ",\"arguments\":")
                          set out_json = sico.text.concat(out_json, ai_nested_json)
                          set out_json = sico.text.concat(out_json, "}},\"range\":{\"start\":")
                          set out_json = sico.text.concat(out_json, sico.u64.to_text(ai_name_offset))
                          set out_json = sico.text.concat(out_json, ",\"end\":")
                          set out_json = sico.text.concat(out_json, sico.u64.to_text(ai_range_end))
                          set out_json = sico.text.concat(out_json, "}}")
                          set ai_advance = ai_seg_count
                        case error(_):
                          return out_json
                      end match
                    case error(_):
                      return out_json
                  end match
                end if
              end if
            end if
          end if
        end if
      end if
    end if
    match U64.checked_add(seg_base, ai_advance):
      case ok(ai_advanced_base):
        set seg_base = ai_advanced_base
      case error(_):
        return out_json
    end match
    let ai_after_seg = next_index(ai_seg_end, args_end)
    if U64.equal(ai_after_seg, args_end):
      set ai_seg_start = args_end
    else:
      if is_word(word_at(words, ai_seg_end), ","):
        set ai_seg_start = ai_after_seg
      else:
        set ai_seg_start = args_end
      end if
    end if
  end while
  return out_json
end function

function fixed_op_name(word: Text) returns Text:
  if is_word(word, "bit_and"):
    return "bit_and"
  end if
  if is_word(word, "bit_or"):
    return "bit_or"
  end if
  if is_word(word, "bit_xor"):
    return "bit_xor"
  end if
  if is_word(word, "shl"):
    return "shl"
  end if
  if is_word(word, "shr"):
    return "shr"
  end if
  return ""
end function

function fixed_operation_operand_width(words: List[Text], atom_idx: U64, caller_name_idx: U64) returns U64:
  let fow_words_len = sico.list.length(words)
  let fow_param_count = count_params(words, caller_name_idx)
  let fow_atom = word_at(words, atom_idx)
  if U64.less_than(binding_parameter_index(words, caller_name_idx, fow_atom), fow_param_count):
    return U64.literal(1)
  end if
  let fow_literal_kind = fixed_literal_argument(words, atom_idx)
  if U64.equal(sico.text.length(fow_literal_kind), U64.literal(0)):
    return U64.literal(1)
  end if
  let fow_sign_idx = next_index(next_index(next_index(next_index(atom_idx, fow_words_len), fow_words_len), fow_words_len), fow_words_len)
  if is_word(word_at(words, fow_sign_idx), "-"):
    return U64.literal(7)
  end if
  return U64.literal(6)
end function

function fixed_operation_operand_atom_idx(words: List[Text], from_idx: U64, caller_name_idx: U64, position: U64) returns U64:
  let foa_words_len = sico.list.length(words)
  let foa_first_idx = next_index(next_index(next_index(next_index(from_idx, foa_words_len), foa_words_len), foa_words_len), foa_words_len)
  if U64.equal(position, U64.literal(0)):
    return foa_first_idx
  end if
  let foa_width = fixed_operation_operand_width(words, foa_first_idx, caller_name_idx)
  match U64.checked_add(foa_first_idx, foa_width):
    case ok(foa_after_first):
      return next_index(foa_after_first, foa_words_len)
    case error(_):
      return foa_words_len
  end match
end function

function fixed_operation_operand_check(words: List[Text], from_idx: U64, end_idx: U64, caller_name_idx: U64, receiver_kind: Text) returns Text:
  let check_words_len = sico.list.length(words)
  let caller_param_count = count_params(words, caller_name_idx)
  let check_open_idx = next_index(next_index(next_index(from_idx, check_words_len), check_words_len), check_words_len)
  if is_word(word_at(words, check_open_idx), "("):
    let check_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  let first_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, U64.literal(0))
  let first_width = fixed_operation_operand_width(words, first_idx, caller_name_idx)
  let comma_idx = first_idx
  match U64.checked_add(first_idx, first_width):
    case ok(check_after_first):
      set comma_idx = check_after_first
    case error(_):
      return "ERR:E-SH-IR-CALL-SHAPE"
  end match
  let second_idx = next_index(comma_idx, check_words_len)
  let second_width = fixed_operation_operand_width(words, second_idx, caller_name_idx)
  let close_idx = second_idx
  match U64.checked_add(second_idx, second_width):
    case ok(check_after_second):
      set close_idx = check_after_second
    case error(_):
      return "ERR:E-SH-IR-CALL-SHAPE"
  end match
  let after_close_idx = next_index(close_idx, check_words_len)
  if U64.equal(after_close_idx, end_idx):
    let check_shape_two_operands = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-ARITY"
  end if
  if is_word(word_at(words, close_idx), ")"):
    let check_close_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  if is_word(word_at(words, comma_idx), ","):
    let check_comma_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  let first_atom = word_at(words, first_idx)
  let first_kind = ""
  let first_id = binding_parameter_index(words, caller_name_idx, first_atom)
  if U64.less_than(first_id, caller_param_count):
    set first_kind = binding_parameter_kind(words, caller_name_idx, first_atom)
  else:
    set first_kind = fixed_literal_argument(words, first_idx)
    if sico.text.starts_with(first_kind, "ERR:"):
      return first_kind
    end if
    if U64.equal(sico.text.length(first_kind), U64.literal(0)):
      return "ERR:E-SH-IR-CALL-ARGUMENT"
    end if
  end if
  if is_word(first_kind, receiver_kind):
    let check_first_kind = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TYPE"
  end if
  let second_atom = word_at(words, second_idx)
  let second_kind = ""
  let second_id = binding_parameter_index(words, caller_name_idx, second_atom)
  if U64.less_than(second_id, caller_param_count):
    set second_kind = binding_parameter_kind(words, caller_name_idx, second_atom)
  else:
    set second_kind = fixed_literal_argument(words, second_idx)
    if sico.text.starts_with(second_kind, "ERR:"):
      return second_kind
    end if
    if U64.equal(sico.text.length(second_kind), U64.literal(0)):
      return "ERR:E-SH-IR-CALL-ARGUMENT"
    end if
  end if
  if is_word(second_kind, receiver_kind):
    let check_second_kind = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TYPE"
  end if
  return ""
end function

function fixed_operation_operand_value(words: List[Text], from_idx: U64, end_idx: U64, caller_name_idx: U64, position: U64) returns U64:
  let fid_words_len = sico.list.length(words)
  let fid_atom_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, position)
  let fid_param_count = count_params(words, caller_name_idx)
  let fid_atom = word_at(words, fid_atom_idx)
  let fid_id = binding_parameter_index(words, caller_name_idx, fid_atom)
  if U64.less_than(fid_id, fid_param_count):
    return fid_id
  end if
  let fid_value = fid_param_count
  if U64.equal(position, U64.literal(1)):
    let fid_first_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, U64.literal(0))
    let fid_first_width = fixed_operation_operand_width(words, fid_first_idx, caller_name_idx)
    if U64.equal(fid_first_width, U64.literal(1)):
      let fid_first_is_binding = I64.literal(1)
    else:
      match U64.checked_add(fid_value, U64.literal(1)):
        case ok(fid_advanced):
          set fid_value = fid_advanced
        case error(_):
          return fid_value
      end match
    end if
  end if
  return fid_value
end function

function fixed_operation_literal_count(words: List[Text], from_idx: U64, caller_name_idx: U64) returns U64:
  let flc_words_len = sico.list.length(words)
  let flc_count = U64.literal(0)
  let flc_first_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, U64.literal(0))
  let flc_second_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, U64.literal(1))
  let flc_first_width = fixed_operation_operand_width(words, flc_first_idx, caller_name_idx)
  let flc_second_width = fixed_operation_operand_width(words, flc_second_idx, caller_name_idx)
  if U64.equal(flc_first_width, U64.literal(1)):
    let flc_first_is_binding = I64.literal(1)
  else:
    set flc_count = next_index(flc_count, flc_count)
  end if
  if U64.equal(flc_second_width, U64.literal(1)):
    let flc_second_is_binding = I64.literal(1)
  else:
    set flc_count = next_index(flc_count, flc_count)
  end if
  return flc_count
end function

function fixed_operation_literal_instructions(words: List[Text], src: Bytes, from_idx: U64, caller_name_idx: U64, first_result_id: U64, anchor_idx: U64, anchor_offset: U64) returns Text:
  let fli_words_len = sico.list.length(words)
  let fli_param_count = count_params(words, caller_name_idx)
  let fli_out = ""
  let fli_result = first_result_id
  let fli_first_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, U64.literal(0))
  let fli_second_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, U64.literal(1))
  let fli_first_width = fixed_operation_operand_width(words, fli_first_idx, caller_name_idx)
  let fli_second_width = fixed_operation_operand_width(words, fli_second_idx, caller_name_idx)
  let fli_first_atom = word_at(words, fli_first_idx)
  let fli_second_atom = word_at(words, fli_second_idx)
  if U64.less_than(binding_parameter_index(words, caller_name_idx, fli_first_atom), fli_param_count):
    let fli_first_is_binding = I64.literal(1)
  else:
    let fli_first_kind = fixed_literal_argument(words, fli_first_idx)
    if sico.text.starts_with(fli_first_kind, "ERR:"):
      let fli_first_err_dead = I64.literal(1)
    else:
      if U64.less_than(U64.literal(0), sico.text.length(fli_first_kind)):
        let fli_sign_idx = next_index(next_index(next_index(next_index(fli_first_idx, fli_words_len), fli_words_len), fli_words_len), fli_words_len)
        let fli_is_negative = is_word(word_at(words, fli_sign_idx), "-")
        let fli_sign_offset = word_span_offset(words, src, anchor_offset, anchor_idx, fli_sign_idx)
        let fli_digits_word = ""
        let fli_digits_offset = fli_sign_offset
        if fli_is_negative:
          let fli_magnitude_idx = next_index(fli_sign_idx, fli_words_len)
          set fli_digits_word = word_at(words, fli_magnitude_idx)
          match U64.checked_add(fli_sign_offset, U64.literal(1)):
            case ok(fli_after_sign):
              set fli_digits_offset = fli_after_sign
            case error(_):
              return fli_out
          end match
        else:
          set fli_digits_word = word_at(words, fli_sign_idx)
        end if
        let fli_digits_end = fli_digits_offset
        match U64.checked_add(fli_digits_offset, sico.bytes.length(sico.text.encode(fli_digits_word))):
          case ok(fli_after_digits):
            set fli_digits_end = fli_after_digits
          case error(_):
            return fli_out
        end match
        let fli_data = fli_digits_word
        if fli_is_negative:
          set fli_data = sico.text.concat("-", fli_digits_word)
        end if
        set fli_out = sico.text.concat(fli_out, "{\"result\":")
        set fli_out = sico.text.concat(fli_out, sico.u64.to_text(fli_result))
        set fli_out = sico.text.concat(fli_out, ",\"ty\":{\"kind\":\"")
        set fli_out = sico.text.concat(fli_out, fli_first_kind)
        set fli_out = sico.text.concat(fli_out, "\"},\"operation\":{\"op\":\"const_")
        set fli_out = sico.text.concat(fli_out, fli_first_kind)
        set fli_out = sico.text.concat(fli_out, "\",\"data\":")
        set fli_out = sico.text.concat(fli_out, fli_data)
        set fli_out = sico.text.concat(fli_out, "},\"range\":{\"start\":")
        set fli_out = sico.text.concat(fli_out, sico.u64.to_text(fli_sign_offset))
        set fli_out = sico.text.concat(fli_out, ",\"end\":")
        set fli_out = sico.text.concat(fli_out, sico.u64.to_text(fli_digits_end))
        set fli_out = sico.text.concat(fli_out, "}}")
        set fli_result = next_index(fli_result, fli_result)
      end if
    end if
  end if
  if U64.less_than(binding_parameter_index(words, caller_name_idx, fli_second_atom), fli_param_count):
    let fli_second_is_binding = I64.literal(1)
  else:
    let fli_second_kind = fixed_literal_argument(words, fli_second_idx)
    if sico.text.starts_with(fli_second_kind, "ERR:"):
      let fli_second_err_dead = I64.literal(1)
    else:
      if U64.less_than(U64.literal(0), sico.text.length(fli_second_kind)):
        let fli_second_sign_idx = next_index(next_index(next_index(next_index(fli_second_idx, fli_words_len), fli_words_len), fli_words_len), fli_words_len)
        let fli_second_is_negative = is_word(word_at(words, fli_second_sign_idx), "-")
        let fli_second_sign_offset = word_span_offset(words, src, anchor_offset, anchor_idx, fli_second_sign_idx)
        let fli_second_digits_word = ""
        let fli_second_digits_offset = fli_second_sign_offset
        if fli_second_is_negative:
          let fli_second_magnitude_idx = next_index(fli_second_sign_idx, fli_words_len)
          set fli_second_digits_word = word_at(words, fli_second_magnitude_idx)
          match U64.checked_add(fli_second_sign_offset, U64.literal(1)):
            case ok(fli_second_after_sign):
              set fli_second_digits_offset = fli_second_after_sign
            case error(_):
              return fli_out
          end match
        else:
          set fli_second_digits_word = word_at(words, fli_second_sign_idx)
        end if
        let fli_second_digits_end = fli_second_digits_offset
        match U64.checked_add(fli_second_digits_offset, sico.bytes.length(sico.text.encode(fli_second_digits_word))):
          case ok(fli_second_after_digits):
            set fli_second_digits_end = fli_second_after_digits
          case error(_):
            return fli_out
        end match
        let fli_second_data = fli_second_digits_word
        if fli_second_is_negative:
          set fli_second_data = sico.text.concat("-", fli_second_digits_word)
        end if
        if U64.less_than(U64.literal(0), sico.text.length(fli_out)):
          set fli_out = sico.text.concat(fli_out, ",")
        end if
        set fli_out = sico.text.concat(fli_out, "{\"result\":")
        set fli_out = sico.text.concat(fli_out, sico.u64.to_text(fli_result))
        set fli_out = sico.text.concat(fli_out, ",\"ty\":{\"kind\":\"")
        set fli_out = sico.text.concat(fli_out, fli_second_kind)
        set fli_out = sico.text.concat(fli_out, "\"},\"operation\":{\"op\":\"const_")
        set fli_out = sico.text.concat(fli_out, fli_second_kind)
        set fli_out = sico.text.concat(fli_out, "\",\"data\":")
        set fli_out = sico.text.concat(fli_out, fli_second_data)
        set fli_out = sico.text.concat(fli_out, "},\"range\":{\"start\":")
        set fli_out = sico.text.concat(fli_out, sico.u64.to_text(fli_second_sign_offset))
        set fli_out = sico.text.concat(fli_out, ",\"end\":")
        set fli_out = sico.text.concat(fli_out, sico.u64.to_text(fli_second_digits_end))
        set fli_out = sico.text.concat(fli_out, "}}")
        set fli_result = next_index(fli_result, fli_result)
      end if
    end if
  end if
  return fli_out
end function

function return_expression_end(src: Bytes, start_idx: U64) returns U64:
  let expression_source_len = sico.bytes.length(src)
  let expression_scan_idx = start_idx
  let expression_last = start_idx
  while U64.less_than(expression_scan_idx, expression_source_len):
    let expression_byte = sico.bytes.at(src, expression_scan_idx, I64.literal(0))
    if I64.equal(expression_byte, I64.literal(10)):
      return expression_last
    end if
    if I64.equal(expression_byte, I64.literal(13)):
      let expression_cr = I64.literal(1)
    else:
      if I64.equal(expression_byte, I64.literal(32)):
        let expression_space = I64.literal(1)
      else:
        if I64.equal(expression_byte, I64.literal(9)):
          let expression_tab = I64.literal(1)
        else:
          set expression_last = next_index(expression_scan_idx, expression_source_len)
        end if
      end if
    end if
    set expression_scan_idx = next_index(expression_scan_idx, expression_source_len)
  end while
  return expression_last
end function

function argument_segment_kind(words: List[Text], segment_start: U64, segment_end: U64, caller_name_idx: U64) returns Text:
  let ask_n = sico.list.length(words)
  let ask_atom = word_at(words, segment_start)
  let ask_parameter_count = count_params(words, caller_name_idx)
  if U64.less_than(binding_parameter_index(words, caller_name_idx, ask_atom), ask_parameter_count):
    return binding_parameter_kind(words, caller_name_idx, ask_atom)
  end if
  let ask_literal = fixed_literal_argument(words, segment_start)
  if sico.text.starts_with(ask_literal, "ERR:"):
    return ask_literal
  end if
  if U64.less_than(U64.literal(0), sico.text.length(ask_literal)):
    return ask_literal
  end if
  if U64.less_than(segment_start, segment_end):
    let ask_open = next_index(segment_start, ask_n)
    if is_word(word_at(words, ask_open), "("):
      let ask_callee = function_declaration_index(words, ask_atom)
      if U64.equal(ask_callee, ask_n):
        return "ERR:E-SH-IR-CALL-TARGET"
      end if
      let ask_close = matching_close(words, ask_open, segment_end)
      if U64.equal(next_index(ask_close, ask_n), segment_end):
        let ask_shape_ok = I64.literal(1)
      else:
        return "ERR:E-SH-IR-CALL-SHAPE"
      end if
      let ask_values = argument_values(words, next_index(ask_open, ask_n), ask_close, caller_name_idx, ask_callee)
      if sico.text.starts_with(ask_values, "ERR:"):
        return ask_values
      end if
      return declared_return_kind(words, next_index(ask_callee, ask_n))
    end if
  end if
  return "ERR:E-SH-IR-CALL-ARGUMENT"
end function

function checked_arithmetic_match_ir(words: List[Text], src: Bytes, function_idx: U64, name_idx: U64, body_from: U64, body_end: U64, fn_start: U64, function_ordinal: U64, return_kind: Text, parameter_count: U64) returns Text:
  let n = sico.list.length(words)
  if U64.equal(parameter_count, U64.literal(2)):
    let arity_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  let m = body_from
  while U64.less_than(m, body_end):
    if is_word(word_at(words, m), "match"):
      break
    end if
    set m = next_index(m, body_end)
  end while
  let receiver = next_index(m, n)
  let dot = next_index(receiver, n)
  let operation = next_index(dot, n)
  let open = next_index(operation, n)
  let left = next_index(open, n)
  let match_line_end = line_end(words, m)
  let close = matching_close(words, open, match_line_end)
  let comma = close
  let operand_scan = left
  while U64.less_than(operand_scan, close):
    if is_word(word_at(words, operand_scan), "("):
      set operand_scan = next_index(matching_close(words, operand_scan, close), close)
    else:
      if is_word(word_at(words, operand_scan), ","):
        set comma = operand_scan
        set operand_scan = close
      else:
        set operand_scan = next_index(operand_scan, close)
      end if
    end if
  end while
  let right = next_index(comma, n)
  let colon = next_index(close, n)
  let ok_case = next_index(line_end(words, m), n)
  let ok_name = next_index(ok_case, n)
  let ok_open = next_index(ok_name, n)
  let binding = next_index(ok_open, n)
  let ok_close = next_index(binding, n)
  let ok_colon = next_index(ok_close, n)
  let ok_return = next_index(line_end(words, ok_case), n)
  let ok_value = next_index(ok_return, n)
  let error_case = next_index(line_end(words, ok_return), n)
  let error_name = next_index(error_case, n)
  let error_open = next_index(error_name, n)
  let wildcard = next_index(error_open, n)
  let error_close = next_index(wildcard, n)
  let error_colon = next_index(error_close, n)
  let error_return = next_index(line_end(words, error_case), n)
  let literal_receiver = next_index(error_return, n)
  let literal_dot = next_index(literal_receiver, n)
  let literal_name = next_index(literal_dot, n)
  let literal_open = next_index(literal_name, n)
  let zero = next_index(literal_open, n)
  let literal_close = next_index(zero, n)
  let end_word = next_index(line_end(words, error_return), n)
  let end_match = next_index(end_word, n)
  let after_match_line = next_index(line_end(words, end_word), n)
  let after_end_word = next_index(after_match_line, n)
  let after_function_word = next_index(after_end_word, n)
  if U64.equal(after_function_word, body_end):
    let complete = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, dot), "."):
    let dot_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  let operation_name = word_at(words, operation)
  if is_word(operation_name, "checked_add"):
    let operation_ok = I64.literal(1)
  else:
    if is_word(operation_name, "checked_sub"):
      let operation_sub_ok = I64.literal(1)
    else:
      if is_word(operation_name, "checked_mul"):
        let operation_mul_ok = I64.literal(1)
      else:
        if is_word(operation_name, "checked_div"):
          let operation_div_ok = I64.literal(1)
        else:
          return "ERR:E-SH-IR-CALL-TARGET"
        end if
      end if
    end if
  end if
  if is_word(word_at(words, open), "("):
    let open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, comma), ","):
    let comma_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, close), ")"):
    let close_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, colon), ":"):
    let colon_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  let kind = ""
  if is_word(word_at(words, receiver), "I64"):
    set kind = "i64"
  else:
    if is_word(word_at(words, receiver), "U64"):
      set kind = "u64"
    else:
      return "ERR:E-SH-IR-CALL-TYPE"
    end if
  end if
  if is_word(kind, return_kind):
    let return_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-TYPE-MISMATCH"
  end if
  let left_kind = argument_segment_kind(words, left, comma, name_idx)
  if sico.text.starts_with(left_kind, "ERR:"):
    return left_kind
  end if
  let right_kind = argument_segment_kind(words, right, close, name_idx)
  if sico.text.starts_with(right_kind, "ERR:"):
    return right_kind
  end if
  if is_word(left_kind, kind):
    let left_kind_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TYPE"
  end if
  if is_word(right_kind, kind):
    let right_kind_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TYPE"
  end if
  let left_count = argument_instruction_count(words, left, comma, name_idx)
  let right_count = argument_instruction_count(words, right, close, name_idx)
  let left_value = binding_parameter_index(words, name_idx, word_at(words, left))
  if U64.less_than(left_value, parameter_count):
    let left_binding = I64.literal(1)
  else:
    match U64.checked_add(parameter_count, left_count):
      case ok(left_after):
        match U64.checked_sub(left_after, U64.literal(1)):
          case ok(left_result):
            set left_value = left_result
          case error(_):
            return "ERR:E-SH-IR-CALL-ARGUMENT"
        end match
      case error(_):
        return "ERR:E-SH-IR-CALL-ARGUMENT"
    end match
  end if
  let right_value = binding_parameter_index(words, name_idx, word_at(words, right))
  if U64.less_than(right_value, parameter_count):
    let right_binding = I64.literal(1)
  else:
    let right_base = parameter_count
    match U64.checked_add(parameter_count, left_count):
      case ok(after_left_instructions):
        set right_base = after_left_instructions
      case error(_):
        return "ERR:E-SH-IR-CALL-ARGUMENT"
    end match
    match U64.checked_add(right_base, right_count):
      case ok(right_after):
        match U64.checked_sub(right_after, U64.literal(1)):
          case ok(right_result):
            set right_value = right_result
          case error(_):
            return "ERR:E-SH-IR-CALL-ARGUMENT"
        end match
      case error(_):
        return "ERR:E-SH-IR-CALL-ARGUMENT"
    end match
  end if
  let binding_name = word_at(words, binding)
  if is_word(word_at(words, ok_case), "case"):
    let ok_case_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, ok_name), "ok"):
    let ok_name_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, ok_open), "("):
    let ok_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, ok_close), ")"):
    let ok_close_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, ok_colon), ":"):
    let ok_colon_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(binding_name, "_"):
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, ok_return), "return"):
    let ok_return_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, ok_value), binding_name):
    let binding_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, error_case), "case"):
    let error_case_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, error_name), "error"):
    let error_name_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, error_open), "("):
    let error_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, wildcard), "_"):
    let wildcard_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, error_close), ")"):
    let error_close_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, error_colon), ":"):
    let error_colon_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, error_return), "return"):
    let error_return_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, literal_receiver), word_at(words, receiver)):
    let literal_receiver_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TYPE"
  end if
  if is_word(word_at(words, literal_dot), "."):
    let literal_dot_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, literal_name), "literal"):
    let literal_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, literal_open), "("):
    let literal_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, zero), "0"):
    let zero_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, literal_close), ")"):
    let literal_close_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, end_word), "end"):
    let end_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, end_match), "match"):
    let end_match_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  let parameters = parameters_ir(words, name_idx, src, fn_start)
  if sico.text.starts_with(parameters, "ERR:"):
    return parameters
  end if
  let match_start = find_text_from(src, "match", fn_start)
  let receiver_start = find_text_from(src, word_at(words, receiver), match_start)
  let close_start = word_span_offset(words, src, receiver_start, receiver, close)
  let colon_start = find_text_from(src, ":", close_start)
  let ok_case_start = find_text_from(src, "case", colon_start)
  let ok_colon_start = find_text_from(src, ":", ok_case_start)
  let ok_value_start = find_text_from(src, binding_name, ok_colon_start)
  let match_end = next_index(colon_start, sico.bytes.length(src))
  let operation_end = next_index(close_start, sico.bytes.length(src))
  let ok_case_end = next_index(ok_colon_start, sico.bytes.length(src))
  let ok_value_end = ok_value_start
  match U64.checked_add(ok_value_start, sico.bytes.length(sico.text.encode(binding_name))):
    case ok(after_ok_value):
      set ok_value_end = after_ok_value
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  let error_case_start = find_text_from(src, "case", ok_value_end)
  let error_colon_start = find_text_from(src, ":", error_case_start)
  let zero_start = find_text_from(src, "0", error_colon_start)
  let literal_close_start = find_text_from(src, ")", zero_start)
  let error_case_end = next_index(error_colon_start, sico.bytes.length(src))
  let zero_end = next_index(zero_start, sico.bytes.length(src))
  let error_block_end = next_index(literal_close_start, sico.bytes.length(src))
  let end_function_offset = find_text_from(src, "end function", fn_start)
  let fn_end = fn_start
  match U64.checked_add(end_function_offset, U64.literal(13)):
    case ok(after_end_function):
      set fn_end = after_end_function
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  if U64.less_than(sico.bytes.length(src), fn_end):
    set fn_end = sico.bytes.length(src)
  end if
  let operand_instruction_count = argument_region_instruction_count(words, left, close, name_idx)
  let operand_json = argument_instructions(words, src, receiver, receiver_start, left, close, name_idx, parameter_count)
  let subject = parameter_count
  match U64.checked_add(parameter_count, operand_instruction_count):
    case ok(after_operands):
      set subject = after_operands
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  let write = next_index(subject, subject)
  let read = next_index(write, write)
  let project = next_index(read, read)
  let error_value = next_index(project, project)
  let result_type = "{\"kind\":\"result\",\"data\":{\"ok\":{\"kind\":\""
  set result_type = sico.text.concat(result_type, kind)
  set result_type = sico.text.concat(result_type, "\"},\"error\":{\"kind\":\"named\",\"data\":\"NumericError\"}}}")
  let out = "{\"id\":"
  set out = sico.text.concat(out, sico.u64.to_text(function_ordinal))
  set out = sico.text.concat(out, ",\"name\":\"")
  set out = sico.text.concat(out, word_at(words, name_idx))
  set out = sico.text.concat(out, "\",\"parameters\":")
  set out = sico.text.concat(out, parameters)
  set out = sico.text.concat(out, ",\"return_type\":{\"kind\":\"")
  set out = sico.text.concat(out, kind)
  set out = sico.text.concat(out, "\"},\"effects\":[],\"locals\":[{\"name\":\"#match0\",\"ty\":")
  set out = sico.text.concat(out, result_type)
  set out = sico.text.concat(out, ",\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(match_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(match_end))
  set out = sico.text.concat(out, "}}],\"entry\":0,\"blocks\":[{\"id\":0,\"instructions\":[")
  if U64.less_than(U64.literal(0), sico.text.length(operand_json)):
    set out = sico.text.concat(out, operand_json)
    set out = sico.text.concat(out, ",")
  end if
  set out = sico.text.concat(out, "{\"result\":")
  set out = sico.text.concat(out, sico.u64.to_text(subject))
  set out = sico.text.concat(out, ",\"ty\":")
  set out = sico.text.concat(out, result_type)
  set out = sico.text.concat(out, ",\"operation\":{\"op\":\"")
  set out = sico.text.concat(out, operation_name)
  set out = sico.text.concat(out, "\",\"data\":{\"left\":")
  set out = sico.text.concat(out, sico.u64.to_text(left_value))
  set out = sico.text.concat(out, ",\"right\":")
  set out = sico.text.concat(out, sico.u64.to_text(right_value))
  set out = sico.text.concat(out, "}},\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(receiver_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(operation_end))
  set out = sico.text.concat(out, "}},{\"result\":")
  set out = sico.text.concat(out, sico.u64.to_text(write))
  set out = sico.text.concat(out, ",\"ty\":{\"kind\":\"unit\"},\"operation\":{\"op\":\"write_local\",\"data\":{\"local\":0,\"value\":")
  set out = sico.text.concat(out, sico.u64.to_text(subject))
  set out = sico.text.concat(out, "}},\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(match_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(match_end))
  set out = sico.text.concat(out, "}}],\"terminator\":{\"kind\":\"match\",\"data\":{\"values\":[")
  set out = sico.text.concat(out, sico.u64.to_text(subject))
  set out = sico.text.concat(out, "],\"arms\":[{\"patterns\":[{\"kind\":\"variant\",\"data\":{\"name\":\"ok\",\"payload\":[{\"kind\":\"binding\",\"data\":\"")
  set out = sico.text.concat(out, binding_name)
  set out = sico.text.concat(out, "\"}]}}],\"target\":1,\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(ok_case_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(ok_case_end))
  set out = sico.text.concat(out, "}},{\"patterns\":[{\"kind\":\"variant\",\"data\":{\"name\":\"error\",\"payload\":[{\"kind\":\"wildcard\"}]}}],\"target\":2,\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(error_case_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(error_case_end))
  set out = sico.text.concat(out, "}}]}},\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(match_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(match_end))
  set out = sico.text.concat(out, "}},{\"id\":1,\"instructions\":[{\"result\":")
  set out = sico.text.concat(out, sico.u64.to_text(read))
  set out = sico.text.concat(out, ",\"ty\":")
  set out = sico.text.concat(out, result_type)
  set out = sico.text.concat(out, ",\"operation\":{\"op\":\"read_local\",\"data\":{\"local\":0}},\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(ok_case_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(ok_case_end))
  set out = sico.text.concat(out, "}},{\"result\":")
  set out = sico.text.concat(out, sico.u64.to_text(project))
  set out = sico.text.concat(out, ",\"ty\":{\"kind\":\"")
  set out = sico.text.concat(out, kind)
  set out = sico.text.concat(out, "\"},\"operation\":{\"op\":\"project\",\"data\":{\"base\":")
  set out = sico.text.concat(out, sico.u64.to_text(read))
  set out = sico.text.concat(out, ",\"field\":\"ok\"}},\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(ok_case_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(ok_case_end))
  set out = sico.text.concat(out, "}}],\"terminator\":{\"kind\":\"return\",\"data\":")
  set out = sico.text.concat(out, sico.u64.to_text(project))
  set out = sico.text.concat(out, "},\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(ok_case_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(ok_value_end))
  set out = sico.text.concat(out, "}},{\"id\":2,\"instructions\":[{\"result\":")
  set out = sico.text.concat(out, sico.u64.to_text(error_value))
  set out = sico.text.concat(out, ",\"ty\":{\"kind\":\"")
  set out = sico.text.concat(out, kind)
  set out = sico.text.concat(out, "\"},\"operation\":{\"op\":\"const_")
  set out = sico.text.concat(out, kind)
  set out = sico.text.concat(out, "\",\"data\":0},\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(zero_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(zero_end))
  set out = sico.text.concat(out, "}}],\"terminator\":{\"kind\":\"return\",\"data\":")
  set out = sico.text.concat(out, sico.u64.to_text(error_value))
  set out = sico.text.concat(out, "},\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(error_case_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(error_block_end))
  set out = sico.text.concat(out, "}}],\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(fn_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(fn_end))
  set out = sico.text.concat(out, "}}")
  return out
end function

function fixed_operation_instruction_json(result_id: U64, kind: Text, operation: Text, left: U64, right: U64, range_start: U64, range_end: U64) returns Text:
  let foi_json = "{\"result\":"
  set foi_json = sico.text.concat(foi_json, sico.u64.to_text(result_id))
  set foi_json = sico.text.concat(foi_json, ",\"ty\":{\"kind\":\"")
  set foi_json = sico.text.concat(foi_json, kind)
  set foi_json = sico.text.concat(foi_json, "\"},\"operation\":{\"op\":\"")
  set foi_json = sico.text.concat(foi_json, operation)
  set foi_json = sico.text.concat(foi_json, "\",\"data\":")
  if is_word(operation, "shl"):
    set foi_json = sico.text.concat(foi_json, "{\"value\":")
  else:
    if is_word(operation, "shr"):
      set foi_json = sico.text.concat(foi_json, "{\"value\":")
    else:
      set foi_json = sico.text.concat(foi_json, "{\"left\":")
    end if
  end if
  set foi_json = sico.text.concat(foi_json, sico.u64.to_text(left))
  if is_word(operation, "shl"):
    set foi_json = sico.text.concat(foi_json, ",\"amount\":")
  else:
    if is_word(operation, "shr"):
      set foi_json = sico.text.concat(foi_json, ",\"amount\":")
    else:
      set foi_json = sico.text.concat(foi_json, ",\"right\":")
    end if
  end if
  set foi_json = sico.text.concat(foi_json, sico.u64.to_text(right))
  set foi_json = sico.text.concat(foi_json, "}},\"range\":{\"start\":")
  set foi_json = sico.text.concat(foi_json, sico.u64.to_text(range_start))
  set foi_json = sico.text.concat(foi_json, ",\"end\":")
  set foi_json = sico.text.concat(foi_json, sico.u64.to_text(range_end))
  set foi_json = sico.text.concat(foi_json, "}}")
  return foi_json
end function

function chained_operand_check(words: List[Text], from_idx: U64, caller_name_idx: U64, local_name: Text, receiver_kind: Text) returns Text:
  let coc_words_len = sico.list.length(words)
  let coc_open = next_index(next_index(next_index(from_idx, coc_words_len), coc_words_len), coc_words_len)
  let coc_first = next_index(coc_open, coc_words_len)
  let coc_comma = next_index(coc_first, coc_words_len)
  let coc_second = next_index(coc_comma, coc_words_len)
  let coc_close = next_index(coc_second, coc_words_len)
  let coc_after_close = next_index(coc_close, coc_words_len)
  let coc_line_end = line_end(words, from_idx)
  if U64.equal(coc_after_close, coc_line_end):
    let coc_arity_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-ARITY"
  end if
  if is_word(word_at(words, coc_open), "("):
    let coc_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  if is_word(word_at(words, coc_comma), ","):
    let coc_comma_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  if is_word(word_at(words, coc_close), ")"):
    let coc_close_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  let coc_position = U64.literal(0)
  while U64.less_than(coc_position, U64.literal(2)):
    let coc_atom_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, coc_position)
    let coc_atom = word_at(words, coc_atom_idx)
    if is_word(coc_atom, local_name):
      let coc_local_ok = I64.literal(1)
    else:
      let coc_param_id = binding_parameter_index(words, caller_name_idx, coc_atom)
      if U64.less_than(coc_param_id, count_params(words, caller_name_idx)):
        let coc_kind = binding_parameter_kind(words, caller_name_idx, coc_atom)
        if is_word(coc_kind, receiver_kind):
          let coc_param_ok = I64.literal(1)
        else:
          return "ERR:E-SH-IR-CALL-TYPE"
        end if
      else:
        return "ERR:E-SH-IR-CALL-ARGUMENT"
      end if
    end if
    set coc_position = next_index(coc_position, coc_position)
  end while
  return ""
end function

function chained_operand_value(words: List[Text], from_idx: U64, caller_name_idx: U64, local_name: Text, local_value: U64, position: U64) returns U64:
  let cov_atom_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, position)
  let cov_atom = word_at(words, cov_atom_idx)
  if is_word(cov_atom, local_name):
    return local_value
  end if
  return binding_parameter_index(words, caller_name_idx, cov_atom)
end function

function chained_let_function_ir(words: List[Text], src: Bytes, name_idx: U64, body_from: U64, body_end: U64, fn_start: U64, function_ordinal: U64, return_kind: Text, parameter_count: U64) returns Text:
  let cl_first_let = body_from
  while U64.less_than(cl_first_let, body_end):
    if is_word(word_at(words, cl_first_let), "let"):
      break
    end if
    set cl_first_let = next_index(cl_first_let, body_end)
  end while
  if U64.equal(cl_first_let, body_end):
    return "ERR:E-SH-IR-STATEMENT"
  end if
  let cl_first_end = line_end(words, cl_first_let)
  let cl_first_binding = next_index(cl_first_let, cl_first_end)
  let cl_first_receiver = next_index(cl_first_binding, cl_first_end)
  let cl_first_dot = next_index(cl_first_receiver, cl_first_end)
  let cl_first_op_idx = next_index(cl_first_dot, cl_first_end)
  let cl_first_open = next_index(cl_first_op_idx, cl_first_end)
  let cl_second_let = next_index(cl_first_end, body_end)
  while U64.less_than(cl_second_let, body_end):
    if is_word(word_at(words, cl_second_let), "<nl>"):
      set cl_second_let = next_index(cl_second_let, body_end)
    else:
      break
    end if
  end while
  if is_word(word_at(words, cl_second_let), "let"):
    let cl_second_let_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-STATEMENT"
  end if
  let cl_second_end = line_end(words, cl_second_let)
  let cl_second_binding = next_index(cl_second_let, cl_second_end)
  let cl_second_receiver = next_index(cl_second_binding, cl_second_end)
  let cl_second_dot = next_index(cl_second_receiver, cl_second_end)
  let cl_second_op_idx = next_index(cl_second_dot, cl_second_end)
  let cl_second_open = next_index(cl_second_op_idx, cl_second_end)
  if is_word(word_at(words, cl_first_binding), word_at(words, cl_second_binding)):
    return "ERR:E-SH-IR-STATEMENT"
  end if
  if U64.less_than(binding_parameter_index(words, name_idx, word_at(words, cl_first_binding)), parameter_count):
    return "ERR:E-SH-IR-STATEMENT"
  end if
  if U64.less_than(binding_parameter_index(words, name_idx, word_at(words, cl_second_binding)), parameter_count):
    return "ERR:E-SH-IR-STATEMENT"
  end if
  if is_word(word_at(words, cl_first_dot), "."):
    let cl_first_dot_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  if is_word(word_at(words, cl_second_dot), "."):
    let cl_second_dot_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  if is_word(word_at(words, cl_first_open), "("):
    let cl_first_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  if is_word(word_at(words, cl_second_open), "("):
    let cl_second_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  let cl_first_operation = fixed_op_name(word_at(words, cl_first_op_idx))
  let cl_second_operation = fixed_op_name(word_at(words, cl_second_op_idx))
  if U64.equal(sico.text.length(cl_first_operation), U64.literal(0)):
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  if U64.equal(sico.text.length(cl_second_operation), U64.literal(0)):
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  let cl_kind = ""
  if is_word(word_at(words, cl_first_receiver), "I64"):
    set cl_kind = "i64"
  else:
    if is_word(word_at(words, cl_first_receiver), "U64"):
      set cl_kind = "u64"
    else:
      return "ERR:E-SH-IR-EXPRESSION"
    end if
  end if
  let cl_second_kind = ""
  if is_word(word_at(words, cl_second_receiver), "I64"):
    set cl_second_kind = "i64"
  else:
    if is_word(word_at(words, cl_second_receiver), "U64"):
      set cl_second_kind = "u64"
    else:
      return "ERR:E-SH-IR-EXPRESSION"
    end if
  end if
  if is_word(cl_kind, cl_second_kind):
    let cl_same_kind = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TYPE"
  end if
  if is_word(cl_kind, return_kind):
    let cl_return_kind_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-TYPE-MISMATCH"
  end if
  let cl_first_close = matching_close(words, cl_first_open, cl_first_end)
  let cl_second_close = matching_close(words, cl_second_open, cl_second_end)
  if U64.equal(next_index(cl_first_close, cl_first_end), cl_first_end):
    let cl_first_complete = I64.literal(1)
  else:
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  if U64.equal(next_index(cl_second_close, cl_second_end), cl_second_end):
    let cl_second_complete = I64.literal(1)
  else:
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  let cl_first_check = fixed_operation_operand_check(words, cl_first_receiver, cl_first_end, name_idx, cl_kind)
  if sico.text.starts_with(cl_first_check, "ERR:"):
    return cl_first_check
  end if
  let cl_first_literal_count = fixed_operation_literal_count(words, cl_first_receiver, name_idx)
  let cl_first_result = parameter_count
  match U64.checked_add(parameter_count, cl_first_literal_count):
    case ok(cl_first_result_id):
      set cl_first_result = cl_first_result_id
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  let cl_second_check = chained_operand_check(words, cl_second_receiver, name_idx, word_at(words, cl_first_binding), cl_kind)
  if sico.text.starts_with(cl_second_check, "ERR:"):
    return cl_second_check
  end if
  let cl_second_result = next_index(cl_first_result, cl_first_result)
  let cl_return_idx = next_index(cl_second_end, body_end)
  while U64.less_than(cl_return_idx, body_end):
    if is_word(word_at(words, cl_return_idx), "<nl>"):
      set cl_return_idx = next_index(cl_return_idx, body_end)
    else:
      break
    end if
  end while
  if is_word(word_at(words, cl_return_idx), "return"):
    let cl_return_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-RETURN-COUNT"
  end if
  let cl_return_end = line_end(words, cl_return_idx)
  let cl_return_value = next_index(cl_return_idx, cl_return_end)
  if U64.equal(next_index(cl_return_value, cl_return_end), cl_return_end):
    let cl_return_single = I64.literal(1)
  else:
    return "ERR:E-SH-IR-STATEMENT"
  end if
  if is_word(word_at(words, cl_return_value), word_at(words, cl_second_binding)):
    let cl_return_binding_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-UNRESOLVED"
  end if
  let cl_tail = next_index(cl_return_end, body_end)
  while U64.less_than(cl_tail, body_end):
    let cl_tail_word = word_at(words, cl_tail)
    if is_word(cl_tail_word, "<nl>"):
      set cl_tail = next_index(cl_tail, body_end)
    else:
      if is_word(cl_tail_word, "end"):
        set cl_tail = body_end
      else:
        return "ERR:E-SH-IR-STATEMENT"
      end if
    end if
  end while
  let cl_first_let_offset = find_text_from(src, "let", fn_start)
  let cl_first_start = word_span_offset(words, src, cl_first_let_offset, cl_first_let, cl_first_receiver)
  let cl_first_range_end = return_expression_end(src, cl_first_start)
  let cl_second_let_offset = find_text_from(src, "let", cl_first_range_end)
  let cl_second_start = word_span_offset(words, src, cl_second_let_offset, cl_second_let, cl_second_receiver)
  let cl_second_range_end = return_expression_end(src, cl_second_start)
  let cl_first_literals = fixed_operation_literal_instructions(words, src, cl_first_receiver, name_idx, parameter_count, cl_first_receiver, cl_first_start)
  let cl_first_left = fixed_operation_operand_value(words, cl_first_receiver, cl_first_end, name_idx, U64.literal(0))
  let cl_first_right = fixed_operation_operand_value(words, cl_first_receiver, cl_first_end, name_idx, U64.literal(1))
  let cl_second_left = chained_operand_value(words, cl_second_receiver, name_idx, word_at(words, cl_first_binding), cl_first_result, U64.literal(0))
  let cl_second_right = chained_operand_value(words, cl_second_receiver, name_idx, word_at(words, cl_first_binding), cl_first_result, U64.literal(1))
  let cl_first_instruction = fixed_operation_instruction_json(cl_first_result, cl_kind, cl_first_operation, cl_first_left, cl_first_right, cl_first_start, cl_first_range_end)
  let cl_second_instruction = fixed_operation_instruction_json(cl_second_result, cl_kind, cl_second_operation, cl_second_left, cl_second_right, cl_second_start, cl_second_range_end)
  let cl_end_offset = find_text_from(src, "end function", fn_start)
  let cl_fn_end = fn_start
  match U64.checked_add(cl_end_offset, U64.literal(13)):
    case ok(cl_after_end):
      set cl_fn_end = cl_after_end
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  if U64.less_than(sico.bytes.length(src), cl_fn_end):
    set cl_fn_end = sico.bytes.length(src)
  end if
  let cl_parameters = parameters_ir(words, name_idx, src, fn_start)
  if sico.text.starts_with(cl_parameters, "ERR:"):
    return cl_parameters
  end if
  let cl_instructions = "["
  set cl_instructions = sico.text.concat(cl_instructions, cl_first_literals)
  if U64.less_than(U64.literal(0), sico.text.length(cl_first_literals)):
    set cl_instructions = sico.text.concat(cl_instructions, ",")
  end if
  set cl_instructions = sico.text.concat(cl_instructions, cl_first_instruction)
  set cl_instructions = sico.text.concat(cl_instructions, ",")
  set cl_instructions = sico.text.concat(cl_instructions, cl_second_instruction)
  set cl_instructions = sico.text.concat(cl_instructions, "]")
  let cl_json = "{\"id\":"
  set cl_json = sico.text.concat(cl_json, sico.u64.to_text(function_ordinal))
  set cl_json = sico.text.concat(cl_json, ",\"name\":\"")
  set cl_json = sico.text.concat(cl_json, word_at(words, name_idx))
  set cl_json = sico.text.concat(cl_json, "\",\"parameters\":")
  set cl_json = sico.text.concat(cl_json, cl_parameters)
  set cl_json = sico.text.concat(cl_json, ",\"return_type\":{\"kind\":\"")
  set cl_json = sico.text.concat(cl_json, return_kind)
  set cl_json = sico.text.concat(cl_json, "\"},\"effects\":[],\"entry\":0,\"blocks\":[{\"id\":0,\"instructions\":")
  set cl_json = sico.text.concat(cl_json, cl_instructions)
  set cl_json = sico.text.concat(cl_json, ",\"terminator\":{\"kind\":\"return\",\"data\":")
  set cl_json = sico.text.concat(cl_json, sico.u64.to_text(cl_second_result))
  set cl_json = sico.text.concat(cl_json, "},\"range\":{\"start\":")
  set cl_json = sico.text.concat(cl_json, sico.u64.to_text(fn_start))
  set cl_json = sico.text.concat(cl_json, ",\"end\":")
  set cl_json = sico.text.concat(cl_json, sico.u64.to_text(cl_fn_end))
  set cl_json = sico.text.concat(cl_json, "}}],\"range\":{\"start\":")
  set cl_json = sico.text.concat(cl_json, sico.u64.to_text(fn_start))
  set cl_json = sico.text.concat(cl_json, ",\"end\":")
  set cl_json = sico.text.concat(cl_json, sico.u64.to_text(cl_fn_end))
  set cl_json = sico.text.concat(cl_json, "}}")
  return cl_json
end function

function local_binding_index(names: List[Text], name: Text) returns U64:
  let lbi_len = sico.list.length(names)
  let lbi_idx = U64.literal(0)
  while U64.less_than(lbi_idx, lbi_len):
    if is_word(word_at(names, lbi_idx), name):
      return lbi_idx
    end if
    set lbi_idx = next_index(lbi_idx, lbi_len)
  end while
  return lbi_len
end function

function u64_list_at(values: List[U64], idx: U64, fallback: U64) returns U64:
  match sico.list.get[U64](values, idx):
    case ok(value):
      return value
    case error(_):
      return fallback
  end match
end function

function straight_environment_operand_check(words: List[Text], from_idx: U64, caller_name_idx: U64, local_names: List[Text], local_kinds: List[Text], receiver_kind: Text) returns Text:
  let seo_words_len = sico.list.length(words)
  let seo_open = next_index(next_index(next_index(from_idx, seo_words_len), seo_words_len), seo_words_len)
  let seo_first = next_index(seo_open, seo_words_len)
  let seo_first_width = fixed_operation_operand_width(words, seo_first, caller_name_idx)
  let seo_comma = seo_first
  match U64.checked_add(seo_first, seo_first_width):
    case ok(seo_after_first):
      set seo_comma = seo_after_first
    case error(_):
      return "ERR:E-SH-IR-CALL-SHAPE"
  end match
  let seo_second = next_index(seo_comma, seo_words_len)
  let seo_second_width = fixed_operation_operand_width(words, seo_second, caller_name_idx)
  let seo_close = seo_second
  match U64.checked_add(seo_second, seo_second_width):
    case ok(seo_after_second):
      set seo_close = seo_after_second
    case error(_):
      return "ERR:E-SH-IR-CALL-SHAPE"
  end match
  let seo_after_close = next_index(seo_close, seo_words_len)
  let seo_line_end = line_end(words, from_idx)
  if U64.equal(seo_after_close, seo_line_end):
    let seo_arity_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-ARITY"
  end if
  if is_word(word_at(words, seo_open), "("):
    let seo_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  if is_word(word_at(words, seo_comma), ","):
    let seo_comma_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  if is_word(word_at(words, seo_close), ")"):
    let seo_close_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  let seo_position = U64.literal(0)
  while U64.less_than(seo_position, U64.literal(2)):
    let seo_atom_idx = seo_first
    if U64.equal(seo_position, U64.literal(1)):
      set seo_atom_idx = seo_second
    end if
    let seo_atom = word_at(words, seo_atom_idx)
    let seo_param_id = binding_parameter_index(words, caller_name_idx, seo_atom)
    if U64.less_than(seo_param_id, count_params(words, caller_name_idx)):
      if is_word(binding_parameter_kind(words, caller_name_idx, seo_atom), receiver_kind):
        let seo_param_ok = I64.literal(1)
      else:
        return "ERR:E-SH-IR-CALL-TYPE"
      end if
    else:
      let seo_local_idx = local_binding_index(local_names, seo_atom)
      if U64.less_than(seo_local_idx, sico.list.length(local_names)):
        if is_word(word_at(local_kinds, seo_local_idx), receiver_kind):
          let seo_local_ok = I64.literal(1)
        else:
          return "ERR:E-SH-IR-CALL-TYPE"
        end if
      else:
        let seo_literal_kind = fixed_literal_argument(words, seo_atom_idx)
        if sico.text.starts_with(seo_literal_kind, "ERR:"):
          return seo_literal_kind
        end if
        if U64.equal(sico.text.length(seo_literal_kind), U64.literal(0)):
          return "ERR:E-SH-IR-CALL-ARGUMENT"
        end if
        if is_word(seo_literal_kind, receiver_kind):
          let seo_literal_ok = I64.literal(1)
        else:
          return "ERR:E-SH-IR-CALL-TYPE"
        end if
      end if
    end if
    set seo_position = next_index(seo_position, seo_position)
  end while
  return ""
end function

function straight_environment_literal_count(words: List[Text], from_idx: U64, caller_name_idx: U64, local_names: List[Text]) returns U64:
  let sel_count = U64.literal(0)
  let sel_position = U64.literal(0)
  while U64.less_than(sel_position, U64.literal(2)):
    let sel_atom_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, sel_position)
    let sel_atom = word_at(words, sel_atom_idx)
    let sel_param = binding_parameter_index(words, caller_name_idx, sel_atom)
    if U64.less_than(sel_param, count_params(words, caller_name_idx)):
      let sel_param_ok = I64.literal(1)
    else:
      if U64.less_than(local_binding_index(local_names, sel_atom), sico.list.length(local_names)):
        let sel_local_ok = I64.literal(1)
      else:
        if U64.less_than(U64.literal(0), sico.text.length(fixed_literal_argument(words, sel_atom_idx))):
          set sel_count = next_index(sel_count, sel_count)
        end if
      end if
    end if
    set sel_position = next_index(sel_position, sel_position)
  end while
  return sel_count
end function

function straight_environment_operand_value(words: List[Text], from_idx: U64, caller_name_idx: U64, local_names: List[Text], local_values: List[U64], first_literal_value: U64, position: U64) returns U64:
  let sev_atom_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, position)
  let sev_atom = word_at(words, sev_atom_idx)
  let sev_param_id = binding_parameter_index(words, caller_name_idx, sev_atom)
  if U64.less_than(sev_param_id, count_params(words, caller_name_idx)):
    return sev_param_id
  end if
  let sev_local_idx = local_binding_index(local_names, sev_atom)
  if U64.less_than(sev_local_idx, sico.list.length(local_names)):
    return u64_list_at(local_values, sev_local_idx, sico.list.length(local_names))
  end if
  let sev_literal_value = first_literal_value
  if U64.equal(position, U64.literal(1)):
    let sev_first_atom_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, U64.literal(0))
    let sev_first_atom = word_at(words, sev_first_atom_idx)
    let sev_first_param = binding_parameter_index(words, caller_name_idx, sev_first_atom)
    if U64.less_than(sev_first_param, count_params(words, caller_name_idx)):
      let sev_first_param_ok = I64.literal(1)
    else:
      if U64.less_than(local_binding_index(local_names, sev_first_atom), sico.list.length(local_names)):
        let sev_first_local_ok = I64.literal(1)
      else:
        set sev_literal_value = next_index(sev_literal_value, sev_literal_value)
      end if
    end if
  end if
  return sev_literal_value
end function

function environment_call_arguments(words: List[Text], args_start: U64, args_end: U64, caller_name_idx: U64, callee_name_idx: U64, local_names: List[Text], local_kinds: List[Text], local_values: List[U64], first_literal_value: U64) returns Text:
  let eca_words_len = sico.list.length(words)
  let eca_callee_params = count_params(words, callee_name_idx)
  if U64.equal(args_start, args_end):
    if U64.equal(eca_callee_params, U64.literal(0)):
      return "[]"
    end if
    return "ERR:E-SH-IR-CALL-ARITY"
  end if
  let eca_json = "["
  let eca_position = U64.literal(0)
  let eca_literal_value = first_literal_value
  let eca_seg_start = args_start
  while U64.less_than(eca_seg_start, args_end):
    let eca_seg_end = args_end
    let eca_scan = eca_seg_start
    while U64.less_than(eca_scan, args_end):
      if is_word(word_at(words, eca_scan), "("):
        set eca_scan = next_index(matching_close(words, eca_scan, args_end), args_end)
      else:
        if is_word(word_at(words, eca_scan), ","):
          set eca_seg_end = eca_scan
          set eca_scan = args_end
        else:
          set eca_scan = next_index(eca_scan, args_end)
        end if
      end if
    end while
    if U64.less_than(eca_position, eca_callee_params):
      let eca_position_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-CALL-ARITY"
    end if
    let eca_atom = word_at(words, eca_seg_start)
    let eca_kind = ""
    let eca_value = U64.literal(0)
    let eca_is_literal = false
    let eca_advance = U64.literal(0)
    let eca_param = binding_parameter_index(words, caller_name_idx, eca_atom)
    if U64.less_than(eca_param, count_params(words, caller_name_idx)):
      set eca_kind = binding_parameter_kind(words, caller_name_idx, eca_atom)
      set eca_value = eca_param
    else:
      let eca_local = local_binding_index(local_names, eca_atom)
      if U64.less_than(eca_local, sico.list.length(local_names)):
        set eca_kind = word_at(local_kinds, eca_local)
        set eca_value = u64_list_at(local_values, eca_local, first_literal_value)
      else:
        set eca_kind = constant_argument_kind(eca_atom)
        if U64.less_than(U64.literal(0), sico.text.length(eca_kind)):
          set eca_value = eca_literal_value
          set eca_is_literal = true
          set eca_advance = U64.literal(1)
        else:
          set eca_kind = fixed_literal_argument(words, eca_seg_start)
          if sico.text.starts_with(eca_kind, "ERR:"):
            return eca_kind
          end if
          if U64.less_than(U64.literal(0), sico.text.length(eca_kind)):
            set eca_value = eca_literal_value
            set eca_is_literal = true
            set eca_advance = U64.literal(1)
          else:
            if U64.less_than(eca_seg_end, eca_words_len):
              if is_word(word_at(words, next_index(eca_seg_start, eca_words_len)), "("):
                let eca_callee_idx = function_declaration_index(words, eca_atom)
                if U64.equal(eca_callee_idx, eca_words_len):
                  return "ERR:E-SH-IR-CALL-TARGET"
                end if
                set eca_kind = declared_return_kind(words, next_index(eca_callee_idx, eca_words_len))
                let eca_seg_count = argument_instruction_count(words, eca_seg_start, eca_seg_end, caller_name_idx)
                match U64.checked_add(eca_literal_value, eca_seg_count):
                  case ok(eca_summed):
                    match U64.checked_sub(eca_summed, U64.literal(1)):
                      case ok(eca_call_value):
                        set eca_value = eca_call_value
                        set eca_advance = eca_seg_count
                      case error(_):
                        return "ERR:E-SH-IR-CALL-ARGUMENT"
                    end match
                  case error(_):
                    return "ERR:E-SH-IR-CALL-ARGUMENT"
                end match
              end if
            end if
            if U64.equal(eca_advance, U64.literal(0)):
              return "ERR:E-SH-IR-CALL-ARGUMENT"
            end if
          end if
        end if
      end if
    end if
    let eca_call_segment = false
    if U64.less_than(next_index(eca_seg_start, eca_words_len), eca_seg_end):
      if is_word(word_at(words, next_index(eca_seg_start, eca_words_len)), "("):
        set eca_call_segment = true
      end if
    end if
    if eca_call_segment:
      let eca_call_shape_ok = I64.literal(1)
    else:
      let eca_width = fixed_operation_operand_width(words, eca_seg_start, caller_name_idx)
      let eca_after_value = eca_seg_start
      match U64.checked_add(eca_seg_start, eca_width):
        case ok(eca_after_segment):
          set eca_after_value = eca_after_segment
        case error(_):
          return "ERR:E-SH-IR-CALL-SHAPE"
      end match
      if U64.equal(eca_after_value, eca_seg_end):
        let eca_shape_ok = I64.literal(1)
      else:
        return "ERR:E-SH-IR-CALL-SHAPE"
      end if
    end if
    let eca_expected = parameter_kind_by_id(words, callee_name_idx, eca_position)
    if is_word(eca_kind, eca_expected):
      let eca_type_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-CALL-TYPE"
    end if
    if U64.less_than(U64.literal(0), eca_position):
      set eca_json = sico.text.concat(eca_json, ",")
    end if
    set eca_json = sico.text.concat(eca_json, sico.u64.to_text(eca_value))
    if eca_is_literal:
      match U64.checked_add(eca_literal_value, eca_advance):
        case ok(eca_advanced):
          set eca_literal_value = eca_advanced
        case error(_):
          return "ERR:E-SH-IR-CALL-ARGUMENT"
      end match
    end if
    set eca_position = next_index(eca_position, eca_position)
    if U64.equal(eca_seg_end, args_end):
      if U64.equal(eca_position, eca_callee_params):
        return sico.text.concat(eca_json, "]")
      end if
      return "ERR:E-SH-IR-CALL-ARITY"
    end if
    if is_word(word_at(words, eca_seg_end), ","):
      set eca_seg_start = next_index(eca_seg_end, args_end)
    else:
      return "ERR:E-SH-IR-CALL-SHAPE"
    end if
  end while
  return "ERR:E-SH-IR-CALL-ARITY"
end function

function scalar_const_instruction_json(result_id: U64, kind: Text, data_json: Text, range_start: U64, range_end: U64) returns Text:
  let scij_json = "{\"result\":"
  set scij_json = sico.text.concat(scij_json, sico.u64.to_text(result_id))
  set scij_json = sico.text.concat(scij_json, ",\"ty\":{\"kind\":\"")
  set scij_json = sico.text.concat(scij_json, kind)
  set scij_json = sico.text.concat(scij_json, "\"},\"operation\":{\"op\":\"const_")
  set scij_json = sico.text.concat(scij_json, kind)
  set scij_json = sico.text.concat(scij_json, "\",\"data\":")
  set scij_json = sico.text.concat(scij_json, data_json)
  set scij_json = sico.text.concat(scij_json, "},\"range\":{\"start\":")
  set scij_json = sico.text.concat(scij_json, sico.u64.to_text(range_start))
  set scij_json = sico.text.concat(scij_json, ",\"end\":")
  set scij_json = sico.text.concat(scij_json, sico.u64.to_text(range_end))
  set scij_json = sico.text.concat(scij_json, "}}")
  return scij_json
end function

function fixed_literal_const_instruction(words: List[Text], src: Bytes, expr_idx: U64, line_end: U64, anchor_idx: U64, anchor_offset: U64, result_id: U64) returns Text:
  let fli_words_len = sico.list.length(words)
  let fli_dot_idx = next_index(expr_idx, fli_words_len)
  let fli_name_idx = next_index(fli_dot_idx, fli_words_len)
  let fli_open_idx = next_index(fli_name_idx, fli_words_len)
  let fli_value_idx = next_index(fli_open_idx, fli_words_len)
  let fli_close_idx = next_index(fli_value_idx, fli_words_len)
  let fli_after_close = next_index(fli_close_idx, fli_words_len)
  let fli_kind = ""
  if is_word(word_at(words, expr_idx), "I64"):
    set fli_kind = "i64"
  else:
    if is_word(word_at(words, expr_idx), "U64"):
      set fli_kind = "u64"
    end if
  end if
  if U64.equal(sico.text.length(fli_kind), U64.literal(0)):
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  if U64.equal(fli_after_close, line_end):
    if is_word(word_at(words, fli_dot_idx), "."):
      if is_word(word_at(words, fli_name_idx), "literal"):
        if is_word(word_at(words, fli_open_idx), "("):
          if is_word(word_at(words, fli_close_idx), ")"):
            if is_canonical_magnitude(word_at(words, fli_value_idx)):
              let fli_magnitude = word_at(words, fli_value_idx)
              if is_word(fli_kind, "i64"):
                if decimal_at_most(fli_magnitude, "9223372036854775807"):
                  let fli_digits_offset = word_span_offset(words, src, anchor_offset, anchor_idx, fli_value_idx)
                  let fli_digits_end = fli_digits_offset
                  match U64.checked_add(fli_digits_offset, sico.bytes.length(sico.text.encode(fli_magnitude))):
                    case ok(fli_after_digits):
                      set fli_digits_end = fli_after_digits
                    case error(_):
                      return "ERR:E-SH-IR-RANGE"
                  end match
                  return scalar_const_instruction_json(result_id, fli_kind, fli_magnitude, fli_digits_offset, fli_digits_end)
                end if
                return "ERR:E-SH-IR-I64-RANGE"
              end if
              if decimal_at_most(fli_magnitude, "18446744073709551615"):
                let fli_u64_digits_offset = word_span_offset(words, src, anchor_offset, anchor_idx, fli_value_idx)
                let fli_u64_digits_end = fli_u64_digits_offset
                match U64.checked_add(fli_u64_digits_offset, sico.bytes.length(sico.text.encode(fli_magnitude))):
                  case ok(fli_u64_after_digits):
                    set fli_u64_digits_end = fli_u64_after_digits
                  case error(_):
                    return "ERR:E-SH-IR-RANGE"
                end match
                return scalar_const_instruction_json(result_id, fli_kind, fli_magnitude, fli_u64_digits_offset, fli_u64_digits_end)
              end if
              return "ERR:E-SH-IR-U64-RANGE"
            end if
          end if
        end if
      end if
    end if
  end if
  let fli_minus_idx = fli_value_idx
  let fli_signed_magnitude_idx = next_index(fli_minus_idx, fli_words_len)
  let fli_signed_close_idx = next_index(fli_signed_magnitude_idx, fli_words_len)
  let fli_after_signed_close = next_index(fli_signed_close_idx, fli_words_len)
  if U64.equal(fli_after_signed_close, line_end):
    if is_word(fli_kind, "i64"):
      if is_word(word_at(words, fli_dot_idx), "."):
        if is_word(word_at(words, fli_name_idx), "literal"):
          if is_word(word_at(words, fli_open_idx), "("):
            if is_word(word_at(words, fli_minus_idx), "-"):
              if is_canonical_magnitude(word_at(words, fli_signed_magnitude_idx)):
                if is_word(word_at(words, fli_signed_close_idx), ")"):
                  let fli_negative_magnitude = word_at(words, fli_signed_magnitude_idx)
                  if decimal_at_most(fli_negative_magnitude, "9223372036854775808"):
                    let fli_sign_offset = word_span_offset(words, src, anchor_offset, anchor_idx, fli_minus_idx)
                    let fli_negative_data = sico.text.concat("-", fli_negative_magnitude)
                    let fli_negative_digits_offset = fli_sign_offset
                    match U64.checked_add(fli_sign_offset, U64.literal(1)):
                      case ok(fli_after_sign):
                        set fli_negative_digits_offset = fli_after_sign
                      case error(_):
                        return "ERR:E-SH-IR-RANGE"
                    end match
                    let fli_negative_digits_end = fli_negative_digits_offset
                    match U64.checked_add(fli_negative_digits_offset, sico.bytes.length(sico.text.encode(fli_negative_magnitude))):
                      case ok(fli_negative_after_digits):
                        set fli_negative_digits_end = fli_negative_after_digits
                      case error(_):
                        return "ERR:E-SH-IR-RANGE"
                    end match
                    return scalar_const_instruction_json(result_id, fli_kind, fli_negative_data, fli_sign_offset, fli_negative_digits_end)
                  end if
                  return "ERR:E-SH-IR-I64-RANGE"
                end if
              end if
            end if
          end if
        end if
      end if
    end if
  end if
  return "ERR:E-SH-IR-EXPRESSION"
end function

function comma_count(text: Text) returns U64:
  let cc_bytes = sico.text.encode(text)
  let cc_n = sico.bytes.length(cc_bytes)
  let cc_i = U64.literal(0)
  let cc_count = U64.literal(0)
  while U64.less_than(cc_i, cc_n):
    if I64.equal(sico.bytes.at(cc_bytes, cc_i, I64.literal(0)), I64.literal(44)):
      set cc_count = next_index(cc_count, cc_count)
    end if
    set cc_i = next_index(cc_i, cc_i)
  end while
  return cc_count
end function

function operand_nonparam_kind(words: List[Text], atom_idx: U64, cell_names: List[Text], cell_kinds: List[Text]) returns Text:
  let onk_atom = word_at(words, atom_idx)
  let onk_cell = local_binding_index(cell_names, onk_atom)
  if U64.less_than(onk_cell, sico.list.length(cell_names)):
    return word_at(cell_kinds, onk_cell)
  end if
  return fixed_literal_argument(words, atom_idx)
end function

function operand_cell_or_literal_json(words: List[Text], src: Bytes, atom_idx: U64, base: U64, anchor_idx: U64, anchor_offset: U64, cell_names: List[Text], cell_kinds: List[Text], cell_locals: List[U64]) returns Text:
  let ocl_words_len = sico.list.length(words)
  let ocl_atom = word_at(words, atom_idx)
  let ocl_cell = local_binding_index(cell_names, ocl_atom)
  if U64.less_than(ocl_cell, sico.list.length(cell_names)):
    let ocl_kind = word_at(cell_kinds, ocl_cell)
    let ocl_offset = word_span_offset(words, src, anchor_offset, anchor_idx, atom_idx)
    let ocl_end = ocl_offset
    match U64.checked_add(ocl_offset, sico.bytes.length(sico.text.encode(ocl_atom))):
      case ok(ocl_after_atom):
        set ocl_end = ocl_after_atom
      case error(_):
        return "ERR:E-SH-IR-RANGE"
    end match
    return read_local_instruction_json(base, ocl_kind, u64_list_at(cell_locals, ocl_cell, U64.literal(0)), ocl_offset, ocl_end)
  end if
  let ocl_lit = fixed_literal_argument(words, atom_idx)
  if sico.text.starts_with(ocl_lit, "ERR:"):
    return ocl_lit
  end if
  if U64.less_than(U64.literal(0), sico.text.length(ocl_lit)):
    return fixed_literal_operand_json(words, src, atom_idx, anchor_idx, anchor_offset, base)
  end if
  return ""
end function

function fixed_literal_operand_json(words: List[Text], src: Bytes, atom_idx: U64, anchor_idx: U64, anchor_offset: U64, result_id: U64) returns Text:
  let flop_words_len = sico.list.length(words)
  let flop_kind = fixed_literal_argument(words, atom_idx)
  let flop_sign_idx = next_index(next_index(next_index(next_index(atom_idx, flop_words_len), flop_words_len), flop_words_len), flop_words_len)
  let flop_is_negative = is_word(word_at(words, flop_sign_idx), "-")
  let flop_sign_offset = word_span_offset(words, src, anchor_offset, anchor_idx, flop_sign_idx)
  let flop_digits_word = ""
  let flop_digits_offset = flop_sign_offset
  if flop_is_negative:
    set flop_digits_word = word_at(words, next_index(flop_sign_idx, flop_words_len))
    match U64.checked_add(flop_sign_offset, U64.literal(1)):
      case ok(flop_after_sign):
        set flop_digits_offset = flop_after_sign
      case error(_):
        return "ERR:E-SH-IR-RANGE"
    end match
  else:
    set flop_digits_word = word_at(words, flop_sign_idx)
  end if
  let flop_digits_end = flop_digits_offset
  match U64.checked_add(flop_digits_offset, sico.bytes.length(sico.text.encode(flop_digits_word))):
    case ok(flop_after_digits):
      set flop_digits_end = flop_after_digits
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  let flop_data = flop_digits_word
  if flop_is_negative:
    set flop_data = sico.text.concat("-", flop_digits_word)
  end if
  return scalar_const_instruction_json(result_id, flop_kind, flop_data, flop_sign_offset, flop_digits_end)
end function

function write_local_instruction_json(result_id: U64, local_idx: U64, value: U64, range_start: U64, range_end: U64) returns Text:
  let wli_json = "{\"result\":"
  set wli_json = sico.text.concat(wli_json, sico.u64.to_text(result_id))
  set wli_json = sico.text.concat(wli_json, ",\"ty\":{\"kind\":\"unit\"},\"operation\":{\"op\":\"write_local\",\"data\":{\"local\":")
  set wli_json = sico.text.concat(wli_json, sico.u64.to_text(local_idx))
  set wli_json = sico.text.concat(wli_json, ",\"value\":")
  set wli_json = sico.text.concat(wli_json, sico.u64.to_text(value))
  set wli_json = sico.text.concat(wli_json, "}},\"range\":{\"start\":")
  set wli_json = sico.text.concat(wli_json, sico.u64.to_text(range_start))
  set wli_json = sico.text.concat(wli_json, ",\"end\":")
  set wli_json = sico.text.concat(wli_json, sico.u64.to_text(range_end))
  set wli_json = sico.text.concat(wli_json, "}}")
  return wli_json
end function

function read_local_instruction_json(result_id: U64, kind: Text, local_idx: U64, range_start: U64, range_end: U64) returns Text:
  let rli_json = "{\"result\":"
  set rli_json = sico.text.concat(rli_json, sico.u64.to_text(result_id))
  set rli_json = sico.text.concat(rli_json, ",\"ty\":{\"kind\":\"")
  set rli_json = sico.text.concat(rli_json, kind)
  set rli_json = sico.text.concat(rli_json, "\"},\"operation\":{\"op\":\"read_local\",\"data\":{\"local\":")
  set rli_json = sico.text.concat(rli_json, sico.u64.to_text(local_idx))
  set rli_json = sico.text.concat(rli_json, "}},\"range\":{\"start\":")
  set rli_json = sico.text.concat(rli_json, sico.u64.to_text(range_start))
  set rli_json = sico.text.concat(rli_json, ",\"end\":")
  set rli_json = sico.text.concat(rli_json, sico.u64.to_text(range_end))
  set rli_json = sico.text.concat(rli_json, "}}")
  return rli_json
end function

function call_instruction_json(result_id: U64, kind: Text, function_id: U64, arguments: Text, range_start: U64, range_end: U64) returns Text:
  let cij_json = "{\"result\":"
  set cij_json = sico.text.concat(cij_json, sico.u64.to_text(result_id))
  set cij_json = sico.text.concat(cij_json, ",\"ty\":{\"kind\":\"")
  set cij_json = sico.text.concat(cij_json, kind)
  set cij_json = sico.text.concat(cij_json, "\"},\"operation\":{\"op\":\"call\",\"data\":{\"function\":")
  set cij_json = sico.text.concat(cij_json, sico.u64.to_text(function_id))
  set cij_json = sico.text.concat(cij_json, ",\"arguments\":")
  set cij_json = sico.text.concat(cij_json, arguments)
  set cij_json = sico.text.concat(cij_json, "}},\"range\":{\"start\":")
  set cij_json = sico.text.concat(cij_json, sico.u64.to_text(range_start))
  set cij_json = sico.text.concat(cij_json, ",\"end\":")
  set cij_json = sico.text.concat(cij_json, sico.u64.to_text(range_end))
  set cij_json = sico.text.concat(cij_json, "}}")
  return cij_json
end function

function straight_environment_function_ir(words: List[Text], src: Bytes, name_idx: U64, body_from: U64, body_end: U64, fn_start: U64, function_ordinal: U64, return_kind: Text, parameter_count: U64, let_count: U64) returns Text:
  let sef_local_names = sico.text.split_lines("")
  let sef_local_kinds = sico.text.split_lines("")
  let sef_local_values = sico.list.empty[U64]()
  let sef_instructions = "["
  let sef_body_idx = body_from
  while U64.less_than(sef_body_idx, body_end):
    if is_word(word_at(words, sef_body_idx), "let"):
      break
    end if
    set sef_body_idx = next_index(sef_body_idx, body_end)
  end while
  let sef_source_cursor = fn_start
  let sef_processed = U64.literal(0)
  let sef_emitted = U64.literal(0)
  let sef_next_result = parameter_count
  while U64.less_than(sef_processed, let_count):
    if is_word(word_at(words, sef_body_idx), "let"):
      let sef_let_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-STATEMENT"
    end if
    let sef_line_end = line_end(words, sef_body_idx)
    let sef_binding_idx = next_index(sef_body_idx, sef_line_end)
    let sef_receiver_idx = next_index(sef_binding_idx, sef_line_end)
    let sef_binding = word_at(words, sef_binding_idx)
    if U64.less_than(binding_parameter_index(words, name_idx, sef_binding), parameter_count):
      return "ERR:E-SH-IR-STATEMENT"
    end if
    if U64.less_than(local_binding_index(sef_local_names, sef_binding), sico.list.length(sef_local_names)):
      return "ERR:E-SH-IR-STATEMENT"
    end if
    let sef_after_receiver = next_index(sef_receiver_idx, sef_line_end)
    let sef_is_call = is_word(word_at(words, sef_after_receiver), "(")
    let sef_kind = ""
    let sef_let_offset = find_text_from(src, "let", sef_source_cursor)
    let sef_expression_start = word_span_offset(words, src, sef_let_offset, sef_body_idx, sef_receiver_idx)
    let sef_expression_end = return_expression_end(src, sef_expression_start)
    let sef_literals = ""
    let sef_operation_result = sef_next_result
    let sef_instruction = ""
    if sef_is_call:
      let sef_callee_idx = function_declaration_index(words, word_at(words, sef_receiver_idx))
      if U64.equal(sef_callee_idx, sico.list.length(words)):
        return "ERR:E-SH-IR-CALL-TARGET"
      end if
      let sef_call_close = matching_close(words, sef_after_receiver, sef_line_end)
      if U64.equal(next_index(sef_call_close, sef_line_end), sef_line_end):
        let sef_call_shape_ok = I64.literal(1)
      else:
        return "ERR:E-SH-IR-CALL-SHAPE"
      end if
      let sef_call_args_start = next_index(sef_after_receiver, sef_call_close)
      let sef_call_arguments = environment_call_arguments(words, sef_call_args_start, sef_call_close, name_idx, sef_callee_idx, sef_local_names, sef_local_kinds, sef_local_values, sef_next_result)
      if sico.text.starts_with(sef_call_arguments, "ERR:"):
        return sef_call_arguments
      end if
      set sef_kind = declared_return_kind(words, next_index(sef_callee_idx, sico.list.length(words)))
      if U64.equal(sico.text.length(sef_kind), U64.literal(0)):
        return "ERR:E-SH-IR-RETURN-TYPE"
      end if
      let sef_call_literal_count = argument_region_instruction_count(words, sef_call_args_start, sef_call_close, name_idx)
      set sef_literals = argument_instructions(words, src, sef_receiver_idx, sef_expression_start, sef_call_args_start, sef_call_close, name_idx, sef_next_result)
      match U64.checked_add(sef_next_result, sef_call_literal_count):
        case ok(sef_call_result):
          set sef_operation_result = sef_call_result
        case error(_):
          return "ERR:E-SH-IR-RANGE"
      end match
      set sef_instruction = call_instruction_json(sef_operation_result, sef_kind, function_declaration_ordinal(words, sef_callee_idx), sef_call_arguments, sef_expression_start, sef_expression_end)
    else:
      if U64.equal(next_index(sef_receiver_idx, sef_line_end), sef_line_end):
        let sef_const_atom = word_at(words, sef_receiver_idx)
        if is_word(sef_const_atom, "ERR-string-escape"):
          return "ERR:E-SH-IR-STRING-ESCAPE"
        end if
        if is_word(sef_const_atom, "ERR-string"):
          return "ERR:E-SH-IR-STRING-UNCLOSED"
        end if
        let sef_alias_param = binding_parameter_index(words, name_idx, sef_const_atom)
        if U64.less_than(sef_alias_param, parameter_count):
          set sef_kind = binding_parameter_kind(words, name_idx, sef_const_atom)
          set sef_operation_result = sef_alias_param
          set sef_instruction = ""
        else:
          let sef_alias_local = local_binding_index(sef_local_names, sef_const_atom)
          if U64.less_than(sef_alias_local, sico.list.length(sef_local_names)):
            set sef_kind = word_at(sef_local_kinds, sef_alias_local)
            set sef_operation_result = u64_list_at(sef_local_values, sef_alias_local, sef_next_result)
            set sef_instruction = ""
          else:
        if is_canonical_magnitude(sef_const_atom):
          set sef_kind = "int"
          set sef_instruction = scalar_const_instruction_json(sef_next_result, sef_kind, sico.text.concat("\"", sico.text.concat(sef_const_atom, "\"")), sef_expression_start, sef_expression_end)
        else:
          if is_word(sef_const_atom, "true"):
            set sef_kind = "bool"
            set sef_instruction = scalar_const_instruction_json(sef_next_result, sef_kind, "true", sef_expression_start, sef_expression_end)
          else:
            if is_word(sef_const_atom, "false"):
              set sef_kind = "bool"
              set sef_instruction = scalar_const_instruction_json(sef_next_result, sef_kind, "false", sef_expression_start, sef_expression_end)
            else:
              if is_string_token(sef_const_atom):
                set sef_kind = "string"
                set sef_instruction = scalar_const_instruction_json(sef_next_result, sef_kind, json_string_token(sef_const_atom), sef_expression_start, sef_expression_end)
              else:
                return "ERR:E-SH-IR-EXPRESSION"
              end if
            end if
          end if
        end if
          end if
        end if
      else:
        let sef_dot_idx = sef_after_receiver
        let sef_operation_idx = next_index(sef_dot_idx, sef_line_end)
        let sef_open_idx = next_index(sef_operation_idx, sef_line_end)
        if is_word(word_at(words, sef_dot_idx), "."):
          let sef_dot_ok = I64.literal(1)
        else:
          return "ERR:E-SH-IR-EXPRESSION"
        end if
        if is_word(word_at(words, sef_open_idx), "("):
          let sef_open_ok = I64.literal(1)
        else:
          return "ERR:E-SH-IR-EXPRESSION"
        end if
        let sef_operation = fixed_op_name(word_at(words, sef_operation_idx))
        if U64.equal(sico.text.length(sef_operation), U64.literal(0)):
          return "ERR:E-SH-IR-EXPRESSION"
        end if
        if is_word(word_at(words, sef_receiver_idx), "I64"):
          set sef_kind = "i64"
        else:
          if is_word(word_at(words, sef_receiver_idx), "U64"):
            set sef_kind = "u64"
          else:
            return "ERR:E-SH-IR-EXPRESSION"
          end if
        end if
        let sef_operand_check = straight_environment_operand_check(words, sef_receiver_idx, name_idx, sef_local_names, sef_local_kinds, sef_kind)
        if sico.text.starts_with(sef_operand_check, "ERR:"):
          return sef_operand_check
        end if
        let sef_literal_count = straight_environment_literal_count(words, sef_receiver_idx, name_idx, sef_local_names)
        set sef_literals = fixed_operation_literal_instructions(words, src, sef_receiver_idx, name_idx, sef_next_result, sef_receiver_idx, sef_expression_start)
        match U64.checked_add(sef_next_result, sef_literal_count):
          case ok(sef_after_literals):
            set sef_operation_result = sef_after_literals
          case error(_):
            return "ERR:E-SH-IR-RANGE"
        end match
        let sef_left = straight_environment_operand_value(words, sef_receiver_idx, name_idx, sef_local_names, sef_local_values, sef_next_result, U64.literal(0))
        let sef_right = straight_environment_operand_value(words, sef_receiver_idx, name_idx, sef_local_names, sef_local_values, sef_next_result, U64.literal(1))
        set sef_instruction = fixed_operation_instruction_json(sef_operation_result, sef_kind, sef_operation, sef_left, sef_right, sef_expression_start, sef_expression_end)
      end if
    end if
    if U64.less_than(U64.literal(0), sico.text.length(sef_instruction)):
      if U64.less_than(U64.literal(0), sef_emitted):
        set sef_instructions = sico.text.concat(sef_instructions, ",")
      end if
      set sef_emitted = next_index(sef_emitted, sef_emitted)
      set sef_instructions = sico.text.concat(sef_instructions, sef_literals)
      if U64.less_than(U64.literal(0), sico.text.length(sef_literals)):
        set sef_instructions = sico.text.concat(sef_instructions, ",")
      end if
      set sef_instructions = sico.text.concat(sef_instructions, sef_instruction)
    end if
    set sef_local_names = sico.list.append(sef_local_names, sef_binding)
    set sef_local_kinds = sico.list.append(sef_local_kinds, sef_kind)
    set sef_local_values = sico.list.append[U64](sef_local_values, sef_operation_result)
    if U64.less_than(U64.literal(0), sico.text.length(sef_instruction)):
      set sef_next_result = next_index(sef_operation_result, sef_operation_result)
    end if
    set sef_source_cursor = sef_expression_end
    set sef_processed = next_index(sef_processed, sef_processed)
    set sef_body_idx = next_index(sef_line_end, body_end)
    while U64.less_than(sef_body_idx, body_end):
      if is_word(word_at(words, sef_body_idx), "<nl>"):
        set sef_body_idx = next_index(sef_body_idx, body_end)
      else:
        break
      end if
    end while
  end while
  if is_word(word_at(words, sef_body_idx), "return"):
    let sef_return_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-RETURN-COUNT"
  end if
  let sef_return_end = line_end(words, sef_body_idx)
  let sef_return_value_idx = next_index(sef_body_idx, sef_return_end)
  let sef_return_name = word_at(words, sef_return_value_idx)
  let sef_return_value = parameter_count
  let sef_return_value_kind = ""
  let sef_return_const = ""
  let sef_return_param = binding_parameter_index(words, name_idx, sef_return_name)
  if U64.less_than(sef_return_param, parameter_count):
    set sef_return_value = sef_return_param
    set sef_return_value_kind = binding_parameter_kind(words, name_idx, sef_return_name)
  else:
    let sef_return_local = local_binding_index(sef_local_names, sef_return_name)
    if U64.less_than(sef_return_local, sico.list.length(sef_local_names)):
      set sef_return_value = u64_list_at(sef_local_values, sef_return_local, parameter_count)
      set sef_return_value_kind = word_at(sef_local_kinds, sef_return_local)
    else:
      let sef_return_second_idx = next_index(sef_return_value_idx, sef_return_end)
      if U64.less_than(sef_return_second_idx, sef_return_end):
        let sef_ret_expr_start = return_expression_start(src, sef_source_cursor)
        if U64.equal(sef_ret_expr_start, sico.bytes.length(src)):
          return "ERR:E-SH-IR-RANGE"
        end if
        if is_word(word_at(words, sef_return_second_idx), "("):
          let sef_ret_callee_idx = function_declaration_index(words, sef_return_name)
          if U64.equal(sef_ret_callee_idx, sico.list.length(words)):
            return "ERR:E-SH-IR-CALL-TARGET"
          end if
          let sef_ret_close = matching_close(words, sef_return_second_idx, sef_return_end)
          if U64.equal(next_index(sef_ret_close, sef_return_end), sef_return_end):
            let sef_ret_shape_ok = I64.literal(1)
          else:
            return "ERR:E-SH-IR-CALL-SHAPE"
          end if
          let sef_ret_args_start = next_index(sef_return_second_idx, sef_return_end)
          let sef_ret_arguments = environment_call_arguments(words, sef_ret_args_start, sef_ret_close, name_idx, sef_ret_callee_idx, sef_local_names, sef_local_kinds, sef_local_values, sef_next_result)
          if sico.text.starts_with(sef_ret_arguments, "ERR:"):
            return sef_ret_arguments
          end if
          let sef_ret_kind = declared_return_kind(words, next_index(sef_ret_callee_idx, sico.list.length(words)))
          if U64.equal(sico.text.length(sef_ret_kind), U64.literal(0)):
            return "ERR:E-SH-IR-RETURN-TYPE"
          end if
          let sef_ret_const_count = argument_region_instruction_count(words, sef_ret_args_start, sef_ret_close, name_idx)
          let sef_ret_consts = argument_instructions(words, src, sef_return_value_idx, sef_ret_expr_start, sef_ret_args_start, sef_ret_close, name_idx, sef_next_result)
          let sef_ret_result = sef_next_result
          match U64.checked_add(sef_next_result, sef_ret_const_count):
            case ok(sef_ret_call_result):
              set sef_ret_result = sef_ret_call_result
            case error(_):
              return "ERR:E-SH-IR-RANGE"
          end match
          let sef_ret_expr_end = return_expression_end(src, sef_ret_expr_start)
          set sef_return_value = sef_ret_result
          set sef_return_value_kind = sef_ret_kind
          set sef_return_const = call_instruction_json(sef_ret_result, sef_ret_kind, function_declaration_ordinal(words, sef_ret_callee_idx), sef_ret_arguments, sef_ret_expr_start, sef_ret_expr_end)
          if U64.less_than(U64.literal(0), sico.text.length(sef_ret_consts)):
            set sef_return_const = sico.text.concat(sef_ret_consts, sico.text.concat(",", sef_return_const))
          end if
        else:
          if is_word(word_at(words, sef_return_second_idx), "."):
            let sef_ret_third_idx = next_index(sef_return_second_idx, sef_return_end)
            if is_word(word_at(words, sef_ret_third_idx), "literal"):
              let sef_ret_literal = fixed_literal_const_instruction(words, src, sef_return_value_idx, sef_return_end, sef_return_value_idx, sef_ret_expr_start, sef_next_result)
              if sico.text.starts_with(sef_ret_literal, "ERR:"):
                return sef_ret_literal
              end if
              if is_word(sef_return_name, "I64"):
                set sef_return_value_kind = "i64"
              else:
                set sef_return_value_kind = "u64"
              end if
              set sef_return_value = sef_next_result
              set sef_return_const = sef_ret_literal
            else:
              let sef_ret_op = fixed_op_name(word_at(words, sef_ret_third_idx))
              if U64.less_than(U64.literal(0), sico.text.length(sef_ret_op)):
                let sef_ret_op_open = next_index(sef_ret_third_idx, sef_return_end)
                if is_word(word_at(words, sef_ret_op_open), "("):
                  let sef_ret_op_open_ok = I64.literal(1)
                else:
                  return "ERR:E-SH-IR-EXPRESSION"
                end if
                let sef_ret_op_kind = ""
                if is_word(sef_return_name, "I64"):
                  set sef_ret_op_kind = "i64"
                else:
                  if is_word(sef_return_name, "U64"):
                    set sef_ret_op_kind = "u64"
                  else:
                    return "ERR:E-SH-IR-EXPRESSION"
                  end if
                end if
                let sef_ret_op_check = straight_environment_operand_check(words, sef_return_value_idx, name_idx, sef_local_names, sef_local_kinds, sef_ret_op_kind)
                if sico.text.starts_with(sef_ret_op_check, "ERR:"):
                  return sef_ret_op_check
                end if
                let sef_ret_op_literal_count = straight_environment_literal_count(words, sef_return_value_idx, name_idx, sef_local_names)
                let sef_ret_op_consts = fixed_operation_literal_instructions(words, src, sef_return_value_idx, name_idx, sef_next_result, sef_return_value_idx, sef_ret_expr_start)
                let sef_ret_op_result = sef_next_result
                match U64.checked_add(sef_next_result, sef_ret_op_literal_count):
                  case ok(sef_ret_op_after):
                    set sef_ret_op_result = sef_ret_op_after
                  case error(_):
                    return "ERR:E-SH-IR-RANGE"
                end match
                let sef_ret_op_left = straight_environment_operand_value(words, sef_return_value_idx, name_idx, sef_local_names, sef_local_values, sef_next_result, U64.literal(0))
                let sef_ret_op_right = straight_environment_operand_value(words, sef_return_value_idx, name_idx, sef_local_names, sef_local_values, sef_next_result, U64.literal(1))
                let sef_ret_op_end = return_expression_end(src, sef_ret_expr_start)
                set sef_return_value = sef_ret_op_result
                set sef_return_value_kind = sef_ret_op_kind
                set sef_return_const = fixed_operation_instruction_json(sef_ret_op_result, sef_ret_op_kind, sef_ret_op, sef_ret_op_left, sef_ret_op_right, sef_ret_expr_start, sef_ret_op_end)
                if U64.less_than(U64.literal(0), sico.text.length(sef_ret_op_consts)):
                  set sef_return_const = sico.text.concat(sef_ret_op_consts, sico.text.concat(",", sef_return_const))
                end if
              else:
                return "ERR:E-SH-IR-EXPRESSION"
              end if
            end if
          else:
            return "ERR:E-SH-IR-UNRESOLVED"
          end if
        end if
      else:
      if is_word(sef_return_name, "ERR-string-escape"):
        return "ERR:E-SH-IR-STRING-ESCAPE"
      end if
      if is_word(sef_return_name, "ERR-string"):
        return "ERR:E-SH-IR-STRING-UNCLOSED"
      end if
      let sef_const_start = return_expression_start(src, sef_source_cursor)
      if U64.equal(sef_const_start, sico.bytes.length(src)):
        return "ERR:E-SH-IR-RANGE"
      end if
      let sef_const_end = sef_const_start
      match U64.checked_add(sef_const_start, sico.bytes.length(sico.text.encode(sef_return_name))):
        case ok(sef_const_after):
          set sef_const_end = sef_const_after
        case error(_):
          return "ERR:E-SH-IR-RANGE"
      end match
      if is_canonical_magnitude(sef_return_name):
        set sef_return_value = sef_next_result
        set sef_return_value_kind = "int"
        set sef_return_const = scalar_const_instruction_json(sef_next_result, sef_return_value_kind, sico.text.concat("\"", sico.text.concat(sef_return_name, "\"")), sef_const_start, sef_const_end)
      else:
        if is_word(sef_return_name, "true"):
          set sef_return_value = sef_next_result
          set sef_return_value_kind = "bool"
          set sef_return_const = scalar_const_instruction_json(sef_next_result, sef_return_value_kind, "true", sef_const_start, sef_const_end)
        else:
          if is_word(sef_return_name, "false"):
            set sef_return_value = sef_next_result
            set sef_return_value_kind = "bool"
            set sef_return_const = scalar_const_instruction_json(sef_next_result, sef_return_value_kind, "false", sef_const_start, sef_const_end)
          else:
            if is_string_token(sef_return_name):
              set sef_return_value = sef_next_result
              set sef_return_value_kind = "string"
              set sef_return_const = scalar_const_instruction_json(sef_next_result, sef_return_value_kind, json_string_token(sef_return_name), sef_const_start, sef_const_end)
            else:
              return "ERR:E-SH-IR-UNRESOLVED"
            end if
          end if
        end if
      end if
      end if
    end if
  end if
  if U64.less_than(U64.literal(0), sico.text.length(sef_return_const)):
    if U64.less_than(U64.literal(0), sef_emitted):
      set sef_instructions = sico.text.concat(sef_instructions, ",")
    end if
    set sef_instructions = sico.text.concat(sef_instructions, sef_return_const)
  end if
  set sef_instructions = sico.text.concat(sef_instructions, "]")
  if is_word(sef_return_value_kind, return_kind):
    let sef_return_type_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-TYPE-MISMATCH"
  end if
  let sef_tail = next_index(sef_return_end, body_end)
  while U64.less_than(sef_tail, body_end):
    let sef_tail_word = word_at(words, sef_tail)
    if is_word(sef_tail_word, "<nl>"):
      set sef_tail = next_index(sef_tail, body_end)
    else:
      if is_word(sef_tail_word, "end"):
        set sef_tail = body_end
      else:
        return "ERR:E-SH-IR-STATEMENT"
      end if
    end if
  end while
  let sef_end_offset = find_text_from(src, "end function", fn_start)
  let sef_fn_end = fn_start
  match U64.checked_add(sef_end_offset, U64.literal(13)):
    case ok(sef_after_end):
      set sef_fn_end = sef_after_end
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  if U64.less_than(sico.bytes.length(src), sef_fn_end):
    set sef_fn_end = sico.bytes.length(src)
  end if
  let sef_parameters = parameters_ir(words, name_idx, src, fn_start)
  if sico.text.starts_with(sef_parameters, "ERR:"):
    return sef_parameters
  end if
  let sef_json = "{\"id\":"
