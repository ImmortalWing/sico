    end if
  else:
    return "ERR:E-SH-IR-CALL-TYPE"
  end if
  let magnitude = word_at(words, literal_value_idx)
  if is_canonical_magnitude(magnitude):
    if is_word(receiver_kind, "i64"):
      if decimal_at_most(magnitude, "9223372036854775807"):
        let literal_in_range = I64.literal(1)
      else:
        return "ERR:E-SH-IR-I64-RANGE"
      end if
    else:
      if decimal_at_most(magnitude, "18446744073709551615"):
        let literal_in_range_u64 = I64.literal(1)
      else:
        return "ERR:E-SH-IR-U64-RANGE"
      end if
    end if
  else:
    return "NO"
  end if
  let source_len = sico.bytes.length(src)
  let match_start = find_text_from(src, "match", fn_start)
  let expression_start = find_text_from(src, receiver, match_start)
  let match_colon_start = find_text_from(src, ":", expression_start)
  let match_end = next_index(match_colon_start, source_len)
  let ok_case_start = find_text_from(src, "case", match_end)
  let ok_case_colon = find_text_from(src, ":", ok_case_start)
  let ok_case_end = next_index(ok_case_colon, source_len)
  let ok_return_start = find_text_from(src, "return", ok_case_end)
  let ok_expression_start = find_text_from(src, ok_binding, ok_return_start)
  let ok_block_end = return_expression_end(src, ok_expression_start)
  let error_case_start = find_text_from(src, "case", ok_block_end)
  let error_case_colon = find_text_from(src, ":", error_case_start)
  let error_case_end = next_index(error_case_colon, source_len)
  let error_return_start = find_text_from(src, "return", error_case_end)
  let literal_expression_start = find_text_from(src, receiver, error_return_start)
  let literal_start = find_text_from(src, magnitude, literal_expression_start)
  let literal_end = index_plus(literal_start, sico.text.length(magnitude), source_len)
  let error_block_end = return_expression_end(src, literal_expression_start)
  let end_function_offset = find_text_from(src, "end function", error_block_end)
  let fn_end = index_plus(end_function_offset, U64.literal(13), source_len)
  if U64.equal(match_start, source_len):
    return "ERR:E-SH-IR-RANGE"
  end if
  if U64.equal(fn_end, source_len):
    if U64.less_than(source_len, fn_end):
      return "ERR:E-SH-IR-RANGE"
    end if
  end if
  let result_type = result_type_json(receiver_kind)
  let checked_result = parameter_count
  let write_result = next_index(checked_result, n)
  let ok_read_result = next_index(write_result, n)
  let ok_project_result = next_index(ok_read_result, n)
  let error_read_result = next_index(ok_project_result, n)
  let error_project_result = next_index(error_read_result, n)
  let literal_result = next_index(error_project_result, n)
  let json = "{\"id\":"
  set json = sico.text.concat(json, sico.u64.to_text(function_ordinal))
  set json = sico.text.concat(json, ",\"name\":\"")
  set json = sico.text.concat(json, word_at(words, name_idx))
  set json = sico.text.concat(json, "\",\"parameters\":")
  set json = sico.text.concat(json, parameters_json)
  set json = sico.text.concat(json, ",\"return_type\":{\"kind\":\"")
  set json = sico.text.concat(json, return_kind)
  set json = sico.text.concat(json, "\"},\"effects\":[],\"locals\":[{\"name\":\"#match0\",\"ty\":")
  set json = sico.text.concat(json, result_type)
  set json = sico.text.concat(json, ",\"range\":{\"start\":")
  set json = sico.text.concat(json, sico.u64.to_text(match_start))
  set json = sico.text.concat(json, ",\"end\":")
  set json = sico.text.concat(json, sico.u64.to_text(match_end))
  set json = sico.text.concat(json, "}}],\"entry\":0,\"blocks\":[{\"id\":0,\"instructions\":[{\"result\":")
  set json = sico.text.concat(json, sico.u64.to_text(checked_result))
  set json = sico.text.concat(json, ",\"ty\":")
  set json = sico.text.concat(json, result_type)
  set json = sico.text.concat(json, ",\"operation\":{\"op\":\"")
  set json = sico.text.concat(json, checked_name)
  set json = sico.text.concat(json, "\",\"data\":{\"left\":")
  set json = sico.text.concat(json, sico.u64.to_text(left_value))
  set json = sico.text.concat(json, ",\"right\":")
  set json = sico.text.concat(json, sico.u64.to_text(right_value))
  set json = sico.text.concat(json, "}},\"range\":{\"start\":")
  set json = sico.text.concat(json, sico.u64.to_text(expression_start))
