  if is_word(word_at(words, sl_return_value_idx), word_at(words, sl_binding_idx)):
    let sl_binding_returned = I64.literal(1)
  else:
    return "ERR:E-SH-IR-UNRESOLVED"
  end if
  let sl_after_return = next_index(sl_return_end, body_end)
