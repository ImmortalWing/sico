end function

function straight_cell_function_ir(words: List[Text], src: Bytes, name_idx: U64, body_from: U64, body_end: U64, fn_start: U64, function_ordinal: U64, return_kind: Text, parameter_count: U64) returns Text:
  let scc_words_len = sico.list.length(words)
  let scc_cell_names = sico.text.split_lines("")
  let scc_cell_kinds = sico.text.split_lines("")
  let scc_cell_locals = sico.list.empty[U64]()
  let scc_cell_starts = sico.list.empty[U64]()
  let scc_cell_ends = sico.list.empty[U64]()
  let scc_cell_count = U64.literal(0)
  let scc_instructions = "["
  let scc_emitted = U64.literal(0)
  let scc_next_result = parameter_count
  let scc_cursor = fn_start
  let scc_body_idx = body_from
  while U64.less_than(scc_body_idx, body_end):
    if is_word(word_at(words, scc_body_idx), "let"):
      break
    end if
    if is_word(word_at(words, scc_body_idx), "set"):
      break
    end if
    set scc_body_idx = next_index(scc_body_idx, body_end)
  end while
  while U64.less_than(scc_body_idx, body_end):
    let scc_line_word = word_at(words, scc_body_idx)
    if is_word(scc_line_word, "let"):
      let scc_stmt_ok = I64.literal(1)
    else:
      if is_word(scc_line_word, "set"):
        let scc_stmt_ok2 = I64.literal(1)
      else:
        if is_word(scc_line_word, "<nl>"):
          set scc_body_idx = next_index(scc_body_idx, body_end)
          continue
        else:
          if is_word(scc_line_word, "return"):
            break
          else:
            return "ERR:E-SH-IR-STATEMENT"
          end if
        end if
      end if
    end if
    let scc_is_set = is_word(scc_line_word, "set")
    let scc_line_end = line_end(words, scc_body_idx)
    let scc_binding_idx = next_index(scc_body_idx, scc_line_end)
