  else:
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  let sl_operation = fixed_op_name(word_at(words, sl_op_idx))
  if U64.equal(sico.text.length(sl_operation), U64.literal(0)):
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  let sl_kind = ""
  if is_word(word_at(words, sl_receiver_idx), "I64"):
    set sl_kind = "i64"
  else:
    if is_word(word_at(words, sl_receiver_idx), "U64"):
      set sl_kind = "u64"
    else:
      return "ERR:E-SH-IR-EXPRESSION"
    end if
  end if
  if is_word(sl_kind, return_kind):
    let sl_return_type_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-TYPE-MISMATCH"
  end if
  let sl_close_idx = matching_close(words, sl_open_idx, sl_let_end)
  if U64.equal(next_index(sl_close_idx, sl_let_end), sl_let_end):
    let sl_expression_complete = I64.literal(1)
  else:
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  let sl_operand_check = fixed_operation_operand_check(words, sl_receiver_idx, sl_let_end, name_idx, sl_kind)
  if sico.text.starts_with(sl_operand_check, "ERR:"):
    return sl_operand_check
  end if
  let sl_return_idx = next_index(sl_let_end, body_end)
  while U64.less_than(sl_return_idx, body_end):
    if is_word(word_at(words, sl_return_idx), "<nl>"):
      set sl_return_idx = next_index(sl_return_idx, body_end)
    else:
      break
    end if
  end while
  if is_word(word_at(words, sl_return_idx), "return"):
    let sl_return_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-RETURN-COUNT"
  end if
  let sl_return_end = line_end(words, sl_return_idx)
  let sl_return_value_idx = next_index(sl_return_idx, sl_return_end)
  if U64.equal(next_index(sl_return_value_idx, sl_return_end), sl_return_end):
    let sl_single_return_value = I64.literal(1)
  else:
    return "ERR:E-SH-IR-STATEMENT"
