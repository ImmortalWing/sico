function checked_result_match_function_ir(words: List[Text], src: Bytes, name_idx: U64, function_ordinal: U64, fn_start: U64, body_from: U64, body_end_word: U64, parameters_json: Text, return_kind: Text) returns Text:
  let n = sico.list.length(words)
