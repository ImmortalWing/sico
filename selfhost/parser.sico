    set sfa_locals_json = sico.text.concat(sfa_locals_json, "\"},\"range\":{\"start\":")
    set sfa_locals_json = sico.text.concat(sfa_locals_json, sico.u64.to_text(u64_list_at(sif_cell_starts, sfa_local_idx, U64.literal(0))))
    set sfa_locals_json = sico.text.concat(sfa_locals_json, ",\"end\":")
    set sfa_locals_json = sico.text.concat(sfa_locals_json, sico.u64.to_text(u64_list_at(sif_cell_ends, sfa_local_idx, U64.literal(0))))
    set sfa_locals_json = sico.text.concat(sfa_locals_json, "}}")
    set sfa_local_idx = next_index(sfa_local_idx, sfa_local_idx)
  end while
  set sfa_locals_json = sico.text.concat(sfa_locals_json, "]")
  let sfa_is_ret = is_word(sif_form, "ret")
  if sfa_is_ret:
    if sif_has_else:
      let sfa_ret_else_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-STATEMENT"
    end if
    if sif_ret1_done:
      let sfa_ret1_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-STATEMENT"
    end if
    if sif_ret2_done:
      let sfa_ret2_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-STATEMENT"
    end if
    if U64.less_than(U64.literal(0), sif_em3):
      return "ERR:E-SH-IR-STATEMENT"
    end if
    if sif_final_done:
      return "ERR:E-SH-IR-STATEMENT"
    end if
  else:
    if sif_final_done:
      let sfa_final_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-RETURN-COUNT"
    end if
  end if
  let sfa_b0_head = "{\"id\":0,\"instructions\":["
  set sfa_b0_head = sico.text.concat(sfa_b0_head, sif_b0)
  set sfa_b0_head = sico.text.concat(sfa_b0_head, "],\"terminator\":{\"kind\":\"branch\",\"data\":{\"condition\":")
  set sfa_b0_head = sico.text.concat(sfa_b0_head, sico.u64.to_text(sif_cond_value))
  let sfa_blocks = ""
  if sfa_is_ret:
    set sfa_b0_head = sico.text.concat(sfa_b0_head, ",\"then_block\":1,\"else_block\":2}},\"range\":{\"start\":")
    set sfa_b0_head = sico.text.concat(sfa_b0_head, sico.u64.to_text(fn_start))
    set sfa_b0_head = sico.text.concat(sfa_b0_head, ",\"end\":")
    set sfa_b0_head = sico.text.concat(sfa_b0_head, sico.u64.to_text(sfa_fn_end))
    set sfa_b0_head = sico.text.concat(sfa_b0_head, "}}")
    let sfa_b1 = "{\"id\":1,\"instructions\":["
    set sfa_b1 = sico.text.concat(sfa_b1, sif_b1)
    set sfa_b1 = sico.text.concat(sfa_b1, "],\"terminator\":{\"kind\":\"return\",\"data\":")
    set sfa_b1 = sico.text.concat(sfa_b1, sico.u64.to_text(sif_ret1_value))
    set sfa_b1 = sico.text.concat(sfa_b1, "},\"range\":{\"start\":")
    set sfa_b1 = sico.text.concat(sfa_b1, sico.u64.to_text(sif_if_start))
    set sfa_b1 = sico.text.concat(sfa_b1, ",\"end\":")
    set sfa_b1 = sico.text.concat(sfa_b1, sico.u64.to_text(sif_if_end))
    set sfa_b1 = sico.text.concat(sfa_b1, "}}")
    let sfa_b2 = "{\"id\":2,\"instructions\":["
    set sfa_b2 = sico.text.concat(sfa_b2, sif_b2)
    set sfa_b2 = sico.text.concat(sfa_b2, "],\"terminator\":{\"kind\":\"return\",\"data\":")
    set sfa_b2 = sico.text.concat(sfa_b2, sico.u64.to_text(sif_ret2_value))
    set sfa_b2 = sico.text.concat(sfa_b2, "},\"range\":{\"start\":")
    set sfa_b2 = sico.text.concat(sfa_b2, sico.u64.to_text(sif_if_start))
    set sfa_b2 = sico.text.concat(sfa_b2, ",\"end\":")
    set sfa_b2 = sico.text.concat(sfa_b2, sico.u64.to_text(sif_if_end))
    set sfa_b2 = sico.text.concat(sfa_b2, "}}")
    let sfa_b3 = "{\"id\":3,\"instructions\":[],\"terminator\":{\"kind\":\"unreachable\"},\"range\":{\"start\":"
    set sfa_b3 = sico.text.concat(sfa_b3, sico.u64.to_text(sif_if_start))
    set sfa_b3 = sico.text.concat(sfa_b3, ",\"end\":")
    set sfa_b3 = sico.text.concat(sfa_b3, sico.u64.to_text(sif_if_end))
    set sfa_b3 = sico.text.concat(sfa_b3, "}}")
    set sfa_blocks = sico.text.concat(sfa_b0_head, sico.text.concat(",", sico.text.concat(sfa_b1, sico.text.concat(",", sico.text.concat(sfa_b2, sico.text.concat(",", sfa_b3))))))
  else:
    if sif_has_else:
      set sfa_b0_head = sico.text.concat(sfa_b0_head, ",\"then_block\":1,\"else_block\":2}},\"range\":{\"start\":")
      set sfa_b0_head = sico.text.concat(sfa_b0_head, sico.u64.to_text(fn_start))
      set sfa_b0_head = sico.text.concat(sfa_b0_head, ",\"end\":")
      set sfa_b0_head = sico.text.concat(sfa_b0_head, sico.u64.to_text(sfa_fn_end))
      set sfa_b0_head = sico.text.concat(sfa_b0_head, "}}")
      let sfa_j1 = "{\"id\":1,\"instructions\":["
      set sfa_j1 = sico.text.concat(sfa_j1, sif_b1)
      set sfa_j1 = sico.text.concat(sfa_j1, "],\"terminator\":{\"kind\":\"jump\",\"data\":3},\"range\":{\"start\":")
      set sfa_j1 = sico.text.concat(sfa_j1, sico.u64.to_text(sif_if_start))
      set sfa_j1 = sico.text.concat(sfa_j1, ",\"end\":")
      set sfa_j1 = sico.text.concat(sfa_j1, sico.u64.to_text(sif_if_end))
      set sfa_j1 = sico.text.concat(sfa_j1, "}}")
      let sfa_j2 = "{\"id\":2,\"instructions\":["
      set sfa_j2 = sico.text.concat(sfa_j2, sif_b2)
      set sfa_j2 = sico.text.concat(sfa_j2, "],\"terminator\":{\"kind\":\"jump\",\"data\":3},\"range\":{\"start\":")
      set sfa_j2 = sico.text.concat(sfa_j2, sico.u64.to_text(sif_if_start))
      set sfa_j2 = sico.text.concat(sfa_j2, ",\"end\":")
      set sfa_j2 = sico.text.concat(sfa_j2, sico.u64.to_text(sif_if_end))
      set sfa_j2 = sico.text.concat(sfa_j2, "}}")
      let sfa_j3 = "{\"id\":3,\"instructions\":["
      set sfa_j3 = sico.text.concat(sfa_j3, sif_b3)
      set sfa_j3 = sico.text.concat(sfa_j3, "],\"terminator\":{\"kind\":\"return\",\"data\":")
      set sfa_j3 = sico.text.concat(sfa_j3, sico.u64.to_text(sif_final_value))
      set sfa_j3 = sico.text.concat(sfa_j3, "},\"range\":{\"start\":")
      set sfa_j3 = sico.text.concat(sfa_j3, sico.u64.to_text(sif_if_start))
      set sfa_j3 = sico.text.concat(sfa_j3, ",\"end\":")
      set sfa_j3 = sico.text.concat(sfa_j3, sico.u64.to_text(sif_if_end))
      set sfa_j3 = sico.text.concat(sfa_j3, "}}")
      set sfa_blocks = sico.text.concat(sfa_b0_head, sico.text.concat(",", sico.text.concat(sfa_j1, sico.text.concat(",", sico.text.concat(sfa_j2, sico.text.concat(",", sfa_j3))))))
    else:
      set sfa_b0_head = sico.text.concat(sfa_b0_head, ",\"then_block\":1,\"else_block\":3}},\"range\":{\"start\":")
      set sfa_b0_head = sico.text.concat(sfa_b0_head, sico.u64.to_text(fn_start))
      set sfa_b0_head = sico.text.concat(sfa_b0_head, ",\"end\":")
      set sfa_b0_head = sico.text.concat(sfa_b0_head, sico.u64.to_text(sfa_fn_end))
      set sfa_b0_head = sico.text.concat(sfa_b0_head, "}}")
      let sfa_n1 = "{\"id\":1,\"instructions\":["
      set sfa_n1 = sico.text.concat(sfa_n1, sif_b1)
      set sfa_n1 = sico.text.concat(sfa_n1, "],\"terminator\":{\"kind\":\"jump\",\"data\":2},\"range\":{\"start\":")
      set sfa_n1 = sico.text.concat(sfa_n1, sico.u64.to_text(sif_if_start))
      set sfa_n1 = sico.text.concat(sfa_n1, ",\"end\":")
      set sfa_n1 = sico.text.concat(sfa_n1, sico.u64.to_text(sif_if_end))
      set sfa_n1 = sico.text.concat(sfa_n1, "}}")
      let sfa_n2 = "{\"id\":2,\"instructions\":["
      set sfa_n2 = sico.text.concat(sfa_n2, sif_b3)
      set sfa_n2 = sico.text.concat(sfa_n2, "],\"terminator\":{\"kind\":\"return\",\"data\":")
      set sfa_n2 = sico.text.concat(sfa_n2, sico.u64.to_text(sif_final_value))
      set sfa_n2 = sico.text.concat(sfa_n2, "},\"range\":{\"start\":")
      set sfa_n2 = sico.text.concat(sfa_n2, sico.u64.to_text(sif_if_start))
      set sfa_n2 = sico.text.concat(sfa_n2, ",\"end\":")
      set sfa_n2 = sico.text.concat(sfa_n2, sico.u64.to_text(sif_if_end))
      set sfa_n2 = sico.text.concat(sfa_n2, "}}")
      let sfa_n3 = "{\"id\":3,\"instructions\":["
      set sfa_n3 = sico.text.concat(sfa_n3, sif_b2)
      set sfa_n3 = sico.text.concat(sfa_n3, "],\"terminator\":{\"kind\":\"jump\",\"data\":2},\"range\":{\"start\":")
      set sfa_n3 = sico.text.concat(sfa_n3, sico.u64.to_text(sif_if_start))
      set sfa_n3 = sico.text.concat(sfa_n3, ",\"end\":")
      set sfa_n3 = sico.text.concat(sfa_n3, sico.u64.to_text(sif_if_end))
      set sfa_n3 = sico.text.concat(sfa_n3, "}}")
      set sfa_blocks = sico.text.concat(sfa_b0_head, sico.text.concat(",", sico.text.concat(sfa_n1, sico.text.concat(",", sico.text.concat(sfa_n2, sico.text.concat(",", sfa_n3))))))
    end if
  end if
  let sfa_json = "{\"id\":"
  set sfa_json = sico.text.concat(sfa_json, sico.u64.to_text(function_ordinal))
  set sfa_json = sico.text.concat(sfa_json, ",\"name\":\"")
  set sfa_json = sico.text.concat(sfa_json, word_at(words, name_idx))
  set sfa_json = sico.text.concat(sfa_json, "\",\"parameters\":")
  set sfa_json = sico.text.concat(sfa_json, sfa_parameters)
  set sfa_json = sico.text.concat(sfa_json, ",\"return_type\":{\"kind\":\"")
  set sfa_json = sico.text.concat(sfa_json, return_kind)
  set sfa_json = sico.text.concat(sfa_json, "\"},\"effects\":[]")
  if U64.less_than(U64.literal(0), sif_cell_count):
    set sfa_json = sico.text.concat(sfa_json, ",\"locals\":")
    set sfa_json = sico.text.concat(sfa_json, sfa_locals_json)
  end if
  set sfa_json = sico.text.concat(sfa_json, ",\"entry\":0,\"blocks\":[")
  set sfa_json = sico.text.concat(sfa_json, sfa_blocks)
  set sfa_json = sico.text.concat(sfa_json, "],\"range\":{\"start\":")
  set sfa_json = sico.text.concat(sfa_json, sico.u64.to_text(fn_start))
  set sfa_json = sico.text.concat(sfa_json, ",\"end\":")
  set sfa_json = sico.text.concat(sfa_json, sico.u64.to_text(sfa_fn_end))
  set sfa_json = sico.text.concat(sfa_json, "}}")
  return sfa_json
end function

function straight_cell_function_ir(words: List[Text], src: Bytes, name_idx: U64, body_from: U64, body_end: U64, fn_start: U64, function_ordinal: U64, return_kind: Text, parameter_count: U64) returns Text:
  let scc_words_len = sico.list.length(words)
  let scc_cell_names = sico.text.split_lines("")
  let scc_cell_kinds = sico.text.split_lines("")
  let scc_cell_locals = sico.list.empty[U64]()
  let scc_cell_starts = sico.list.empty[U64]()
  let scc_cell_ends = sico.list.empty[U64]()
  let scc_cell_count = U64.literal(0)
  let scc_instructions = "["
  let scc_emitted = U64.literal(0)
  let scc_next_result = parameter_count
  let scc_cursor = fn_start
  let scc_body_idx = body_from
  while U64.less_than(scc_body_idx, body_end):
    if is_word(word_at(words, scc_body_idx), "let"):
      break
    end if
    if is_word(word_at(words, scc_body_idx), "set"):
      break
    end if
    set scc_body_idx = next_index(scc_body_idx, body_end)
  end while
  while U64.less_than(scc_body_idx, body_end):
    let scc_line_word = word_at(words, scc_body_idx)
    if is_word(scc_line_word, "let"):
      let scc_stmt_ok = I64.literal(1)
    else:
      if is_word(scc_line_word, "set"):
        let scc_stmt_ok2 = I64.literal(1)
      else:
        if is_word(scc_line_word, "<nl>"):
          set scc_body_idx = next_index(scc_body_idx, body_end)
          continue
        else:
          if is_word(scc_line_word, "return"):
            break
          else:
            return "ERR:E-SH-IR-STATEMENT"
          end if
        end if
      end if
    end if
    let scc_is_set = is_word(scc_line_word, "set")
    let scc_line_end = line_end(words, scc_body_idx)
    let scc_binding_idx = next_index(scc_body_idx, scc_line_end)
    let scc_receiver_idx = next_index(scc_binding_idx, scc_line_end)
    let scc_binding = word_at(words, scc_binding_idx)
    let scc_keyword_offset = find_text_from(src, scc_line_word, scc_cursor)
    let scc_binding_offset = word_span_offset(words, src, scc_keyword_offset, scc_body_idx, scc_binding_idx)
    let scc_binding_end = scc_binding_offset
    match U64.checked_add(scc_binding_offset, sico.bytes.length(sico.text.encode(scc_binding))):
      case ok(scc_after_binding):
        set scc_binding_end = scc_after_binding
      case error(_):
        return "ERR:E-SH-IR-RANGE"
    end match
    let scc_expr_start = word_span_offset(words, src, scc_keyword_offset, scc_body_idx, scc_receiver_idx)
    let scc_line_end_offset = return_expression_end(src, scc_expr_start)
    if scc_is_set:
      let scc_set_cell = local_binding_index(scc_cell_names, scc_binding)
      if U64.less_than(scc_set_cell, sico.list.length(scc_cell_names)):
        let scc_set_ok = I64.literal(1)
      else:
        return "ERR:E-SH-IR-SET-CELL"
      end if
    else:
      let scc_shadowed_parameter = binding_parameter_index(words, name_idx, scc_binding)
      if U64.less_than(scc_shadowed_parameter, parameter_count):
        return "ERR:E-SH-IR-CELL-SHADOW"
      end if
      if U64.less_than(local_binding_index(scc_cell_names, scc_binding), sico.list.length(scc_cell_names)):
        return "ERR:E-SH-IR-CELL-REDEFINED"
      end if
    end if
    let scc_rhs_multi = U64.less_than(next_index(scc_receiver_idx, scc_line_end), scc_line_end)
    let scc_rhs_instrs = ""
    let scc_rhs_count = U64.literal(0)
    let scc_rhs_value = scc_next_result
    let scc_rhs_kind = ""
    if scc_rhs_multi:
      let scc_rhs_second_idx = next_index(scc_receiver_idx, scc_line_end)
      if is_word(word_at(words, scc_rhs_second_idx), "."):
        let scc_rhs_third_idx = next_index(scc_rhs_second_idx, scc_line_end)
        if is_word(word_at(words, scc_rhs_third_idx), "literal"):
          let scc_rhs_literal = fixed_literal_const_instruction(words, src, scc_receiver_idx, scc_line_end, scc_receiver_idx, scc_expr_start, scc_next_result)
          if sico.text.starts_with(scc_rhs_literal, "ERR:"):
            return scc_rhs_literal
          end if
          set scc_rhs_instrs = scc_rhs_literal
          set scc_rhs_count = U64.literal(1)
          if is_word(word_at(words, scc_receiver_idx), "I64"):
            set scc_rhs_kind = "i64"
          else:
            set scc_rhs_kind = "u64"
          end if
        else:
          let sco_op = fixed_op_name(word_at(words, scc_rhs_third_idx))
          if U64.equal(sico.text.length(sco_op), U64.literal(0)):
            return "ERR:E-SH-IR-EXPRESSION"
          end if
          let sco_open_idx = next_index(scc_rhs_third_idx, scc_line_end)
          if is_word(word_at(words, sco_open_idx), "("):
            let sco_open_ok = I64.literal(1)
          else:
            return "ERR:E-SH-IR-EXPRESSION"
          end if
          let sco_kind = ""
          if is_word(word_at(words, scc_receiver_idx), "I64"):
            set sco_kind = "i64"
          else:
            if is_word(word_at(words, scc_receiver_idx), "U64"):
              set sco_kind = "u64"
            else:
