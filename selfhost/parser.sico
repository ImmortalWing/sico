  set sl_instructions = sico.text.concat(sl_instructions, sico.u64.to_text(sl_right))
  set sl_instructions = sico.text.concat(sl_instructions, "}},\"range\":{\"start\":")
  set sl_instructions = sico.text.concat(sl_instructions, sico.u64.to_text(sl_expression_start))
  set sl_instructions = sico.text.concat(sl_instructions, ",\"end\":")
  set sl_instructions = sico.text.concat(sl_instructions, sico.u64.to_text(sl_expression_end))
  set sl_instructions = sico.text.concat(sl_instructions, "}}]")
  let sl_json = "{\"id\":"
  set sl_json = sico.text.concat(sl_json, sico.u64.to_text(function_ordinal))
  set sl_json = sico.text.concat(sl_json, ",\"name\":\"")
  set sl_json = sico.text.concat(sl_json, word_at(words, name_idx))
  set sl_json = sico.text.concat(sl_json, "\",\"parameters\":")
  set sl_json = sico.text.concat(sl_json, sl_parameters)
  set sl_json = sico.text.concat(sl_json, ",\"return_type\":{\"kind\":\"")
  set sl_json = sico.text.concat(sl_json, return_kind)
  set sl_json = sico.text.concat(sl_json, "\"},\"effects\":[],\"entry\":0,\"blocks\":[{\"id\":0,\"instructions\":")
  set sl_json = sico.text.concat(sl_json, sl_instructions)
  set sl_json = sico.text.concat(sl_json, ",\"terminator\":{\"kind\":\"return\",\"data\":")
  set sl_json = sico.text.concat(sl_json, sico.u64.to_text(sl_result))
  set sl_json = sico.text.concat(sl_json, "},\"range\":{\"start\":")
