  set json = sico.text.concat(json, sico.u64.to_text(match_colon_start))
  set json = sico.text.concat(json, "}},{\"result\":")
  set json = sico.text.concat(json, sico.u64.to_text(write_result))
  set json = sico.text.concat(json, ",\"ty\":{\"kind\":\"unit\"},\"operation\":{\"op\":\"write_local\",\"data\":{\"local\":0,\"value\":")
  set json = sico.text.concat(json, sico.u64.to_text(checked_result))
  set json = sico.text.concat(json, "}},\"range\":{\"start\":")
  set json = sico.text.concat(json, sico.u64.to_text(match_start))
  set json = sico.text.concat(json, ",\"end\":")
  set json = sico.text.concat(json, sico.u64.to_text(match_end))
  set json = sico.text.concat(json, "}}],\"terminator\":{\"kind\":\"match\",\"data\":{\"values\":[")
  set json = sico.text.concat(json, sico.u64.to_text(checked_result))
  set json = sico.text.concat(json, "],\"arms\":[{\"patterns\":[{\"kind\":\"variant\",\"data\":{\"name\":\"ok\",\"payload\":[{\"kind\":\"binding\",\"data\":\"")
  set json = sico.text.concat(json, ok_binding)
  set json = sico.text.concat(json, "\"}]}}],\"target\":1,\"range\":{\"start\":")
  set json = sico.text.concat(json, sico.u64.to_text(ok_case_start))
  set json = sico.text.concat(json, ",\"end\":")
  set json = sico.text.concat(json, sico.u64.to_text(ok_case_end))
  set json = sico.text.concat(json, "}},{\"patterns\":[{\"kind\":\"variant\",\"data\":{\"name\":\"error\",\"payload\":[{\"kind\":\"binding\",\"data\":\"")
  set json = sico.text.concat(json, word_at(words, error_binding_idx))
  set json = sico.text.concat(json, "\"}]}}],\"target\":2,\"range\":{\"start\":")
  set json = sico.text.concat(json, sico.u64.to_text(error_case_start))
  set json = sico.text.concat(json, ",\"end\":")
  set json = sico.text.concat(json, sico.u64.to_text(error_case_end))
  set json = sico.text.concat(json, "}}]}},\"range\":{\"start\":")
  set json = sico.text.concat(json, sico.u64.to_text(match_start))
  set json = sico.text.concat(json, ",\"end\":")
  set json = sico.text.concat(json, sico.u64.to_text(match_end))
  set json = sico.text.concat(json, "}},{\"id\":1,\"instructions\":[{\"result\":")
  set json = sico.text.concat(json, sico.u64.to_text(ok_read_result))
  set json = sico.text.concat(json, ",\"ty\":")
