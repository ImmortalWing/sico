  let operand_instruction_count = argument_region_instruction_count(words, left, close, name_idx)
  let operand_json = argument_instructions(words, src, receiver, receiver_start, left, close, name_idx, parameter_count)
  let subject = parameter_count
  match U64.checked_add(parameter_count, operand_instruction_count):
    case ok(after_operands):
      set subject = after_operands
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  let write = next_index(subject, subject)
  let read = next_index(write, write)
  let project = next_index(read, read)
  let error_value = next_index(project, project)
  if I64.equal(fallback_is_parameter, I64.literal(1)):
    set error_value = fallback_parameter
  end if
  let result_type = "{\"kind\":\"result\",\"data\":{\"ok\":{\"kind\":\""
  set result_type = sico.text.concat(result_type, kind)
  set result_type = sico.text.concat(result_type, "\"},\"error\":{\"kind\":\"named\",\"data\":\"NumericError\"}}}")
  let out = "{\"id\":"
  set out = sico.text.concat(out, sico.u64.to_text(function_ordinal))
  set out = sico.text.concat(out, ",\"name\":\"")
  set out = sico.text.concat(out, word_at(words, name_idx))
  set out = sico.text.concat(out, "\",\"parameters\":")
  set out = sico.text.concat(out, parameters)
  set out = sico.text.concat(out, ",\"return_type\":{\"kind\":\"")
  set out = sico.text.concat(out, kind)
  set out = sico.text.concat(out, "\"},\"effects\":[],\"locals\":[{\"name\":\"#match0\",\"ty\":")
  set out = sico.text.concat(out, result_type)
  set out = sico.text.concat(out, ",\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(match_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(match_end))
  set out = sico.text.concat(out, "}}],\"entry\":0,\"blocks\":[{\"id\":0,\"instructions\":[")
  if U64.less_than(U64.literal(0), sico.text.length(operand_json)):
    set out = sico.text.concat(out, operand_json)
    set out = sico.text.concat(out, ",")
  end if
  set out = sico.text.concat(out, "{\"result\":")
  set out = sico.text.concat(out, sico.u64.to_text(subject))
  set out = sico.text.concat(out, ",\"ty\":")
  set out = sico.text.concat(out, result_type)
  set out = sico.text.concat(out, ",\"operation\":{\"op\":\"")
  set out = sico.text.concat(out, operation_name)
  set out = sico.text.concat(out, "\",\"data\":{\"left\":")
  set out = sico.text.concat(out, sico.u64.to_text(left_value))
  set out = sico.text.concat(out, ",\"right\":")
  set out = sico.text.concat(out, sico.u64.to_text(right_value))
  set out = sico.text.concat(out, "}},\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(receiver_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(operation_end))
  set out = sico.text.concat(out, "}},{\"result\":")
  set out = sico.text.concat(out, sico.u64.to_text(write))
  set out = sico.text.concat(out, ",\"ty\":{\"kind\":\"unit\"},\"operation\":{\"op\":\"write_local\",\"data\":{\"local\":0,\"value\":")
  set out = sico.text.concat(out, sico.u64.to_text(subject))
  set out = sico.text.concat(out, "}},\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(match_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(match_end))
  set out = sico.text.concat(out, "}}],\"terminator\":{\"kind\":\"match\",\"data\":{\"values\":[")
  set out = sico.text.concat(out, sico.u64.to_text(subject))
  set out = sico.text.concat(out, "],\"arms\":[{\"patterns\":[{\"kind\":\"variant\",\"data\":{\"name\":\"ok\",\"payload\":[{\"kind\":\"binding\",\"data\":\"")
  set out = sico.text.concat(out, binding_name)
  set out = sico.text.concat(out, "\"}]}}],\"target\":1,\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(ok_case_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(ok_case_end))
  set out = sico.text.concat(out, "}},{\"patterns\":[{\"kind\":\"variant\",\"data\":{\"name\":\"error\",\"payload\":[{\"kind\":\"wildcard\"}]}}],\"target\":2,\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(error_case_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(error_case_end))
  set out = sico.text.concat(out, "}}]}},\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(match_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(match_end))
  set out = sico.text.concat(out, "}},{\"id\":1,\"instructions\":[{\"result\":")
  set out = sico.text.concat(out, sico.u64.to_text(read))
  set out = sico.text.concat(out, ",\"ty\":")
  set out = sico.text.concat(out, result_type)
  set out = sico.text.concat(out, ",\"operation\":{\"op\":\"read_local\",\"data\":{\"local\":0}},\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(ok_case_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(ok_case_end))
  set out = sico.text.concat(out, "}},{\"result\":")
  set out = sico.text.concat(out, sico.u64.to_text(project))
  set out = sico.text.concat(out, ",\"ty\":{\"kind\":\"")
  set out = sico.text.concat(out, kind)
  set out = sico.text.concat(out, "\"},\"operation\":{\"op\":\"project\",\"data\":{\"base\":")
  set out = sico.text.concat(out, sico.u64.to_text(read))
  set out = sico.text.concat(out, ",\"field\":\"ok\"}},\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(ok_case_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(ok_case_end))
  set out = sico.text.concat(out, "}}],\"terminator\":{\"kind\":\"return\",\"data\":")
  set out = sico.text.concat(out, sico.u64.to_text(project))
  set out = sico.text.concat(out, "},\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(ok_case_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(ok_value_end))
  set out = sico.text.concat(out, "}},{\"id\":2,\"instructions\":")
  if I64.equal(fallback_is_parameter, I64.literal(1)):
    set out = sico.text.concat(out, "[]")
  else:
    set out = sico.text.concat(out, "[{\"result\":")
    set out = sico.text.concat(out, sico.u64.to_text(error_value))
    set out = sico.text.concat(out, ",\"ty\":{\"kind\":\"")
    set out = sico.text.concat(out, kind)
    set out = sico.text.concat(out, "\"},\"operation\":{\"op\":\"const_")
    set out = sico.text.concat(out, kind)
    set out = sico.text.concat(out, "\",\"data\":0},\"range\":{\"start\":")
    set out = sico.text.concat(out, sico.u64.to_text(zero_start))
    set out = sico.text.concat(out, ",\"end\":")
    set out = sico.text.concat(out, sico.u64.to_text(zero_end))
    set out = sico.text.concat(out, "}}]")
  end if
  set out = sico.text.concat(out, ",\"terminator\":{\"kind\":\"return\",\"data\":")
  set out = sico.text.concat(out, sico.u64.to_text(error_value))
  set out = sico.text.concat(out, "},\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(error_case_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(error_block_end))
  set out = sico.text.concat(out, "}}],\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(fn_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(fn_end))
  set out = sico.text.concat(out, "}}")
  return out
end function

function list_get_match_ir(words: List[Text], src: Bytes, name_idx: U64, body_from: U64, body_end: U64, fn_start: U64, function_ordinal: U64, return_kind: Text, parameter_count: U64) returns Text:
  let n = sico.list.length(words)
  if U64.equal(parameter_count, U64.literal(2)):
    let lgm_arity_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  let m = body_from
  while U64.less_than(m, body_end):
    if is_word(word_at(words, m), "match"):
      break
    end if
    set m = next_index(m, body_end)
  end while
  let lgm_receiver = next_index(m, n)
  let lgm_dot1 = next_index(lgm_receiver, n)
  let lgm_list_seg = next_index(lgm_dot1, n)
  let lgm_dot2 = next_index(lgm_list_seg, n)
  let lgm_get_seg = next_index(lgm_dot2, n)
  let lgm_open = next_index(lgm_get_seg, n)
  let lgm_left = next_index(lgm_open, n)
  let lgm_match_line_end = line_end(words, m)
  let lgm_close = matching_close(words, lgm_open, lgm_match_line_end)
  let lgm_comma = lgm_close
  let lgm_operand_scan = lgm_left
  while U64.less_than(lgm_operand_scan, lgm_close):
    if is_word(word_at(words, lgm_operand_scan), "("):
      set lgm_operand_scan = next_index(matching_close(words, lgm_operand_scan, lgm_close), lgm_close)
    else:
      if is_word(word_at(words, lgm_operand_scan), ","):
        set lgm_comma = lgm_operand_scan
        set lgm_operand_scan = lgm_close
      else:
        set lgm_operand_scan = next_index(lgm_operand_scan, lgm_close)
      end if
    end if
  end while
  let lgm_right = next_index(lgm_comma, n)
  let lgm_colon = next_index(lgm_close, n)
  let lgm_ok_case = next_index(line_end(words, m), n)
  let lgm_ok_name = next_index(lgm_ok_case, n)
  let lgm_ok_open = next_index(lgm_ok_name, n)
  let lgm_binding = next_index(lgm_ok_open, n)
  let lgm_ok_close = next_index(lgm_binding, n)
  let lgm_ok_colon = next_index(lgm_ok_close, n)
  let lgm_ok_return = next_index(line_end(words, lgm_ok_case), n)
  let lgm_ok_value = next_index(lgm_ok_return, n)
  let lgm_error_case = next_index(line_end(words, lgm_ok_return), n)
  let lgm_error_name = next_index(lgm_error_case, n)
  let lgm_error_open = next_index(lgm_error_name, n)
  let lgm_wildcard = next_index(lgm_error_open, n)
  let lgm_error_close = next_index(lgm_wildcard, n)
  let lgm_error_colon = next_index(lgm_error_close, n)
  let lgm_error_return = next_index(line_end(words, lgm_error_case), n)
  let lgm_literal = next_index(lgm_error_return, n)
  let lgm_end_word = next_index(line_end(words, lgm_error_return), n)
  let lgm_end_match = next_index(lgm_end_word, n)
  let lgm_after_match_line = next_index(line_end(words, lgm_end_word), n)
  let lgm_after_end_word = next_index(lgm_after_match_line, n)
  let lgm_after_function_word = next_index(lgm_after_end_word, n)
  if U64.equal(lgm_after_function_word, body_end):
    let lgm_complete = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, lgm_receiver), "sico"):
    let lgm_receiver_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TARGET"
  end if
  if is_word(word_at(words, lgm_dot1), "."):
    let lgm_dot1_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TARGET"
  end if
  if is_word(word_at(words, lgm_list_seg), "list"):
    let lgm_list_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TARGET"
  end if
  if is_word(word_at(words, lgm_dot2), "."):
    let lgm_dot2_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TARGET"
  end if
  if is_word(word_at(words, lgm_get_seg), "get"):
    let lgm_get_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TARGET"
  end if
  if is_word(word_at(words, lgm_open), "("):
