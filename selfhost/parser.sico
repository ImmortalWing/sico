        set sif_next = next_index(sif_next, sif_next)
      end if
      if U64.equal(sif_target, U64.literal(1)):
        set sif_ret1_done = true
        set sif_ret1_value = swr_value
      else:
        if U64.equal(sif_target, U64.literal(2)):
          set sif_ret2_done = true
          set sif_ret2_value = swr_value
        else:
          set sif_final_done = true
          set sif_final_value = swr_value
        end if
      end if
      set sif_cursor = return_expression_end(src, swr_start)
      set sif_idx = next_index(swr_line_end, body_end)
      while U64.less_than(sif_idx, body_end):
        if is_word(word_at(words, sif_idx), "<nl>"):
          set sif_idx = next_index(sif_idx, body_end)
        else:
          break
        end if
      end while
      continue
    end if
    if is_word(swk_word, "else"):
      if U64.equal(sif_target, U64.literal(1)):
        set sif_target = U64.literal(2)
        set sif_has_else = true
        set sif_cursor = return_expression_end(src, find_text_from(src, "else", sif_cursor))
        set sif_idx = next_index(line_end(words, sif_idx), body_end)
        while U64.less_than(sif_idx, body_end):
          if is_word(word_at(words, sif_idx), "<nl>"):
            set sif_idx = next_index(sif_idx, body_end)
          else:
            break
          end if
        end while
        continue
      else:
        return "ERR:E-SH-IR-STATEMENT"
      end if
    end if
    if is_word(swk_word, "end"):
      let swk_end_word = word_at(words, next_index(sif_idx, body_end))
      if is_word(swk_end_word, "function"):
        break
      end if
      if is_word(swk_end_word, "if"):
        if U64.equal(sif_target, U64.literal(1)):
          if is_word(sif_form, "ret"):
            return "ERR:E-SH-IR-STATEMENT"
          end if
          set sif_target = U64.literal(3)
        else:
          if U64.equal(sif_target, U64.literal(2)):
            set sif_target = U64.literal(3)
          else:
            return "ERR:E-SH-IR-STATEMENT"
          end if
        end if
        set sif_cursor = return_expression_end(src, find_text_from(src, "end if", sif_cursor))
        set sif_idx = next_index(line_end(words, sif_idx), body_end)
        while U64.less_than(sif_idx, body_end):
          if is_word(word_at(words, sif_idx), "<nl>"):
            set sif_idx = next_index(sif_idx, body_end)
          else:
            break
          end if
        end while
        continue
      end if
      return "ERR:E-SH-IR-STATEMENT"
    end if
    return "ERR:E-SH-IR-STATEMENT"
  end while
  let sfa_end_offset = find_text_from(src, "end function", fn_start)
  let sfa_fn_end = fn_start
  match U64.checked_add(sfa_end_offset, U64.literal(13)):
    case ok(sfa_after_end):
      set sfa_fn_end = sfa_after_end
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  if U64.less_than(sico.bytes.length(src), sfa_fn_end):
    set sfa_fn_end = sico.bytes.length(src)
  end if
  let sfa_parameters = parameters_ir(words, name_idx, src, fn_start)
  if sico.text.starts_with(sfa_parameters, "ERR:"):
    return sfa_parameters
  end if
  let sfa_locals_json = "["
  let sfa_local_idx = U64.literal(0)
  while U64.less_than(sfa_local_idx, sico.list.length(sif_cell_names)):
    if U64.less_than(U64.literal(0), sfa_local_idx):
      set sfa_locals_json = sico.text.concat(sfa_locals_json, ",")
    end if
    set sfa_locals_json = sico.text.concat(sfa_locals_json, "{\"name\":\"")
