            set instructions_json = sico.text.concat(instructions_json, ",\"end\":")
            set instructions_json = sico.text.concat(instructions_json, range_end_text)
            set instructions_json = sico.text.concat(instructions_json, "}}]")
          else:
            if is_word(expression_kind, "const_u64"):
