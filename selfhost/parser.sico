  set json = sico.text.concat(json, ",\"end\":")
  set json = sico.text.concat(json, sico.u64.to_text(ok_case_end))
  set json = sico.text.concat(json, "}}],\"terminator\":{\"kind\":\"return\",\"data\":")
  set json = sico.text.concat(json, sico.u64.to_text(ok_project_result))
  set json = sico.text.concat(json, "},\"range\":{\"start\":")
  set json = sico.text.concat(json, sico.u64.to_text(ok_case_start))
  set json = sico.text.concat(json, ",\"end\":")
  set json = sico.text.concat(json, sico.u64.to_text(ok_block_end))
  set json = sico.text.concat(json, "}},{\"id\":2,\"instructions\":[{\"result\":")
  set json = sico.text.concat(json, sico.u64.to_text(error_read_result))
  set json = sico.text.concat(json, ",\"ty\":")
  set json = sico.text.concat(json, result_type)
  set json = sico.text.concat(json, ",\"operation\":{\"op\":\"read_local\",\"data\":{\"local\":0}},\"range\":{\"start\":")
  set json = sico.text.concat(json, sico.u64.to_text(error_case_start))
  set json = sico.text.concat(json, ",\"end\":")
  set json = sico.text.concat(json, sico.u64.to_text(error_case_end))
  set json = sico.text.concat(json, "}},{\"result\":")
  set json = sico.text.concat(json, sico.u64.to_text(error_project_result))
  set json = sico.text.concat(json, ",\"ty\":{\"kind\":\"named\",\"data\":\"NumericError\"},\"operation\":{\"op\":\"project\",\"data\":{\"base\":")
  set json = sico.text.concat(json, sico.u64.to_text(error_read_result))
  set json = sico.text.concat(json, ",\"field\":\"error\"}},\"range\":{\"start\":")
  set json = sico.text.concat(json, sico.u64.to_text(error_case_start))
  set json = sico.text.concat(json, ",\"end\":")
  set json = sico.text.concat(json, sico.u64.to_text(error_case_end))
  set json = sico.text.concat(json, "}},{\"result\":")
  set json = sico.text.concat(json, sico.u64.to_text(literal_result))
  set json = sico.text.concat(json, ",\"ty\":{\"kind\":\"")
  set json = sico.text.concat(json, receiver_kind)
  set json = sico.text.concat(json, "\"},\"operation\":{\"op\":\"const_")
  set json = sico.text.concat(json, receiver_kind)
  set json = sico.text.concat(json, "\",\"data\":")
  set json = sico.text.concat(json, magnitude)
  set json = sico.text.concat(json, "},\"range\":{\"start\":")
  set json = sico.text.concat(json, sico.u64.to_text(literal_start))
  set json = sico.text.concat(json, ",\"end\":")
  set json = sico.text.concat(json, sico.u64.to_text(literal_end))
  set json = sico.text.concat(json, "}}],\"terminator\":{\"kind\":\"return\",\"data\":")
  set json = sico.text.concat(json, sico.u64.to_text(literal_result))
  set json = sico.text.concat(json, "},\"range\":{\"start\":")
  set json = sico.text.concat(json, sico.u64.to_text(error_case_start))
  set json = sico.text.concat(json, ",\"end\":")
  set json = sico.text.concat(json, sico.u64.to_text(error_block_end))
  set json = sico.text.concat(json, "}}],\"range\":{\"start\":")
  set json = sico.text.concat(json, sico.u64.to_text(fn_start))
  set json = sico.text.concat(json, ",\"end\":")
  set json = sico.text.concat(json, sico.u64.to_text(fn_end))
  set json = sico.text.concat(json, "}}")
  return json
end function

function scalar_ir(words: List[Text], src: Bytes) returns Text:
  let source_len = sico.bytes.length(src)
  let n = sico.list.length(words)
  if U64.equal(n, U64.literal(1)):
    if is_word(word_at(words, U64.literal(0)), "ERR-string-escape"):
      return "ERR:E-SH-IR-STRING-ESCAPE"
    end if
    if is_word(word_at(words, U64.literal(0)), "ERR-string"):
      return "ERR:E-SH-IR-STRING-UNCLOSED"
    end if
  end if
  let i = U64.literal(0)
  let prev = ""
  let function_count = U64.literal(0)
  let functions_json = ""
  let source_cursor = U64.literal(0)
  while U64.less_than(i, n):
    let token = word_at(words, i)
    if is_word(token, "function"):
      if is_declaration_start(prev):
        set function_count = next_index(function_count, function_count)
        let name_idx = next_index(i, n)
        if U64.equal(name_idx, n):
          return "ERR:E-SH-IR-FUNCTION-NAME"
        end if
        let function_name = word_at(words, name_idx)
        if U64.equal(function_declaration_index(words, function_name), name_idx):
          let first_definition_ok = I64.literal(1)
        else:
          return "ERR:E-SH-IR-FUNCTION-DUPLICATE"
        end if
        let function_ordinal = function_count
        let fn_start = find_text_from(src, "function", source_cursor)
        let parameter_count = count_params(words, name_idx)
        let body_from = next_index(name_idx, n)
        let return_type_kind = declared_return_kind(words, body_from)
        let body_end_word = find_body_end(words, body_from)
        if U64.less_than(U64.literal(0), count_until_end_function(words, body_from, "match")):
          let match_parameters_json = parameters_ir(words, name_idx, src, fn_start)
          if sico.text.starts_with(match_parameters_json, "ERR:"):
            return match_parameters_json
          end if
          let match_function_json = checked_result_match_function_ir(words, src, name_idx, function_ordinal, fn_start, body_from, body_end_word, match_parameters_json, return_type_kind)
          if sico.text.starts_with(match_function_json, "ERR:"):
            return match_function_json
          end if
          if is_word(match_function_json, "NO"):
            return "ERR:E-SH-IR-CONTROL"
          end if
          if U64.less_than(U64.literal(1), function_count):
            set functions_json = sico.text.concat(functions_json, ",")
          end if
          set functions_json = sico.text.concat(functions_json, match_function_json)
          let match_end_function_offset = find_text_from(src, "end function", fn_start)
          set source_cursor = index_plus(match_end_function_offset, U64.literal(13), source_len)
          set i = body_end_word
          set prev = "function"
          continue
        end if
        if U64.less_than(U64.literal(0), count_until_end_function(words, body_from, "for")):
          return "ERR:E-SH-IR-CONTROL"
        end if
        let gsf_route = U64.literal(0)
        if U64.less_than(U64.literal(0), count_until_end_function(words, body_from, "set")):
          set gsf_route = U64.literal(1)
        end if
        if U64.less_than(U64.literal(0), count_until_end_function(words, body_from, "if")):
          set gsf_route = U64.literal(1)
        end if
        if U64.less_than(U64.literal(0), count_until_end_function(words, body_from, "while")):
          set gsf_route = U64.literal(1)
        end if
        if U64.less_than(U64.literal(0), count_until_end_function(words, body_from, "break")):
          set gsf_route = U64.literal(1)
        end if
        if U64.less_than(U64.literal(0), count_until_end_function(words, body_from, "continue")):
          set gsf_route = U64.literal(1)
        end if
        if U64.equal(gsf_route, U64.literal(1)):
          let set_parameters_json = parameters_ir(words, name_idx, src, fn_start)
          if sico.text.starts_with(set_parameters_json, "ERR:"):
            return set_parameters_json
          end if
          let set_function_json = general_straight_function_ir(words, src, i, fn_start, name_idx, function_ordinal, body_from, body_end_word, set_parameters_json, return_type_kind, parameter_count)
          if sico.text.starts_with(set_function_json, "ERR:"):
            return set_function_json
          end if
          if U64.less_than(U64.literal(1), function_count):
            set functions_json = sico.text.concat(functions_json, ",")
          end if
          set functions_json = sico.text.concat(functions_json, set_function_json)
          let set_end_function_offset = find_text_from(src, "end function", fn_start)
          set source_cursor = index_plus(set_end_function_offset, U64.literal(13), source_len)
          set i = body_end_word
          set prev = "function"
          continue
        end if
        let straight_let_count = count_until_end_function(words, body_from, "let")
        let straight_let_instruction_count = fixed_let_count_between(words, body_from, body_end_word)
        let straight_let_json = fixed_let_instructions(words, src, body_from, body_end_word, fn_start, parameter_count)
        if sico.text.starts_with(straight_let_json, "ERR:"):
          return straight_let_json
        end if
        let operation_constant_base = parameter_count
        match U64.checked_add(parameter_count, straight_let_instruction_count):
          case ok(after_straight_lets):
            set operation_constant_base = after_straight_lets
          case error(_):
            return "ERR:E-SH-IR-RANGE"
        end match
        let return_seen = U64.literal(0)
        let literal = ""
        let expression_kind = ""
        let expression_type = ""
        let string_value = ""
        let call_arguments_json = ""
        let call_range = I64.literal(0)
        let range_lexeme = ""
        let range_prefix = U64.literal(0)
        let call_target_idx = n
        let call_constant_count = U64.literal(0)
        let call_constants_json = ""
        let fixed_op_name_value = ""
        let fixed_op_left = n
        let fixed_op_right = n
        let op_constant_count = U64.literal(0)
        let op_constants_json = ""
        let binding_value = n
        let body_i = body_from
        while U64.less_than(body_i, body_end_word):
          let body_token = word_at(words, body_i)
          if is_word(body_token, "return"):
            set return_seen = next_index(return_seen, return_seen)
            if U64.less_than(U64.literal(1), return_seen):
              return "ERR:E-SH-IR-RETURN-COUNT"
            end if
            let start = next_index(body_i, n)
            let finish = line_end(words, start)
            let after_first = next_index(start, finish)
      if U64.equal(after_first, finish):
        let positive_magnitude = word_at(words, start)
        if is_canonical_magnitude(positive_magnitude):
          set literal = positive_magnitude
          set range_lexeme = positive_magnitude
          set expression_kind = "const_int"
          set expression_type = "int"
        else:
          if is_word(positive_magnitude, "true"):
            set literal = positive_magnitude
            set range_lexeme = positive_magnitude
            set expression_kind = "const_bool"
            set expression_type = "bool"
          else:
            if is_word(positive_magnitude, "false"):
              set literal = positive_magnitude
              set range_lexeme = positive_magnitude
              set expression_kind = "const_bool"
              set expression_type = "bool"
            else:
              if is_string_token(positive_magnitude):
                set literal = positive_magnitude
                set range_lexeme = positive_magnitude
                set string_value = json_string_token(positive_magnitude)
                set expression_kind = "const_string"
                set expression_type = "string"
              else:
                let resolved_binding_value = binding_parameter_index(words, name_idx, positive_magnitude)
                if U64.less_than(resolved_binding_value, parameter_count):
                  let resolved_binding_kind = binding_parameter_kind(words, name_idx, positive_magnitude)
                  if sico.text.starts_with(resolved_binding_kind, "ERR:"):
                    return resolved_binding_kind
                  end if
                  set binding_value = resolved_binding_value
                  set literal = positive_magnitude
                  set range_lexeme = positive_magnitude
                  set expression_kind = "binding"
                  set expression_type = resolved_binding_kind
                else:
                  let resolved_let_value = fixed_let_binding_id(words, body_from, body_end_word, positive_magnitude, parameter_count)
                  if U64.less_than(resolved_let_value, n):
                    let resolved_let_kind = fixed_let_binding_kind(words, body_from, body_end_word, positive_magnitude)
                    if U64.equal(sico.text.length(resolved_let_kind), U64.literal(0)):
                      return "ERR:E-SH-IR-UNRESOLVED"
                    end if
                    set binding_value = resolved_let_value
                    set literal = positive_magnitude
                    set range_lexeme = positive_magnitude
                    set expression_kind = "binding"
                    set expression_type = resolved_let_kind
                  else:
                    return "ERR:E-SH-IR-UNRESOLVED"
                  end if
                end if
              end if
            end if
          end if
        end if
      else:
        if is_word(word_at(words, next_index(start, finish)), "("):
          let callee_name = word_at(words, start)
          let callee_name_idx = function_declaration_index(words, callee_name)
          if U64.equal(callee_name_idx, n):
            return "ERR:E-SH-IR-CALL-TARGET"
          end if
                let callee_return_kind = declared_return_kind(words, next_index(callee_name_idx, n))
                let call_close_idx = matching_close(words, next_index(start, finish), finish)
                let call_args_start = next_index(next_index(start, finish), finish)
                let resolved_call_arguments = argument_values(words, call_args_start, call_close_idx, name_idx, callee_name_idx)
                if sico.text.starts_with(resolved_call_arguments, "ERR:"):
                  return resolved_call_arguments
                end if
                set call_arguments_json = resolved_call_arguments
                set call_target_idx = callee_name_idx
                set expression_kind = "call"
                set expression_type = callee_return_kind
                set call_range = I64.literal(1)
                set call_constant_count = argument_region_instruction_count(words, call_args_start, call_close_idx, name_idx)
                set call_constants_json = argument_instructions(words, src, start, return_expression_start(src, fn_start), call_args_start, call_close_idx, name_idx, operation_constant_base)
        else:
          let op_name = fixed_op_name(word_at(words, next_index(next_index(start, finish), finish)))
          let op_receiver_kind = ""
          if is_word(word_at(words, start), "I64"):
            set op_receiver_kind = "i64"
          else:
            if is_word(word_at(words, start), "U64"):
              set op_receiver_kind = "u64"
            end if
          end if
          let is_fixed_op = false
          if is_word(word_at(words, next_index(start, finish)), "."):
            if U64.less_than(U64.literal(0), sico.text.length(op_name)):
              if U64.less_than(U64.literal(0), sico.text.length(op_receiver_kind)):
                if is_word(word_at(words, next_index(next_index(next_index(start, finish), finish), finish)), "("):
                  set is_fixed_op = true
                end if
              end if
            end if
          end if
          let checked_name = checked_op_name(word_at(words, next_index(next_index(start, finish), finish)))
          let is_checked_op = false
