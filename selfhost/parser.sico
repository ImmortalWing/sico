                  set scl_ni_arg_value = scl_ni_param
                else:
                  let scl_ni_cell = local_binding_index(cell_names, scl_ni_atom)
                  if U64.less_than(scl_ni_cell, sico.list.length(cell_names)):
                    let scl_ni_atom_off = word_span_offset(words, src, expr_start, receiver_idx, scl_ni_arg)
                    let scl_ni_atom_end = scl_ni_atom_off
                    match U64.checked_add(scl_ni_atom_off, sico.bytes.length(sico.text.encode(scl_ni_atom))):
                      case ok(scl_ni_after_atom):
                        set scl_ni_atom_end = scl_ni_after_atom
                      case error(_):
                        return "ERR:E-SH-IR-RANGE"
                    end match
                    set scl_ni_pre = read_local_instruction_json(scl_base, "bytes", u64_list_at(cell_locals, scl_ni_cell, U64.literal(0)), scl_ni_atom_off, scl_ni_atom_end)
                    set scl_ni_arg_value = scl_base
                    set scl_ni_advance = U64.literal(2)
                  else:
                    return "ERR:E-SH-IR-CALL-ARGUMENT"
                  end if
                end if
                let scl_ni_id = scl_base
                if U64.equal(scl_ni_advance, U64.literal(2)):
                  match U64.checked_add(scl_base, U64.literal(1)):
                    case ok(scl_ni_bumped):
                      set scl_ni_id = scl_ni_bumped
                    case error(_):
                      return "ERR:E-SH-IR-RANGE"
