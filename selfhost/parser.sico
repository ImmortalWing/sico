    set out = sico.text.concat(out, nir_inner_json)
    set out = sico.text.concat(out, ",")
  end if
  set out = sico.text.concat(out, nir_outer_json)
  set out = sico.text.concat(out, "],\"terminator\":{\"kind\":\"return\",\"data\":")
  set out = sico.text.concat(out, sico.u64.to_text(nir_outer_result))
  set out = sico.text.concat(out, "},\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(fn_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(nir_fn_end))
  set out = sico.text.concat(out, "}}],\"range\":{\"start\":")
  set out = sico.text.concat(out, sico.u64.to_text(fn_start))
  set out = sico.text.concat(out, ",\"end\":")
  set out = sico.text.concat(out, sico.u64.to_text(nir_fn_end))
  set out = sico.text.concat(out, "}}")
  return out
end function

function fixed_operation_instruction_json(result_id: U64, kind: Text, operation: Text, left: U64, right: U64, range_start: U64, range_end: U64) returns Text:
  let foi_json = "{\"result\":"
  set foi_json = sico.text.concat(foi_json, sico.u64.to_text(result_id))
  set foi_json = sico.text.concat(foi_json, ",\"ty\":{\"kind\":\"")
  set foi_json = sico.text.concat(foi_json, kind)
  set foi_json = sico.text.concat(foi_json, "\"},\"operation\":{\"op\":\"")
  set foi_json = sico.text.concat(foi_json, operation)
  set foi_json = sico.text.concat(foi_json, "\",\"data\":")
  if is_word(operation, "shl"):
    set foi_json = sico.text.concat(foi_json, "{\"value\":")
  else:
    if is_word(operation, "shr"):
      set foi_json = sico.text.concat(foi_json, "{\"value\":")
    else:
      set foi_json = sico.text.concat(foi_json, "{\"left\":")
    end if
  end if
  set foi_json = sico.text.concat(foi_json, sico.u64.to_text(left))
  if is_word(operation, "shl"):
    set foi_json = sico.text.concat(foi_json, ",\"amount\":")
  else:
    if is_word(operation, "shr"):
      set foi_json = sico.text.concat(foi_json, ",\"amount\":")
    else:
      set foi_json = sico.text.concat(foi_json, ",\"right\":")
    end if
  end if
  set foi_json = sico.text.concat(foi_json, sico.u64.to_text(right))
  set foi_json = sico.text.concat(foi_json, "}},\"range\":{\"start\":")
  set foi_json = sico.text.concat(foi_json, sico.u64.to_text(range_start))
  set foi_json = sico.text.concat(foi_json, ",\"end\":")
  set foi_json = sico.text.concat(foi_json, sico.u64.to_text(range_end))
  set foi_json = sico.text.concat(foi_json, "}}")
  return foi_json
end function

function chained_operand_check(words: List[Text], from_idx: U64, caller_name_idx: U64, local_name: Text, receiver_kind: Text) returns Text:
  let coc_words_len = sico.list.length(words)
  let coc_open = next_index(next_index(next_index(from_idx, coc_words_len), coc_words_len), coc_words_len)
  let coc_first = next_index(coc_open, coc_words_len)
  let coc_comma = next_index(coc_first, coc_words_len)
  let coc_second = next_index(coc_comma, coc_words_len)
  let coc_close = next_index(coc_second, coc_words_len)
  let coc_after_close = next_index(coc_close, coc_words_len)
  let coc_line_end = line_end(words, from_idx)
  if U64.equal(coc_after_close, coc_line_end):
    let coc_arity_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-ARITY"
  end if
  if is_word(word_at(words, coc_open), "("):
    let coc_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  if is_word(word_at(words, coc_comma), ","):
    let coc_comma_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  if is_word(word_at(words, coc_close), ")"):
    let coc_close_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  let coc_position = U64.literal(0)
  while U64.less_than(coc_position, U64.literal(2)):
    let coc_atom_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, coc_position)
    let coc_atom = word_at(words, coc_atom_idx)
    if is_word(coc_atom, local_name):
      let coc_local_ok = I64.literal(1)
    else:
      let coc_param_id = binding_parameter_index(words, caller_name_idx, coc_atom)
      if U64.less_than(coc_param_id, count_params(words, caller_name_idx)):
        let coc_kind = binding_parameter_kind(words, caller_name_idx, coc_atom)
        if is_word(coc_kind, receiver_kind):
          let coc_param_ok = I64.literal(1)
        else:
          return "ERR:E-SH-IR-CALL-TYPE"
        end if
      else:
        return "ERR:E-SH-IR-CALL-ARGUMENT"
      end if
    end if
    set coc_position = next_index(coc_position, coc_position)
  end while
  return ""
end function

function chained_operand_value(words: List[Text], from_idx: U64, caller_name_idx: U64, local_name: Text, local_value: U64, position: U64) returns U64:
  let cov_atom_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, position)
  let cov_atom = word_at(words, cov_atom_idx)
  if is_word(cov_atom, local_name):
    return local_value
  end if
  return binding_parameter_index(words, caller_name_idx, cov_atom)
end function

function chained_let_function_ir(words: List[Text], src: Bytes, name_idx: U64, body_from: U64, body_end: U64, fn_start: U64, function_ordinal: U64, return_kind: Text, parameter_count: U64) returns Text:
  let cl_first_let = body_from
  while U64.less_than(cl_first_let, body_end):
    if is_word(word_at(words, cl_first_let), "let"):
      break
    end if
    set cl_first_let = next_index(cl_first_let, body_end)
  end while
  if U64.equal(cl_first_let, body_end):
    return "ERR:E-SH-IR-STATEMENT"
  end if
  let cl_first_end = line_end(words, cl_first_let)
  let cl_first_binding = next_index(cl_first_let, cl_first_end)
  let cl_first_receiver = next_index(cl_first_binding, cl_first_end)
  let cl_first_dot = next_index(cl_first_receiver, cl_first_end)
  let cl_first_op_idx = next_index(cl_first_dot, cl_first_end)
  let cl_first_open = next_index(cl_first_op_idx, cl_first_end)
  let cl_second_let = next_index(cl_first_end, body_end)
  while U64.less_than(cl_second_let, body_end):
    if is_word(word_at(words, cl_second_let), "<nl>"):
      set cl_second_let = next_index(cl_second_let, body_end)
    else:
      break
    end if
  end while
  if is_word(word_at(words, cl_second_let), "let"):
    let cl_second_let_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-STATEMENT"
  end if
  let cl_second_end = line_end(words, cl_second_let)
  let cl_second_binding = next_index(cl_second_let, cl_second_end)
  let cl_second_receiver = next_index(cl_second_binding, cl_second_end)
  let cl_second_dot = next_index(cl_second_receiver, cl_second_end)
  let cl_second_op_idx = next_index(cl_second_dot, cl_second_end)
  let cl_second_open = next_index(cl_second_op_idx, cl_second_end)
  if is_word(word_at(words, cl_first_binding), word_at(words, cl_second_binding)):
    return "ERR:E-SH-IR-STATEMENT"
  end if
  if U64.less_than(binding_parameter_index(words, name_idx, word_at(words, cl_first_binding)), parameter_count):
    return "ERR:E-SH-IR-STATEMENT"
  end if
  if U64.less_than(binding_parameter_index(words, name_idx, word_at(words, cl_second_binding)), parameter_count):
    return "ERR:E-SH-IR-STATEMENT"
  end if
  if is_word(word_at(words, cl_first_dot), "."):
    let cl_first_dot_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  if is_word(word_at(words, cl_second_dot), "."):
    let cl_second_dot_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  if is_word(word_at(words, cl_first_open), "("):
    let cl_first_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  if is_word(word_at(words, cl_second_open), "("):
    let cl_second_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  let cl_first_operation = fixed_op_name(word_at(words, cl_first_op_idx))
  let cl_second_operation = fixed_op_name(word_at(words, cl_second_op_idx))
  if U64.equal(sico.text.length(cl_first_operation), U64.literal(0)):
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  if U64.equal(sico.text.length(cl_second_operation), U64.literal(0)):
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  let cl_kind = ""
  if is_word(word_at(words, cl_first_receiver), "I64"):
    set cl_kind = "i64"
  else:
    if is_word(word_at(words, cl_first_receiver), "U64"):
      set cl_kind = "u64"
    else:
      return "ERR:E-SH-IR-EXPRESSION"
    end if
  end if
  let cl_second_kind = ""
  if is_word(word_at(words, cl_second_receiver), "I64"):
    set cl_second_kind = "i64"
  else:
    if is_word(word_at(words, cl_second_receiver), "U64"):
      set cl_second_kind = "u64"
    else:
      return "ERR:E-SH-IR-EXPRESSION"
    end if
  end if
  if is_word(cl_kind, cl_second_kind):
    let cl_same_kind = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TYPE"
  end if
  if is_word(cl_kind, return_kind):
    let cl_return_kind_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-TYPE-MISMATCH"
  end if
  let cl_first_close = matching_close(words, cl_first_open, cl_first_end)
  let cl_second_close = matching_close(words, cl_second_open, cl_second_end)
  if U64.equal(next_index(cl_first_close, cl_first_end), cl_first_end):
    let cl_first_complete = I64.literal(1)
  else:
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  if U64.equal(next_index(cl_second_close, cl_second_end), cl_second_end):
    let cl_second_complete = I64.literal(1)
  else:
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  let cl_first_check = fixed_operation_operand_check(words, cl_first_receiver, cl_first_end, name_idx, cl_kind)
  if sico.text.starts_with(cl_first_check, "ERR:"):
    return cl_first_check
  end if
  let cl_first_literal_count = fixed_operation_literal_count(words, cl_first_receiver, name_idx)
  let cl_first_result = parameter_count
  match U64.checked_add(parameter_count, cl_first_literal_count):
    case ok(cl_first_result_id):
      set cl_first_result = cl_first_result_id
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  let cl_second_check = chained_operand_check(words, cl_second_receiver, name_idx, word_at(words, cl_first_binding), cl_kind)
  if sico.text.starts_with(cl_second_check, "ERR:"):
    return cl_second_check
  end if
  let cl_second_result = next_index(cl_first_result, cl_first_result)
  let cl_return_idx = next_index(cl_second_end, body_end)
  while U64.less_than(cl_return_idx, body_end):
    if is_word(word_at(words, cl_return_idx), "<nl>"):
      set cl_return_idx = next_index(cl_return_idx, body_end)
    else:
      break
    end if
  end while
  if is_word(word_at(words, cl_return_idx), "return"):
    let cl_return_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-RETURN-COUNT"
  end if
  let cl_return_end = line_end(words, cl_return_idx)
  let cl_return_value = next_index(cl_return_idx, cl_return_end)
  if U64.equal(next_index(cl_return_value, cl_return_end), cl_return_end):
    let cl_return_single = I64.literal(1)
  else:
    return "ERR:E-SH-IR-STATEMENT"
  end if
  if is_word(word_at(words, cl_return_value), word_at(words, cl_second_binding)):
    let cl_return_binding_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-UNRESOLVED"
  end if
  let cl_tail = next_index(cl_return_end, body_end)
  while U64.less_than(cl_tail, body_end):
    let cl_tail_word = word_at(words, cl_tail)
    if is_word(cl_tail_word, "<nl>"):
      set cl_tail = next_index(cl_tail, body_end)
    else:
      if is_word(cl_tail_word, "end"):
        set cl_tail = body_end
      else:
        return "ERR:E-SH-IR-STATEMENT"
      end if
    end if
  end while
  let cl_first_let_offset = find_text_from(src, "let", fn_start)
  let cl_first_start = word_span_offset(words, src, cl_first_let_offset, cl_first_let, cl_first_receiver)
  let cl_first_range_end = return_expression_end(src, cl_first_start)
  let cl_second_let_offset = find_text_from(src, "let", cl_first_range_end)
  let cl_second_start = word_span_offset(words, src, cl_second_let_offset, cl_second_let, cl_second_receiver)
  let cl_second_range_end = return_expression_end(src, cl_second_start)
  let cl_first_literals = fixed_operation_literal_instructions(words, src, cl_first_receiver, name_idx, parameter_count, cl_first_receiver, cl_first_start)
  let cl_first_left = fixed_operation_operand_value(words, cl_first_receiver, cl_first_end, name_idx, U64.literal(0))
  let cl_first_right = fixed_operation_operand_value(words, cl_first_receiver, cl_first_end, name_idx, U64.literal(1))
  let cl_second_left = chained_operand_value(words, cl_second_receiver, name_idx, word_at(words, cl_first_binding), cl_first_result, U64.literal(0))
  let cl_second_right = chained_operand_value(words, cl_second_receiver, name_idx, word_at(words, cl_first_binding), cl_first_result, U64.literal(1))
  let cl_first_instruction = fixed_operation_instruction_json(cl_first_result, cl_kind, cl_first_operation, cl_first_left, cl_first_right, cl_first_start, cl_first_range_end)
  let cl_second_instruction = fixed_operation_instruction_json(cl_second_result, cl_kind, cl_second_operation, cl_second_left, cl_second_right, cl_second_start, cl_second_range_end)
  let cl_end_offset = find_text_from(src, "end function", fn_start)
  let cl_fn_end = fn_start
  match U64.checked_add(cl_end_offset, U64.literal(13)):
    case ok(cl_after_end):
      set cl_fn_end = cl_after_end
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  if U64.less_than(sico.bytes.length(src), cl_fn_end):
    set cl_fn_end = sico.bytes.length(src)
  end if
  let cl_parameters = parameters_ir(words, name_idx, src, fn_start)
  if sico.text.starts_with(cl_parameters, "ERR:"):
    return cl_parameters
  end if
  let cl_instructions = "["
  set cl_instructions = sico.text.concat(cl_instructions, cl_first_literals)
  if U64.less_than(U64.literal(0), sico.text.length(cl_first_literals)):
    set cl_instructions = sico.text.concat(cl_instructions, ",")
  end if
  set cl_instructions = sico.text.concat(cl_instructions, cl_first_instruction)
  set cl_instructions = sico.text.concat(cl_instructions, ",")
  set cl_instructions = sico.text.concat(cl_instructions, cl_second_instruction)
  set cl_instructions = sico.text.concat(cl_instructions, "]")
  let cl_json = "{\"id\":"
  set cl_json = sico.text.concat(cl_json, sico.u64.to_text(function_ordinal))
  set cl_json = sico.text.concat(cl_json, ",\"name\":\"")
  set cl_json = sico.text.concat(cl_json, word_at(words, name_idx))
  set cl_json = sico.text.concat(cl_json, "\",\"parameters\":")
  set cl_json = sico.text.concat(cl_json, cl_parameters)
  set cl_json = sico.text.concat(cl_json, ",\"return_type\":{\"kind\":\"")
  set cl_json = sico.text.concat(cl_json, return_kind)
  set cl_json = sico.text.concat(cl_json, "\"},\"effects\":[],\"entry\":0,\"blocks\":[{\"id\":0,\"instructions\":")
  set cl_json = sico.text.concat(cl_json, cl_instructions)
  set cl_json = sico.text.concat(cl_json, ",\"terminator\":{\"kind\":\"return\",\"data\":")
  set cl_json = sico.text.concat(cl_json, sico.u64.to_text(cl_second_result))
  set cl_json = sico.text.concat(cl_json, "},\"range\":{\"start\":")
  set cl_json = sico.text.concat(cl_json, sico.u64.to_text(fn_start))
  set cl_json = sico.text.concat(cl_json, ",\"end\":")
  set cl_json = sico.text.concat(cl_json, sico.u64.to_text(cl_fn_end))
  set cl_json = sico.text.concat(cl_json, "}}],\"range\":{\"start\":")
  set cl_json = sico.text.concat(cl_json, sico.u64.to_text(fn_start))
  set cl_json = sico.text.concat(cl_json, ",\"end\":")
  set cl_json = sico.text.concat(cl_json, sico.u64.to_text(cl_fn_end))
  set cl_json = sico.text.concat(cl_json, "}}")
  return cl_json
end function

function local_binding_index(names: List[Text], name: Text) returns U64:
  let lbi_len = sico.list.length(names)
  let lbi_idx = U64.literal(0)
  while U64.less_than(lbi_idx, lbi_len):
    if is_word(word_at(names, lbi_idx), name):
      return lbi_idx
    end if
    set lbi_idx = next_index(lbi_idx, lbi_len)
  end while
  let lbi_prefixed = sico.text.concat("#match", name)
  let lbi_found = lbi_len
  let lbi_scan = U64.literal(0)
  while U64.less_than(lbi_scan, lbi_len):
    if is_word(word_at(names, lbi_scan), lbi_prefixed):
      set lbi_found = lbi_scan
    end if
    set lbi_scan = next_index(lbi_scan, lbi_len)
  end while
  return lbi_found
end function

function u64_list_at(values: List[U64], idx: U64, fallback: U64) returns U64:
  match sico.list.get[U64](values, idx):
    case ok(value):
      return value
    case error(_):
      return fallback
  end match
end function

function straight_environment_operand_check(words: List[Text], from_idx: U64, caller_name_idx: U64, local_names: List[Text], local_kinds: List[Text], receiver_kind: Text) returns Text:
  let seo_words_len = sico.list.length(words)
  let seo_open = next_index(next_index(next_index(from_idx, seo_words_len), seo_words_len), seo_words_len)
  let seo_first = next_index(seo_open, seo_words_len)
  let seo_first_width = fixed_operation_operand_width(words, seo_first, caller_name_idx)
  let seo_comma = seo_first
  match U64.checked_add(seo_first, seo_first_width):
    case ok(seo_after_first):
      set seo_comma = seo_after_first
    case error(_):
      return "ERR:E-SH-IR-CALL-SHAPE"
  end match
  let seo_second = next_index(seo_comma, seo_words_len)
  let seo_second_width = fixed_operation_operand_width(words, seo_second, caller_name_idx)
  let seo_close = seo_second
  match U64.checked_add(seo_second, seo_second_width):
    case ok(seo_after_second):
      set seo_close = seo_after_second
    case error(_):
      return "ERR:E-SH-IR-CALL-SHAPE"
  end match
  let seo_after_close = next_index(seo_close, seo_words_len)
  let seo_line_end = line_end(words, from_idx)
  if U64.equal(seo_after_close, seo_line_end):
    let seo_arity_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-ARITY"
  end if
  if is_word(word_at(words, seo_open), "("):
    let seo_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  if is_word(word_at(words, seo_comma), ","):
    let seo_comma_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  if is_word(word_at(words, seo_close), ")"):
    let seo_close_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  let seo_position = U64.literal(0)
  while U64.less_than(seo_position, U64.literal(2)):
    let seo_atom_idx = seo_first
    if U64.equal(seo_position, U64.literal(1)):
      set seo_atom_idx = seo_second
    end if
    let seo_atom = word_at(words, seo_atom_idx)
    let seo_param_id = binding_parameter_index(words, caller_name_idx, seo_atom)
    if U64.less_than(seo_param_id, count_params(words, caller_name_idx)):
      if is_word(binding_parameter_kind(words, caller_name_idx, seo_atom), receiver_kind):
        let seo_param_ok = I64.literal(1)
      else:
        return "ERR:E-SH-IR-CALL-TYPE"
      end if
    else:
      let seo_local_idx = local_binding_index(local_names, seo_atom)
      if U64.less_than(seo_local_idx, sico.list.length(local_names)):
        if is_word(word_at(local_kinds, seo_local_idx), receiver_kind):
          let seo_local_ok = I64.literal(1)
        else:
          return "ERR:E-SH-IR-CALL-TYPE"
        end if
      else:
        let seo_literal_kind = fixed_literal_argument(words, seo_atom_idx)
        if sico.text.starts_with(seo_literal_kind, "ERR:"):
          return seo_literal_kind
        end if
        if U64.equal(sico.text.length(seo_literal_kind), U64.literal(0)):
          return "ERR:E-SH-IR-CALL-ARGUMENT"
        end if
        if is_word(seo_literal_kind, receiver_kind):
          let seo_literal_ok = I64.literal(1)
        else:
          return "ERR:E-SH-IR-CALL-TYPE"
        end if
      end if
    end if
    set seo_position = next_index(seo_position, seo_position)
  end while
  return ""
end function

function straight_environment_literal_count(words: List[Text], from_idx: U64, caller_name_idx: U64, local_names: List[Text]) returns U64:
  let sel_count = U64.literal(0)
  let sel_position = U64.literal(0)
  while U64.less_than(sel_position, U64.literal(2)):
    let sel_atom_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, sel_position)
    let sel_atom = word_at(words, sel_atom_idx)
    let sel_param = binding_parameter_index(words, caller_name_idx, sel_atom)
    if U64.less_than(sel_param, count_params(words, caller_name_idx)):
      let sel_param_ok = I64.literal(1)
    else:
      if U64.less_than(local_binding_index(local_names, sel_atom), sico.list.length(local_names)):
        let sel_local_ok = I64.literal(1)
      else:
        if U64.less_than(U64.literal(0), sico.text.length(fixed_literal_argument(words, sel_atom_idx))):
          set sel_count = next_index(sel_count, sel_count)
        end if
      end if
    end if
    set sel_position = next_index(sel_position, sel_position)
  end while
  return sel_count
end function

function straight_environment_operand_value(words: List[Text], from_idx: U64, caller_name_idx: U64, local_names: List[Text], local_values: List[U64], first_literal_value: U64, position: U64) returns U64:
  let sev_atom_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, position)
  let sev_atom = word_at(words, sev_atom_idx)
  let sev_param_id = binding_parameter_index(words, caller_name_idx, sev_atom)
  if U64.less_than(sev_param_id, count_params(words, caller_name_idx)):
    return sev_param_id
  end if
  let sev_local_idx = local_binding_index(local_names, sev_atom)
  if U64.less_than(sev_local_idx, sico.list.length(local_names)):
    return u64_list_at(local_values, sev_local_idx, sico.list.length(local_names))
  end if
  let sev_literal_value = first_literal_value
  if U64.equal(position, U64.literal(1)):
    let sev_first_atom_idx = fixed_operation_operand_atom_idx(words, from_idx, caller_name_idx, U64.literal(0))
    let sev_first_atom = word_at(words, sev_first_atom_idx)
    let sev_first_param = binding_parameter_index(words, caller_name_idx, sev_first_atom)
    if U64.less_than(sev_first_param, count_params(words, caller_name_idx)):
      let sev_first_param_ok = I64.literal(1)
    else:
      if U64.less_than(local_binding_index(local_names, sev_first_atom), sico.list.length(local_names)):
        let sev_first_local_ok = I64.literal(1)
      else:
        set sev_literal_value = next_index(sev_literal_value, sev_literal_value)
      end if
    end if
  end if
  return sev_literal_value
end function

function environment_call_arguments(words: List[Text], args_start: U64, args_end: U64, caller_name_idx: U64, callee_name_idx: U64, local_names: List[Text], local_kinds: List[Text], local_values: List[U64], first_literal_value: U64) returns Text:
  let eca_words_len = sico.list.length(words)
  let eca_callee_params = count_params(words, callee_name_idx)
  if U64.equal(args_start, args_end):
    if U64.equal(eca_callee_params, U64.literal(0)):
      return "[]"
    end if
    return "ERR:E-SH-IR-CALL-ARITY"
  end if
  let eca_json = "["
  let eca_position = U64.literal(0)
  let eca_literal_value = first_literal_value
  let eca_seg_start = args_start
  while U64.less_than(eca_seg_start, args_end):
    let eca_seg_end = args_end
    let eca_scan = eca_seg_start
    while U64.less_than(eca_scan, args_end):
      if is_word(word_at(words, eca_scan), "("):
        set eca_scan = next_index(matching_close(words, eca_scan, args_end), args_end)
      else:
        if is_word(word_at(words, eca_scan), ","):
          set eca_seg_end = eca_scan
          set eca_scan = args_end
        else:
          set eca_scan = next_index(eca_scan, args_end)
        end if
      end if
    end while
    if U64.less_than(eca_position, eca_callee_params):
      let eca_position_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-CALL-ARITY"
    end if
    let eca_atom = word_at(words, eca_seg_start)
    let eca_kind = ""
    let eca_value = U64.literal(0)
    let eca_is_literal = false
    let eca_advance = U64.literal(0)
    let eca_param = binding_parameter_index(words, caller_name_idx, eca_atom)
    if U64.less_than(eca_param, count_params(words, caller_name_idx)):
      set eca_kind = binding_parameter_kind(words, caller_name_idx, eca_atom)
      set eca_value = eca_param
    else:
      let eca_local = local_binding_index(local_names, eca_atom)
      if U64.less_than(eca_local, sico.list.length(local_names)):
        set eca_kind = word_at(local_kinds, eca_local)
        set eca_value = u64_list_at(local_values, eca_local, first_literal_value)
      else:
        set eca_kind = constant_argument_kind(eca_atom)
        if U64.less_than(U64.literal(0), sico.text.length(eca_kind)):
          set eca_value = eca_literal_value
          set eca_is_literal = true
          set eca_advance = U64.literal(1)
        else:
          set eca_kind = fixed_literal_argument(words, eca_seg_start)
          if sico.text.starts_with(eca_kind, "ERR:"):
            return eca_kind
          end if
          if U64.less_than(U64.literal(0), sico.text.length(eca_kind)):
            set eca_value = eca_literal_value
            set eca_is_literal = true
            set eca_advance = U64.literal(1)
          else:
            if U64.less_than(eca_seg_end, eca_words_len):
              if is_word(word_at(words, next_index(eca_seg_start, eca_words_len)), "("):
                let eca_callee_idx = function_declaration_index(words, eca_atom)
                if U64.equal(eca_callee_idx, eca_words_len):
                  return "ERR:E-SH-IR-CALL-TARGET"
                end if
                set eca_kind = declared_return_kind(words, next_index(eca_callee_idx, eca_words_len))
                let eca_seg_count = argument_instruction_count(words, eca_seg_start, eca_seg_end, caller_name_idx)
                match U64.checked_add(eca_literal_value, eca_seg_count):
                  case ok(eca_summed):
                    match U64.checked_sub(eca_summed, U64.literal(1)):
                      case ok(eca_call_value):
                        set eca_value = eca_call_value
                        set eca_advance = eca_seg_count
                      case error(_):
                        return "ERR:E-SH-IR-CALL-ARGUMENT"
                    end match
                  case error(_):
                    return "ERR:E-SH-IR-CALL-ARGUMENT"
                end match
              end if
            end if
            if U64.equal(eca_advance, U64.literal(0)):
              return "ERR:E-SH-IR-CALL-ARGUMENT"
            end if
          end if
        end if
      end if
    end if
    let eca_call_segment = false
    if U64.less_than(next_index(eca_seg_start, eca_words_len), eca_seg_end):
      if is_word(word_at(words, next_index(eca_seg_start, eca_words_len)), "("):
        set eca_call_segment = true
      end if
    end if
    if eca_call_segment:
      let eca_call_shape_ok = I64.literal(1)
    else:
      let eca_width = fixed_operation_operand_width(words, eca_seg_start, caller_name_idx)
      let eca_after_value = eca_seg_start
      match U64.checked_add(eca_seg_start, eca_width):
        case ok(eca_after_segment):
          set eca_after_value = eca_after_segment
        case error(_):
          return "ERR:E-SH-IR-CALL-SHAPE"
      end match
      if U64.equal(eca_after_value, eca_seg_end):
        let eca_shape_ok = I64.literal(1)
      else:
        return "ERR:E-SH-IR-CALL-SHAPE"
      end if
    end if
    let eca_expected = parameter_kind_by_id(words, callee_name_idx, eca_position)
    if is_word(eca_kind, eca_expected):
      let eca_type_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-CALL-TYPE"
    end if
    if U64.less_than(U64.literal(0), eca_position):
      set eca_json = sico.text.concat(eca_json, ",")
    end if
    set eca_json = sico.text.concat(eca_json, sico.u64.to_text(eca_value))
    if eca_is_literal:
      match U64.checked_add(eca_literal_value, eca_advance):
        case ok(eca_advanced):
          set eca_literal_value = eca_advanced
        case error(_):
          return "ERR:E-SH-IR-CALL-ARGUMENT"
      end match
    end if
    set eca_position = next_index(eca_position, eca_position)
    if U64.equal(eca_seg_end, args_end):
      if U64.equal(eca_position, eca_callee_params):
        return sico.text.concat(eca_json, "]")
      end if
      return "ERR:E-SH-IR-CALL-ARITY"
    end if
    if is_word(word_at(words, eca_seg_end), ","):
      set eca_seg_start = next_index(eca_seg_end, args_end)
    else:
      return "ERR:E-SH-IR-CALL-SHAPE"
    end if
  end while
  return "ERR:E-SH-IR-CALL-ARITY"
end function

function scalar_const_instruction_json(result_id: U64, kind: Text, data_json: Text, range_start: U64, range_end: U64) returns Text:
  let scij_json = "{\"result\":"
  set scij_json = sico.text.concat(scij_json, sico.u64.to_text(result_id))
  set scij_json = sico.text.concat(scij_json, ",\"ty\":{\"kind\":\"")
  set scij_json = sico.text.concat(scij_json, kind)
  set scij_json = sico.text.concat(scij_json, "\"},\"operation\":{\"op\":\"const_")
  set scij_json = sico.text.concat(scij_json, kind)
  set scij_json = sico.text.concat(scij_json, "\",\"data\":")
  set scij_json = sico.text.concat(scij_json, data_json)
  set scij_json = sico.text.concat(scij_json, "},\"range\":{\"start\":")
  set scij_json = sico.text.concat(scij_json, sico.u64.to_text(range_start))
  set scij_json = sico.text.concat(scij_json, ",\"end\":")
  set scij_json = sico.text.concat(scij_json, sico.u64.to_text(range_end))
  set scij_json = sico.text.concat(scij_json, "}}")
  return scij_json
end function

function fixed_literal_const_instruction(words: List[Text], src: Bytes, expr_idx: U64, line_end: U64, anchor_idx: U64, anchor_offset: U64, result_id: U64) returns Text:
  let fli_words_len = sico.list.length(words)
  let fli_dot_idx = next_index(expr_idx, fli_words_len)
  let fli_name_idx = next_index(fli_dot_idx, fli_words_len)
  let fli_open_idx = next_index(fli_name_idx, fli_words_len)
  let fli_value_idx = next_index(fli_open_idx, fli_words_len)
  let fli_close_idx = next_index(fli_value_idx, fli_words_len)
  let fli_after_close = next_index(fli_close_idx, fli_words_len)
  let fli_kind = ""
  if is_word(word_at(words, expr_idx), "I64"):
    set fli_kind = "i64"
  else:
    if is_word(word_at(words, expr_idx), "U64"):
      set fli_kind = "u64"
    end if
  end if
  if U64.equal(sico.text.length(fli_kind), U64.literal(0)):
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  if U64.equal(fli_after_close, line_end):
    if is_word(word_at(words, fli_dot_idx), "."):
      if is_word(word_at(words, fli_name_idx), "literal"):
        if is_word(word_at(words, fli_open_idx), "("):
          if is_word(word_at(words, fli_close_idx), ")"):
            if is_canonical_magnitude(word_at(words, fli_value_idx)):
              let fli_magnitude = word_at(words, fli_value_idx)
              if is_word(fli_kind, "i64"):
                if decimal_at_most(fli_magnitude, "9223372036854775807"):
                  let fli_digits_offset = word_span_offset(words, src, anchor_offset, anchor_idx, fli_value_idx)
                  let fli_digits_end = fli_digits_offset
                  match U64.checked_add(fli_digits_offset, sico.bytes.length(sico.text.encode(fli_magnitude))):
                    case ok(fli_after_digits):
                      set fli_digits_end = fli_after_digits
                    case error(_):
                      return "ERR:E-SH-IR-RANGE"
                  end match
                  return scalar_const_instruction_json(result_id, fli_kind, fli_magnitude, fli_digits_offset, fli_digits_end)
                end if
                return "ERR:E-SH-IR-I64-RANGE"
              end if
              if decimal_at_most(fli_magnitude, "18446744073709551615"):
                let fli_u64_digits_offset = word_span_offset(words, src, anchor_offset, anchor_idx, fli_value_idx)
                let fli_u64_digits_end = fli_u64_digits_offset
                match U64.checked_add(fli_u64_digits_offset, sico.bytes.length(sico.text.encode(fli_magnitude))):
                  case ok(fli_u64_after_digits):
                    set fli_u64_digits_end = fli_u64_after_digits
                  case error(_):
                    return "ERR:E-SH-IR-RANGE"
                end match
                return scalar_const_instruction_json(result_id, fli_kind, fli_magnitude, fli_u64_digits_offset, fli_u64_digits_end)
              end if
              return "ERR:E-SH-IR-U64-RANGE"
            end if
          end if
        end if
      end if
    end if
  end if
  let fli_minus_idx = fli_value_idx
  let fli_signed_magnitude_idx = next_index(fli_minus_idx, fli_words_len)
  let fli_signed_close_idx = next_index(fli_signed_magnitude_idx, fli_words_len)
  let fli_after_signed_close = next_index(fli_signed_close_idx, fli_words_len)
  if U64.equal(fli_after_signed_close, line_end):
    if is_word(fli_kind, "i64"):
      if is_word(word_at(words, fli_dot_idx), "."):
        if is_word(word_at(words, fli_name_idx), "literal"):
          if is_word(word_at(words, fli_open_idx), "("):
            if is_word(word_at(words, fli_minus_idx), "-"):
              if is_canonical_magnitude(word_at(words, fli_signed_magnitude_idx)):
                if is_word(word_at(words, fli_signed_close_idx), ")"):
                  let fli_negative_magnitude = word_at(words, fli_signed_magnitude_idx)
                  if decimal_at_most(fli_negative_magnitude, "9223372036854775808"):
                    let fli_sign_offset = word_span_offset(words, src, anchor_offset, anchor_idx, fli_minus_idx)
                    let fli_negative_data = sico.text.concat("-", fli_negative_magnitude)
                    let fli_negative_digits_offset = fli_sign_offset
                    match U64.checked_add(fli_sign_offset, U64.literal(1)):
                      case ok(fli_after_sign):
                        set fli_negative_digits_offset = fli_after_sign
                      case error(_):
                        return "ERR:E-SH-IR-RANGE"
                    end match
                    let fli_negative_digits_end = fli_negative_digits_offset
                    match U64.checked_add(fli_negative_digits_offset, sico.bytes.length(sico.text.encode(fli_negative_magnitude))):
                      case ok(fli_negative_after_digits):
                        set fli_negative_digits_end = fli_negative_after_digits
                      case error(_):
                        return "ERR:E-SH-IR-RANGE"
                    end match
                    return scalar_const_instruction_json(result_id, fli_kind, fli_negative_data, fli_sign_offset, fli_negative_digits_end)
                  end if
                  return "ERR:E-SH-IR-I64-RANGE"
                end if
              end if
            end if
          end if
        end if
      end if
    end if
  end if
  return "ERR:E-SH-IR-EXPRESSION"
end function

function comma_count(text: Text) returns U64:
  let cc_bytes = sico.text.encode(text)
  let cc_n = sico.bytes.length(cc_bytes)
  let cc_i = U64.literal(0)
  let cc_count = U64.literal(0)
  while U64.less_than(cc_i, cc_n):
    if I64.equal(sico.bytes.at(cc_bytes, cc_i, I64.literal(0)), I64.literal(44)):
      set cc_count = next_index(cc_count, cc_count)
    end if
    set cc_i = next_index(cc_i, cc_i)
  end while
  return cc_count
end function

function operand_nonparam_kind(words: List[Text], atom_idx: U64, cell_names: List[Text], cell_kinds: List[Text]) returns Text:
  let onk_atom = word_at(words, atom_idx)
  let onk_cell = local_binding_index(cell_names, onk_atom)
  if U64.less_than(onk_cell, sico.list.length(cell_names)):
    return word_at(cell_kinds, onk_cell)
  end if
  return fixed_literal_argument(words, atom_idx)
end function

function operand_cell_or_literal_json(words: List[Text], src: Bytes, atom_idx: U64, base: U64, anchor_idx: U64, anchor_offset: U64, cell_names: List[Text], cell_kinds: List[Text], cell_locals: List[U64]) returns Text:
  let ocl_words_len = sico.list.length(words)
  let ocl_atom = word_at(words, atom_idx)
  let ocl_cell = local_binding_index(cell_names, ocl_atom)
  if U64.less_than(ocl_cell, sico.list.length(cell_names)):
    let ocl_kind = word_at(cell_kinds, ocl_cell)
    let ocl_offset = word_span_offset(words, src, anchor_offset, anchor_idx, atom_idx)
    let ocl_end = ocl_offset
    match U64.checked_add(ocl_offset, sico.bytes.length(sico.text.encode(ocl_atom))):
      case ok(ocl_after_atom):
        set ocl_end = ocl_after_atom
      case error(_):
        return "ERR:E-SH-IR-RANGE"
    end match
    return read_local_instruction_json(base, ocl_kind, u64_list_at(cell_locals, ocl_cell, U64.literal(0)), ocl_offset, ocl_end)
  end if
  let ocl_lit = fixed_literal_argument(words, atom_idx)
  if sico.text.starts_with(ocl_lit, "ERR:"):
    return ocl_lit
  end if
  if U64.less_than(U64.literal(0), sico.text.length(ocl_lit)):
    return fixed_literal_operand_json(words, src, atom_idx, anchor_idx, anchor_offset, base)
  end if
  return ""
end function

function fixed_literal_operand_json(words: List[Text], src: Bytes, atom_idx: U64, anchor_idx: U64, anchor_offset: U64, result_id: U64) returns Text:
  let flop_words_len = sico.list.length(words)
  let flop_kind = fixed_literal_argument(words, atom_idx)
  let flop_sign_idx = next_index(next_index(next_index(next_index(atom_idx, flop_words_len), flop_words_len), flop_words_len), flop_words_len)
  let flop_is_negative = is_word(word_at(words, flop_sign_idx), "-")
  let flop_sign_offset = word_span_offset(words, src, anchor_offset, anchor_idx, flop_sign_idx)
  let flop_digits_word = ""
  let flop_digits_offset = flop_sign_offset
  if flop_is_negative:
    set flop_digits_word = word_at(words, next_index(flop_sign_idx, flop_words_len))
    match U64.checked_add(flop_sign_offset, U64.literal(1)):
      case ok(flop_after_sign):
        set flop_digits_offset = flop_after_sign
      case error(_):
        return "ERR:E-SH-IR-RANGE"
    end match
  else:
    set flop_digits_word = word_at(words, flop_sign_idx)
  end if
  let flop_digits_end = flop_digits_offset
  match U64.checked_add(flop_digits_offset, sico.bytes.length(sico.text.encode(flop_digits_word))):
    case ok(flop_after_digits):
      set flop_digits_end = flop_after_digits
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  let flop_data = flop_digits_word
  if flop_is_negative:
    set flop_data = sico.text.concat("-", flop_digits_word)
  end if
  return scalar_const_instruction_json(result_id, flop_kind, flop_data, flop_sign_offset, flop_digits_end)
end function

function write_local_instruction_json(result_id: U64, local_idx: U64, value: U64, range_start: U64, range_end: U64) returns Text:
  let wli_json = "{\"result\":"
  set wli_json = sico.text.concat(wli_json, sico.u64.to_text(result_id))
  set wli_json = sico.text.concat(wli_json, ",\"ty\":{\"kind\":\"unit\"},\"operation\":{\"op\":\"write_local\",\"data\":{\"local\":")
  set wli_json = sico.text.concat(wli_json, sico.u64.to_text(local_idx))
  set wli_json = sico.text.concat(wli_json, ",\"value\":")
  set wli_json = sico.text.concat(wli_json, sico.u64.to_text(value))
  set wli_json = sico.text.concat(wli_json, "}},\"range\":{\"start\":")
  set wli_json = sico.text.concat(wli_json, sico.u64.to_text(range_start))
  set wli_json = sico.text.concat(wli_json, ",\"end\":")
  set wli_json = sico.text.concat(wli_json, sico.u64.to_text(range_end))
  set wli_json = sico.text.concat(wli_json, "}}")
  return wli_json
end function

function type_json(kind: Text) returns Text:
  if sico.text.starts_with(kind, "{"):
    return kind
  end if
  return sico.text.concat("{\"kind\":\"", sico.text.concat(kind, "\"}"))
end function

function read_local_instruction_json(result_id: U64, kind: Text, local_idx: U64, range_start: U64, range_end: U64) returns Text:
  let rli_json = "{\"result\":"
  set rli_json = sico.text.concat(rli_json, sico.u64.to_text(result_id))
  set rli_json = sico.text.concat(rli_json, ",\"ty\":")
  set rli_json = sico.text.concat(rli_json, type_json(kind))
  set rli_json = sico.text.concat(rli_json, ",\"operation\":{\"op\":\"read_local\",\"data\":{\"local\":")
  set rli_json = sico.text.concat(rli_json, sico.u64.to_text(local_idx))
  set rli_json = sico.text.concat(rli_json, "}},\"range\":{\"start\":")
  set rli_json = sico.text.concat(rli_json, sico.u64.to_text(range_start))
  set rli_json = sico.text.concat(rli_json, ",\"end\":")
  set rli_json = sico.text.concat(rli_json, sico.u64.to_text(range_end))
  set rli_json = sico.text.concat(rli_json, "}}")
  return rli_json
end function

function call_instruction_json(result_id: U64, kind: Text, function_id: U64, arguments: Text, range_start: U64, range_end: U64) returns Text:
  let cij_json = "{\"result\":"
  set cij_json = sico.text.concat(cij_json, sico.u64.to_text(result_id))
  set cij_json = sico.text.concat(cij_json, ",\"ty\":")
  set cij_json = sico.text.concat(cij_json, type_json(kind))
  set cij_json = sico.text.concat(cij_json, ",\"operation\":{\"op\":\"call\",\"data\":{\"function\":")
  set cij_json = sico.text.concat(cij_json, sico.u64.to_text(function_id))
  set cij_json = sico.text.concat(cij_json, ",\"arguments\":")
  set cij_json = sico.text.concat(cij_json, arguments)
  set cij_json = sico.text.concat(cij_json, "}},\"range\":{\"start\":")
  set cij_json = sico.text.concat(cij_json, sico.u64.to_text(range_start))
  set cij_json = sico.text.concat(cij_json, ",\"end\":")
  set cij_json = sico.text.concat(cij_json, sico.u64.to_text(range_end))
  set cij_json = sico.text.concat(cij_json, "}}")
  return cij_json
end function

function straight_environment_function_ir(words: List[Text], src: Bytes, name_idx: U64, body_from: U64, body_end: U64, fn_start: U64, function_ordinal: U64, return_kind: Text, parameter_count: U64, let_count: U64) returns Text:
  let sef_local_names = sico.text.split_lines("")
  let sef_local_kinds = sico.text.split_lines("")
  let sef_local_values = sico.list.empty[U64]()
  let sef_instructions = "["
  let sef_body_idx = body_from
  while U64.less_than(sef_body_idx, body_end):
    if is_word(word_at(words, sef_body_idx), "let"):
      break
    end if
    set sef_body_idx = next_index(sef_body_idx, body_end)
  end while
  let sef_source_cursor = fn_start
  let sef_processed = U64.literal(0)
  let sef_emitted = U64.literal(0)
  let sef_next_result = parameter_count
  while U64.less_than(sef_processed, let_count):
    if is_word(word_at(words, sef_body_idx), "let"):
      let sef_let_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-STATEMENT"
    end if
    let sef_line_end = line_end(words, sef_body_idx)
    let sef_binding_idx = next_index(sef_body_idx, sef_line_end)
    let sef_receiver_idx = next_index(sef_binding_idx, sef_line_end)
    let sef_binding = word_at(words, sef_binding_idx)
    if U64.less_than(binding_parameter_index(words, name_idx, sef_binding), parameter_count):
      return "ERR:E-SH-IR-STATEMENT"
    end if
    if U64.less_than(local_binding_index(sef_local_names, sef_binding), sico.list.length(sef_local_names)):
      return "ERR:E-SH-IR-STATEMENT"
    end if
    let sef_after_receiver = next_index(sef_receiver_idx, sef_line_end)
    let sef_is_call = is_word(word_at(words, sef_after_receiver), "(")
    let sef_kind = ""
    let sef_let_offset = find_text_from(src, "let", sef_source_cursor)
    let sef_expression_start = word_span_offset(words, src, sef_let_offset, sef_body_idx, sef_receiver_idx)
    let sef_expression_end = return_expression_end(src, sef_expression_start)
    let sef_literals = ""
    let sef_operation_result = sef_next_result
    let sef_instruction = ""
    if sef_is_call:
      let sef_callee_idx = function_declaration_index(words, word_at(words, sef_receiver_idx))
      if U64.equal(sef_callee_idx, sico.list.length(words)):
        return "ERR:E-SH-IR-CALL-TARGET"
      end if
      let sef_call_close = matching_close(words, sef_after_receiver, sef_line_end)
      if U64.equal(next_index(sef_call_close, sef_line_end), sef_line_end):
        let sef_call_shape_ok = I64.literal(1)
      else:
        return "ERR:E-SH-IR-CALL-SHAPE"
      end if
      let sef_call_args_start = next_index(sef_after_receiver, sef_call_close)
      let sef_call_arguments = environment_call_arguments(words, sef_call_args_start, sef_call_close, name_idx, sef_callee_idx, sef_local_names, sef_local_kinds, sef_local_values, sef_next_result)
      if sico.text.starts_with(sef_call_arguments, "ERR:"):
        return sef_call_arguments
      end if
      set sef_kind = declared_return_kind(words, next_index(sef_callee_idx, sico.list.length(words)))
      if U64.equal(sico.text.length(sef_kind), U64.literal(0)):
        return "ERR:E-SH-IR-RETURN-TYPE"
      end if
      let sef_call_literal_count = argument_region_instruction_count(words, sef_call_args_start, sef_call_close, name_idx)
      set sef_literals = argument_instructions(words, src, sef_receiver_idx, sef_expression_start, sef_call_args_start, sef_call_close, name_idx, sef_next_result)
      match U64.checked_add(sef_next_result, sef_call_literal_count):
        case ok(sef_call_result):
          set sef_operation_result = sef_call_result
        case error(_):
          return "ERR:E-SH-IR-RANGE"
      end match
      set sef_instruction = call_instruction_json(sef_operation_result, sef_kind, function_declaration_ordinal(words, sef_callee_idx), sef_call_arguments, sef_expression_start, sef_expression_end)
    else:
      if U64.equal(next_index(sef_receiver_idx, sef_line_end), sef_line_end):
        let sef_const_atom = word_at(words, sef_receiver_idx)
        if is_word(sef_const_atom, "ERR-string-escape"):
          return "ERR:E-SH-IR-STRING-ESCAPE"
        end if
        if is_word(sef_const_atom, "ERR-string"):
          return "ERR:E-SH-IR-STRING-UNCLOSED"
        end if
        let sef_alias_param = binding_parameter_index(words, name_idx, sef_const_atom)
        if U64.less_than(sef_alias_param, parameter_count):
          set sef_kind = binding_parameter_kind(words, name_idx, sef_const_atom)
          set sef_operation_result = sef_alias_param
          set sef_instruction = ""
        else:
          let sef_alias_local = local_binding_index(sef_local_names, sef_const_atom)
          if U64.less_than(sef_alias_local, sico.list.length(sef_local_names)):
            set sef_kind = word_at(sef_local_kinds, sef_alias_local)
            set sef_operation_result = u64_list_at(sef_local_values, sef_alias_local, sef_next_result)
            set sef_instruction = ""
          else:
        if is_canonical_magnitude(sef_const_atom):
          set sef_kind = "int"
          set sef_instruction = scalar_const_instruction_json(sef_next_result, sef_kind, sico.text.concat("\"", sico.text.concat(sef_const_atom, "\"")), sef_expression_start, sef_expression_end)
        else:
          if is_word(sef_const_atom, "true"):
            set sef_kind = "bool"
            set sef_instruction = scalar_const_instruction_json(sef_next_result, sef_kind, "true", sef_expression_start, sef_expression_end)
          else:
            if is_word(sef_const_atom, "false"):
              set sef_kind = "bool"
              set sef_instruction = scalar_const_instruction_json(sef_next_result, sef_kind, "false", sef_expression_start, sef_expression_end)
            else:
              if is_string_token(sef_const_atom):
                set sef_kind = "string"
                set sef_instruction = scalar_const_instruction_json(sef_next_result, sef_kind, json_string_token(sef_const_atom), sef_expression_start, sef_expression_end)
              else:
                return "ERR:E-SH-IR-EXPRESSION"
              end if
            end if
          end if
        end if
          end if
        end if
      else:
        let sef_dot_idx = sef_after_receiver
        let sef_operation_idx = next_index(sef_dot_idx, sef_line_end)
        let sef_open_idx = next_index(sef_operation_idx, sef_line_end)
        if is_word(word_at(words, sef_dot_idx), "."):
          let sef_dot_ok = I64.literal(1)
        else:
          return "ERR:E-SH-IR-EXPRESSION"
        end if
        if is_word(word_at(words, sef_open_idx), "("):
          let sef_open_ok = I64.literal(1)
        else:
          return "ERR:E-SH-IR-EXPRESSION"
        end if
        let sef_operation = fixed_op_name(word_at(words, sef_operation_idx))
        if U64.equal(sico.text.length(sef_operation), U64.literal(0)):
          return "ERR:E-SH-IR-EXPRESSION"
        end if
        if is_word(word_at(words, sef_receiver_idx), "I64"):
          set sef_kind = "i64"
        else:
          if is_word(word_at(words, sef_receiver_idx), "U64"):
            set sef_kind = "u64"
          else:
            return "ERR:E-SH-IR-EXPRESSION"
          end if
        end if
        let sef_operand_check = straight_environment_operand_check(words, sef_receiver_idx, name_idx, sef_local_names, sef_local_kinds, sef_kind)
        if sico.text.starts_with(sef_operand_check, "ERR:"):
          return sef_operand_check
        end if
        let sef_literal_count = straight_environment_literal_count(words, sef_receiver_idx, name_idx, sef_local_names)
        set sef_literals = fixed_operation_literal_instructions(words, src, sef_receiver_idx, name_idx, sef_next_result, sef_receiver_idx, sef_expression_start)
        match U64.checked_add(sef_next_result, sef_literal_count):
          case ok(sef_after_literals):
            set sef_operation_result = sef_after_literals
          case error(_):
            return "ERR:E-SH-IR-RANGE"
        end match
        let sef_left = straight_environment_operand_value(words, sef_receiver_idx, name_idx, sef_local_names, sef_local_values, sef_next_result, U64.literal(0))
        let sef_right = straight_environment_operand_value(words, sef_receiver_idx, name_idx, sef_local_names, sef_local_values, sef_next_result, U64.literal(1))
        set sef_instruction = fixed_operation_instruction_json(sef_operation_result, sef_kind, sef_operation, sef_left, sef_right, sef_expression_start, sef_expression_end)
      end if
    end if
    if U64.less_than(U64.literal(0), sico.text.length(sef_instruction)):
      if U64.less_than(U64.literal(0), sef_emitted):
        set sef_instructions = sico.text.concat(sef_instructions, ",")
      end if
      set sef_emitted = next_index(sef_emitted, sef_emitted)
      set sef_instructions = sico.text.concat(sef_instructions, sef_literals)
      if U64.less_than(U64.literal(0), sico.text.length(sef_literals)):
        set sef_instructions = sico.text.concat(sef_instructions, ",")
      end if
      set sef_instructions = sico.text.concat(sef_instructions, sef_instruction)
    end if
    set sef_local_names = sico.list.append(sef_local_names, sef_binding)
    set sef_local_kinds = sico.list.append(sef_local_kinds, sef_kind)
    set sef_local_values = sico.list.append[U64](sef_local_values, sef_operation_result)
    if U64.less_than(U64.literal(0), sico.text.length(sef_instruction)):
      set sef_next_result = next_index(sef_operation_result, sef_operation_result)
    end if
    set sef_source_cursor = sef_expression_end
    set sef_processed = next_index(sef_processed, sef_processed)
    set sef_body_idx = next_index(sef_line_end, body_end)
    while U64.less_than(sef_body_idx, body_end):
      if is_word(word_at(words, sef_body_idx), "<nl>"):
        set sef_body_idx = next_index(sef_body_idx, body_end)
      else:
        break
      end if
    end while
  end while
  if is_word(word_at(words, sef_body_idx), "return"):
    let sef_return_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-RETURN-COUNT"
  end if
  let sef_return_end = line_end(words, sef_body_idx)
  let sef_return_value_idx = next_index(sef_body_idx, sef_return_end)
  let sef_return_name = word_at(words, sef_return_value_idx)
  let sef_return_value = parameter_count
  let sef_return_value_kind = ""
  let sef_return_const = ""
  let sef_return_param = binding_parameter_index(words, name_idx, sef_return_name)
  if U64.less_than(sef_return_param, parameter_count):
    set sef_return_value = sef_return_param
    set sef_return_value_kind = binding_parameter_kind(words, name_idx, sef_return_name)
  else:
    let sef_return_local = local_binding_index(sef_local_names, sef_return_name)
    if U64.less_than(sef_return_local, sico.list.length(sef_local_names)):
      set sef_return_value = u64_list_at(sef_local_values, sef_return_local, parameter_count)
      set sef_return_value_kind = word_at(sef_local_kinds, sef_return_local)
    else:
      let sef_return_second_idx = next_index(sef_return_value_idx, sef_return_end)
      if U64.less_than(sef_return_second_idx, sef_return_end):
        let sef_ret_expr_start = return_expression_start(src, sef_source_cursor)
        if U64.equal(sef_ret_expr_start, sico.bytes.length(src)):
          return "ERR:E-SH-IR-RANGE"
        end if
        if is_word(word_at(words, sef_return_second_idx), "("):
          let sef_ret_callee_idx = function_declaration_index(words, sef_return_name)
          if U64.equal(sef_ret_callee_idx, sico.list.length(words)):
            return "ERR:E-SH-IR-CALL-TARGET"
          end if
          let sef_ret_close = matching_close(words, sef_return_second_idx, sef_return_end)
          if U64.equal(next_index(sef_ret_close, sef_return_end), sef_return_end):
            let sef_ret_shape_ok = I64.literal(1)
          else:
            return "ERR:E-SH-IR-CALL-SHAPE"
          end if
          let sef_ret_args_start = next_index(sef_return_second_idx, sef_return_end)
          let sef_ret_arguments = environment_call_arguments(words, sef_ret_args_start, sef_ret_close, name_idx, sef_ret_callee_idx, sef_local_names, sef_local_kinds, sef_local_values, sef_next_result)
          if sico.text.starts_with(sef_ret_arguments, "ERR:"):
            return sef_ret_arguments
          end if
          let sef_ret_kind = declared_return_kind(words, next_index(sef_ret_callee_idx, sico.list.length(words)))
          if U64.equal(sico.text.length(sef_ret_kind), U64.literal(0)):
            return "ERR:E-SH-IR-RETURN-TYPE"
          end if
          let sef_ret_const_count = argument_region_instruction_count(words, sef_ret_args_start, sef_ret_close, name_idx)
          let sef_ret_consts = argument_instructions(words, src, sef_return_value_idx, sef_ret_expr_start, sef_ret_args_start, sef_ret_close, name_idx, sef_next_result)
          let sef_ret_result = sef_next_result
          match U64.checked_add(sef_next_result, sef_ret_const_count):
            case ok(sef_ret_call_result):
              set sef_ret_result = sef_ret_call_result
            case error(_):
              return "ERR:E-SH-IR-RANGE"
          end match
          let sef_ret_expr_end = return_expression_end(src, sef_ret_expr_start)
          set sef_return_value = sef_ret_result
          set sef_return_value_kind = sef_ret_kind
          set sef_return_const = call_instruction_json(sef_ret_result, sef_ret_kind, function_declaration_ordinal(words, sef_ret_callee_idx), sef_ret_arguments, sef_ret_expr_start, sef_ret_expr_end)
          if U64.less_than(U64.literal(0), sico.text.length(sef_ret_consts)):
            set sef_return_const = sico.text.concat(sef_ret_consts, sico.text.concat(",", sef_return_const))
          end if
        else:
          if is_word(word_at(words, sef_return_second_idx), "."):
            let sef_ret_third_idx = next_index(sef_return_second_idx, sef_return_end)
            if is_word(word_at(words, sef_ret_third_idx), "literal"):
              let sef_ret_literal = fixed_literal_const_instruction(words, src, sef_return_value_idx, sef_return_end, sef_return_value_idx, sef_ret_expr_start, sef_next_result)
              if sico.text.starts_with(sef_ret_literal, "ERR:"):
                return sef_ret_literal
              end if
              if is_word(sef_return_name, "I64"):
                set sef_return_value_kind = "i64"
              else:
                set sef_return_value_kind = "u64"
              end if
              set sef_return_value = sef_next_result
              set sef_return_const = sef_ret_literal
            else:
              let sef_ret_op = fixed_op_name(word_at(words, sef_ret_third_idx))
              if U64.less_than(U64.literal(0), sico.text.length(sef_ret_op)):
                let sef_ret_op_open = next_index(sef_ret_third_idx, sef_return_end)
                if is_word(word_at(words, sef_ret_op_open), "("):
                  let sef_ret_op_open_ok = I64.literal(1)
                else:
                  return "ERR:E-SH-IR-EXPRESSION"
                end if
                let sef_ret_op_kind = ""
                if is_word(sef_return_name, "I64"):
                  set sef_ret_op_kind = "i64"
                else:
                  if is_word(sef_return_name, "U64"):
                    set sef_ret_op_kind = "u64"
                  else:
                    return "ERR:E-SH-IR-EXPRESSION"
                  end if
                end if
                let sef_ret_op_check = straight_environment_operand_check(words, sef_return_value_idx, name_idx, sef_local_names, sef_local_kinds, sef_ret_op_kind)
                if sico.text.starts_with(sef_ret_op_check, "ERR:"):
                  return sef_ret_op_check
                end if
                let sef_ret_op_literal_count = straight_environment_literal_count(words, sef_return_value_idx, name_idx, sef_local_names)
                let sef_ret_op_consts = fixed_operation_literal_instructions(words, src, sef_return_value_idx, name_idx, sef_next_result, sef_return_value_idx, sef_ret_expr_start)
                let sef_ret_op_result = sef_next_result
                match U64.checked_add(sef_next_result, sef_ret_op_literal_count):
                  case ok(sef_ret_op_after):
                    set sef_ret_op_result = sef_ret_op_after
                  case error(_):
                    return "ERR:E-SH-IR-RANGE"
                end match
                let sef_ret_op_left = straight_environment_operand_value(words, sef_return_value_idx, name_idx, sef_local_names, sef_local_values, sef_next_result, U64.literal(0))
                let sef_ret_op_right = straight_environment_operand_value(words, sef_return_value_idx, name_idx, sef_local_names, sef_local_values, sef_next_result, U64.literal(1))
                let sef_ret_op_end = return_expression_end(src, sef_ret_expr_start)
                set sef_return_value = sef_ret_op_result
                set sef_return_value_kind = sef_ret_op_kind
                set sef_return_const = fixed_operation_instruction_json(sef_ret_op_result, sef_ret_op_kind, sef_ret_op, sef_ret_op_left, sef_ret_op_right, sef_ret_expr_start, sef_ret_op_end)
                if U64.less_than(U64.literal(0), sico.text.length(sef_ret_op_consts)):
                  set sef_return_const = sico.text.concat(sef_ret_op_consts, sico.text.concat(",", sef_return_const))
                end if
              else:
                return "ERR:E-SH-IR-EXPRESSION"
              end if
            end if
          else:
            return "ERR:E-SH-IR-UNRESOLVED"
          end if
        end if
      else:
      if is_word(sef_return_name, "ERR-string-escape"):
        return "ERR:E-SH-IR-STRING-ESCAPE"
      end if
      if is_word(sef_return_name, "ERR-string"):
        return "ERR:E-SH-IR-STRING-UNCLOSED"
      end if
      let sef_const_start = return_expression_start(src, sef_source_cursor)
      if U64.equal(sef_const_start, sico.bytes.length(src)):
        return "ERR:E-SH-IR-RANGE"
      end if
      let sef_const_end = sef_const_start
      match U64.checked_add(sef_const_start, sico.bytes.length(sico.text.encode(sef_return_name))):
        case ok(sef_const_after):
          set sef_const_end = sef_const_after
        case error(_):
          return "ERR:E-SH-IR-RANGE"
      end match
      if is_canonical_magnitude(sef_return_name):
        set sef_return_value = sef_next_result
        set sef_return_value_kind = "int"
        set sef_return_const = scalar_const_instruction_json(sef_next_result, sef_return_value_kind, sico.text.concat("\"", sico.text.concat(sef_return_name, "\"")), sef_const_start, sef_const_end)
      else:
        if is_word(sef_return_name, "true"):
          set sef_return_value = sef_next_result
          set sef_return_value_kind = "bool"
          set sef_return_const = scalar_const_instruction_json(sef_next_result, sef_return_value_kind, "true", sef_const_start, sef_const_end)
        else:
          if is_word(sef_return_name, "false"):
            set sef_return_value = sef_next_result
            set sef_return_value_kind = "bool"
            set sef_return_const = scalar_const_instruction_json(sef_next_result, sef_return_value_kind, "false", sef_const_start, sef_const_end)
          else:
            if is_string_token(sef_return_name):
              set sef_return_value = sef_next_result
              set sef_return_value_kind = "string"
              set sef_return_const = scalar_const_instruction_json(sef_next_result, sef_return_value_kind, json_string_token(sef_return_name), sef_const_start, sef_const_end)
            else:
              return "ERR:E-SH-IR-UNRESOLVED"
            end if
          end if
        end if
      end if
      end if
    end if
  end if
  if U64.less_than(U64.literal(0), sico.text.length(sef_return_const)):
    if U64.less_than(U64.literal(0), sef_emitted):
      set sef_instructions = sico.text.concat(sef_instructions, ",")
    end if
    set sef_instructions = sico.text.concat(sef_instructions, sef_return_const)
  end if
  set sef_instructions = sico.text.concat(sef_instructions, "]")
  if is_word(sef_return_value_kind, return_kind):
    let sef_return_type_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-TYPE-MISMATCH"
  end if
  let sef_tail = next_index(sef_return_end, body_end)
  while U64.less_than(sef_tail, body_end):
    let sef_tail_word = word_at(words, sef_tail)
    if is_word(sef_tail_word, "<nl>"):
      set sef_tail = next_index(sef_tail, body_end)
    else:
      if is_word(sef_tail_word, "end"):
        set sef_tail = body_end
      else:
        return "ERR:E-SH-IR-STATEMENT"
      end if
    end if
  end while
  let sef_end_offset = find_text_from(src, "end function", fn_start)
  let sef_fn_end = fn_start
  match U64.checked_add(sef_end_offset, U64.literal(13)):
    case ok(sef_after_end):
      set sef_fn_end = sef_after_end
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  if U64.less_than(sico.bytes.length(src), sef_fn_end):
    set sef_fn_end = sico.bytes.length(src)
  end if
  let sef_parameters = parameters_ir(words, name_idx, src, fn_start)
  if sico.text.starts_with(sef_parameters, "ERR:"):
    return sef_parameters
  end if
  let sef_json = "{\"id\":"
  set sef_json = sico.text.concat(sef_json, sico.u64.to_text(function_ordinal))
  set sef_json = sico.text.concat(sef_json, ",\"name\":\"")
  set sef_json = sico.text.concat(sef_json, word_at(words, name_idx))
  set sef_json = sico.text.concat(sef_json, "\",\"parameters\":")
  set sef_json = sico.text.concat(sef_json, sef_parameters)
  set sef_json = sico.text.concat(sef_json, ",\"return_type\":{\"kind\":\"")
  set sef_json = sico.text.concat(sef_json, return_kind)
  set sef_json = sico.text.concat(sef_json, "\"},\"effects\":[],\"entry\":0,\"blocks\":[{\"id\":0,\"instructions\":")
  set sef_json = sico.text.concat(sef_json, sef_instructions)
  set sef_json = sico.text.concat(sef_json, ",\"terminator\":{\"kind\":\"return\",\"data\":")
  set sef_json = sico.text.concat(sef_json, sico.u64.to_text(sef_return_value))
  set sef_json = sico.text.concat(sef_json, "},\"range\":{\"start\":")
  set sef_json = sico.text.concat(sef_json, sico.u64.to_text(fn_start))
  set sef_json = sico.text.concat(sef_json, ",\"end\":")
  set sef_json = sico.text.concat(sef_json, sico.u64.to_text(sef_fn_end))
  set sef_json = sico.text.concat(sef_json, "}}],\"range\":{\"start\":")
  set sef_json = sico.text.concat(sef_json, sico.u64.to_text(fn_start))
  set sef_json = sico.text.concat(sef_json, ",\"end\":")
  set sef_json = sico.text.concat(sef_json, sico.u64.to_text(sef_fn_end))
  set sef_json = sico.text.concat(sef_json, "}}")
  return sef_json
end function

function while_call_rhs_packed(words: List[Text], src: Bytes, name_idx: U64, receiver_idx: U64, line_end: U64, expr_start: U64, line_end_offset: U64, cell_names: List[Text], cell_kinds: List[Text], cell_locals: List[U64], parameter_count: U64, base: U64) returns Text:
  let words_len = sico.list.length(words)
