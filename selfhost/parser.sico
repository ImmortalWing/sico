function scalar_ir(words: List[Text], src: Bytes) returns Text:
  let source_len = sico.bytes.length(src)
  let n = sico.list.length(words)
  if U64.equal(n, U64.literal(1)):
    if is_word(word_at(words, U64.literal(0)), "ERR-string-escape"):
      return "ERR:E-SH-IR-STRING-ESCAPE"
    end if
    if is_word(word_at(words, U64.literal(0)), "ERR-string"):
      return "ERR:E-SH-IR-STRING-UNCLOSED"
    end if
  end if
  let i = U64.literal(0)
  let prev = ""
  let function_count = U64.literal(0)
  let functions_json = ""
  let source_cursor = U64.literal(0)
  while U64.less_than(i, n):
    let token = word_at(words, i)
    if is_word(token, "function"):
      if is_declaration_start(prev):
        set function_count = next_index(function_count, function_count)
        let name_idx = next_index(i, n)
        if U64.equal(name_idx, n):
          return "ERR:E-SH-IR-FUNCTION-NAME"
        end if
        let function_name = word_at(words, name_idx)
        if U64.equal(function_declaration_index(words, function_name), name_idx):
          let first_definition_ok = I64.literal(1)
        else:
          return "ERR:E-SH-IR-FUNCTION-DUPLICATE"
        end if
        let function_ordinal = function_count
        let fn_start = find_text_from(src, "function", source_cursor)
        let parameter_count = count_params(words, name_idx)
        let body_from = next_index(name_idx, n)
        let return_type_kind = declared_return_kind(words, body_from)
        let body_end_word = find_body_end(words, body_from)
        let let_count = count_until_end_function(words, body_from, "let")
        let set_count = count_until_end_function(words, body_from, "set")
        let match_count = count_until_end_function(words, body_from, "match")
        let if_count = count_until_end_function(words, body_from, "if")
        if U64.less_than(U64.literal(1), match_count):
          if U64.equal(count_until_end_function(words, body_from, "while"), U64.literal(0)):
            return "ERR:E-SH-IR-CONTROL"
          end if
        end if
        let direct_intrinsic_json = direct_bytes_equal_encode_ir(words, src, name_idx, body_from, body_end_word, fn_start, function_ordinal, return_type_kind, parameter_count)
        if is_word(direct_intrinsic_json, "SKIP"):
          let no_direct_intrinsic = I64.literal(1)
        else:
          if sico.text.starts_with(direct_intrinsic_json, "ERR:"):
            return direct_intrinsic_json
          end if
          if U64.less_than(U64.literal(1), function_count):
            set functions_json = sico.text.concat(functions_json, ",")
          end if
          set functions_json = sico.text.concat(functions_json, direct_intrinsic_json)
          let direct_end_offset = find_text_from(src, "end function", fn_start)
          let direct_fn_end = fn_start
          match U64.checked_add(direct_end_offset, U64.literal(13)):
            case ok(direct_after_end):
              set direct_fn_end = direct_after_end
            case error(_):
              return "ERR:E-SH-IR-RANGE"
          end match
          if U64.less_than(source_len, direct_fn_end):
            set direct_fn_end = source_len
          end if
          set source_cursor = direct_fn_end
          set i = body_end_word
          set prev = "function"
          continue
        end if
        let guard_chain_json = fixed_guard_chain_ir(words, src, name_idx, fn_start, function_ordinal)
        if sico.text.starts_with(guard_chain_json, "SKIP"):
          let no_guard_chain = I64.literal(1)
        else:
          if sico.text.starts_with(guard_chain_json, "ERR:"):
            return guard_chain_json
          end if
          if U64.less_than(U64.literal(1), function_count):
