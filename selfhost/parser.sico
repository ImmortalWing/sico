      return sico.text.concat("2\n", sico.text.concat(sico.u64.to_text(gic_intr_id), sico.text.concat("\n", sico.text.concat(ret_kind, sico.text.concat("\n", gic_pieces)))))
    else:
      return "ERR:E-SH-IR-CALL-ARGUMENT"
    end if
