  end if
  let sbl_src = next_index(sbl_open, sbl_close)
  let sbl_comma1 = next_index(sbl_src, sbl_close)
  let sbl_cursor = next_index(sbl_comma1, sbl_close)
  let sbl_comma2 = next_index(sbl_cursor, sbl_close)
