function control_if_function_ir(words: List[Text], src: Bytes, name_idx: U64, body_from: U64, body_end: U64, fn_start: U64, function_ordinal: U64, return_kind: Text, parameter_count: U64) returns Text:
  let sif_words_len = sico.list.length(words)
  let sif_cell_names = sico.text.split_lines("")
  let sif_cell_kinds = sico.text.split_lines("")
  let sif_cell_locals = sico.list.empty[U64]()
  let sif_cell_starts = sico.list.empty[U64]()
  let sif_cell_ends = sico.list.empty[U64]()
  let sif_cell_count = U64.literal(0)
  let sif_b0 = ""
  let sif_b1 = ""
  let sif_b2 = ""
  let sif_b3 = ""
  let sif_em0 = U64.literal(0)
  let sif_em1 = U64.literal(0)
  let sif_em2 = U64.literal(0)
  let sif_em3 = U64.literal(0)
  let sif_next = parameter_count
  let sif_target = U64.literal(0)
  let sif_form = ""
  let sif_has_else = false
  let sif_final_done = false
  let sif_ret1_done = false
  let sif_ret2_done = false
  let sif_ret1_value = U64.literal(0)
  let sif_ret2_value = U64.literal(0)
  let sif_final_value = U64.literal(0)
  let sif_cond_value = U64.literal(0)
  let sif_if_start = fn_start
  let sif_if_end = fn_start
  let sif_cursor = fn_start
  let sif_idx = body_from
  while U64.less_than(sif_idx, body_end):
    if is_word(word_at(words, sif_idx), "let"):
      break
    end if
    if is_word(word_at(words, sif_idx), "if"):
      break
    end if
    if is_word(word_at(words, sif_idx), "set"):
      break
    end if
    set sif_idx = next_index(sif_idx, body_end)
  end while
  while U64.less_than(sif_idx, body_end):
    let swk_word = word_at(words, sif_idx)
    if is_word(swk_word, "<nl>"):
      set sif_idx = next_index(sif_idx, body_end)
      continue
    end if
    let swk_is_stmt = false
    let swk_is_set = false
    if is_word(swk_word, "let"):
      set swk_is_stmt = true
    else:
      if is_word(swk_word, "set"):
        set swk_is_stmt = true
        set swk_is_set = true
      end if
    end if
    if swk_is_stmt:
      if U64.less_than(U64.literal(0), sif_target):
        if is_word(sif_form, "ret"):
          return "ERR:E-SH-IR-STATEMENT"
        end if
      end if
      let sws_line_end = line_end(words, sif_idx)
      let sws_binding_idx = next_index(sif_idx, sws_line_end)
      let sws_receiver_idx = next_index(sws_binding_idx, sws_line_end)
      let sws_binding = word_at(words, sws_binding_idx)
      let sws_keyword_offset = find_text_from(src, swk_word, sif_cursor)
      let sws_binding_offset = word_span_offset(words, src, sws_keyword_offset, sif_idx, sws_binding_idx)
      let sws_binding_end = sws_binding_offset
      match U64.checked_add(sws_binding_offset, sico.bytes.length(sico.text.encode(sws_binding))):
        case ok(sws_after_binding):
          set sws_binding_end = sws_after_binding
        case error(_):
          return "ERR:E-SH-IR-RANGE"
      end match
      let sws_expr_start = word_span_offset(words, src, sws_keyword_offset, sif_idx, sws_receiver_idx)
      let sws_line_end_offset = return_expression_end(src, sws_expr_start)
      let sws_rhs_multi = U64.less_than(next_index(sws_receiver_idx, sws_line_end), sws_line_end)
      let sws_rhs_json = ""
      let sws_rhs_count = U64.literal(0)
      let sws_rhs_value = sif_next
      let sws_rhs_kind = ""
      if sws_rhs_multi:
        let sws_rhs_literal = fixed_literal_const_instruction(words, src, sws_receiver_idx, sws_line_end, sws_receiver_idx, sws_expr_start, sif_next)
        if sico.text.starts_with(sws_rhs_literal, "ERR:"):
          return sws_rhs_literal
        end if
        set sws_rhs_json = sws_rhs_literal
        set sws_rhs_count = U64.literal(1)
        if is_word(word_at(words, sws_receiver_idx), "I64"):
          set sws_rhs_kind = "i64"
        else:
          set sws_rhs_kind = "u64"
        end if
      else:
        let sws_atom = word_at(words, sws_receiver_idx)
        if is_word(sws_atom, "ERR-string-escape"):
          return "ERR:E-SH-IR-STRING-ESCAPE"
        end if
        if is_word(sws_atom, "ERR-string"):
          return "ERR:E-SH-IR-STRING-UNCLOSED"
        end if
        let sws_atom_end = sws_expr_start
        match U64.checked_add(sws_expr_start, sico.bytes.length(sico.text.encode(sws_atom))):
          case ok(sws_after_atom):
            set sws_atom_end = sws_after_atom
          case error(_):
            return "ERR:E-SH-IR-RANGE"
        end match
        let sws_param = binding_parameter_index(words, name_idx, sws_atom)
        if U64.less_than(sws_param, parameter_count):
          set sws_rhs_value = sws_param
          set sws_rhs_kind = binding_parameter_kind(words, name_idx, sws_atom)
        else:
          let sws_cell = local_binding_index(sif_cell_names, sws_atom)
          if U64.less_than(sws_cell, sico.list.length(sif_cell_names)):
            set sws_rhs_kind = word_at(sif_cell_kinds, sws_cell)
            set sws_rhs_json = read_local_instruction_json(sif_next, sws_rhs_kind, u64_list_at(sif_cell_locals, sws_cell, U64.literal(0)), sws_expr_start, sws_atom_end)
            set sws_rhs_count = U64.literal(1)
          else:
