      return "ERR:E-SH-IR-MATCH-SHAPE"
    end if
    if is_word(word_at(words, literal_open), "("):
      let literal_open_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-MATCH-SHAPE"
    end if
    if is_word(word_at(words, zero), "0"):
      let zero_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-MATCH-SHAPE"
    end if
    if is_word(word_at(words, literal_close), ")"):
      let literal_close_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-MATCH-SHAPE"
    end if
  end if
  if is_word(word_at(words, end_word), "end"):
    let end_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, end_match), "match"):
    let end_match_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  let parameters = parameters_ir(words, name_idx, src, fn_start)
  if sico.text.starts_with(parameters, "ERR:"):
    return parameters
  end if
  let match_start = find_text_from(src, "match", fn_start)
  let receiver_start = find_text_from(src, word_at(words, receiver), match_start)
  let close_start = word_span_offset(words, src, receiver_start, receiver, close)
  let colon_start = find_text_from(src, ":", close_start)
  let ok_case_start = find_text_from(src, "case", colon_start)
  let ok_colon_start = find_text_from(src, ":", ok_case_start)
  let ok_value_start = find_text_from(src, binding_name, ok_colon_start)
  let match_end = next_index(colon_start, sico.bytes.length(src))
  let operation_end = next_index(close_start, sico.bytes.length(src))
  let ok_case_end = next_index(ok_colon_start, sico.bytes.length(src))
  let ok_value_end = ok_value_start
  match U64.checked_add(ok_value_start, sico.bytes.length(sico.text.encode(binding_name))):
    case ok(after_ok_value):
      set ok_value_end = after_ok_value
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  let error_case_start = find_text_from(src, "case", ok_value_end)
  let error_colon_start = find_text_from(src, ":", error_case_start)
  let zero_start = find_text_from(src, "0", error_colon_start)
  let literal_close_start = find_text_from(src, ")", zero_start)
  let error_case_end = next_index(error_colon_start, sico.bytes.length(src))
  let zero_end = next_index(zero_start, sico.bytes.length(src))
  let fallback_start = find_text_from(src, word_at(words, literal_receiver), error_colon_start)
  let fallback_end = fallback_start
  match U64.checked_add(fallback_start, sico.bytes.length(sico.text.encode(word_at(words, literal_receiver)))):
    case ok(after_fallback):
      set fallback_end = after_fallback
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  let error_block_end = next_index(literal_close_start, sico.bytes.length(src))
  if I64.equal(fallback_is_parameter, I64.literal(1)):
    set error_block_end = fallback_end
  end if
  let end_function_offset = find_text_from(src, "end function", fn_start)
  let fn_end = fn_start
  match U64.checked_add(end_function_offset, U64.literal(13)):
    case ok(after_end_function):
      set fn_end = after_end_function
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  if U64.less_than(sico.bytes.length(src), fn_end):
    set fn_end = sico.bytes.length(src)
