  set gcp_compare = sico.text.concat(gcp_compare, ",\"ty\":{\"kind\":\"bool\"},\"operation\":{\"op\":\"")
  set gcp_compare = sico.text.concat(gcp_compare, gcp_op)
  set gcp_compare = sico.text.concat(gcp_compare, "\",\"data\":{\"left\":")
  set gcp_compare = sico.text.concat(gcp_compare, sico.u64.to_text(gcp_l_value))
  set gcp_compare = sico.text.concat(gcp_compare, ",\"right\":")
  set gcp_compare = sico.text.concat(gcp_compare, sico.u64.to_text(gcp_r_value))
  set gcp_compare = sico.text.concat(gcp_compare, "}},\"range\":{\"start\":")
  set gcp_compare = sico.text.concat(gcp_compare, sico.u64.to_text(cond_start))
  set gcp_compare = sico.text.concat(gcp_compare, ",\"end\":")
  set gcp_compare = sico.text.concat(gcp_compare, sico.u64.to_text(gcp_cond_end))
  set gcp_compare = sico.text.concat(gcp_compare, "}}")
  if U64.less_than(U64.literal(0), sico.text.length(gcp_json)):
    set gcp_json = sico.text.concat(gcp_json, gcp_compare)
  else:
