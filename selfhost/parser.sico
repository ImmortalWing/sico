    return "ERR:E-SH-IR-CALL-TYPE"
  end if
  let gcc_open = next_index(cond_idx, line_end)
  if is_word(word_at(words, gcc_open), "("):
    let gcc_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  let gcc_close = matching_close(words, gcc_open, line_end)
  let gcc_colon = next_index(gcc_close, line_end)
  if is_word(word_at(words, gcc_colon), ":"):
    if U64.equal(next_index(gcc_colon, line_end), line_end):
      let gcc_complete = I64.literal(1)
    else:
      return "ERR:E-SH-IR-CALL-SHAPE"
    end if
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  let gcc_argument = next_index(gcc_open, gcc_close)
  if is_intrinsic_path(words, gcc_argument, "bytes", "at"):
    if U64.equal(count_params(words, gcc_callee_idx), U64.literal(1)):
      let gcc_arity_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-CALL-ARITY"
