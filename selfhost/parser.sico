    set gcp_l_kind = binding_parameter_kind(words, name_idx, gcp_l_atom)
  else:
    set gcp_l_kind = operand_nonparam_kind(words, gcp_l_idx, cell_names, cell_kinds)
    if sico.text.starts_with(gcp_l_kind, "ERR:"):
      return gcp_l_kind
    end if
    if U64.equal(sico.text.length(gcp_l_kind), U64.literal(0)):
      return "ERR:E-SH-IR-EXPRESSION"
    end if
    set gcp_l_json = operand_cell_or_literal_json(words, src, gcp_l_idx, base, cond_idx, cond_start, cell_names, cell_kinds, cell_locals)
    if sico.text.starts_with(gcp_l_json, "ERR:"):
      return gcp_l_json
    end if
    if U64.less_than(U64.literal(0), sico.text.length(gcp_l_json)):
      set gcp_l_count = U64.literal(1)
    end if
  end if
  if is_word(gcp_l_kind, gcp_ckind):
    let gcplk_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TYPE"
  end if
  let gcp_r_base = base
  match U64.checked_add(base, gcp_l_count):
    case ok(gcp_r_after_l):
      set gcp_r_base = gcp_r_after_l
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  let gcp_r_idx = fixed_operation_operand_atom_idx(words, cond_idx, name_idx, U64.literal(1))
  let gcp_r_atom = word_at(words, gcp_r_idx)
  let gcp_r_json = ""
  let gcp_r_count = U64.literal(0)
  let gcp_r_value = gcp_r_base
  let gcp_r_kind = ""
  let gcp_r_param = binding_parameter_index(words, name_idx, gcp_r_atom)
  if U64.less_than(gcp_r_param, parameter_count):
    set gcp_r_value = gcp_r_param
    set gcp_r_kind = binding_parameter_kind(words, name_idx, gcp_r_atom)
  else:
    set gcp_r_kind = operand_nonparam_kind(words, gcp_r_idx, cell_names, cell_kinds)
    if sico.text.starts_with(gcp_r_kind, "ERR:"):
      return gcp_r_kind
    end if
    if U64.equal(sico.text.length(gcp_r_kind), U64.literal(0)):
      return "ERR:E-SH-IR-EXPRESSION"
    end if
    set gcp_r_json = operand_cell_or_literal_json(words, src, gcp_r_idx, gcp_r_base, cond_idx, cond_start, cell_names, cell_kinds, cell_locals)
    if sico.text.starts_with(gcp_r_json, "ERR:"):
      return gcp_r_json
    end if
