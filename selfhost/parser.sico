  let sl_expression_end = return_expression_end(src, sl_expression_start)
  let sl_literal_count = fixed_operation_literal_count(words, sl_receiver_idx, name_idx)
  let sl_literals = fixed_operation_literal_instructions(words, src, sl_receiver_idx, name_idx, parameter_count, sl_receiver_idx, sl_expression_start)
  let sl_left = fixed_operation_operand_value(words, sl_receiver_idx, sl_let_end, name_idx, U64.literal(0))
  let sl_right = fixed_operation_operand_value(words, sl_receiver_idx, sl_let_end, name_idx, U64.literal(1))
  let sl_result = parameter_count
  match U64.checked_add(parameter_count, sl_literal_count):
    case ok(sl_result_id):
