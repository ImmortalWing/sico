                      set instructions_json = sico.text.concat(instructions_json, expression_type)
                      set instructions_json = sico.text.concat(instructions_json, "\"},\"operation\":{\"op\":\"call\",\"data\":{\"function\":")
                      set instructions_json = sico.text.concat(instructions_json, sico.u64.to_text(function_declaration_ordinal(words, call_target_idx)))
                      set instructions_json = sico.text.concat(instructions_json, ",\"arguments\":")
                      set instructions_json = sico.text.concat(instructions_json, call_arguments_json)
                      set instructions_json = sico.text.concat(instructions_json, "}},\"range\":{\"start\":")
                      set instructions_json = sico.text.concat(instructions_json, range_start_text)
                      set instructions_json = sico.text.concat(instructions_json, ",\"end\":")
                      set instructions_json = sico.text.concat(instructions_json, range_end_text)
                      set instructions_json = sico.text.concat(instructions_json, "}}]")
                  else:
                    if is_word(expression_kind, "fixed_op"):
                      match U64.checked_add(parameter_count, op_constant_count):
                        case ok(op_result):
                          set result_value = op_result
                        case error(_):
                          return "ERR:E-SH-IR-RANGE"
                      end match
                      set instructions_json = "["
                      set instructions_json = sico.text.concat(instructions_json, op_constants_json)
                      if U64.less_than(U64.literal(0), sico.text.length(op_constants_json)):
                        set instructions_json = sico.text.concat(instructions_json, ",")
                      end if
