end function

function list_aware_parameter_index(words: List[Text], function_name_idx: U64, binding: Text) returns U64:
  let lap_len = sico.list.length(words)
  let lap_open = next_index(function_name_idx, lap_len)
  let lap_token = next_index(lap_open, lap_len)
  let lap_id = U64.literal(0)
  while U64.less_than(lap_token, lap_len):
    if is_word(word_at(words, lap_token), ")"):
      return lap_len
    end if
    if is_word(word_at(words, lap_token), binding):
      return lap_id
    end if
    let lap_colon = next_index(lap_token, lap_len)
    let lap_type = next_index(lap_colon, lap_len)
    let lap_after_type = next_index(lap_type, lap_len)
    let lap_step = lap_after_type
    if is_word(word_at(words, lap_after_type), "["):
      set lap_step = next_index(lap_after_type, lap_len)
      set lap_step = next_index(lap_step, lap_len)
      set lap_step = next_index(lap_step, lap_len)
    end if
    if is_word(word_at(words, lap_step), ","):
      set lap_token = next_index(lap_step, lap_len)
      set lap_id = next_index(lap_id, lap_id)
    else:
      return lap_len
    end if
  end while
  return lap_len
end function

function nested_intrinsic_return_ir(words: List[Text], src: Bytes, name_idx: U64, body_from: U64, body_end: U64, fn_start: U64, function_ordinal: U64, parameter_count: U64) returns Text:
  let n = sico.list.length(words)
  let nir_scan = body_from
  while U64.less_than(nir_scan, body_end):
    if is_word(word_at(words, nir_scan), "return"):
      break
    end if
    set nir_scan = next_index(nir_scan, body_end)
  end while
  if U64.less_than(nir_scan, body_end):
    let nir_return_ok = I64.literal(1)
  else:
    return "SKIP"
  end if
  let nir_expr = next_index(nir_scan, n)
  if is_word(word_at(words, nir_expr), "sico"):
    let nir_path_ok = I64.literal(1)
  else:
    return "SKIP"
  end if
  let nir_line = line_end(words, nir_scan)
  let nir_after_line = next_index(nir_line, n)
  let nir_after_end = next_index(nir_after_line, n)
  if is_word(word_at(words, nir_after_line), "end"):
    let nir_end_ok = I64.literal(1)
  else:
    return "SKIP"
  end if
  if is_word(word_at(words, nir_after_end), "function"):
    let nir_function_ok = I64.literal(1)
  else:
    return "SKIP"
  end if
  if U64.equal(next_index(nir_after_end, n), body_end):
    let nir_complete = I64.literal(1)
  else:
    return "SKIP"
  end if
  let nir_u8d = I64.literal(0)
  let nir_u_seg = next_index(next_index(nir_expr, n), n)
  let nir_u_name = next_index(next_index(nir_u_seg, n), n)
  if is_word(word_at(words, next_index(nir_expr, n)), "."):
    if is_word(word_at(words, nir_u_seg), "bytes"):
      if is_word(word_at(words, nir_u_name), "utf8_decode"):
        set nir_u8d = I64.literal(1)
      end if
    end if
  end if
