    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, error_open), "("):
    let error_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, wildcard), "_"):
    let wildcard_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, error_close), ")"):
    let error_close_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, error_colon), ":"):
    let error_colon_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  if is_word(word_at(words, error_return), "return"):
    let error_return_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-MATCH-SHAPE"
  end if
  let fallback_parameter = binding_parameter_index(words, name_idx, word_at(words, literal_receiver))
  let fallback_is_parameter = I64.literal(0)
  if U64.less_than(fallback_parameter, parameter_count):
    if U64.equal(next_index(literal_receiver, n), line_end(words, error_return)):
      set fallback_is_parameter = I64.literal(1)
    else:
      return "ERR:E-SH-IR-MATCH-SHAPE"
    end if
  else:
    if is_word(word_at(words, literal_receiver), word_at(words, receiver)):
      let literal_receiver_ok = I64.literal(1)
    else:
