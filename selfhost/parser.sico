  end match
  if U64.less_than(sico.bytes.length(src), sl_fn_end):
    set sl_fn_end = sico.bytes.length(src)
  end if
  let sl_parameters = parameters_ir(words, name_idx, src, fn_start)
  if sico.text.starts_with(sl_parameters, "ERR:"):
    return sl_parameters
  end if
  let sl_instructions = "["
  set sl_instructions = sico.text.concat(sl_instructions, sl_literals)
  if U64.less_than(U64.literal(0), sico.text.length(sl_literals)):
    set sl_instructions = sico.text.concat(sl_instructions, ",")
  end if
  set sl_instructions = sico.text.concat(sl_instructions, "{\"result\":")
  set sl_instructions = sico.text.concat(sl_instructions, sico.u64.to_text(sl_result))
  set sl_instructions = sico.text.concat(sl_instructions, ",\"ty\":{\"kind\":\"")
  set sl_instructions = sico.text.concat(sl_instructions, sl_kind)
  set sl_instructions = sico.text.concat(sl_instructions, "\"},\"operation\":{\"op\":\"")
  set sl_instructions = sico.text.concat(sl_instructions, sl_operation)
  set sl_instructions = sico.text.concat(sl_instructions, "\",\"data\":")
  if is_word(sl_operation, "shl"):
    set sl_instructions = sico.text.concat(sl_instructions, "{\"value\":")
  else:
    if is_word(sl_operation, "shr"):
      set sl_instructions = sico.text.concat(sl_instructions, "{\"value\":")
    else:
      set sl_instructions = sico.text.concat(sl_instructions, "{\"left\":")
    end if
  end if
  set sl_instructions = sico.text.concat(sl_instructions, sico.u64.to_text(sl_left))
  if is_word(sl_operation, "shl"):
    set sl_instructions = sico.text.concat(sl_instructions, ",\"amount\":")
  else:
    if is_word(sl_operation, "shr"):
      set sl_instructions = sico.text.concat(sl_instructions, ",\"amount\":")
    else:
      set sl_instructions = sico.text.concat(sl_instructions, ",\"right\":")
    end if
  end if
  set sl_instructions = sico.text.concat(sl_instructions, sico.u64.to_text(sl_right))
  set sl_instructions = sico.text.concat(sl_instructions, "}},\"range\":{\"start\":")
  set sl_instructions = sico.text.concat(sl_instructions, sico.u64.to_text(sl_expression_start))
  set sl_instructions = sico.text.concat(sl_instructions, ",\"end\":")
  set sl_instructions = sico.text.concat(sl_instructions, sico.u64.to_text(sl_expression_end))
  set sl_instructions = sico.text.concat(sl_instructions, "}}]")
  let sl_json = "{\"id\":"
  set sl_json = sico.text.concat(sl_json, sico.u64.to_text(function_ordinal))
  set sl_json = sico.text.concat(sl_json, ",\"name\":\"")
  set sl_json = sico.text.concat(sl_json, word_at(words, name_idx))
  set sl_json = sico.text.concat(sl_json, "\",\"parameters\":")
  set sl_json = sico.text.concat(sl_json, sl_parameters)
  set sl_json = sico.text.concat(sl_json, ",\"return_type\":{\"kind\":\"")
  set sl_json = sico.text.concat(sl_json, return_kind)
  set sl_json = sico.text.concat(sl_json, "\"},\"effects\":[],\"entry\":0,\"blocks\":[{\"id\":0,\"instructions\":")
  set sl_json = sico.text.concat(sl_json, sl_instructions)
  set sl_json = sico.text.concat(sl_json, ",\"terminator\":{\"kind\":\"return\",\"data\":")
  set sl_json = sico.text.concat(sl_json, sico.u64.to_text(sl_result))
  set sl_json = sico.text.concat(sl_json, "},\"range\":{\"start\":")
  set sl_json = sico.text.concat(sl_json, sico.u64.to_text(fn_start))
  set sl_json = sico.text.concat(sl_json, ",\"end\":")
  set sl_json = sico.text.concat(sl_json, sico.u64.to_text(sl_fn_end))
  set sl_json = sico.text.concat(sl_json, "}}],\"range\":{\"start\":")
  set sl_json = sico.text.concat(sl_json, sico.u64.to_text(fn_start))
  set sl_json = sico.text.concat(sl_json, ",\"end\":")
  set sl_json = sico.text.concat(sl_json, sico.u64.to_text(sl_fn_end))
  set sl_json = sico.text.concat(sl_json, "}}")
  return sl_json
end function

function is_intrinsic_path(words: List[Text], start: U64, family: Text, member: Text) returns Bool:
  let n = sico.list.length(words)
  let dot1 = next_index(start, n)
  let family_idx = next_index(dot1, n)
  let dot2 = next_index(family_idx, n)
  let member_idx = next_index(dot2, n)
  if is_word(word_at(words, start), "sico"):
    if is_word(word_at(words, dot1), "."):
      if is_word(word_at(words, family_idx), family):
        if is_word(word_at(words, dot2), "."):
          return is_word(word_at(words, member_idx), member)
        end if
      end if
    end if
  end if
  return false
end function

function intrinsic_instruction_json(result_id: U64, kind: Text, name: Text, arguments: Text, range_start: U64, range_end: U64) returns Text:
  let json = "{\"result\":"
  set json = sico.text.concat(json, sico.u64.to_text(result_id))
  set json = sico.text.concat(json, ",\"ty\":")
  set json = sico.text.concat(json, type_json(kind))
  set json = sico.text.concat(json, ",\"operation\":{\"op\":\"intrinsic\",\"data\":{\"name\":\"")
  set json = sico.text.concat(json, name)
  set json = sico.text.concat(json, "\",\"arguments\":")
  set json = sico.text.concat(json, arguments)
  set json = sico.text.concat(json, "}},\"range\":{\"start\":")
  set json = sico.text.concat(json, sico.u64.to_text(range_start))
  set json = sico.text.concat(json, ",\"end\":")
  set json = sico.text.concat(json, sico.u64.to_text(range_end))
  return sico.text.concat(json, "}}")
end function

function direct_bytes_equal_encode_ir(words: List[Text], src: Bytes, name_idx: U64, body_from: U64, body_end: U64, fn_start: U64, function_ordinal: U64, return_kind: Text, parameter_count: U64) returns Text:
  let n = sico.list.length(words)
  if U64.equal(parameter_count, U64.literal(2)):
    let arity_ok = I64.literal(1)
  else:
    return "SKIP"
  end if
  if is_word(return_kind, "bool"):
    let return_ok = I64.literal(1)
  else:
    return "SKIP"
  end if
  let return_idx = body_from
  while U64.less_than(return_idx, body_end):
    if is_word(word_at(words, return_idx), "return"):
      break
    end if
    set return_idx = next_index(return_idx, body_end)
  end while
  if U64.equal(return_idx, body_end):
    return "SKIP"
  end if
  let start = next_index(return_idx, n)
  if is_intrinsic_path(words, start, "bytes", "equal"):
    let outer_path_ok = I64.literal(1)
  else:
    return "SKIP"
  end if
  let outer_member = next_index(next_index(next_index(next_index(start, n), n), n), n)
  let outer_open = next_index(outer_member, n)
  if is_word(word_at(words, outer_open), "("):
    let outer_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  let outer_close = matching_close(words, outer_open, line_end(words, return_idx))
  if U64.equal(next_index(outer_close, n), line_end(words, return_idx)):
    let outer_complete = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  let left_start = next_index(outer_open, n)
  if is_intrinsic_path(words, left_start, "text", "encode"):
    let left_path_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TARGET"
  end if
  let left_member = next_index(next_index(next_index(next_index(left_start, n), n), n), n)
  let left_open = next_index(left_member, n)
  let left_close = matching_close(words, left_open, outer_close)
  let left_argument = next_index(left_open, n)
  if U64.equal(next_index(left_argument, n), left_close):
    let left_arity_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-ARITY"
  end if
  let comma = next_index(left_close, n)
  if is_word(word_at(words, comma), ","):
    let comma_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
  end if
  let right_start = next_index(comma, n)
  if is_intrinsic_path(words, right_start, "text", "encode"):
    let right_path_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TARGET"
  end if
  let right_member = next_index(next_index(next_index(next_index(right_start, n), n), n), n)
  let right_open = next_index(right_member, n)
  let right_close = matching_close(words, right_open, outer_close)
  let right_argument = next_index(right_open, n)
  if U64.equal(next_index(right_argument, n), right_close):
    let right_arity_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-ARITY"
  end if
  if U64.equal(next_index(right_close, n), outer_close):
    let outer_arity_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-ARITY"
  end if
  let left_value = binding_parameter_index(words, name_idx, word_at(words, left_argument))
  let right_value = binding_parameter_index(words, name_idx, word_at(words, right_argument))
  if U64.less_than(left_value, parameter_count):
    if is_word(binding_parameter_kind(words, name_idx, word_at(words, left_argument)), "string"):
      let left_type_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-CALL-TYPE"
    end if
  else:
    return "ERR:E-SH-IR-UNRESOLVED"
  end if
  if U64.less_than(right_value, parameter_count):
    if is_word(binding_parameter_kind(words, name_idx, word_at(words, right_argument)), "string"):
      let right_type_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-CALL-TYPE"
    end if
  else:
    return "ERR:E-SH-IR-UNRESOLVED"
  end if
  let parameters = parameters_ir(words, name_idx, src, fn_start)
  if sico.text.starts_with(parameters, "ERR:"):
    return parameters
  end if
  let expression_start = return_expression_start(src, fn_start)
  let left_start_offset = word_span_offset(words, src, expression_start, start, left_start)
  let left_close_offset = word_span_offset(words, src, expression_start, start, left_close)
  let right_start_offset = word_span_offset(words, src, expression_start, start, right_start)
  let right_close_offset = word_span_offset(words, src, expression_start, start, right_close)
  let expression_end = return_expression_end(src, expression_start)
  let left_end_offset = next_index(left_close_offset, sico.bytes.length(src))
  let right_end_offset = next_index(right_close_offset, sico.bytes.length(src))
  let left_result = parameter_count
  let right_result = next_index(left_result, left_result)
  let equal_result = next_index(right_result, right_result)
  let instructions = intrinsic_instruction_json(left_result, "bytes", "sico.text.encode", sico.text.concat("[", sico.text.concat(sico.u64.to_text(left_value), "]")), left_start_offset, left_end_offset)
  set instructions = sico.text.concat(instructions, ",")
  set instructions = sico.text.concat(instructions, intrinsic_instruction_json(right_result, "bytes", "sico.text.encode", sico.text.concat("[", sico.text.concat(sico.u64.to_text(right_value), "]")), right_start_offset, right_end_offset))
  set instructions = sico.text.concat(instructions, ",")
  let equal_arguments = sico.text.concat("[", sico.text.concat(sico.u64.to_text(left_result), sico.text.concat(",", sico.text.concat(sico.u64.to_text(right_result), "]"))))
  set instructions = sico.text.concat(instructions, intrinsic_instruction_json(equal_result, "bool", "sico.bytes.equal", equal_arguments, expression_start, expression_end))
  let end_function_offset = find_text_from(src, "end function", fn_start)
  let fn_end = fn_start
  match U64.checked_add(end_function_offset, U64.literal(13)):
    case ok(after_end_function):
      set fn_end = after_end_function
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  if U64.less_than(sico.bytes.length(src), fn_end):
    set fn_end = sico.bytes.length(src)
  end if
  let json = "{\"id\":"
  set json = sico.text.concat(json, sico.u64.to_text(function_ordinal))
  set json = sico.text.concat(json, ",\"name\":\"")
  set json = sico.text.concat(json, word_at(words, name_idx))
  set json = sico.text.concat(json, "\",\"parameters\":")
  set json = sico.text.concat(json, parameters)
  set json = sico.text.concat(json, ",\"return_type\":{\"kind\":\"bool\"},\"effects\":[],\"entry\":0,\"blocks\":[{\"id\":0,\"instructions\":[")
  set json = sico.text.concat(json, instructions)
  set json = sico.text.concat(json, "],\"terminator\":{\"kind\":\"return\",\"data\":")
  set json = sico.text.concat(json, sico.u64.to_text(equal_result))
  set json = sico.text.concat(json, "},\"range\":{\"start\":")
  set json = sico.text.concat(json, sico.u64.to_text(fn_start))
  set json = sico.text.concat(json, ",\"end\":")
  set json = sico.text.concat(json, sico.u64.to_text(fn_end))
  set json = sico.text.concat(json, "}}],\"range\":{\"start\":")
  set json = sico.text.concat(json, sico.u64.to_text(fn_start))
  set json = sico.text.concat(json, ",\"end\":")
  set json = sico.text.concat(json, sico.u64.to_text(fn_end))
  return sico.text.concat(json, "}}")
end function

function fixed_guard_condition_json(words: List[Text], src: Bytes, expr_idx: U64, expr_end: U64, name_idx: U64, expr_offset: U64, first_result: U64) returns Text:
  let n = sico.list.length(words)
  let receiver = word_at(words, expr_idx)
  let kind = ""
  if is_word(receiver, "I64"):
    set kind = "i64"
  else:
    if is_word(receiver, "U64"):
      set kind = "u64"
    else:
      return "SKIP:COND-RECEIVER"
    end if
  end if
  let dot = next_index(expr_idx, n)
  let predicate = next_index(dot, n)
  let open = next_index(predicate, n)
  if is_word(word_at(words, dot), "."):
    let dot_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  let operation = ""
  if is_word(word_at(words, predicate), "equal"):
    set operation = "equal_fixed"
  else:
    if is_word(word_at(words, predicate), "less_than"):
      set operation = "less_fixed"
    else:
      return "SKIP:COND-OPERATION"
    end if
  end if
  if is_word(word_at(words, open), "("):
    let open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  let left_idx = fixed_operation_operand_atom_idx(words, expr_idx, name_idx, U64.literal(0))
  let right_idx = fixed_operation_operand_atom_idx(words, expr_idx, name_idx, U64.literal(1))
  let left_value = binding_parameter_index(words, name_idx, word_at(words, left_idx))
  if U64.less_than(left_value, count_params(words, name_idx)):
    if is_word(binding_parameter_kind(words, name_idx, word_at(words, left_idx)), kind):
      let left_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-CALL-TYPE"
    end if
  else:
    return "SKIP:COND-LEFT"
  end if
  let right_kind = fixed_literal_argument(words, right_idx)
  if sico.text.starts_with(right_kind, "ERR:"):
    return right_kind
  end if
  if is_word(right_kind, kind):
    let right_ok = I64.literal(1)
  else:
    return "SKIP:COND-RIGHT"
  end if
  let right_width = fixed_operation_operand_width(words, right_idx, name_idx)
  let close = right_idx
  match U64.checked_add(right_idx, right_width):
    case ok(after_right):
      set close = after_right
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  if is_word(word_at(words, close), ")"):
    if U64.equal(next_index(close, n), expr_end):
      let shape_ok = I64.literal(1)
    else:
      return "ERR:E-SH-IR-EXPRESSION"
    end if
  else:
    return "ERR:E-SH-IR-EXPRESSION"
  end if
  let right_json = fixed_literal_operand_json(words, src, right_idx, expr_idx, expr_offset, first_result)
  if sico.text.starts_with(right_json, "ERR:"):
    return right_json
  end if
  let close_offset = word_span_offset(words, src, expr_offset, expr_idx, close)
  let condition_end = next_index(close_offset, sico.bytes.length(src))
  let result = next_index(first_result, first_result)
  let condition_json = "{\"result\":"
  set condition_json = sico.text.concat(condition_json, sico.u64.to_text(result))
  set condition_json = sico.text.concat(condition_json, ",\"ty\":{\"kind\":\"bool\"},\"operation\":{\"op\":\"")
  set condition_json = sico.text.concat(condition_json, operation)
  set condition_json = sico.text.concat(condition_json, "\",\"data\":{\"left\":")
  set condition_json = sico.text.concat(condition_json, sico.u64.to_text(left_value))
  set condition_json = sico.text.concat(condition_json, ",\"right\":")
  set condition_json = sico.text.concat(condition_json, sico.u64.to_text(first_result))
  set condition_json = sico.text.concat(condition_json, "}},\"range\":{\"start\":")
  set condition_json = sico.text.concat(condition_json, sico.u64.to_text(expr_offset))
  set condition_json = sico.text.concat(condition_json, ",\"end\":")
  set condition_json = sico.text.concat(condition_json, sico.u64.to_text(condition_end))
  set condition_json = sico.text.concat(condition_json, "}}")
  return sico.text.concat(right_json, sico.text.concat(",", condition_json))
end function

function user_call_expression_json(words: List[Text], src: Bytes, expr_idx: U64, expr_end: U64, name_idx: U64, expr_offset: U64, first_result: U64, expected_kind: Text) returns Text:
  let n = sico.list.length(words)
  let open = next_index(expr_idx, n)
  if is_word(word_at(words, open), "("):
    let open_ok = I64.literal(1)
  else:
    return "SKIP:CALL-OPEN"
  end if
  let close = matching_close(words, open, expr_end)
  if U64.equal(next_index(close, n), expr_end):
    let close_ok = I64.literal(1)
  else:
    return "SKIP:CALL-SHAPE"
  end if
  let callee_idx = function_declaration_index(words, word_at(words, expr_idx))
  if U64.equal(callee_idx, n):
    return "SKIP:CALL-TARGET"
  end if
  let callee_kind = declared_return_kind(words, next_index(callee_idx, n))
  if is_word(callee_kind, expected_kind):
    let return_kind_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-TYPE"
  end if
  let args_start = next_index(open, close)
  let empty_names = sico.text.split_lines("")
  let empty_kinds = sico.text.split_lines("")
  let empty_values = sico.list.empty[U64]()
  let arguments = environment_call_arguments(words, args_start, close, name_idx, callee_idx, empty_names, empty_kinds, empty_values, first_result)
  if sico.text.starts_with(arguments, "ERR:"):
    return arguments
  end if
  let literal_count = argument_region_instruction_count(words, args_start, close, name_idx)
  let literals = argument_instructions(words, src, expr_idx, expr_offset, args_start, close, name_idx, first_result)
  let result = first_result
  match U64.checked_add(first_result, literal_count):
    case ok(call_result):
      set result = call_result
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  let close_offset = word_span_offset(words, src, expr_offset, expr_idx, close)
  let expression_end = next_index(close_offset, sico.bytes.length(src))
  let call_json = call_instruction_json(result, callee_kind, function_declaration_ordinal(words, callee_idx), arguments, expr_offset, expression_end)
  if U64.less_than(U64.literal(0), sico.text.length(literals)):
    return sico.text.concat(literals, sico.text.concat(",", call_json))
  end if
  return call_json
end function

function fixed_guard_chain_ir(words: List[Text], src: Bytes, name_idx: U64, fn_start: U64, function_ordinal: U64) returns Text:
  let n = sico.list.length(words)
  let body_from = next_index(name_idx, n)
  let body_end = find_body_end(words, body_from)
  let guard_count = U64.literal(0)
  let count_cursor = body_from
  let count_previous = ""
  while U64.less_than(count_cursor, body_end):
    let count_word = word_at(words, count_cursor)
    if is_word(count_word, "if"):
      if is_word(count_previous, "end"):
        let closing_if = I64.literal(1)
      else:
        set guard_count = next_index(guard_count, guard_count)
      end if
    end if
    set count_previous = count_word
    set count_cursor = next_index(count_cursor, body_end)
  end while
  let parameter_count = count_params(words, name_idx)
  let return_kind = declared_return_kind(words, body_from)
  if U64.less_than(U64.literal(0), guard_count):
    let count_ok = I64.literal(1)
  else:
    return sico.text.concat("SKIP:COUNT:", sico.u64.to_text(guard_count))
  end if
  if U64.equal(parameter_count, U64.literal(1)):
    if is_word(return_kind, "bool"):
      let signature_ok = I64.literal(1)
    else:
      if is_word(return_kind, "string"):
        let string_signature_ok = I64.literal(1)
      else:
        return "SKIP:RETURN-TYPE"
      end if
    end if
  else:
    return "SKIP:ARITY"
  end if
  let end_function_offset = find_text_from(src, "end function", fn_start)
  let fn_end = fn_start
  match U64.checked_add(end_function_offset, U64.literal(13)):
    case ok(after_end):
      set fn_end = after_end
    case error(_):
      return "ERR:E-SH-IR-RANGE"
  end match
  if U64.less_than(sico.bytes.length(src), fn_end):
    set fn_end = sico.bytes.length(src)
  end if
  let parameters = parameters_ir(words, name_idx, src, fn_start)
  if sico.text.starts_with(parameters, "ERR:"):
    return parameters
  end if
  let blocks = ""
  let jumps = ""
  let emitted_blocks = U64.literal(0)
  let emitted_jumps = U64.literal(0)
  let next_value = parameter_count
  let guard_index = U64.literal(0)
  let idx = next_index(line_end(words, body_from), body_end)
  let source_cursor = fn_start
