          end if
          set functions_json = sico.text.concat(functions_json, control_if_json)
          let control_if_end_offset = find_text_from(src, "end function", fn_start)
          let control_if_fn_end = fn_start
          match U64.checked_add(control_if_end_offset, U64.literal(13)):
            case ok(control_if_after_end):
              set control_if_fn_end = control_if_after_end
            case error(_):
              return "ERR:E-SH-IR-RANGE"
          end match
          if U64.less_than(source_len, control_if_fn_end):
            set control_if_fn_end = source_len
          end if
          set source_cursor = control_if_fn_end
          set i = body_end_word
          set prev = "function"
          continue
        end if
        let body_statement_count = let_count
        if U64.less_than(body_statement_count, set_count):
          set body_statement_count = set_count
        end if
        if U64.less_than(U64.literal(0), body_statement_count):
          if U64.less_than(U64.literal(0), match_count):
            return "ERR:E-SH-IR-STATEMENT"
