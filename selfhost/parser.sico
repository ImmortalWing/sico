    return gw_compare_packed(words, src, name_idx, cond_idx, line_end, cond_start, cell_names, cell_kinds, cell_locals, parameter_count, base)
  end if
  if is_word(word_at(words, cond_idx), "sico"):
    return "ERR:E-SH-IR-SCICOND"
  end if
  let gcc_words_len = sico.list.length(words)
  let gcc_callee_idx = function_declaration_index(words, word_at(words, cond_idx))
  if U64.equal(gcc_callee_idx, gcc_words_len):
    return "ERR:E-SH-IR-CALL-TARGET"
  end if
