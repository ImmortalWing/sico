              if is_word(expression_kind, "const_bool"):
                set instructions_json = "[{\"result\":"
                set instructions_json = sico.text.concat(instructions_json, sico.u64.to_text(result_value))
                set instructions_json = sico.text.concat(instructions_json, ",\"ty\":{\"kind\":\"bool\"},\"operation\":{\"op\":\"const_bool\",\"data\":")
                set instructions_json = sico.text.concat(instructions_json, literal)
                set instructions_json = sico.text.concat(instructions_json, "},\"range\":{\"start\":")
                set instructions_json = sico.text.concat(instructions_json, range_start_text)
                set instructions_json = sico.text.concat(instructions_json, ",\"end\":")
                set instructions_json = sico.text.concat(instructions_json, range_end_text)
                set instructions_json = sico.text.concat(instructions_json, "}}]")
              else:
                if is_word(expression_kind, "const_string"):
                  set instructions_json = "[{\"result\":"
                  set instructions_json = sico.text.concat(instructions_json, sico.u64.to_text(result_value))
                  set instructions_json = sico.text.concat(instructions_json, ",\"ty\":{\"kind\":\"string\"},\"operation\":{\"op\":\"const_string\",\"data\":")
                  set instructions_json = sico.text.concat(instructions_json, string_value)
                  set instructions_json = sico.text.concat(instructions_json, "},\"range\":{\"start\":")
                  set instructions_json = sico.text.concat(instructions_json, range_start_text)
                  set instructions_json = sico.text.concat(instructions_json, ",\"end\":")
                  set instructions_json = sico.text.concat(instructions_json, range_end_text)
                  set instructions_json = sico.text.concat(instructions_json, "}}]")
                else:
                  if is_word(expression_kind, "binding"):
                    set result_value = binding_value
                    set instructions_json = "[]"
                  else:
                    if is_word(expression_kind, "call"):
                      match U64.checked_add(parameter_count, call_constant_count):
                        case ok(call_result):
                          set result_value = call_result
                        case error(_):
                          return "ERR:E-SH-IR-RANGE"
                      end match
                      set instructions_json = "["
                      set instructions_json = sico.text.concat(instructions_json, call_constants_json)
                      if U64.less_than(U64.literal(0), sico.text.length(call_constants_json)):
                        set instructions_json = sico.text.concat(instructions_json, ",")
                      end if
                      set instructions_json = sico.text.concat(instructions_json, "{\"result\":")
                      set instructions_json = sico.text.concat(instructions_json, sico.u64.to_text(result_value))
                      set instructions_json = sico.text.concat(instructions_json, ",\"ty\":{\"kind\":\"")
                      set instructions_json = sico.text.concat(instructions_json, expression_type)
                      set instructions_json = sico.text.concat(instructions_json, "\"},\"operation\":{\"op\":\"call\",\"data\":{\"function\":")
                      set instructions_json = sico.text.concat(instructions_json, sico.u64.to_text(function_declaration_ordinal(words, call_target_idx)))
                      set instructions_json = sico.text.concat(instructions_json, ",\"arguments\":")
                      set instructions_json = sico.text.concat(instructions_json, call_arguments_json)
                      set instructions_json = sico.text.concat(instructions_json, "}},\"range\":{\"start\":")
                      set instructions_json = sico.text.concat(instructions_json, range_start_text)
                      set instructions_json = sico.text.concat(instructions_json, ",\"end\":")
                      set instructions_json = sico.text.concat(instructions_json, range_end_text)
                      set instructions_json = sico.text.concat(instructions_json, "}}]")
                  else:
                    if is_word(expression_kind, "fixed_op"):
                      match U64.checked_add(parameter_count, op_constant_count):
                        case ok(op_result):
                          set result_value = op_result
                        case error(_):
                          return "ERR:E-SH-IR-RANGE"
                      end match
                      set instructions_json = "["
                      set instructions_json = sico.text.concat(instructions_json, op_constants_json)
                      if U64.less_than(U64.literal(0), sico.text.length(op_constants_json)):
                        set instructions_json = sico.text.concat(instructions_json, ",")
                      end if
                      set instructions_json = sico.text.concat(instructions_json, "{\"result\":")
                      set instructions_json = sico.text.concat(instructions_json, sico.u64.to_text(result_value))
                      set instructions_json = sico.text.concat(instructions_json, ",\"ty\":{\"kind\":\"")
                      set instructions_json = sico.text.concat(instructions_json, expression_type)
                      set instructions_json = sico.text.concat(instructions_json, "\"},\"operation\":{\"op\":\"")
                      set instructions_json = sico.text.concat(instructions_json, fixed_op_name_value)
                      set instructions_json = sico.text.concat(instructions_json, "\",\"data\":")
                      if is_word(fixed_op_name_value, "shl"):
                        set instructions_json = sico.text.concat(instructions_json, "{\"value\":")
                      else:
                        if is_word(fixed_op_name_value, "shr"):
                          set instructions_json = sico.text.concat(instructions_json, "{\"value\":")
                        else:
                          set instructions_json = sico.text.concat(instructions_json, "{\"left\":")
                        end if
                      end if
                      set instructions_json = sico.text.concat(instructions_json, sico.u64.to_text(fixed_op_left))
                      if is_word(fixed_op_name_value, "shl"):
                        set instructions_json = sico.text.concat(instructions_json, ",\"amount\":")
                      else:
                        if is_word(fixed_op_name_value, "shr"):
                          set instructions_json = sico.text.concat(instructions_json, ",\"amount\":")
                        else:
                          set instructions_json = sico.text.concat(instructions_json, ",\"right\":")
                        end if
                      end if
                      set instructions_json = sico.text.concat(instructions_json, sico.u64.to_text(fixed_op_right))
                      set instructions_json = sico.text.concat(instructions_json, "}},\"range\":{\"start\":")
                      set instructions_json = sico.text.concat(instructions_json, range_start_text)
                      set instructions_json = sico.text.concat(instructions_json, ",\"end\":")
                      set instructions_json = sico.text.concat(instructions_json, range_end_text)
                      set instructions_json = sico.text.concat(instructions_json, "}}]")
                    else:
                      return "ERR:E-SH-IR-EXPRESSION-KIND"
                    end if
                    end if
                  end if
                end if
              end if
            end if
          end if
        end if
        let function_json = "{\"id\":"
        set function_json = sico.text.concat(function_json, sico.u64.to_text(function_ordinal))
        set function_json = sico.text.concat(function_json, ",\"name\":\"")
        set function_json = sico.text.concat(function_json, function_name)
        set function_json = sico.text.concat(function_json, "\",\"parameters\":")
        set function_json = sico.text.concat(function_json, parameters_json)
        set function_json = sico.text.concat(function_json, ",\"return_type\":{\"kind\":\"")
        set function_json = sico.text.concat(function_json, return_type_kind)
        set function_json = sico.text.concat(function_json, "\"},\"effects\":[],\"entry\":0,\"blocks\":[{\"id\":0,\"instructions\":")
        set function_json = sico.text.concat(function_json, instructions_json)
        set function_json = sico.text.concat(function_json, ",\"terminator\":{\"kind\":\"return\",\"data\":")
        set function_json = sico.text.concat(function_json, sico.u64.to_text(result_value))
        set function_json = sico.text.concat(function_json, "},\"range\":{\"start\":")
        set function_json = sico.text.concat(function_json, sico.u64.to_text(fn_start))
        set function_json = sico.text.concat(function_json, ",\"end\":")
        set function_json = sico.text.concat(function_json, sico.u64.to_text(fn_end))
        set function_json = sico.text.concat(function_json, "}}],\"range\":{\"start\":")
        set function_json = sico.text.concat(function_json, sico.u64.to_text(fn_start))
        set function_json = sico.text.concat(function_json, ",\"end\":")
        set function_json = sico.text.concat(function_json, sico.u64.to_text(fn_end))
        set function_json = sico.text.concat(function_json, "}}")
        if U64.less_than(U64.literal(1), function_count):
          set functions_json = sico.text.concat(functions_json, ",")
        end if
        set functions_json = sico.text.concat(functions_json, function_json)
        set source_cursor = fn_end
        set i = body_end_word
        set prev = "function"
        continue
      end if
    end if
    set prev = token
    set i = next_index(i, n)
  end while
  if U64.equal(function_count, U64.literal(0)):
    return "ERR:E-SH-IR-FUNCTION-COUNT"
  end if
  let json = "{\"schema\":\"sico.ir.v0\",\"source_name\":\"selfhost-input.sico\",\"source_len\":"
  set json = sico.text.concat(json, sico.u64.to_text(source_len))
  set json = sico.text.concat(json, ",\"functions\":[")
  set json = sico.text.concat(json, functions_json)
  set json = sico.text.concat(json, "]}")
  return json
end function

function main(input: ScriptInput) returns Result[ScriptOutput, ScriptError]:
  let words = lex_words(input.stdin)
  match sico.list.get(input.arguments, U64.literal(0)):
    case ok(mode):
      if is_word(mode, "--emit-ir"):
        let ir = scalar_ir(words, input.stdin)
        if sico.text.starts_with(ir, "ERR:"):
          return invalid_input(ir)
        end if
        return ok(ScriptOutput(stdout: sico.text.encode(ir), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
      end if
    case error(_):
      let no_mode = I64.literal(0)
  end match
  let out = summarize(words)
  return ok(ScriptOutput(stdout: sico.text.encode(out), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
end function
