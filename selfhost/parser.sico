function while_bytes_at_local_src_packed(words: List[Text], src: Bytes, name_idx: U64, receiver_idx: U64, line_end: U64, expr_start: U64, line_end_offset: U64, cell_names: List[Text], cell_kinds: List[Text], cell_locals: List[U64], parameter_count: U64, base: U64) returns Text:
  let sbl_member = next_index(next_index(next_index(next_index(receiver_idx, line_end), line_end), line_end), line_end)
  let sbl_open = next_index(sbl_member, line_end)
  if is_word(word_at(words, sbl_open), "("):
    let sbl_open_ok = I64.literal(1)
  else:
    return "ERR:E-SH-IR-CALL-SHAPE"
