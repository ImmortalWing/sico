// mutation: MUT-005
// syntax: C
// source-case: RESULT-002
// expect: reject(SYNTAX_MISSING_ENUM_CLOSE)
// recovery: next-definition(AppError)

enum ParseError {
  Empty,
  Invalid(value: Text),

enum AppError {
  MissingInput,
  BadInput(value: Text),
}

fn parse() -> Result[Int, ParseError] {
  return Ok(1)
}

fn load() -> Result[Int, AppError] {
  return parse().map_error(fn(problem) => match problem {
    ParseError.Empty: AppError.MissingInput,
    ParseError.Invalid(value): AppError.BadInput(value),
  })
}
