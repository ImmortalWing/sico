// syntax: A0
// source-case: RES-002
// expect: reject(SYNTAX_MISSING_USING_CLOSE)
// recovery: function-close(read_once)

enum ReadError
  Failed
end

resource Reader
  fn read(borrow self) -> Result<Text, ReadError>
  fn close(self) -> Unit
end

fn read_once(reader: Reader) -> Result<Text, ReadError>
  using reader
    return reader.read()
end
