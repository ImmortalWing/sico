enum ReadError
  Failed
end

resource Reader
  fn read(borrow self) -> Result<Text, ReadError>
  fn close(self) -> Unit

fn read_once(reader: Reader) -> Result<Text, ReadError>
  using reader
    return reader.read()
  end
end
