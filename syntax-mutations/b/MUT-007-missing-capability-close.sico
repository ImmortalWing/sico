// mutation: MUT-007
// syntax: B
// source-case: CAP-001
// expect: reject(SYNTAX_MISSING_CAPABILITY_CLOSE)
// recovery: next-definition(announce)

enum ConsoleError:
  case Denied
end enum

capability Console:
  function write(text: Text) returns Result[Unit, ConsoleError]

export function announce(console: Console) returns Result[Unit, ConsoleError]:
  effects:
    console.write
  capabilities:
    console
  return console.write("ready")
end function
