// mutation: MUT-009
// syntax: B
// source-case: RES-002
// expect: reject(SYNTAX_MISSING_USING_CLOSE)
// recovery: function-close(read_once)

enum ReadError:
  case Failed
end enum

resource Reader:
  function read(borrow self) returns Result[Text, ReadError]
  function close(self) returns Unit
end resource

function read_once(reader: Reader) returns Result[Text, ReadError]:
  using reader:
    return reader.read()
end function
