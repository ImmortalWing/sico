      "sico-source",
      "sico-syntax",
      "sico-lexer",
      "sico-parser",
      "sico-hir",
      "sico-semantics"
    ],
    "compiler": [
      "sico-diagnostics",
      "sico-format",
      "sico-index",
      "sico-ir",
      "sico-codegen-wasm"
    ],
    "observability": [
      "sico-observability"
    ],
    "tooling": [
      "sico-ai-tools",
      "sico-cli",
      "sico-language-server",
      "sico-mcp-server",
      "sico-tooling-protocol"
    ],
    "application": [
      "sico-package"
    ],
    "runtime": [
      "sico-runtime",
      "sico-app-cli"
    ],
    "host": [
      "sico-host-core",
      "sico-desktop-host",
      "sico-mobile-host-core"
    ],
    "ecosystem": [
      "sico-ecosystem",
      "sico-registry-server"
    ],
    "integration": [
      "sico-third-party-pilot"
    ]
  },
  "allowed_normal_dependencies": {
    "language": [
      "language"
    ],
    "compiler": [
      "language",
      "compiler",
      "observability"
    ],
    "observability": [
      "observability"
    ],
    "tooling": [
      "language",
      "compiler",
      "observability",
      "tooling"
    ],
    "application": [
      "application"
    ],
    "runtime": [
      "application",
      "observability",
      "runtime"
    ],
    "host": [
      "application",
      "observability",
      "runtime",
      "host"
    ],
    "ecosystem": [
      "application",
      "ecosystem"
    ],
    "integration": [
      "language",
      "compiler",
      "observability",
      "tooling",
      "application",
      "runtime",
      "host",
      "ecosystem",
      "integration"
    ]
  },
  "allowed_normal_dependency_exceptions": [
    {
      "source": "sico-app-cli",
      "target": "sico-codegen-wasm",
      "reason": "sico-app dev directly orchestrates source compilation before package execution"
    },
    {
      "source": "sico-app-cli",
      "target": "sico-ir",
      "reason": "sico-app dev validates compiler IR support before Runtime launch"
    },
    {
      "source": "sico-cli",
      "target": "sico-package",
      "reason": "the M8 Script compiler command composes the versioned Script adapter"
    },
    {
      "source": "sico-package",
      "target": "sico-codegen-wasm",
      "reason": "Script package composition reuses the compiler-owned deterministic adapter generator"
    }
  ],
  "command_ownership": {
    "sico": [
      "check",
      "format",
      "outline",
      "build-component"
    ],
    "sico-app": [
      "pack-sapp",
      "inspect-sapp",
      "run-sapp",
      "dev-source-orchestration"
    ],
    "sico-desktop-host": [
      "install",
      "open",
      "uninstall",
      "platform-association"
    ]
  }
}
