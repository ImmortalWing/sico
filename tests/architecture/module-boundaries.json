{
  "schema": "sico.module-boundaries.v1",
  "model": "openjdk-style-modular-monorepo",
  "modules": {
    "language": [
      "sico-source",
      "sico-syntax",
      "sico-lexer",
      "sico-parser",
      "sico-hir",
      "sico-semantics"
    ],
    "compiler": [
      "sico-diagnostics",
      "sico-format",
      "sico-index",
      "sico-ir",
      "sico-codegen-wasm"
    ],
    "tooling": [
      "sico-cli",
      "sico-language-server",
      "sico-ai-tools"
    ],
    "application": [
      "sico-package"
    ],
    "runtime": [
      "sico-runtime",
      "sico-app-cli"
    ],
    "host": [
      "sico-host-core",
      "sico-desktop-host",
      "sico-mobile-host-core"
    ],
    "ecosystem": [
      "sico-ecosystem",
      "sico-registry-server"
    ],
    "integration": [
      "sico-third-party-pilot"
    ]
  },
  "allowed_normal_dependencies": {
    "language": ["language"],
    "compiler": ["language", "compiler"],
    "tooling": ["language", "compiler", "tooling"],
    "application": ["application"],
    "runtime": ["application", "runtime"],
    "host": ["application", "runtime", "host"],
    "ecosystem": ["application", "ecosystem"],
    "integration": [
      "language",
      "compiler",
      "tooling",
      "application",
      "runtime",
      "host",
      "ecosystem",
      "integration"
    ]
  },
  "command_ownership": {
    "sico": ["check", "format", "outline", "build-component"],
    "sico-app": ["pack-sapp", "inspect-sapp", "run-sapp", "dev-source-orchestration"],
    "sico-desktop-host": ["install", "open", "uninstall", "platform-association"]
  }
}
