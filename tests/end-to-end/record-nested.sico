record ScriptInput:
  field arguments: List[Text]
  field stdin: Bytes
end record

record ScriptOutput:
  field stdout: Bytes
  field stderr: Bytes
  field exit_code: I64
end record

enum ScriptErrorCode:
  case InvalidInput
  case ResourceLimit
  case DomainError
  case Cancelled
end enum

record ScriptError:
  field code: ScriptErrorCode
  field message: Text
end record

record Point:
  x: I64
  y: I64
end record

record Segment:
  a: Point
  b: Point
  label: Text
end record

function main(input: ScriptInput) returns Result[ScriptOutput, ScriptError]:
  let seg = Segment(a: Point(x: I64.literal(1), y: I64.literal(2)), b: Point(x: I64.literal(3), y: I64.literal(4)), label: "diag")
  match I64.checked_add(seg.b.x, seg.a.y):
    case ok(total):
      if I64.equal(total, I64.literal(5)):
        return ok(ScriptOutput(stdout: sico.text.encode("record-nested-ok"), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
      else:
        return error(ScriptError(code: ScriptErrorCode.DomainError, message: "chain mismatch"))
      end if
    case error(_):
      return error(ScriptError(code: ScriptErrorCode.DomainError, message: "overflow"))
  end match
end function
