record ScriptInput:
  field arguments: List[Text]
  field stdin: Bytes
end record

record ScriptOutput:
  field stdout: Bytes
  field stderr: Bytes
  field exit_code: I64
end record

enum ScriptErrorCode:
  case InvalidInput
  case ResourceLimit
  case DomainError
  case Cancelled
end enum

record ScriptError:
  field code: ScriptErrorCode
  field message: Text
end record

function fail(message: Text) returns Result[ScriptOutput, ScriptError]:
  return error(ScriptError(code: ScriptErrorCode.DomainError, message: message))
end function

function finish(result: Result[Bool, Text]) returns Result[ScriptOutput, ScriptError]:
  match result:
    case ok(done):
      return ok(ScriptOutput(stdout: sico.text.encode("transformed"), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
    case error(message):
      return fail(message)
  end match
end function

function decode_and_finish(content: Bytes) returns Result[ScriptOutput, ScriptError]:
  match sico.bytes.is_utf8(content):
    case true:
      return finish(sico.fs.write("output.txt", sico.text.encode(sico.text.concat("words: ", sico.u64.to_text(sico.list.length(sico.text.split_words(sico.bytes.utf8_decode(content))))))))
    case false:
      return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: "input is not UTF-8"))
  end match
end function

function transformed(result: Result[Bytes, Text]) returns Result[ScriptOutput, ScriptError]:
  match result:
    case ok(content):
      return decode_and_finish(content)
    case error(message):
      return fail(message)
  end match
end function

function main(input: ScriptInput) returns Result[ScriptOutput, ScriptError]:
  return transformed(sico.fs.read("../secret.txt"))
end function
