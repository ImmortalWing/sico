record ScriptInput:
  field arguments: List[Text]
  field stdin: Bytes
end record

record ScriptOutput:
  field stdout: Bytes
  field stderr: Bytes
  field exit_code: I64
end record

enum ScriptErrorCode:
  case InvalidInput
  case ResourceLimit
  case DomainError
  case Cancelled
end enum

record ScriptError:
  field code: ScriptErrorCode
  field message: Text
end record

function dive(n: I64) returns I64:
  match I64.checked_add(n, I64.literal(1)):
    case ok(next):
      return dive(next)
    case error(_):
      return n
  end match
end function

function main(input: ScriptInput) returns Result[ScriptOutput, ScriptError]:
  let depth = dive(I64.literal(0))
  return ok(ScriptOutput(stdout: sico.text.encode("unreachable"), stderr: sico.text.encode(""), exit_code: depth))
end function
