record ScriptInput:
  field arguments: List[Text]
  field stdin: Bytes
end record

record ScriptOutput:
  field stdout: Bytes
  field stderr: Bytes
  field exit_code: I64
end record

enum ScriptErrorCode:
  case InvalidInput
  case ResourceLimit
  case DomainError
  case Cancelled
end enum

record ScriptError:
  field code: ScriptErrorCode
  field message: Text
end record

function fail(message: Text) returns Result[ScriptOutput, ScriptError]:
  return ok(ScriptOutput(stdout: sico.text.encode(sico.text.concat("error:", message)), stderr: sico.text.encode(""), exit_code: I64.literal(1)))
end function

function pick() returns Result[ScriptOutput, ScriptError]:
  match sico.picker.open("sico picker open window", sico.text.split_words("")):
    case ok(chosen):
      return ok(ScriptOutput(stdout: sico.text.encode(chosen), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
    case error(name):
      return fail(name)
  end match
end function

function main(input: ScriptInput) returns Result[ScriptOutput, ScriptError]:
  return pick()
end function
