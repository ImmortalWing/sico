record ScriptInput:
  field arguments: List[Text]
  field stdin: Bytes
end record

record ScriptOutput:
  field stdout: Bytes
  field stderr: Bytes
  field exit_code: I64
end record

enum ScriptErrorCode:
  case InvalidInput
  case ResourceLimit
  case DomainError
  case Cancelled
end enum

record ScriptError:
  field code: ScriptErrorCode
  field message: Text
end record

async function shout(word: Text) returns Text:
  return sico.text.concat(word, "!")
end function

function main(input: ScriptInput) returns Result[ScriptOutput, ScriptError]:
  task group:
    let first = spawn shout("alpha")
    let second = spawn shout("beta")
    return ok(ScriptOutput(stdout: sico.text.encode(sico.text.concat(sico.text.concat(await first, " "), await second)), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
  end task
end function
