record ScriptInput:
  field arguments: List[Text]
  field stdin: Bytes
end record

record ScriptOutput:
  field stdout: Bytes
  field stderr: Bytes
  field exit_code: I64
end record

enum ScriptErrorCode:
  case InvalidInput
  case ResourceLimit
  case DomainError
  case Cancelled
end enum

record ScriptError:
  field code: ScriptErrorCode
  field message: Text
end record

function main(input: ScriptInput) returns Result[ScriptOutput, ScriptError]:
  let l0 = sico.list.empty[I64]()
  let l1 = sico.list.append[I64](l0, I64.literal(10))
  let l2 = sico.list.append[I64](l1, I64.literal(20))
  let l3 = sico.list.append[I64](l2, I64.literal(30))
  let total = I64.literal(0)
  let out = ""
  for n in l3:
    match I64.checked_add(total, n):
      case ok(next):
        set total = next
        set out = sico.text.concat(out, sico.i64.to_text(n))
      case error(_):
        return error(ScriptError(code: ScriptErrorCode.DomainError, message: "overflow"))
    end match
  end for
  set out = sico.text.concat(out, sico.text.concat("=", sico.i64.to_text(total)))
  return ok(ScriptOutput(stdout: sico.text.encode(out), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
end function
