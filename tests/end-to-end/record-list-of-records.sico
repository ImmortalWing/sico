record ScriptInput:
  field arguments: List[Text]
  field stdin: Bytes
end record

record ScriptOutput:
  field stdout: Bytes
  field stderr: Bytes
  field exit_code: I64
end record

enum ScriptErrorCode:
  case InvalidInput
  case ResourceLimit
  case DomainError
  case Cancelled
end enum

record ScriptError:
  field code: ScriptErrorCode
  field message: Text
end record

record Point:
  x: I64
  y: I64
end record

function main(input: ScriptInput) returns Result[ScriptOutput, ScriptError]:
  let l1 = sico.list.append[Point](sico.list.empty[Point](), Point(x: I64.literal(1), y: I64.literal(2)))
  let l2 = sico.list.append[Point](l1, Point(x: I64.literal(3), y: I64.literal(4)))
  let l3 = sico.list.append[Point](l2, Point(x: I64.literal(5), y: I64.literal(6)))
  let l4 = sico.list.append[Point](l3, Point(x: I64.literal(7), y: I64.literal(8)))
  match sico.list.get[Point](l4, U64.literal(0)):
    case error(_):
      return error(ScriptError(code: ScriptErrorCode.DomainError, message: "get-0-failed"))
    case ok(first):
      match sico.list.get[Point](l4, U64.literal(3)):
        case error(_):
          return error(ScriptError(code: ScriptErrorCode.DomainError, message: "get-3-failed"))
        case ok(last):
          match sico.list.get[Point](l4, U64.literal(9)):
            case ok(_):
              return error(ScriptError(code: ScriptErrorCode.DomainError, message: "get-9-should-error"))
            case error(_):
              match U64.equal(sico.list.length[Point](l4), U64.literal(4)):
                case true:
                  if I64.equal(first.x, I64.literal(1)):
                    if I64.equal(first.y, I64.literal(2)):
                      if I64.equal(last.x, I64.literal(7)):
                        if I64.equal(last.y, I64.literal(8)):
                          let total = I64.literal(0)
                          for p in l4:
                            match I64.checked_add(total, p.x):
                              case ok(next_x):
                                match I64.checked_add(next_x, p.y):
                                  case ok(next):
                                    set total = next
                                  case error(_):
                                    return error(ScriptError(code: ScriptErrorCode.DomainError, message: "for-sum-overflow"))
                                end match
                              case error(_):
                                return error(ScriptError(code: ScriptErrorCode.DomainError, message: "for-sum-overflow"))
                            end match
                          end for
                          if I64.equal(total, I64.literal(36)):
                            return ok(ScriptOutput(stdout: sico.text.encode("record-list-of-records-ok"), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
                          else:
                            return error(ScriptError(code: ScriptErrorCode.DomainError, message: "for-sum"))
                          end if
                        else:
                          return error(ScriptError(code: ScriptErrorCode.DomainError, message: "last.y"))
                        end if
                      else:
                        return error(ScriptError(code: ScriptErrorCode.DomainError, message: "last.x"))
                      end if
                    else:
                      return error(ScriptError(code: ScriptErrorCode.DomainError, message: "first.y"))
                    end if
                  else:
                    return error(ScriptError(code: ScriptErrorCode.DomainError, message: "first.x"))
                  end if
                case false:
                  return error(ScriptError(code: ScriptErrorCode.DomainError, message: "length"))
              end match
          end match
      end match
  end match
end function
