record ScriptInput:
  field arguments: List[Text]
  field stdin: Bytes
end record

record ScriptOutput:
  field stdout: Bytes
  field stderr: Bytes
  field exit_code: I64
end record

enum ScriptErrorCode:
  case InvalidInput
  case ResourceLimit
  case DomainError
  case Cancelled
end enum

record ScriptError:
  field code: ScriptErrorCode
  field message: Text
end record

record HttpResponse:
  field status: I64
  field body: Bytes
end record

function fail(message: Text) returns Result[ScriptOutput, ScriptError]:
  match sico.text.contains(message, "cancelled"):
    case true:
      return error(ScriptError(code: ScriptErrorCode.Cancelled, message: message))
    case false:
      return error(ScriptError(code: ScriptErrorCode.DomainError, message: message))
  end match
end function

function finish(result: Result[HttpResponse, Text]) returns Result[ScriptOutput, ScriptError]:
  match result:
    case ok(response):
      return ok(ScriptOutput(stdout: sico.bytes.concat(sico.text.encode(sico.text.concat(sico.i64.to_text(response.status), ":")), response.body), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
    case error(message):
      return fail(message)
  end match
end function

function main(input: ScriptInput) returns Result[ScriptOutput, ScriptError]:
  return finish(sico.http.request("POST", sico.text.join(input.arguments, ""), input.stdin))
end function
