record ScriptInput:
  field arguments: List[Text]
  field stdin: Bytes
end record

record ScriptOutput:
  field stdout: Bytes
  field stderr: Bytes
  field exit_code: I64
end record

enum ScriptErrorCode:
  case InvalidInput
  case ResourceLimit
  case DomainError
  case Cancelled
end enum

record ScriptError:
  field code: ScriptErrorCode
  field message: Text
end record

function lookup(document: Text) returns Result[ScriptOutput, ScriptError]:
  match sico.json.has(document, "name"):
    case true:
      return ok(ScriptOutput(stdout: sico.text.encode(sico.json.get(document, "name")), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
    case false:
      return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: "missing name field"))
  end match
end function

function main(input: ScriptInput) returns Result[ScriptOutput, ScriptError]:
  match sico.json.is_valid(sico.bytes.utf8_decode(input.stdin)):
    case true:
      return lookup(sico.bytes.utf8_decode(input.stdin))
    case false:
      return error(ScriptError(code: ScriptErrorCode.InvalidInput, message: "malformed JSON"))
  end match
end function
