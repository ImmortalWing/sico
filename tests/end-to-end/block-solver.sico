record ScriptInput:
  field arguments: List[Text]
  field stdin: Bytes
end record

record ScriptOutput:
  field stdout: Bytes
  field stderr: Bytes
  field exit_code: I64
end record

enum ScriptErrorCode:
  case InvalidInput
  case ResourceLimit
  case DomainError
  case Cancelled
end enum

record ScriptError:
  field code: ScriptErrorCode
  field message: Text
end record

function addU(a: U64, b: U64) returns U64:
  match U64.checked_add(a, b):
    case ok(v):
      return v
    case error(_):
      return U64.literal(18446744073709551615)
  end match
end function

function subU(a: U64, b: U64) returns U64:
  match U64.checked_sub(a, b):
    case ok(v):
      return v
    case error(_):
      return U64.literal(0)
  end match
end function

function mulU(a: U64, b: U64) returns U64:
  match U64.checked_mul(a, b):
    case ok(v):
      return v
    case error(_):
      return U64.literal(18446744073709551615)
  end match
end function

function addI(a: I64, b: I64) returns I64:
  match I64.checked_add(a, b):
    case ok(v):
      return v
    case error(_):
      return I64.literal(9223372036854775807)
  end match
end function

function negI(a: I64) returns I64:
  return subI(I64.literal(0), a)
end function

function subI(a: I64, b: I64) returns I64:
  match I64.checked_sub(a, b):
    case ok(v):
      return v
    case error(_):
      return I64.literal(-9223372036854775808)
  end match
end function

function mulI(a: I64, b: I64) returns I64:
  match I64.checked_mul(a, b):
    case ok(v):
      return v
    case error(_):
      return I64.literal(9223372036854775807)
  end match
end function

function divI(a: I64, b: I64) returns I64:
  match I64.checked_div(a, b):
    case ok(v):
      return v
    case error(_):
      return I64.literal(0)
  end match
end function

function popcount_u(x: U64) returns U64:
  let a = subU(x, U64.bit_and(U64.shr(x, U64.literal(1)), U64.literal(6148914691236517205)))
  let b = addI_u(U64.bit_and(a, U64.literal(3689348814741910323)), U64.bit_and(U64.shr(a, U64.literal(2)), U64.literal(3689348814741910323)))
  let c = U64.bit_and(addI_u(b, U64.shr(b, U64.literal(4))), U64.literal(1085102592571150095))
  let s1 = addI_u(c, U64.shr(c, U64.literal(8)))
  let s2 = addI_u(s1, U64.shr(c, U64.literal(16)))
  let s3 = addI_u(s2, U64.shr(c, U64.literal(24)))
  let s4 = addI_u(s3, U64.shr(c, U64.literal(32)))
  let s5 = addI_u(s4, U64.shr(c, U64.literal(40)))
  let s6 = addI_u(s5, U64.shr(c, U64.literal(48)))
  let s7 = addI_u(s6, U64.shr(c, U64.literal(56)))
  return U64.bit_and(s7, U64.literal(255))
end function

function addI_u(a: U64, b: U64) returns U64:
  match U64.checked_add(a, b):
    case ok(v):
      return v
    case error(_):
      return U64.literal(18446744073709551615)
  end match
end function


function bridge64(x: U64) returns I64:
  match U64.less_than(x, U64.literal(64)):
    case false:
      return I64.literal(64)
    case true:
      return bridge_small(x)
  end match
  return I64.literal(0)
end function

function bridge_small(x: U64) returns I64:
    match U64.less_than(x, U64.literal(32)):
