record ScriptInput:
  field arguments: List[Text]
  field stdin: Bytes
end record

record ScriptOutput:
  field stdout: Bytes
  field stderr: Bytes
  field exit_code: I64
end record

enum ScriptErrorCode:
  case InvalidInput
  case ResourceLimit
  case DomainError
  case Cancelled
end enum

record ScriptError:
  field code: ScriptErrorCode
  field message: Text
end record

function main(input: ScriptInput) returns Result[ScriptOutput, ScriptError]:
  let words = sico.text.split_words("alpha beta gamma delta")
  let out = ""
  let total = I64.literal(0)
  for w in words:
    set out = sico.text.concat(out, w)
    set out = sico.text.concat(out, "|")
    match I64.checked_add(total, I64.literal(1)):
      case ok(next):
        set total = next
      case error(_):
        return error(ScriptError(code: ScriptErrorCode.DomainError, message: "overflow"))
    end match
  end for
  match I64.equal(total, I64.literal(4)):
    case true:
      return ok(ScriptOutput(stdout: sico.text.encode(out), stderr: sico.text.encode(""), exit_code: I64.literal(0)))
    case false:
      return error(ScriptError(code: ScriptErrorCode.DomainError, message: "count"))
  end match
end function
