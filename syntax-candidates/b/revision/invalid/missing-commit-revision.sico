// case: REV-101
// syntax: B
// expect: reject(MISSING_REVISION)
// semantics: SEM-083, SEM-113

newtype Revision from Int

enum SaveError:
  case Stale(expected: Revision, actual: Revision)
end enum

capability Store:
  function commit(expected: Revision, value: Text) returns Result[Revision, SaveError]
end capability

export function save(store: Store, value: Text) returns Result[Revision, SaveError]:
  effects:
    store.write
  capabilities:
    store
  return store.commit(value)
end function
