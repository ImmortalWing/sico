// case: CAP-001
// syntax: B
// expect: accept
// semantics: SEM-060, SEM-080, SEM-082

enum ConsoleError:
  case Denied
end enum

capability Console:
  function write(text: Text) returns Result[Unit, ConsoleError]
end capability

export function announce(console: Console) returns Result[Unit, ConsoleError]:
  effects:
    console.write
  capabilities:
    console
  return console.write("ready")
end function
