// case: STREAM-102
// syntax: B
// expect: reject(ASYNC_VALUE_REQUIRES_AWAIT)
// semantics: SEM-100, SEM-105

enum ReadError:
  case Failed
end enum

function pull_one(stream: Stream[Int, ReadError]) returns Result[Option[Int], ReadError]:
  using stream:
    return stream.next()
  end using
end function
