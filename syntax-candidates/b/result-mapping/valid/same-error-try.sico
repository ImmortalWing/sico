// case: RESULT-001
// syntax: B
// expect: accept
// semantics: SEM-034, SEM-070, SEM-071

enum LoadError:
  case Missing
end enum

function read_value() returns Result[Int, LoadError]:
  return ok(1)
end function

function load_twice() returns Result[Int, LoadError]:
  let first = try read_value()
  let second = try read_value()
  return ok(first + second)
end function
