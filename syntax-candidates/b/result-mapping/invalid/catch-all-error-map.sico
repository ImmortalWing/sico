// case: RESULT-103
// syntax: B
// expect: reject(SEALED_ERROR_WILDCARD)
// semantics: SEM-031, SEM-064, SEM-071

enum ParseError:
  case Empty
  case Invalid(value: Text)
end enum

enum AppError:
  case BadInput
end enum

function parse() returns Result[Int, ParseError]:
  return ok(1)
end function

function load() returns Result[Int, AppError]:
  return parse().map_error(function(problem) returns AppError:
    match problem:
      case ParseError.Empty:
        return AppError.BadInput
      case else:
        return AppError.BadInput
    end match
  end function)
end function
