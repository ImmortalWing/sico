// case: RES-103
// syntax: C
// expect: reject(BORROW_ACROSS_SUSPENSION)
// semantics: SEM-090, SEM-092, SEM-100

resource Reader {
  fn read(borrow self) -> Text
  fn close(self) -> Unit
}

async fn tick() -> Int {
  return 1
}

async fn read_later(reader: Reader) -> Text {
  let borrowed = borrow reader
  let pending = tick()
  let done = await pending
  return borrowed.read()
}
