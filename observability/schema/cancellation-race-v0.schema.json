{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sico.dev/schema/cancellation-race-v0.schema.json",
  "title": "Sico cancellation race v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "states", "winner_rule", "typed_cancellation_exit", "cases", "races"],
  "properties": {
    "schema": { "const": "sico.cancellation-race.v0" },
    "states": {
      "const": ["running", "cancellation-requested", "terminal"]
    },
    "winner_rule": { "const": "first-runtime-observed-committed-terminal-wins" },
    "typed_cancellation_exit": { "const": 123 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "runner_observed", "terminal_class", "exit_code", "typed_cancel"],
        "properties": {
          "id": { "type": "string", "pattern": "^cancel-v0-[a-z0-9-]+$" },
          "input": { "enum": ["guest-completion", "guest-failure", "timeout", "signal", "client-request", "host-failure", "external-kill-fallback"] },
          "runner_observed": { "type": "boolean" },
          "terminal_class": { "enum": ["output", "domain-error", "timeout", "cancelled", "host-provider-failure", "external-termination"] },
          "exit_code": { "type": ["integer", "null"], "minimum": 0, "maximum": 127 },
          "typed_cancel": { "type": "boolean" }
        }
      }
    },
    "races": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "first_observed", "second_observed", "expected_winner", "terminal_count"],
        "properties": {
          "id": { "type": "string", "pattern": "^race-v0-[a-z0-9-]+$" },
          "first_observed": { "type": "string", "minLength": 1, "maxLength": 64 },
          "second_observed": { "type": "string", "minLength": 1, "maxLength": 64 },
          "expected_winner": { "type": "string", "minLength": 1, "maxLength": 64 },
          "terminal_count": { "const": 1 }
        }
      }
    }
  }
}
