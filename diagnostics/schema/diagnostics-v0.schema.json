{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sico:schema:diagnostics:v0",
  "title": "Sico diagnostics envelope v0",
  "type": "object",
  "required": ["schema", "protocol_version", "tool", "coordinate_system", "diagnostics", "summary"],
  "properties": {
    "schema": { "const": "sico.diagnostics.v0" },
    "protocol_version": { "const": 0 },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "coordinate_system": {
      "type": "object",
      "required": ["encoding", "byte_base", "byte_end", "line_base", "column_base", "column_unit"],
      "properties": {
        "encoding": { "const": "utf-8" },
        "byte_base": { "const": 0 },
        "byte_end": { "const": "exclusive" },
        "line_base": { "const": 1 },
        "column_base": { "const": 1 },
        "column_unit": { "const": "unicode-scalar-value" }
      },
      "additionalProperties": true
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "summary": {
      "type": "object",
      "required": ["emitted", "errors", "warnings", "info", "suppressed", "truncated"],
      "properties": {
        "emitted": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "suppressed": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "position": {
      "type": "object",
      "required": ["byte", "line", "column"],
      "properties": {
        "byte": { "type": "integer", "minimum": 0 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" }
      },
      "additionalProperties": false
    },
    "arguments": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        ]
      }
    },
    "related": {
      "type": "object",
      "required": ["file", "range", "message"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "range": { "$ref": "#/$defs/range" },
        "message": { "type": "string", "minLength": 1, "maxLength": 120 }
      },
      "additionalProperties": true
    },
    "diagnostic": {
      "type": "object",
      "required": ["id", "code", "key", "severity", "kind", "message", "arguments", "file", "range"],
      "properties": {
        "id": { "type": "string", "pattern": "^d[1-9][0-9]*$" },
        "code": { "type": "string", "pattern": "^E[1-9][0-9]{3}$" },
        "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "severity": { "enum": ["error", "warning", "info"] },
        "kind": { "enum": ["root", "cascade"] },
        "caused_by": { "type": "string", "pattern": "^d[1-9][0-9]*$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 120 },
        "arguments": { "$ref": "#/$defs/arguments" },
        "file": { "type": "string", "minLength": 1 },
        "range": { "$ref": "#/$defs/range" },
        "related": {
          "type": "array",
          "items": { "$ref": "#/$defs/related" }
        },
        "hint": { "type": "string", "minLength": 1, "maxLength": 100 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "cascade" } } },
          "then": { "required": ["caused_by"] }
        }
      ],
      "additionalProperties": true
    }
  }
}
